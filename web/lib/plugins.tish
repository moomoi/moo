// The plugins in moomoi/plugins, for the marketplace. `commands` are [title, what it does];
// `network` is the manifest's permissions.network; `about` may hold <code>. Install opens
// moo://plugins/<id> (app/src/main.tish onUrl).
export let PLUGINS = [
    { id: 'devtools', glyph: '⌘', name: 'Dev Toolbox', by: 'moo', tag: 'core', tier: 'A', network: [],
      text: 'Base64, URLs, JWTs, JSON, hashes, colors and timestamps. Paste anything, copy the answer.',
      about: 'Type <code>dev</code> and paste. Dev Toolbox works out what you gave it and offers every transform that fits: decode a JWT and see when it expires, pretty-print or minify JSON, Base64 and URL encode or decode, SHA-1 and SHA-256, convert colors between hex, RGB and HSL, turn Unix timestamps into dates and back, or generate lorem ipsum. Everything runs offline in the sandbox.',
      commands: [['Dev Toolbox', 'dev, then paste anything'], ['Convert Timestamp', 'ts 1767225600 · ts now'], ['Generate Lorem Ipsum', 'lorem 3']] },
    { id: 'github', glyph: '⑂', name: 'GitHub', by: 'moo', tag: 'core', tier: 'A', network: ['api.github.com'],
      text: 'Your pull requests, review requests, issues and notifications, and repository search.',
      about: "Everything waiting on you, one keystroke away: your open pull requests, the reviews you've been asked for, issues assigned to you and your notifications. Type <code>gh</code> and a name to search repositories. Sign in with a personal access token; moo opens GitHub's token page with the right scopes and keeps the token in your Keychain.",
      commands: [['Search GitHub Repositories', 'gh moo'], ['My Pull Requests', 'Open PRs you wrote'], ['Review Requests', 'PRs waiting on your review'], ['My GitHub Issues', 'Assigned to you'], ['GitHub Notifications', 'Your inbox'], ['Add GitHub Token', 'One-time setup'], ['Sign Out of GitHub', '']] },
    { id: 'packages', glyph: '▣', name: 'Package Search', by: 'moo', tag: 'core', tier: 'A', network: ['registry.npmjs.org', 'crates.io', 'formulae.brew.sh', 'pypi.org'],
      text: 'npm, crates.io, Homebrew and PyPI. Open the page or copy the install command.',
      about: 'Look up a package without opening a browser. Search npm and crates.io by keyword, or look up a Homebrew formula or cask and a PyPI project by name. Each result shows its latest version and description; Return opens its page, and the row under it copies <code>npm i</code>, <code>cargo add</code>, <code>brew install</code> or <code>pip install</code>.',
      commands: [['Search npm', 'npm react'], ['Search crates.io', 'crate serde'], ['Search Homebrew', 'brew ripgrep'], ['Search PyPI', 'pip requests']] },
    { id: 'weather', glyph: '☀', name: 'Weather', by: 'moo', tag: 'core', tier: 'A', network: ['api.open-meteo.com', 'geocoding-api.open-meteo.com'],
      text: 'Now and the next 7 days for any city. No account, no API key.',
      about: 'Type <code>weather</code> and a city for the current conditions and a 7-day forecast, with the chance of rain. Add <code>f</code> or <code>c</code> to switch units. moo remembers your last city, so <code>weather</code> on its own is all you need. Forecasts come from Open-Meteo.',
      commands: [['Weather', 'weather paris · weather tokyo f']] },
    { id: 'convert', glyph: '⇄', name: 'Unit Converter', by: 'moo', tag: 'core', tier: 'A', network: [],
      text: 'Length, mass, volume, data and more. Type “5 mi in km” and copy the answer.',
      about: 'Every conversion for what you typed, as a list you can scroll and copy from. It covers length, mass, volume, data sizes and temperature. It runs entirely in its sandbox, with no network and no files.',
      commands: [['Convert Units', '10 km, 72 f, 3 lb, 512 mib'], ['Generate Password', 'Copy a random 20-character password'], ['Converter Stats', 'Calls served by this plugin']] },
    { id: 'slack', glyph: '#', name: 'Slack', by: 'moo', tag: 'core', tier: 'A', network: ['slack.com'],
      text: 'Send messages, search conversations and jump to any channel without opening Slack.',
      about: "Type <code>slack</code> and a space, pick who it's to, type the message and press Return. Search your messages as you type, or jump straight into any channel or DM. Sign-in uses OAuth with PKCE, so no secret ships with moo, and your token stays in the Keychain.",
      docs: '/docs/slack',
      commands: [['Send Slack Message', 'slack, then To and Message'], ['Search Slack Messages', 'Results as you type'], ['Open Slack Channel', 'Channels and DMs'], ['Refresh Slack Channels', 'Reload channels and people'], ['Sign In to Slack', 'Browser sign-in'], ['Sign Out of Slack', ''], ['Set Slack Client ID', 'One-time setup']] },
    { id: 'utils', glyph: '⚙', name: 'Moo Utils', by: 'moo', tag: 'core', tier: 'B', network: [],
      text: 'Generate UUIDs, find and copy emoji, and jump to developer docs from one place.',
      about: 'Small tools you reach for every day, a keystroke away. This is a first-party native plugin compiled into moo.',
      commands: [['Generate UUID', 'Copy a random v4 UUID'], ['Search Emoji', 'Find and copy an emoji'], ['Developer Links', 'Open docs in the browser'], ['Plugin Stats', 'How often this plugin ran']] },
    { id: 'hello-list', glyph: '≡', name: 'Hello List', by: 'moo', tag: 'example', tier: 'A', network: [],
      text: 'The smallest list plugin there is. Read it, fork it, ship your own in an afternoon.',
      about: "An example of list views. Star greetings in a dozen languages, or turn any text into camelCase, snake_case and friends. Start here if you're writing your first plugin.",
      docs: '/docs/first-plugin',
      commands: [['Hello List', 'Star a greeting'], ['Change Case', 'UPPER, lower, Title, camel, snake, kebab…']] }
]

export fn tagLabel(p) {
  return p.tag === 'core' ? 'Built in' : p.tag
}
