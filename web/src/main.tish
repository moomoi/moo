</div>
`)

fn legal(title, active, content) {
    let on = (name) => active === name ? ` class="on"` : ""
    return page(title, "legal", `<div class="wrap doc"><aside><a href="/legal"${on("index")}>Overview</a><a href="/legal/terms"${on("terms")}>Terms of Use</a><a href="/legal/privacy"${on("privacy")}>Privacy</a></aside><article class="prose up">${content}</article></div>`)
}

let LEGAL = legal("Legal · Moo", "index", `
<h1>Legal</h1>
<p>The short version: moo runs on your Mac, keeps your stuff on your Mac, and doesn't sell anything about you to anyone.</p>
<div class="legal-cards">
<a class="card" href="/legal/terms"><h3 style="margin-top:0">Terms of Use</h3><p>The rules for using moo and this site.</p></a>
<a class="card" href="/legal/privacy"><h3 style="margin-top:0">Privacy</h3><p>What moo touches, and what it never does.</p></a>
</div>
`)

let TERMS = legal("Terms of Use · Moo", "terms", `
<h1>Terms of Use</h1>
<p class="date">Last updated October 2026</p>
<h2>Using moo</h2>
<p>moo is provided free of charge for personal and commercial use on your own Macs. Use it lawfully and don't try to break, reverse-engineer around or abuse the services it connects to.</p>
<h2>Plugins</h2>
<p>Plugins in the marketplace may be written by third parties. They run sandboxed, but you're responsible for the plugins you install and the access you grant them.</p>
<h2>AI and third-party services</h2>
<p>When you use Ask AI with an external provider, or sign in to a service like Slack, your use of that service is also governed by its own terms.</p>
<h2>No warranty</h2>
<p>moo is provided <b>“as is”</b>, without warranties of any kind. To the extent the law allows, we aren't liable for any damages arising from its use.</p>
<h2>Changes</h2>
<p>We may update these terms. Material changes will be noted on this page with a new date.</p>
<h2>Contact</h2>
<p>Questions? Open an issue on <a href="${REPO_URL}">GitHub</a>.</p>
`)

let PRIVACY = legal("Privacy · Moo", "privacy", `
<h1>Privacy</h1>
<p class="date">Last updated October 2026</p>
<h2>Local first</h2>
<p>moo is a native app. Your searches, files, clipboard history and settings <b>stay on your Mac</b>. We don't run analytics or collect telemetry.</p>
<h2>Sign-in</h2>
<p>When you sign in, your browser passes briefly through <b>moo.moi/callback</b>, which forwards it straight back to moo on your Mac. The relay keeps no state and logs nothing about requests. The sign-in code can't be redeemed without a secret that never leaves your Mac.</p>
<h2>AI</h2>
<p>On-device Apple Intelligence never leaves your machine. If you choose an external provider, your prompts go directly to that provider under its privacy policy.</p>
<h2>Plugins</h2>
<p>Plugins run in a sandbox with no file, network or process access unless granted. A plugin that connects to a service, like Slack, talks to that service directly.</p>
<h2>This website</h2>
<p>moo.moi serves plain HTML and CSS. No scripts, no cookies, no trackers.</p>
<h2>Contact</h2>
<p>Questions? Open an issue on <a href="${REPO_URL}">GitHub</a>.</p>
`)

let SIGN_IN_FAILED = bare("Sign-in link not recognised · Moo", `
<img class="mark" src="${ICON_PNG}" alt="Moo">
<h1>This sign-in link isn't from moo</h1>
<p>We couldn't find moo waiting for this sign-in. No harm done — just start again from the app.</p>
<ol><li>Open moo</li><li>Go to <b>&nbsp;Settings → Account</b></li><li>Choose <b>&nbsp;Sign in</b></li></ol>
<a class="btn go" href="/">Back to moo.moi</a>
`)

let NOT_FOUND = bare("Not found · Moo", `
<p class="four grad">404</p>
<h1>moo? Nothing here.</h1>
<p>That page wandered off the pasture.</p>
<a class="btn go" href="/">Take me home</a>
`)

fn queryParam(query, name) {
    let parts = query.split("&")
    for (let i = 0; i < parts.length; i = i + 1) {
        let p = parts[i]
        let eq = p.indexOf("=")
        let key = eq < 0 ? p : p.slice(0, eq)
        if (key === name) {
            return eq < 0 ? "" : p.slice(eq + 1)
        }
    }
    return null
}

// The loopback port named by a relay state, or 0 when the state isn't `<port>.<nonce>`.
fn relayPort(state) {
    if (state === null) {
        return 0
    }
    let dot = state.indexOf(".")
    if (dot < 4 || dot > 5) {
        return 0
    }
    let nonce = state.slice(dot + 1)
    if (nonce.length < 16 || nonce.length > 128) {
        return 0
    }
    let port = 0
    for (let i = 0; i < dot; i = i + 1) {
        let d = DIGITS.indexOf(state[i])
        if (d < 0) {
            return 0
        }
        port = port * 10 + d
    }
    for (let i = 0; i < nonce.length; i = i + 1) {
        if (NONCE_CHARS.indexOf(nonce[i]) < 0) {
            return 0
        }
    }
    if (port < 1024 || port > 65535) {
        return 0
    }
    return port
}

fn callback(req) {
    let port = relayPort(queryParam(req.query, "state"))
    if (port === 0) {
        return { status: 400, headers: PAGE_HEADERS, body: SIGN_IN_FAILED }
    }
    return {
        status: 302,
        headers: {
            "Location": `http://127.0.0.1:${port}/callback?${req.query}`,
            "Cache-Control": "no-store",
            "Referrer-Policy": "no-referrer"
        },
        body: ""
    }
}

fn handle(req) {
    if (req.method !== "GET" && req.method !== "HEAD") {
        return { status: 405, headers: { "Allow": "GET, HEAD" }, body: "" }
    }
    if (req.path === "/callback") {
        return callback(req)
    }
    if (req.path === "/download") {
        return { status: 302, headers: { "Location": DOWNLOAD_URL, "Cache-Control": "no-store" }, body: "" }
    }
    if (req.path === "/health") {
        return { status: 200, headers: { "Content-Type": "text/plain", "Cache-Control": "no-store" }, body: "ok" }
    }
    let pages = { "/": HOME, "/index.html": HOME, "/get": GET, "/marketplace": MARKETPLACE, "/legal": LEGAL, "/legal/terms": TERMS, "/legal/privacy": PRIVACY }
    if (req.path in pages) {
        return { status: 200, headers: PAGE_HEADERS, body: pages[req.path] }
    }
    return { status: 404, headers: PAGE_HEADERS, body: NOT_FOUND }
}

let port = "PORT" in process.env ? parseInt(process.env.PORT) : 8080
console.log(`moo.moi listening on ${port}`)
serve(port, handle)
