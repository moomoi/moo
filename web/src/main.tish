// The plugins that ship in this repo (plugins/), plus what's next.
let PLUGINS = [
    { glyph: "⇄", name: "Unit Converter", by: "moo", tag: "core", text: "Length, mass, volume, data and more. Type “5 mi in km” and copy the answer." },
    { glyph: "#", name: "Slack", by: "moo", tag: "core", text: "Send messages, search conversations and jump to any channel without opening Slack." },
    { glyph: "⚙", name: "Moo Utils", by: "moo", tag: "core", text: "Generate UUIDs, find and copy emoji, and jump to developer docs from one place." },
    { glyph: "≡", name: "Hello List", by: "moo", tag: "example", text: "The smallest list plugin there is. Read it, fork it, ship your own in an afternoon." }
]

fn plugCards() {
    let out = ""
    for (let i = 0; i < PLUGINS.length; i = i + 1) {
        let p = PLUGINS[i]
        out = out + `<div class="card plug"><div class="top"><div class="glyph">${p.glyph}</div><div><h3>${p.name}</h3><span class="by">by ${p.by}</span></div></div><p>${p.text}</p><span class="tag${p.tag === "core" ? " core" : ""}">${p.tag === "core" ? "Built in" : p.tag}</span></div>`
    }
    return out
}

let MARKETPLACE = page("Marketplace · Moo", "market", `
<div class="wrap hero" style="padding-bottom:48px">
<span class="eyebrow up"><b></b>Marketplace</span>
