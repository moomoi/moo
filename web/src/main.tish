// moo.moi: the landing page, download, marketplace and legal pages, and the sign-in relay.
//
// Hypery only redirects to the registered https://moo.moi/callback, so /callback sends the browser
// on, query untouched, to the loopback listener Moo opened for that sign-in. The listener's port
// travels in `state` as `<port>.<nonce>`. Moo checks the whole state and redeems the code with its
// PKCE verifier, which never leaves the Mac, so nothing passing through here can be redeemed alone.

import { ICON_PNG, FAVICON_PNG } from "./icon.tish"

// Promoted releases are mirrored to this public repo under a fixed asset name (docs/release.md).
let DOWNLOAD_URL = "https://github.com/moomoi/moo/releases/latest/download/Moo-macos-universal.dmg"
let REPO_URL = "https://github.com/moomoi/moo"
let BREW = "brew install --cask moomoi/moo/moo"

let DIGITS = "0123456789"
let NONCE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// Pages carry no script; the policy keeps it that way. Every effect below is CSS.
let PAGE_HEADERS = {
    "Content-Type": "text/html; charset=utf-8",
    "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "Strict-Transport-Security": "max-age=31536000"
}

let STYLE = `
:root { color-scheme: dark light; --bg: #07070a; --fg: #f4f4f6; --dim: #8b8b96; --faint: #4a4a55; --glass: #ffffff0a; --glass2: #ffffff12; --line: #ffffff17; --g1: #fe588a; --g2: #5b6eff; --g3: #9b5bff; --grad: linear-gradient(110deg, var(--g1), var(--g3) 45%, var(--g2)); --mono: ui-monospace, "SF Mono", Menlo, monospace; }
@media (prefers-color-scheme: light) { :root { --bg: #fbfbfd; --fg: #0b0b10; --dim: #5d5d68; --faint: #b8b8c2; --glass: #ffffffb3; --glass2: #ffffff; --line: #0000001a; } }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--fg); font: 16px/1.55 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", "Helvetica Neue", sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
a { color: inherit; }
::selection { background: var(--g1); color: #fff; }

/* atmosphere */
.sky { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
.sky i { position: absolute; width: 60vmax; height: 60vmax; border-radius: 50%; filter: blur(90px); opacity: .32; animation: drift 22s ease-in-out infinite alternate; }
.sky i:nth-child(1) { background: var(--g1); top: -30vmax; left: -15vmax; }
.sky i:nth-child(2) { background: var(--g2); top: -25vmax; right: -20vmax; animation-duration: 28s; animation-direction: alternate-reverse; }
.sky i:nth-child(3) { background: var(--g3); bottom: -45vmax; left: 20vmax; opacity: .16; animation-duration: 34s; }
.sky::after { content: ""; position: absolute; inset: 0; background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 28px 28px; -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 70%); mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 70%); }
@keyframes drift { to { transform: translate(8vmax, 6vmax) scale(1.15); } }

/* nav */
nav { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(18px) saturate(1.6); -webkit-backdrop-filter: blur(18px) saturate(1.6); background: color-mix(in srgb, var(--bg) 60%, transparent); border-bottom: 1px solid var(--line); }
nav .in { width: min(1120px, 100% - 32px); margin: 0 auto; height: 60px; display: flex; align-items: center; gap: 24px; }
nav .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: -.03em; font-size: 20px; text-decoration: none; }
nav .brand img { width: 28px; height: 28px; border-radius: 7px; }
nav .links { margin-left: auto; display: flex; gap: 22px; align-items: center; font-size: 14px; }
nav .links a { text-decoration: none; color: var(--dim); transition: color .2s; }
nav .links a:hover, nav .links a.on { color: var(--fg); }
nav .links a.pill { color: #fff; background: var(--fg); color: var(--bg); padding: 7px 14px; border-radius: 99px; font-weight: 600; }
@media (max-width: 560px) { nav .links a.hide { display: none; } nav .links { gap: 14px; } }

.wrap { width: min(1120px, 100% - 32px); margin: 0 auto; }
.grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
.eyebrow { display: inline-flex; align-items: center; gap: 8px; font: 12px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--dim); padding: 6px 12px; border: 1px solid var(--line); border-radius: 99px; background: var(--glass); }
.eyebrow b { width: 6px; height: 6px; border-radius: 50%; background: var(--g1); box-shadow: 0 0 12px var(--g1); animation: pulse 2s infinite; }
@keyframes pulse { 50% { opacity: .3; } }
.up { animation: up .9s cubic-bezier(.2,.8,.2,1) both; }
.d1 { animation-delay: .08s; } .d2 { animation-delay: .16s; } .d3 { animation-delay: .24s; } .d4 { animation-delay: .32s; }
@keyframes up { from { opacity: 0; transform: translateY(18px); filter: blur(6px); } }

/* hero */
.hero { text-align: center; padding: 88px 0 40px; }
.hero h1 { font-size: clamp(96px, 22vw, 230px); line-height: .82; letter-spacing: -.075em; font-weight: 850; margin: 28px 0 18px; }
.hero h1 span { display: inline-block; padding: 0 .1em .04em 0; margin-right: -.025em; background: var(--grad); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer 8s linear infinite; filter: drop-shadow(0 20px 60px #fe588a40); }
@keyframes shimmer { to { background-position: -200% 0; } }
.hero .lede { font-size: clamp(18px, 2.4vw, 22px); color: var(--dim); max-width: 34ch; margin: 0 auto 34px; }
.hero .lede b { color: var(--fg); font-weight: 600; }
.ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; align-items: center; }
.btn { position: relative; display: inline-flex; align-items: center; gap: 10px; padding: 14px 24px; border-radius: 99px; font-weight: 650; text-decoration: none; transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s; }
.btn.go { color: #fff; background: var(--grad); box-shadow: 0 10px 40px -8px #fe588aaa, inset 0 1px 0 #ffffff55; }
.btn.go:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 18px 60px -8px #9b5bffcc, inset 0 1px 0 #ffffff55; }
.btn svg { width: 18px; height: 18px; }
.chip { font: 13px var(--mono); color: var(--dim); padding: 12px 18px; border: 1px solid var(--line); border-radius: 99px; background: var(--glass); user-select: all; max-width: 100%; overflow-x: auto; white-space: nowrap; }
.chip::before { content: "$ "; color: var(--g1); }
.fine { margin-top: 18px; font-size: 13px; color: var(--faint); }

/* launcher demo */
.stage { position: relative; margin: 64px auto 0; width: min(720px, 100%); }
.stage::before { content: ""; position: absolute; inset: 10% 5% -10%; background: var(--grad); filter: blur(70px); opacity: .35; z-index: -1; }
.win { border-radius: 22px; padding: 1px; background: linear-gradient(160deg, #ffffff40, #ffffff08 40%, #ffffff20); box-shadow: 0 40px 120px -30px #000c; text-align: left; }
.win .glass { border-radius: 21px; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px); overflow: hidden; }
.field { display: flex; align-items: center; gap: 14px; padding: 20px 22px; border-bottom: 1px solid var(--line); font-size: 24px; }
.field svg { width: 22px; height: 22px; flex: none; color: var(--dim); }
.keys { margin-left: auto; display: flex; gap: 6px; }
kbd { font: 12px var(--mono); padding: 3px 8px; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 7px; background: var(--glass2); color: var(--dim); }
.deck { display: grid; }
.deck > .q { grid-area: 1 / 1; opacity: 0; animation: show 16s infinite; }
.deck > .q:nth-child(2) { animation-delay: 4s; } .deck > .q:nth-child(3) { animation-delay: 8s; } .deck > .q:nth-child(4) { animation-delay: 12s; }
@keyframes show { 0%, 24% { opacity: 1; } 25%, 100% { opacity: 0; } }
.type { font-family: var(--mono); font-size: 21px; display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: bottom; width: 0; border-right: 2px solid var(--g1); animation: type 16s steps(var(--n)) infinite, caret .8s step-end infinite; animation-delay: inherit; }
.deck > .q:nth-child(2) .type { animation-delay: 4s, 0s; } .deck > .q:nth-child(3) .type { animation-delay: 8s, 0s; } .deck > .q:nth-child(4) .type { animation-delay: 12s, 0s; }
@keyframes type { 0% { width: 0; } 7%, 21% { width: calc(var(--n) * 1ch + 2px); } 24%, 100% { width: 0; } }
@keyframes caret { 50% { border-color: transparent; } }
.rows { padding: 8px; }
.row { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 12px; font-size: 15px; }
.row.hit { background: linear-gradient(90deg, #fe588a26, #5b6eff1a); box-shadow: inset 0 0 0 1px #fe588a40; }
.row .ic { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; font-size: 16px; background: var(--glass2); border: 1px solid var(--line); flex: none; }
.row small { color: var(--dim); margin-left: auto; font-size: 12px; font-family: var(--mono); }
.row em { font-style: normal; color: var(--dim); }
.big { font-size: 30px; font-weight: 700; letter-spacing: -.02em; }

/* sections */
section { padding: 120px 0 0; }
.head { text-align: center; margin-bottom: 48px; }
.head h2, h2.t { font-size: clamp(36px, 6vw, 64px); letter-spacing: -.045em; line-height: 1; margin: 18px 0 14px; font-weight: 800; }
.head p { color: var(--dim); font-size: 18px; max-width: 46ch; margin: 0 auto; }
.bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
.card { position: relative; grid-column: span 2; padding: 28px; border-radius: 22px; background: var(--glass); border: 1px solid var(--line); overflow: hidden; transition: transform .35s cubic-bezier(.2,.8,.2,1), border-color .35s; }
.card.w { grid-column: span 3; } .card.x { grid-column: span 4; }
.card::after { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; background: var(--grad); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s; }
.card:hover { transform: translateY(-4px); }
.card:hover::after { opacity: 1; }
.card h3 { font-size: 22px; letter-spacing: -.02em; margin: 18px 0 6px; }
.card p { color: var(--dim); margin: 0; font-size: 15px; }
.glyph { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--grad); box-shadow: 0 8px 24px -6px #fe588a99; color: #fff; }
.glyph svg { width: 22px; height: 22px; }
.card .stat { font-size: 72px; font-weight: 850; letter-spacing: -.06em; line-height: 1; }
@media (max-width: 820px) { .bento { grid-template-columns: 1fr; } .card, .card.w, .card.x { grid-column: auto; } }

.final { text-align: center; padding: 140px 0 40px; }
footer { position: relative; margin-top: 120px; border-top: 1px solid var(--line); overflow: hidden; }
footer .in { display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; padding: 28px 0; font-size: 13px; color: var(--dim); }
footer .in a { text-decoration: none; margin-left: 18px; } footer .in a:hover { color: var(--fg); }
footer .mega { font-size: clamp(120px, 34vw, 420px); font-weight: 900; letter-spacing: -.08em; line-height: .72; text-align: center; margin: 0 0 -.12em; background: linear-gradient(var(--line), transparent 85%); -webkit-background-clip: text; background-clip: text; color: transparent; user-select: none; }

/* download */
.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; counter-reset: s; text-align: left; margin-top: 80px; }
.steps div { padding: 26px; border-radius: 20px; border: 1px solid var(--line); background: var(--glass); counter-increment: s; }
.steps div::before { content: "0" counter(s); font: 13px var(--mono); color: var(--g1); }
.steps h3 { margin: 12px 0 6px; font-size: 19px; } .steps p { margin: 0; color: var(--dim); font-size: 15px; }
@media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
.specs { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
.specs span { font-size: 13px; color: var(--dim); padding: 6px 12px; border-radius: 99px; border: 1px solid var(--line); }

/* marketplace */
.market { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
.plug { grid-column: auto; display: flex; flex-direction: column; }
.plug .top { display: flex; align-items: center; gap: 14px; }
.plug .top .glyph { font-size: 22px; }
.plug h3 { margin: 0; font-size: 18px; }
.plug .by { font-size: 12px; color: var(--dim); font-family: var(--mono); }
.plug p { margin: 16px 0 20px; flex: 1; }
.tag { align-self: flex-start; font: 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; padding: 4px 10px; border-radius: 99px; border: 1px solid var(--line); color: var(--dim); }
.tag.core { color: var(--g1); border-color: #fe588a55; }
.plug.ghost { border-style: dashed; background: transparent; justify-content: center; align-items: center; text-align: center; min-height: 220px; }

/* legal */
.doc { display: grid; grid-template-columns: 200px 1fr; gap: 64px; padding-top: 72px; }
.doc aside { position: sticky; top: 92px; align-self: start; display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
.doc aside a { text-decoration: none; color: var(--dim); padding: 8px 12px; border-radius: 10px; }
.doc aside a.on { color: var(--fg); background: var(--glass2); box-shadow: inset 2px 0 0 var(--g1); }
.prose { max-width: 68ch; }
.prose h1 { font-size: clamp(40px, 6vw, 64px); letter-spacing: -.045em; line-height: 1; margin: 0 0 10px; }
.prose .date { font: 13px var(--mono); color: var(--dim); }
.prose h2 { font-size: 22px; letter-spacing: -.02em; margin: 44px 0 10px; }
.prose p, .prose li { color: var(--dim); }
.prose b { color: var(--fg); }
.prose a { color: var(--fg); text-decoration-color: var(--g1); text-underline-offset: 3px; }
.legal-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 32px; }
.legal-cards a { text-decoration: none; }
@media (max-width: 760px) { .doc { grid-template-columns: 1fr; gap: 24px; } .doc aside { position: static; flex-direction: row; } }

/* bare cards: sign-in relay errors, 404 */
.bare { min-height: 100vh; display: grid; place-items: center; padding: 32px 16px; }
.solo { width: min(460px, 100%); text-align: center; }
.solo .win .glass { padding: 40px 32px; }
.solo .mark { width: 72px; height: 72px; border-radius: 18px; box-shadow: 0 16px 50px -10px #fe588aaa; }
.solo h1 { font-size: 28px; letter-spacing: -.03em; margin: 22px 0 8px; }
.solo p { color: var(--dim); margin: 0 0 22px; }
.solo ol { text-align: left; margin: 0 0 26px; padding: 0; list-style: none; counter-reset: s; }
.solo li { counter-increment: s; display: flex; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; }
.solo li::before { content: counter(s); flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font: 12px var(--mono); background: var(--glass2); border: 1px solid var(--line); }
.four { font-size: clamp(120px, 30vw, 200px); font-weight: 900; letter-spacing: -.08em; line-height: .9; margin: 0; }

@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } .deck > .q:first-child { opacity: 1; } .deck > .q:first-child .type { width: auto; } }
`

let ICON_SEARCH = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`
let ICON_DOWN = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>`
let ICON_BOLT = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>`
let ICON_CHIP = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg>`
let ICON_KEY = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="3"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 15h10"/></svg>`
let ICON_SPARK = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 4.8 2.7 7.4 8 8-5.3.6-7.4 3.2-8 10-.6-6.8-2.7-9.4-8-10 5.3-.6 7.4-3.2 8-8z"/></svg>`
let ICON_PUZZLE = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M10 3h4v3a2 2 0 1 0 4 0V3h3v7h-3a2 2 0 1 0 0 4h3v7h-7v-3a2 2 0 1 0-4 0v3H3v-7h3a2 2 0 1 0 0-4H3V3z"/></svg>`

fn nav(active) {
    let on = (name) => active === name ? ` class="on"` : ""
    return `<nav><div class="in"><a class="brand" href="/"><img src="${ICON_PNG}" alt="">moo</a><div class="links"><a href="/marketplace"${on("market")}>Marketplace</a><a class="hide" href="/legal"${on("legal")}>Legal</a><a class="hide" href="${REPO_URL}">GitHub</a><a class="pill" href="/get">Download</a></div></div></nav>`
}

let FOOTER = `<footer><div class="wrap in"><span>© Moo · Made for the Mac, by keyboard.</span><span><a href="/get">Download</a><a href="/marketplace">Marketplace</a><a href="/legal/terms">Terms</a><a href="/legal/privacy">Privacy</a></span></div><div class="mega">moo</div></footer>`

fn shell(title, body) {
    return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#07070a"><title>${title}</title><link rel="icon" type="image/png" href="${FAVICON_PNG}"><link rel="apple-touch-icon" href="${ICON_PNG}"><style>${STYLE}</style></head><body><div class="sky"><i></i><i></i><i></i></div>${body}</body></html>`
}

// A full page: nav, content, footer. `active` lights up its nav link.
fn page(title, active, content) {
    return shell(title, `${nav(active)}<main>${content}</main>${FOOTER}`)
}

// A single centred glass card with no chrome, for the relay's error page and 404.
fn bare(title, content) {
    return shell(title, `<main class="bare"><div class="solo up"><div class="win"><div class="glass">${content}</div></div></div></main>`)
}

fn query(text, rows) {
    return `<div class="q"><div class="field">${ICON_SEARCH}<span class="type" style="--n:${text.length}">${text}</span><span class="keys"><kbd>⌘</kbd><kbd>Space</kbd></span></div><div class="rows">${rows}</div></div>`
}

fn row(icon, label, meta, hit) {
    return `<div class="row${hit ? " hit" : ""}"><span class="ic">${icon}</span><span>${label}</span><small>${meta}</small></div>`
}

let DEMO = `<div class="stage up d4"><div class="win"><div class="glass"><div class="deck">
${query("12% of 3,400", row("=", `<span class="big">408</span>`, "↵ copy", true) + row("⇄", "<em>3,400 × 0.12</em>", "math", false) + row("⌘", "Open Calculator", "app", false))}
${query("slack design", row("#", "#design <em>· Moo HQ</em>", "↵ open", true) + row("✉", "Send to #design…", "slack", false) + row("⌕", "Search Slack for “design”", "slack", false))}
${query("5 mi in km", row("⇄", `<span class="big">8.047 km</span>`, "↵ copy", true) + row("⇄", "<em>26,400 ft · 8,046.7 m</em>", "convert", false) + row("◫", "Units & currencies", "plugin", false))}
${query("ask why is the sky", row("✦", "Ask AI: “why is the sky blue?”", "↵ ask", true) + row("⎘", "Clipboard: “sky-hero.png”", "clip", false) + row("◐", "Toggle dark mode", "system", false))}
</div></div></div></div>`

let HOME = page("Moo — the launcher for macOS", "home", `
<div class="wrap hero">
<span class="eyebrow up"><b></b>Native · Instant · Yours</span>
<h1 class="up d1"><span>moo</span></h1>
<p class="lede up d2">One hotkey. Then <b>type anything</b>. Apps, files, math, clipboard, windows and AI — before you finish thinking it.</p>
<div class="ctas up d3"><a class="btn go" href="/get">${ICON_DOWN}Download for Mac</a><code class="chip">${BREW}</code></div>
<p class="fine up d3">Free · macOS 14+ · Apple silicon &amp; Intel</p>
${DEMO}
</div>
<section class="wrap" id="features">
<div class="head"><span class="eyebrow">Why moo</span><h2>Fast is a <span class="grad">feeling</span>.</h2><p>No webviews. No Electron. No spinner. Just your Mac, answering at the speed of your fingers.</p></div>
<div class="bento">
<div class="card x"><div class="glyph">${ICON_CHIP}</div><h3>Native all the way down</h3><p>AppKit from the first pixel to the last. It opens before your hand leaves the keyboard and sips memory while it waits.</p></div>
<div class="card"><div class="stat grad">0ms</div><h3>Spinners</h3><p>Answers appear as you type.</p></div>
<div class="card"><div class="glyph">${ICON_BOLT}</div><h3>Instant answers</h3><p>Math, units, currencies, time zones and definitions.</p></div>
<div class="card"><div class="glyph">${ICON_KEY}</div><h3>Your Mac, by keyboard</h3><p>Windows, volume, dark mode, running apps, system commands.</p></div>
<div class="card"><div class="glyph">${ICON_SPARK}</div><h3>AI built in</h3><p>On-device Apple Intelligence, or bring your own provider.</p></div>
