// The page frame: <html> with the inline stylesheet, the background, nav and footer.
import { h } from "lattish"
import { STYLE } from "../style.tish"
import { ICON_PNG, FAVICON_PNG } from "../icon.tish"
import { PLUGINS_REPO } from "../links.tish"

export fn Shell(props) {
  return (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#07070a" />
        <title>{props.title}</title>
        <link rel="icon" type="image/png" href={FAVICON_PNG} />
        <link rel="apple-touch-icon" href={ICON_PNG} />
        <style><raw html={STYLE} /></style>
      </head>
      <body>
        <div class="sky"><i></i><i></i><i></i></div>
        {props.children}
      </body>
    </html>
  )
}

// A nav link, lit up when it is the current section.
fn NavLink(props) {
  return <a href={props.href} class={props.active === props.name ? "on" : null}>{props.children}</a>
}

export fn Nav(props) {
  return (
    <nav>
      <div class="in">
        <a class="brand" href="/"><img src={ICON_PNG} alt="" />moo</a>
        <div class="links">
          <NavLink href="/docs" name="docs" active={props.active}>Docs</NavLink>
          <NavLink href="/marketplace" name="market" active={props.active}>Marketplace</NavLink>
          <a class="hide" href={PLUGINS_REPO}>GitHub</a>
          <a class="pill" href="/get">Download</a>
        </div>
      </div>
    </nav>
  )
}

export fn Footer() {
  return (
    <footer>
      <div class="wrap in">
        <span>© Moo · Made for the Mac, by keyboard.</span>
        <span><a href="/get">Download</a><a href="/docs">Docs</a><a href="/marketplace">Marketplace</a><a href="/legal/terms">Terms</a><a href="/legal/privacy">Privacy</a></span>
      </div>
      <div class="mega">moo</div>
    </footer>
  )
}

// A full page: nav, content, footer. `active` lights up its nav link.
export fn Page(props) {
  return (
    <Shell title={props.title}>
      <Nav active={props.active} />
      <main>{props.children}</main>
      <Footer />
    </Shell>
  )
}

// One centred glass card with no chrome: the relay's error page and the 404.
export fn Bare(props) {
  return (
    <Shell title={props.title}>
      <main class="bare"><div class="solo up"><div class="win"><div class="glass">{props.children}</div></div></div></main>
    </Shell>
  )
}

// The big hero heading used by the inner pages.
export fn Hero(props) {
  return (
    <div class="wrap hero" style={props.style ? props.style : null}>
      <span class="eyebrow up"><b></b>{props.eyebrow}</span>
      {props.children}
    </div>
  )
}
