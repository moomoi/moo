import { h } from "lattish"
import { Bare } from "../components/layout.tish"
import { ICON_PNG } from "../icon.tish"

// /callback with a state that isn't Moo's.
export fn SignInFailed() {
  return (
    <Bare title="Sign-in link not recognised · Moo">
      <img class="mark" src={ICON_PNG} alt="Moo" />
      <h1>This sign-in link isn't from moo</h1>
      <p>We couldn't find moo waiting for this sign-in. No harm done — just start again from the app.</p>
      <ol><li>Open moo</li><li>Go to <b>{" Settings → Account"}</b></li><li>Choose <b>{" Sign in"}</b></li></ol>
      <a class="btn go" href="/">Back to moo.moi</a>
    </Bare>
  )
}

export fn NotFound() {
  return (
    <Bare title="Not found · Moo">
      <p class="four grad">404</p>
      <h1>moo? Nothing here.</h1>
      <p>That page wandered off the pasture.</p>
      <a class="btn go" href="/">Take me home</a>
    </Bare>
  )
}
