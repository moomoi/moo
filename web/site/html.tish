// Server-side rendering for Lattish trees. Lattish's `h` builds plain { tag, props, children }
// nodes and calls function components on the spot, so a page is a tree of tags and text by the
// time it gets here; this turns it into HTML. The site renders every page once, at build time
// (render.tish), and the server only serves the strings.
//
// - Text and attribute values are escaped. `class` and `className` both work.
// - `true` boolean attributes render bare (`<details open>`); false and null ones are left out.
// - `<raw html={…} />` emits trusted HTML as is: inline SVG icons, rendered markdown, and the
//   plugins' `about` text, which carries <code>.

import { Fragment } from 'lattish'

let VOID = ['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'source', 'track', 'wbr']

export fn esc(s) {
  return ('' + s).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;')
}

fn attrs(props) {
  if (props === null) {
    return ''
  }
  let out = ''
  let keys = Object.keys(props)
  for (let i = 0; i < keys.length; i = i + 1) {
    let k = keys[i]
    let v = props[k]
    if (k === 'children' || k === 'key' || v === null || v === false) {
      continue
    }
    let name = k === 'className' ? 'class' : k
    out = out + (v === true ? ' ' + name : ' ' + name + '="' + esc(v) + '"')
  }
  return out
}

export fn renderToString(node) {
  if (node === null || node === false || node === true) {
    return ''
  }
  if (typeof node === 'string' || typeof node === 'number') {
    return esc(node)
  }
  if (Array.isArray(node)) {
    let out = ''
    for (let i = 0; i < node.length; i = i + 1) {
      out = out + renderToString(node[i])
    }
    return out
  }
  if (node.tag === 'raw') {
    return node.props !== null && node.props.html ? node.props.html : ''
  }
  let inner = renderToString(node.children)
  if (node.tag === Fragment) {
    return inner
  }
  if (VOID.indexOf(node.tag) >= 0) {
    return '<' + node.tag + attrs(node.props) + '>'
  }
  return '<' + node.tag + attrs(node.props) + '>' + inner + '</' + node.tag + '>'
}

// A whole document.
export fn renderPage(node) {
  return '<!doctype html>' + renderToString(node)
}
