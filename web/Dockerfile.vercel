# moo.moi on Vercel: the Lattish site rendered to HTML, then the Tish server compiled to a native
# Linux binary and served from distroless. Vercel builds this on every deploy from web/. The
# compiler and Lattish come from npm at the versions in package.json; the code the compiler
# generates takes the tish crates from crates.io.
# Also runs anywhere else: docker build -f Dockerfile.vercel -t moo-web .
# Stay on Debian 12 in both stages: building on a newer glibc than distroless/cc-debian12 makes the
# binary fail at start with "GLIBC_x.xx not found".

FROM node:22-bookworm-slim AS deps
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM rust:bookworm AS build
COPY --from=deps /usr/local/bin/node /usr/local/bin/node
WORKDIR /web
COPY . .
COPY --from=deps /web/node_modules ./node_modules
RUN node_modules/.bin/tish run --feature fs render.tish \
 && node_modules/.bin/tish build src/main.tish --target native --native-backend rust --feature http --feature process -o /moo-web

FROM gcr.io/distroless/cc-debian12
COPY --from=build /moo-web /moo-web
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/moo-web"]
