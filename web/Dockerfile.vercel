# moo.moi on Vercel: the Tish server compiled to a native Linux binary, served from distroless.
# Vercel builds this on every deploy from web/. The compiler is the npm release of tish (the same
# version as ../package.json): the npm package carries the sources a build needs next to the
# binary, which `cargo install` doesn't. The code it generates takes the tish crates from crates.io.
# Also runs anywhere else: docker build -f Dockerfile.vercel -t moo-web .
# Stay on Debian 12 in both stages: building on a newer glibc than distroless/cc-debian12 makes the
# binary fail at start with "GLIBC_x.xx not found".

FROM node:22-bookworm-slim AS tish
ARG TISH_VERSION=3.15.2
RUN npm install -g "@tishlang/tish@$TISH_VERSION"

FROM rust:bookworm AS build
COPY --from=tish /usr/local/lib/node_modules/@tishlang/tish /opt/tish
COPY src /web/src
WORKDIR /web
RUN /opt/tish/bin/tish build src/main.tish --target native --native-backend rust --feature http --feature process -o /moo-web

FROM gcr.io/distroless/cc-debian12
COPY --from=build /moo-web /moo-web
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/moo-web"]
