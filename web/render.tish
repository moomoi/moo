// Renders the whole site to HTML: every route's Lattish page (site/pages) through renderToString,
// written to dist/pages.tish, which the server (src/main.tish) compiles in. Run from web/ (build.sh does it first):
//
//   tish run --feature fs render.tish
//
// To change the site, edit the components in site/; dist/pages.tish is only ever generated.

import { h } from "lattish"
import { writeFile, mkdir } from "fs"
import { renderPage } from "./site/html.tish"
import { loadDocs } from "./site/markdown.tish"
import { PLUGINS } from "./site/plugins.tish"
import { Home } from "./site/pages/home.tish"
import { Get } from "./site/pages/get.tish"
import { Marketplace, PluginPage } from "./site/pages/marketplace.tish"
import { LegalIndex, Terms, Privacy } from "./site/pages/legal.tish"
import { DocsHome, DocPage } from "./site/pages/docs.tish"
import { SignInFailed, NotFound } from "./site/pages/errors.tish"

let docs = loadDocs("docs")

let pages = {}
let route = (path, node) => {
  pages[path] = renderPage(node)
}
route("/", <Home />)
route("/get", <Get />)
route("/marketplace", <Marketplace />)
for (let i = 0; i < PLUGINS.length; i = i + 1) {
  route("/marketplace/" + PLUGINS[i].id, <PluginPage plugin={PLUGINS[i]} />)
}
route("/legal", <LegalIndex />)
route("/legal/terms", <Terms />)
route("/legal/privacy", <Privacy />)
route("/docs", <DocsHome docs={docs} />)
for (let i = 0; i < docs.length; i = i + 1) {
  route("/docs/" + docs[i].slug, <DocPage docs={docs} index={i} />)
}

let out = "// Generated by web/render.tish from web/site/ and web/docs/. Do not edit.\n"
  + "export let PAGES = " + JSON.stringify(pages) + "\n"
  + "export let SIGN_IN_FAILED = " + JSON.stringify(renderPage(<SignInFailed />)) + "\n"
  + "export let NOT_FOUND = " + JSON.stringify(renderPage(<NotFound />)) + "\n"
mkdir("dist")
writeFile("dist/pages.tish", out)
console.log("site: " + Object.keys(pages).length + " pages (" + docs.length + " docs) -> dist/pages.tish")
