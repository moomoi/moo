import { Icon } from '../lib/icons.tish'
import { Hero } from '../lib/ui.tish'
import { BREW } from '../lib/links.tish'

export fn head(ctx) { return { title: 'Download', description: 'Download moo for macOS 14 and later, Apple silicon and Intel, or install it with Homebrew.' } }

fn Step(props) {
  return <div><h3>{props.title}</h3><p>{props.children}</p></div>
}

export fn page(ctx) {
  return (
    <Hero eyebrow="Latest release">
      <h2 class="t up d1" style="font-size:clamp(48px,9vw,104px)">Get <span class="grad">moo</span>.</h2>
      <p class="lede up d2">One download. Drag to Applications. Done.</p>
      <div class="ctas up d3"><a class="btn go" href="/download"><Icon name="down" />Download for Mac (.dmg)</a></div>
      <div class="specs up d3"><span>macOS 14 Sonoma or later</span><span>Universal · Apple silicon & Intel</span><span>Signed & notarized</span></div>
      <p class="fine up d4">Prefer Homebrew?</p>
      <div class="ctas up d4"><code class="chip">{BREW}</code></div>
      <div class="steps up d4">
        <Step title="Open the .dmg">Drag moo into Applications and launch it.</Step>
        <Step title="Grant access">Allow Accessibility so moo can manage windows and type for you.</Step>
        <Step title="Press the hotkey"><kbd>⌘</kbd> <kbd>Space</kbd> or your own. Then type anything.</Step>
      </div>
    </Hero>
  )
}
