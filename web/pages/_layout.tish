// Every page: the background, nav and footer. Docs and legal pages light up their nav link.
import { PLUGINS_REPO } from '../lib/links.tish'

fn NavLink(props) {
  return <a href={props.href} class={props.on ? 'on' : null}>{props.children}</a>
}

export fn layout(ctx, children) {
  let p = ctx.path
  return (
    <>
      <div class="sky"><i></i><i></i><i></i></div>
      <nav>
        <div class="in">
          <a class="brand" href="/"><img src="/icon.png" alt="" />moo</a>
          <div class="links">
            <NavLink href="/docs" on={p.startsWith('/docs')}>Docs</NavLink>
            <NavLink href="/marketplace" on={p.startsWith('/marketplace')}>Marketplace</NavLink>
            <a class="hide" href={PLUGINS_REPO}>GitHub</a>
            <a class="pill" href="/get">Download</a>
          </div>
        </div>
      </nav>
      <main>{children}</main>
      <footer>
        <div class="wrap in">
          <span>© Moo · Made for the Mac, by keyboard.</span>
          <span><a href="/get">Download</a><a href="/docs">Docs</a><a href="/marketplace">Marketplace</a><a href="/legal/terms">Terms</a><a href="/legal/privacy">Privacy</a></span>
        </div>
        <div class="mega">moo</div>
      </footer>
    </>
  )
}
