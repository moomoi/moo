// Stage 1: a natively compiled Tish host discovers and loads a Tish-compiled plugin at runtime.
// Build: tish build host.tish --target native --feature ffi -o host
// Run from this directory: ./host ../host-vm/plugins/hello-v2.lib

import { loadModule } from "tish:ffi"
import { argv } from "tish:process"

let path = argv.length > 1 ? argv[argv.length - 1] : "../host-vm/plugins/hello-v2.lib"
let plugin = loadModule(path)

console.log("exports  =", JSON.stringify(Object.keys(plugin)))
console.log("manifest =", JSON.stringify(plugin.manifest()))
console.log("greet    =", plugin.greet("native host"))

let items = ["Safari", "Slack", "System Settings", "Terminal"].map((t) => ({ title: t }))
console.log("search   =", JSON.stringify(plugin.search(items, "s")))

let rendered = []
let onAction = plugin.run((tree) => { rendered.push(tree) })
console.log("rendered =", JSON.stringify(rendered))
console.log("onAction =", onAction("open"))

try {
  plugin.fail()
  console.log("fail     = no throw (wrong)")
} catch (e) {
  console.log("fail     = caught", JSON.stringify(e))
}

try {
  loadModule("./does-not-exist.lib")
  console.log("missing  = no throw (wrong)")
} catch (e) {
  console.log("missing  = caught", e.name + ": " + e.message.slice(0, 70))
}

let n = 100000
let t0 = Date.now()
for (let i = 0; i < n; i = i + 1) {
  plugin.greet("x")
}
let dt = Date.now() - t0
console.log("greet x" + n + " in " + dt + "ms => " + (dt * 1000 / n) + "us/call")
console.log("again    =", loadModule(path) === plugin ? "same object" : "new object, cached library")
