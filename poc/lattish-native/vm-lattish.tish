// Lattish (the Tish source: reconciler + hooks) on the bytecode VM, driving a recording host.
// This is the Tier A plugin shape: the plugin VM runs Lattish, the host receives node operations.
import { h, Fragment, useState, createRoot } from "lattish"

let nextId = 1
let ops = []
let handlers = {}

fn node(kind, tag) {
  let n = { id: nextId, kind: kind, tag: tag, text: "", children: [] }
  nextId = nextId + 1
  return n
}

let RecordingHost = {
  createElement: (tag) => { let n = node("el", tag); ops.push("create " + tag + "#" + n.id); return n },
  createText: (v) => { let n = node("text", null); n.text = v; ops.push("text#" + n.id + " " + JSON.stringify(v)); return n },
  createComment: () => node("comment", null),
  createFragment: () => node("fragment", null),
  isText: (n) => n.kind === "text",
  setText: (n, v) => { if (n.text !== v) { n.text = v; ops.push("setText#" + n.id + " " + JSON.stringify(v)) } },
  appendChild: (p, c) => {
    if (c.kind === "fragment") {
      for (let k of c.children) { p.children.push(k) }
      c.children = []
    } else {
      p.children.push(c)
    }
    ops.push("append #" + c.id + " -> #" + p.id)
  },
  removeChild: (p, c) => { p.children = p.children.filter((x) => x.id !== c.id); ops.push("remove #" + c.id) },
  replaceChild: (p, nc, oc) => { p.children = p.children.map((x) => x.id === oc.id ? nc : x); ops.push("replace #" + oc.id + " with #" + nc.id) },
  replaceChildren: (p, nodes) => { p.children = nodes; ops.push("replaceChildren #" + p.id) },
  childAt: (p, i) => p.children[i],
  firstChild: (p) => p.children.length > 0 ? p.children[0] : null,
  mountProp: (el, tag, k, v) => {
    if (k === "onClick") { handlers[String(el.id)] = v } else { ops.push("prop #" + el.id + " " + k + "=" + JSON.stringify(v)) }
  },
  patchProp: (el, tag, k, v, prev) => {
    if (k === "onClick") { handlers[String(el.id)] = v } else { ops.push("patch #" + el.id + " " + k + "=" + JSON.stringify(v)) }
  },
  styleRemoved: (el) => {},
  setRef: (refObj, value) => { refObj.current = value },
  schedule: (cb) => { pending.push(cb) }
}

let pending = []
fn drainPending() {
  while (pending.length > 0) {
    let batch = pending
    pending = []
    for (let cb of batch) { cb() }
  }
}

fn Row(props) {
  return <item title={props.title} subtitle={props.subtitle} />
}

fn App() {
  let [query, setQuery] = useState("")
  let all = [
    { title: "Safari", subtitle: "Application" },
    { title: "Slack", subtitle: "Application" },
    { title: "Terminal", subtitle: "Application" }
  ]
  let rows = all.filter((r) => r.title.toLowerCase().indexOf(query) >= 0)
  return (
    <list searchText={query}>
      <button onClick={() => setQuery("s")}>{"filter: " + query}</button>
      {rows.map((r) => <Row title={r.title} subtitle={r.subtitle} />)}
    </list>
  )
}

fn dump(n, depth) {
  let pad = ""
  for (let i = 0; i < depth; i = i + 1) { pad = pad + "  " }
  if (n.kind === "text") { console.log(pad + JSON.stringify(n.text)); return }
  if (n.kind === "comment") { return }
  console.log(pad + "<" + n.tag + " #" + n.id + ">")
  for (let c of n.children) { dump(c, depth + 1) }
}

let root = node("el", "root")
createRoot(root, RecordingHost).render(App)
drainPending()
console.log("--- mount: " + ops.length + " ops")
dump(root, 0)

ops = []
let btn = root.children[0].children.find((c) => c.tag === "button")
handlers[String(btn.id)]()
drainPending()
console.log("--- after click: " + ops.length + " ops")
for (let o of ops) { console.log("  " + o) }
dump(root, 0)
