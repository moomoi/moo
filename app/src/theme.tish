// Moo's look: every colour, type size, corner radius, glass tint and animation timing. To
// re-theme, edit or replace THEME; nothing visual is decided in Rust (setTheme hands the panel
// part to the native side, the rest is used by the views in main.tish).
//
// Colours are AppKit semantic names, which follow light / dark mode by themselves ("label",
// "secondaryLabel", "controlAccent", "quaternaryLabel", …), or hex "#RRGGBB" / "#RRGGBBAA".
// Panel colours may also be { light, dark }.

export const THEME = {
  colors: {
    text: 'label',
    secondaryText: 'secondaryLabel',
    accent: 'controlAccent',
    onAccent: '#FFFFFF',
    selection: 'quaternaryLabel',
    keycap: 'quaternaryLabel',
    hover: '#8080801F',
    keycapHover: 'tertiaryLabel',
    scrollThumbHover: 'secondaryLabel',
    clear: '#00000000',
    divider: 'separator',
    scrollThumb: 'tertiaryLabel',
    scrollTrack: '#00000000'
  },
  scrollbar: { width: 6, gap: 4, inset: 6, minThumb: 28 },
  type: {
    field: 22,
    row: 14,
    detail: 13,
    section: 12,
    status: 12,
    hint: 12,
    keycap: 11,
    gridLabel: 11
  },
  weight: { row: 'regular', section: 'semibold', keycap: 'medium' },
  icon: {
    searchImage: 'SearchIcon.png',
    search: 'magnifyingglass',
    calculator: 'equal.circle.fill',
    dictionary: 'character.book.closed.fill',
    web: 'globe',
    settings: 'gearshape',
    contact: 'person.crop.circle.fill',
    email: 'envelope',
    phone: 'phone',
    ai: 'sparkles',
