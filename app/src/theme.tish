    signedIn: 'person.crop.circle.fill',
    apiKey: 'key',
    signUp: 'person.badge.plus',
    balance: 'creditcard',
    addCredits: 'plus.circle',
    signOut: 'rectangle.portrait.and.arrow.right',
    waiting: 'globe',
    warning: 'exclamationmark.triangle',
    organization: 'building.2',
    personalOrg: 'person.crop.square',
    row: 24,
    field: 22,
    category: 20,
    grid: 64,
    symbolScale: 'large'
  },
  radius: { row: 10, gridCell: 14, keycap: 5 },
  hotkeys: { alias: 120, keys: 150 },
  statusIcon: 'MenuBarIcon.tiff',
  statusSymbol: 'magnifyingglass',
  appIcon: 'AppIcon.icns',
  panel: { radius: 22, margin: 36, top: 0.8, shadow: { opacity: 0.35, radius: 18, offset: 8 } },
  glass: {
    style: 'clear',
    spacing: 6,
    tint: {
      bar: { light: '#F7F7FA59', dark: '#0F0F1259' },
      panel: { light: '#F7F7FA59', dark: '#0F0F1259' }
    },
    scrim: { light: '#FAFAFC8C', dark: '#0C0C0E8C' }
  },
  vibrancy: {
    material: 'popover',
    tint: { light: '#FAFAFCC7', dark: '#1A1A1CC7' },
    edge: { light: '#0000001F', dark: '#FFFFFF24' },
    edgeWidth: 1,
    shadow: true
  },
  motion: {
    open: {
      response: 0.18,
      damping: 0.58,
      secs: 0,
      stagger: 0.016,
      fadeDelay: 0.09,
      fadeSecs: 0.1,
      pieceFade: 3,
      tuck: 4,
      scale: { bar: [0.6, 0.8], panel: [0.94, 0.96] }
    },
    morph: { response: 0.42, damping: 0.78, secs: 0.6, fade: 1.5 }
  }
}
// Views drawn by Tish.
// Selected row, grid cell and key-cap backgrounds.
// Under the pointer: rows, grid cells, category buttons and scroll bar thumb; key caps. Fainter
// than the selection, which keeps its colour when hovered.
// Layer colours need alpha hex: "#00000000" keeps a row's layer, so its shape never changes.
// The hairline under the search field and above the footer.
// Scroll bar beside lists and the grid: the thumb, and the track behind it.
// Shown only when there is more than fits. width: the bar; gap: space left of it; inset: space
// above and below the track; minThumb: the shortest thumb.
// Icon heights: result rows, the field's search / category symbol, category buttons, the grid.
// Image in the field outside a category, among Moo's resources (packaging/ in the repo), tinted
// like a symbol. `search` (an SF Symbol) stands in when that file is missing.
// SF Symbol beside calculator and time zone answers.
// SF Symbol of Define Word and dictionary answers.
// SF Symbol of Search the Web, its suggestions and the root "Search Google" row.
// SF Symbol of Settings.
// SF Symbols of Search Contacts: a contact, its email addresses and phone numbers.
// SF Symbols of Ask AI and AI Models, and of the Hypery Account rows.
// SF Symbols of a Hypery organization without its own icon: a team, the personal one.
// SF Symbol scale: "small", "medium" or "large".
// Column widths of the Hotkeys and Aliases table, after the name.
// Menu bar icon: an image among Moo's resources (packaging/ in the repo), drawn as a template.
// `statusSymbol` (an SF Symbol) stands in when that file is missing.
// App icon, also on Moo's own rows (Settings, Quit Moo).

// The panel behind the views (glass on macOS 26, vibrancy before).
// Corner radius of the full panel; the idle bar's pieces are capsules.
// Clear border around the panel, so springs can overshoot without clipping.
// Top edge, as a fraction of the screen height from the bottom.
// Drop shadow under the panel (inside the margin): how dark, how soft, how far down.
// "regular" or "clear".
// Pieces closer than this melt together; the idle bar's 8 pt gaps keep them apart at rest.
// Clear glass with one light tint, the same collapsed and expanded.
// Drawn over the glass, under the views: how much the glass dims what is behind it, so busy
// content (text, windows) never competes with Moo's own. Raise the alpha for more contrast.
// Before macOS 26: raw vibrancy lets busy windows show through, so a dense tint keeps text
// readable, with a hairline edge and the window's shadow.
// Opening: the field grows from its centre (from `scale` of its size) and the buttons spring
// out of its right end, `stagger` apart; the views fade in from `fadeDelay` over `fadeSecs`,
// as the pieces reach their places. response is the spring's period, damping its damping
// ratio (0.58 overshoots about 11%), secs its length (0 turns it off).
// 0: no opening animation; the panel appears at once. (0.36 springs it open.)
// Bar ↔ panel: slower and softer than opening, so the change reads as motion and the big
// panel overshoots less than the margin (about 2%). `fade` is how fast pieces that only one
// shape has fade out or in.
