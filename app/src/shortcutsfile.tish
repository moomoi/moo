// shortcuts.json on disk: where it is, reading it, and editing it in place (see shortcuts.tish
// for the format). Each edit reads the file fresh, changes it and writes it atomically, so hand
// edits made meanwhile are kept.

import { readFile, writeFile, mkdir, rename, fileExists } from 'tish:fs'
import { env } from 'tish:process'
import { keysError, localDateTime } from 'tish:moo'
import { clipboardText, selectedText } from './platform.tish'
import { parse, toJson, emptyConfig, shortcut, needsQuery, expand, shellValues as argsOf, upsert, remove, bind, unbind, checkKeyword as keywordError, checkAlias as aliasError, setAlias as putAlias, setDisabled as putDisabled, setPanelKey as putPanelKey, setProvider } from './shortcuts.tish'

export fn configPath() {
  if (env.MOO_CONFIG) {
    return env.MOO_CONFIG
  }
  if (env.XDG_CONFIG_HOME) {
    return env.XDG_CONFIG_HOME + '/moo/shortcuts.json'
  }
  return env.HOME ? env.HOME + '/.config/moo/shortcuts.json' : ''
}

export fn configDir() {
  let p = configPath()
  let i = p.lastIndexOf('/')
  return i > 0 ? p.slice(0, i) : ''
}

fn failed(r) {
  return typeof r === 'object' && r !== null && 'error' in r
}

// -> { cfg, warnings } or { error }; a missing file is an empty config.
fn load() {
  let path = configPath()
  if (path === '') {
    return { error: 'HOME is not set' }
  }
  if (!fileExists(path)) {
    return { cfg: emptyConfig(), warnings: [] }
  }
  let text = readFile(path)
  if (failed(text)) {
    return { error: path + ': ' + text.error }
  }
  let r = parse(text, keysError)
  return failed(r) ? { error: path + ': ' + r.error } : r
}

// Write atomically (temp file, then rename), creating the folder. null or the error.
fn save(cfg) {
  let path = configPath()
  let made = mkdir(configDir(), { recursive: true })
  if (failed(made)) {
    return configDir() + ': ' + made.error
  }
  let tmp = path + '.tmp'
  let w = writeFile(tmp, toJson(cfg))
  if (failed(w)) {
    return tmp + ': ' + w.error
  }
  let r = rename(tmp, path)
  return failed(r) ? path + ': ' + r.error : null
}

fn result(error) {
  return error === null ? { ok: true } : { ok: false, error: error }
}

// Load, apply `f(cfg)` (null or an error), save -> { ok, error }.
fn edit(f) {
  let r = load()
  if (failed(r)) {
    return result(r.error)
  }
  let e = f(r.cfg)
  return result(e !== null ? e : save(r.cfg))
}

// -> { ok, error, path, launcher, aiModel, shortcuts, hotkeys, aliases: [{ run, alias }],
// disabled: [run], keys: [{ action, keys }], warnings }.
export fn loadShortcuts() {
  let r = load()
  let cfg = failed(r) ? emptyConfig() : r.cfg
  return {
    ok: !failed(r),
    error: failed(r) ? r.error : '',
    path: configPath(),
    launcher: cfg.launcher,
    aiModel: cfg.ai.model,
    shortcuts: cfg.shortcuts.map((x) => ({
      keyword: x.keyword, name: x.name, kind: x.kind, target: x.target, input: x.input, output: x.output,
      hotkey: x.hotkey, expand: x.kind === 'text' && x.expand,
      needsQuery: needsQuery(x.kind === 'command' ? x.input : x.target)
    })),
    hotkeys: cfg.hotkeys,
    aliases: cfg.aliases.map((p) => ({ run: p[0], alias: p[1] })),
    disabled: cfg.disabled,
    keys: cfg.keys.map((p) => ({ action: p[0], keys: p[1] })),
    warnings: failed(r) ? [] : r.warnings
  }
}

// `ai` in the file: { model, providers: [{ id, title, url, keyEnv, clientId, redirectUri,
// organization }] }; empty when the file is missing or broken.
export fn aiConfig() {
  let r = load()
  return failed(r) ? { model: '', providers: [] } : r.cfg.ai
}

// The file's path, creating an empty one if missing (never rewrites).
export fn ensureShortcutsFile() {
  let path = configPath()
  if (path !== '' && !fileExists(path)) {
    let e = save(emptyConfig())
    if (e !== null) {
      console.error('moo: ' + e)
    }
  }
  return path
}

// `saveShortcut({ keyword, name, kind, target, input?, output?, hotkey?, model?, expand? },
// replacing?)`; `replacing` is the keyword of the shortcut being edited.
export fn saveShortcut(v, replacing) {
  let s = shortcut(v)
  if (s.hotkey !== '') {
    let e = keysError(s.hotkey)
    if (e !== null) {
      return result(e)
    }
  }
  return edit((cfg) => upsert(cfg, s, replacing))
}

export fn checkKeyword(keyword, replacing) {
  let r = load()
  return result(keywordError(failed(r) ? emptyConfig() : r.cfg, keyword, replacing))
}

export fn removeShortcut(keyword) {
  return edit((cfg) => remove(cfg, keyword))
}

// Add or replace a hotkey binding.
export fn bindHotkey(keys, run, query) {
  let e = keysError(keys)
  let b = { keys: keys, run: run, query: typeof query === 'string' ? query : '' }
  return e !== null ? result(e) : edit((cfg) => bind(cfg, b))
}

export fn unbindHotkey(keys) {
  return edit((cfg) => unbind(cfg, keys))
}

// Save the launcher hotkey ("" removes it). Registering it is up to the caller.
export fn setLauncherHotkey(keys) {
  let e = keys === '' ? null : keysError(keys)
  if (e !== null) {
    return result(e)
  }
  return edit((cfg) => {
    cfg.launcher = keys
    return null
  })
}

// Save `alias` for what `run` names ("" removes it).
export fn setAlias(run, alias) {
  return edit((cfg) => putAlias(cfg, run, alias))
}

export fn checkAlias(alias, run) {
  let r = load()
  return result(aliasError(failed(r) ? emptyConfig() : r.cfg, alias, run))
}

// Leave what `run` names out of search, or bring it back.
export fn setDisabled(run, disabled) {
  return edit((cfg) => putDisabled(cfg, run, disabled === true))
}

// Save a panel key ("none" for no key, "" for the default).
export fn setPanelKey(action, keys) {
  let e = keys === '' || keys === 'none' ? null : keysError(keys)
  return e !== null ? result(e) : edit((cfg) => putPanelKey(cfg, action, keys))
}

// `ai.model`: `apple` or `provider:model`; empty lets Moo choose.
export fn aiSetModel(model) {
  return edit((cfg) => {
    cfg.ai.model = model.trim()
    return null
  })
}

// The OAuth client id for a provider's browser sign-in.
export fn aiSetClientId(provider, id) {
  return edit((cfg) => setProvider(cfg, provider, 'clientId', id.trim()))
}

// The organization a provider's requests act for and bill to; "" for the personal one.
export fn aiSetOrganization(provider, id) {
  return edit((cfg) => setProvider(cfg, provider, 'organization', id.trim()))
}

// Values for a template, reading the clipboard, selection and clock only when it uses them.
fn varsFor(template, query) {
  let v = { query: query, clipboard: '', selection: '', date: '', time: '' }
  if (template.indexOf('{clipboard}') >= 0) {
    v.clipboard = clipboardText()
  }
  if (template.indexOf('{selection}') >= 0) {
    let t = selectedText()
    v.selection = typeof t === 'string' ? t : ''
  }
  if (template.indexOf('{date}') >= 0 || template.indexOf('{time}') >= 0) {
    let dt = localDateTime()
    v.date = dt[0]
    v.time = dt[1]
  }
  return v
}

// Fill `{query}` (encoded for the kind), `{clipboard}`, `{selection}`, `{date}` and `{time}`;
// `~/` at the start becomes the home folder for `open`.
export fn expandTemplate(template, query, kind) {
  let out = expand(template, varsFor(template, query), kind)
  if (kind === 'open' && (out === '~' || out.startsWith('~/')) && env.HOME) {
    out = env.HOME + out.slice(1)
  }
  return out
}

// `[query, clipboard, selection]`: the `$1`..`$3` of a shell shortcut's script.
export fn shellValues(template, query) {
  return argsOf(varsFor(template, query))
}
