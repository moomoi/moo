fn pick(list, roll) {
  return list[Math.floor(roll * list.length) % list.length]
}

// A fresh roll from an old one, so one random number can make several independent choices.
fn reroll(roll) {
  let r = (roll * 9301 + 0.49297) * 233.280
  return r - Math.floor(r)
}

// `date` is the local "YYYY-MM-DD", `time` the local "HH:MM", `roll` a number in [0, 1).
export fn greeting(date, time, roll) {
  let hour = parseInt(time.slice(0, 2))
  let monthDay = date.slice(5, 10)
  let month = '' + parseInt(date.slice(5, 7))
  let weekday = new Date(date + 'T12:00:00Z').getUTCDay()
  let r = reroll(roll)
  // A holiday wins most of the time; otherwise mix time of day, weekday, season and evergreens.
  if (monthDay in DATES && roll < 0.7) {
    return pick(DATES[monthDay], r)
  }
  if (time === '11:11') {
    return '11:11, make a moo-wish'
  }
  if (roll < 0.3 && !isNaN(hour)) {
    for (let i = 0; i < TIME_OF_DAY.length; i = i + 1) {
      let slot = TIME_OF_DAY[i]
      if (hour >= slot[0] && hour <= slot[1]) {
        return pick(slot[2], r)
      }
    }
  }
  if (roll < 0.5 && !isNaN(weekday)) {
    return pick(WEEKDAYS[weekday], r)
  }
  if (roll < 0.58 && month in MONTHS) {
    return pick(MONTHS[month], r)
  }
  return pick(ANYTIME, r)
}
