// Remote and local language models: Hypery (API key or browser sign-in), OpenAI, Ollama and
// LM Studio built in, more from `ai.providers` in shortcuts.json. Requests go through tish:http and
// macos.whenSettled, so the launcher never waits on the network; callbacks run on the main thread.
//
// Credentials, first found: an API key in the Keychain (account = provider id), an OAuth token
// (account `<id>.oauth`, refreshed when it expires, one refresh at a time per provider so a rotating
// refresh token is never spent twice), the provider's environment variable. Local providers need
// none. Apple's on-device model is separate (aiAsk and friends, native).
//
// Note for the native compiler: a parameter that is only stored in an object literal gets typed as
// a number (and panics on a string), so such parameters go through `"" + x` first.

import { macos } from "tish:macos"
import { fetch } from "tish:http"
import { env } from "tish:process"
import { keychainGet, keychainSet, keychainDelete, keychainHas, oauthSignIn, oauthCancel, oauthRefresh, withUi } from "tish:moo"
import { aiConfig } from "./shortcutsfile.tish"
import { providers, splitModel, origin, endpoints, oauthAccount, noCredential, newLines, feedLines, newStream, streamLine, errorMessage, parseModels, parseOrgs, activeOrg, dollars, parseTokens, tokensJson, staleTokens, ORG_HEADER, utf8 } from "./aicore.tish"

// Wait for `p`, then `cb(value, error)` against the launcher UI (focus kept).
fn settle(p, cb) {
  macos.whenSettled(p, (v, e) => {
    withUi(() => cb(v, e))
  })
}

fn now() {
  return Date.now() / 1000
}

fn allProviders() {
  return providers(aiConfig().providers, env)
}

fn findProvider(name) {
  let list = allProviders()
  for (let i = 0; i < list.length; i = i + 1) {
    if (list[i].id === name) {
      return list[i]
    }
  }
  return null
}

fn envValue(name) {
  if (name === "") {
    return ""
  }
  let v = env[name]
  return typeof v === "string" ? v : ""
}

// ── Credentials ─────────────────────────────────────────────────────────────

// What `credential` would find, without reading the Keychain: "key", "signed in", "environment"
// or "".
fn credentialSource(p) {
  if (keychainHas(p.id)) {
    return "key"
  }
  if (keychainHas(oauthAccount(p.id))) {
    return "signed in"
  }
  return envValue(p.keyEnv) !== "" ? "environment" : ""
}

// Refreshes in flight, by provider id: the callbacks waiting for the new token.
let refreshing = {}

// `done(error, key)`: the API key or access token for `p`, or key null when there is none. May
// refresh an OAuth token first (one refresh per provider at a time).
fn credential(p, done) {
  if (keychainHas(p.id)) {
    let k = keychainGet(p.id)
    if (typeof k === "string" && k !== "") {
      done(null, k)
      return
    }
  }
  let account = oauthAccount(p.id)
  if (keychainHas(account)) {
    let saved = keychainGet(account)
    let t = typeof saved === "string" ? parseTokens(saved) : null
    if (t !== null && !staleTokens(t, now())) {
      done(null, t.access)
      return
    }
    let ep = endpoints(p)
    if (t !== null && ep !== null && t.refresh !== "") {
      if (p.id in refreshing) {
        refreshing[p.id].push(done)
        return
      }
      refreshing[p.id] = [done]
      let title = "" + p.title
      oauthRefresh(ep, t.refresh, (r) => {
        let waiting = refreshing[p.id]
        delete refreshing[p.id]
        let err = null
        if (r.error !== "") {
          err = title + ": sign in again (" + r.error + ")"
        } else {
          let saveError = keychainSet(account, tokensJson(r))
          if (saveError !== null) {
            err = saveError
          }
        }
        for (let i = 0; i < waiting.length; i = i + 1) {
          waiting[i](err, err === null ? r.access : null)
        }
      })
      return
    }
  }
  // The index lists it but the Keychain would not hand it over: another build of Moo (signed
  // differently) saved it, or the prompt was refused. "Not signed in" would contradict the UI.
  if (keychainHas(p.id) || keychainHas(account)) {
    done(p.title + ": the Keychain would not give Moo the saved sign-in; sign in again", null)
    return
  }
  let fromEnv = envValue(p.keyEnv)
  done(null, fromEnv !== "" ? fromEnv : null)
}

fn headersFor(key, org) {
  let h = { "Content-Type": "application/json" }
  if (key !== null) {
    h["Authorization"] = "Bearer " + key
  }
  if (org !== "") {
    h[ORG_HEADER] = org
  }
  return h
}

// Read a whole response body as text; `done(text)` ("" on failure).
fn bodyText(res, done) {
  settle(res.text(), (t, e) => done(e === null && typeof t === "string" ? t : ""))
}

// ── Chat ────────────────────────────────────────────────────────────────────

let nextRequest = 1
// Requests streaming now: id -> { cb, st }, so a cancel can answer with the text so far.
let active = {}
// Request id -> "pending" (cancelled before its stream started; the next step reports it) or
// "reported" (the caller has its "cancelled" event; the stream is just dropped).
let cancelled = {}

// True when `request` was cancelled; reports it once if nobody has yet.
fn stopped(request, cb) {
  if (!(request in cancelled)) {
    return false
  }
  if (cancelled[request] === "pending") {
    cb(event(request, "cancelled", newStream()))
  }
  delete cancelled[request]
  return true
}

fn event(request, kind, st) {
  return { request: request, kind: "" + kind, text: st.text, calls: st.calls, finish: st.finish }
}

fn failEvent(request, message) {
  return { request: request, kind: "error", text: "" + message, calls: [], finish: "" }
}

// Read the event stream; `cb` gets "partial" events while text arrives, then "done" or "error".
fn readStream(request, reader, lines, st, cb) {
  settle(reader.read(), (r, err) => {
    if (stopped(request, cb)) {
      return
    }
    if (err !== null) {
      delete active[request]
      cb(failEvent(request, "" + err))
      return
    }
    let changed = false
    if (!r.done) {
      feedLines(lines, r.value)
    } else if (lines.rest.length > 0) {
      lines.done.push(utf8(lines.rest))
      lines.rest = []
    }
    for (let i = 0; i < lines.done.length; i = i + 1) {
      if (streamLine(st, lines.done[i])) {
        changed = true
      }
    }
    lines.done = []
    if (r.done) {
      delete active[request]
      streamLine(st, "")
      cb(st.error !== "" ? failEvent(request, st.error) : event(request, "done", st))
      return
    }
    if (changed) {
      cb(event(request, "partial", st))
    }
    readStream(request, reader, lines, st, cb)
  })
}

fn send(request, url, key, org, body, attempt, cb) {
  if (stopped(request, cb)) {
    return
  }
  let h = headersFor(key, org)
  h["Accept"] = "text/event-stream"
  settle(fetch(url, { method: "POST", headers: h, body: body, timeout: 0 }), (res, err) => {
    if (stopped(request, cb)) {
      return
    }
    if (err !== null || res.error) {
      cb(failEvent(request, err !== null ? "" + err : res.error))
      return
    }
    if (res.status !== 200) {
      bodyText(res, (text) => {
        let limited = res.status === 429 || text.indexOf("RATE_LIMITED") >= 0
        if (limited && attempt < 2) {
          setTimeout(() => send(request, url, key, org, body, attempt + 1, cb), 1500 * Math.pow(2, attempt))
          return
        }
        cb(failEvent(request, errorMessage(res.status, text)))
      })
      return
    }
    let st = newStream()
    active[request] = { cb: cb, st: st }
    readStream(request, res.body.getReader(), newLines(), st, cb)
  })
}

// Stream a reply from `model` (`provider:model`) for `messages` (JSON array of chat messages);
// `tools` is a JSON array of OpenAI function tools, or "". `cb({ request, kind, text, calls,
// finish })`: kind "partial" (text so far), then "done", "error" or "cancelled". Returns the id.
export fn aiChat(model, messages, tools, cb) {
  let request = nextRequest
  nextRequest = nextRequest + 1
  let parts = splitModel(model)
  let p = findProvider(parts[0])
  let name = parts[1]
  // Answer on the next turn, so the caller has the id before the first event.
  let answer = (e) => setTimeout(() => withUi(() => cb(e)), 0)
  if (p === null) {
    answer(failEvent(request, "unknown AI provider `" + parts[0] + "`"))
    return request
  }
  if (name === "") {
    answer(failEvent(request, "name a model: `" + p.id + ":<model>` (see `moo ai models`)"))
    return request
  }
  credential(p, (err, key) => {
    if (stopped(request, cb)) {
      return
    }
    if (err !== null) {
      answer(failEvent(request, err))
      return
    }
    if (key === null && !p.local) {
      answer(failEvent(request, noCredential(p)))
      return
    }
    let body = "{\"model\":" + JSON.stringify(name) + ",\"stream\":true,\"messages\":" + (messages.trim() === "" ? "[]" : messages)
    let t = tools.trim()
    if (t !== "" && t !== "[]") {
      body = body + ",\"tools\":" + t
    }
    send(request, p.url + "/chat/completions", key, p.organization, body + "}", 0, cb)
  })
  return request
}

// Stop a reply: its callback gets "cancelled" (with the text so far) and nothing after.
export fn aiChatCancel(request) {
  if (request in active) {
    let a = active[request]
    delete active[request]
    cancelled[request] = "reported"
    withUi(() => a.cb(event(request, "cancelled", a.st)))
  } else {
    cancelled[request] = "pending"
  }
}

// ── Models ──────────────────────────────────────────────────────────────────

fn listing(p, models, error) {
  return { provider: p.id, title: p.title, models: [].concat(models), error: "" + error }
}

fn listModels(p, done) {
  let fetchList = (key) => {
    let h = headersFor(key, "")
    settle(fetch(p.url + "/models" + p.modelsQuery, { headers: h, timeout: p.local ? 2000 : 20000 }), (res, err) => {
      if (err !== null || res.error) {
        done(listing(p, [], p.local ? "not running" : (err !== null ? "" + err : res.error)))
        return
      }
      bodyText(res, (text) => {
        if (res.status !== 200) {
          done(listing(p, [], errorMessage(res.status, text)))
          return
        }
        let models = parseModels(text)
        if (p.modelsQuery === "") {
          models.sort((a, b) => a.id < b.id ? -1 : (a.id > b.id ? 1 : 0))
        }
        done(listing(p, models, ""))
      })
    })
  }
  // A public list needs no key, so listing never reads the Keychain for it.
  if (p.publicModels) {
    fetchList(null)
    return
  }
  credential(p, (err, key) => {
    if (err !== null) {
      done(listing(p, [], err))
    } else if (key === null && !p.local) {
      done(listing(p, [], "no API key"))
    } else {
      fetchList(key)
    }
  })
}

// `cb([{ provider, title, models: [{ id, name, owner, context, tier }], error }])` once every
// provider (but Apple's) has answered, in provider order.
export fn aiModels(cb) {
  let list = allProviders()
  let results = list.map((p) => null)
  let left = list.length
  for (let i = 0; i < list.length; i = i + 1) {
    let slot = i
    listModels(list[i], (l) => {
      results[slot] = l
      left = left - 1
      if (left === 0) {
        cb(results)
      }
    })
  }
}

// `[{ id, title, url, local, credential, oauth, signIn, account }]`, Apple's on-device model first.
export fn aiProviders() {
  let rows = [{ id: "apple", title: "Apple on-device", url: "", local: true, credential: "", oauth: false, signIn: false, account: false }]
  let list = allProviders()
  for (let i = 0; i < list.length; i = i + 1) {
    let p = list[i]
    rows.push({ id: p.id, title: p.title, url: p.url, local: p.local, credential: credentialSource(p), oauth: p.oauth !== null,
      signIn: p.oauth !== null && p.clientId !== "", account: p.account })
  }
  return rows
}

// ── Accounts (Hypery) ───────────────────────────────────────────────────────

fn newAccount(p, pname) {
  let o = p === null ? "" : origin(p.url)
  return { provider: "" + pname, credential: p === null ? "" : credentialSource(p), email: "", name: "", manage: o + "/dashboard",
    billing: o + "/dashboard", keys: o + "/dashboard", balance: -1, monthSpent: -1, monthLimit: -1, organization: "", orgs: [], error: "" }
}

fn setLinks(a, o, slug) {
  if (slug !== "") {
    a.manage = o + "/settings/" + slug
    a.billing = o + "/settings/" + slug + "/billing"
    a.keys = o + "/settings/" + slug + "/api-keys"
  }
}

fn readBalance(a, text) {
  let v = JSON.parse(text)
  if (typeof v === "object" && v !== null && typeof v.balance === "object" && v.balance !== null) {
    a.balance = dollars(v.balance.current)
    a.monthSpent = dollars(v.balance.monthlySpent)
    a.monthLimit = dollars(v.balance.monthlyLimit)
  } else {
    a.error = "the balance reply had no balance"
  }
}

// GET `path` on the provider's site with its credential; `done(status, text)` (status 0 on failure).
fn getPath(p, key, path, done) {
  let h = headersFor(key, p.organization)
  settle(fetch(origin(p.url) + path, { headers: h, timeout: 15000 }), (res, err) => {
    if (err !== null || res.error) {
      done(0, err !== null ? "" + err : res.error)
      return
    }
    bodyText(res, (text) => done(res.status, text))
  })
}

fn fetchAccount(p, key, cb) {
  let a = newAccount(p, p.id)
  let o = origin(p.url)
  let wallet = () => {
    let active = activeOrg(a.orgs, p.organization)
    let personal = active === null || active.personal
    if (active !== null) {
      a.organization = active.id
      setLinks(a, o, active.slug)
    }
    // The wallet of the organization in the header; it needs `billing:read`. Without that scope
    // only the personal wallet is readable.
    getPath(p, key, "/api/wallet/state", (st, text) => {
      if (st === 200) {
        readBalance(a, text)
        cb(a)
      } else if ((st === 403 || st === 404) && personal) {
        getPath(p, key, "/api/wallet/balance", (st2, text2) => {
          if (st2 === 200) {
            readBalance(a, text2)
          } else {
            a.error = st2 === 0 ? text2 : errorMessage(st2, text2)
          }
          cb(a)
        })
      } else {
        a.error = st === 403 ? "this organization's balance needs billing access" : (st === 0 ? text : errorMessage(st, text))
        cb(a)
      }
    })
  }
  let memberships = () => {
    getPath(p, key, "/api/auth/list_memberships", (st, text) => {
      if (st === 200) {
        a.orgs = parseOrgs(text)
      }
      wallet()
    })
  }
  if (a.credential !== "signed in") {
    memberships()
    return
  }
  getPath(p, key, "/api/user/me", (st, text) => {
    if (st === 200) {
      let v = JSON.parse(text)
      if (typeof v === "object" && v !== null) {
        a.email = typeof v.email === "string" ? v.email : ""
        a.name = typeof v.name === "string" ? v.name : ""
        setLinks(a, o, typeof v.slug === "string" ? v.slug : "")
      }
    }
    memberships()
  })
}

// `cb({ provider, credential, email, name, manage, billing, keys, balance, monthSpent, monthLimit,
// organization, orgs: [{ id, name, slug, image, personal, role }], error })`. Amounts are US
// dollars, -1 when unknown; the balance and links are `organization`'s.
export fn aiAccount(pname, cb) {
  let p = findProvider(pname)
  let answer = (a) => setTimeout(() => withUi(() => cb(a)), 0)
  if (p === null) {
    let a = newAccount(null, pname)
    a.error = "unknown AI provider `" + pname + "`"
    answer(a)
    return
  }
  if (!p.account) {
    let a = newAccount(p, p.id)
    a.error = p.title + " has no account details"
    answer(a)
    return
  }
  credential(p, (err, key) => {
    if (err !== null || key === null) {
      let a = newAccount(p, p.id)
      a.error = err !== null ? err : "not signed in"
      answer(a)
      return
    }
    fetchAccount(p, key, cb)
  })
}

// ── Keys and sign-in ────────────────────────────────────────────────────────

// Save (or, with "", forget) an API key -> { ok, error }.
export fn aiSetKey(pname, key) {
  if (findProvider(pname) === null) {
    return { ok: false, error: "unknown AI provider `" + pname + "`" }
  }
  if (key.trim() === "") {
    keychainDelete(pname)
    return { ok: true, error: "" }
  }
  let e = keychainSet(pname, key.trim())
  return e === null ? { ok: true, error: "" } : { ok: false, error: e }
}

// Forget the provider's API key and sign-in.
export fn aiLogout(pname) {
  keychainDelete(pname)
  keychainDelete(oauthAccount(pname))
}

// Browser sign-in; `cb({ ok, error })`.
export fn aiLogin(pname, cb) {
  let p = findProvider(pname)
  let answer = (error) => setTimeout(() => withUi(() => cb({ ok: error === "", error: error })), 0)
  if (p === null) {
    answer("unknown AI provider `" + pname + "`")
    return
  }
  let ep = endpoints(p)
  if (ep === null) {
    answer(p.title + " has no browser sign-in; use an API key")
    return
  }
  if (ep.clientId === "") {
    answer(p.title + " sign-in needs an OAuth client id: set ai.providers." + p.id + ".clientId in shortcuts.json or MOO_" + p.id.toUpperCase() + "_CLIENT_ID")
    return
  }
  let account = oauthAccount(p.id)
  oauthSignIn(ep, (r) => {
    if (r.error !== "") {
      cb({ ok: false, error: r.error })
      return
    }
    let e = keychainSet(account, tokensJson(r))
    cb({ ok: e === null, error: e === null ? "" : e })
  })
}

export fn aiCancelLogin() {
  oauthCancel()
}
