// Windows: Moo's use of tish-windows's services, with platform.tish's exports and shapes. What
// Windows has no counterpart for yet (dictionary, contacts, window layouts, Spotlight-style
// file search, typed-keyword snippets) answers empty or "not on Windows yet", so those features
// simply don't show up.

import { windows } from 'tish:windows'
import { fileExists, mkdir } from 'tish:fs'
import { env } from 'tish:process'
import { about, hide, quit, show, reindex as reindexApps, search as searchApps, appFolders, bundleResources, exeDir, findFiles as findIndexed, recentFiles as recentIndexed } from './natives.tish'

let NOT_YET = 'not on Windows yet'

// Open a URL, file, folder or app. The launcher hides at once; Windows opens it a moment later.
export fn launch(target) {
  let isUrl = target.indexOf(':') > 1
  if (target === '' || (!isUrl && !fileExists(target))) {
    return false
  }
  hide()
  setTimeout(() => windows.workspace.open(target), 0)
  return true
}

// Select `path` in Explorer; hides the launcher when it exists.
export fn revealFile(path) {
  // The file index keeps `/`-separated paths; Explorer's /select wants backslashes.
  let ok = windows.workspace.reveal(winPath(path))
  if (ok) {
    hide()
  }
  return ok
}

export fn copyText(text) {
  return windows.pasteboard.writeText(text)
}

export fn clipboardText() {
  return windows.pasteboard.readText()
}

// `cb({ text, app, appPath })` for each copy; Moo's own copies say "Moo".
export fn watchClipboard(cb) {
  return windows.pasteboard.watch((c) => {
    cb({ text: c.text, app: c.app === '' && c.appPath === '' ? 'Moo' : c.app, appPath: c.appPath })
  })
}

// -> { ok, message, error }
export fn trashFile(path) {
  if (env.MOO_SYSTEM_DRY_RUN) {
    return { ok: true, message: 'dry run: trash ' + path, error: '' }
  }
  let r = windows.workspace.trash(path)
  return { ok: r.ok, message: 'Recycle Bin', error: r.error }
}

export let appsFor = (path) => []

export let openWith = (path, app) => ({ ok: false, message: '', error: NOT_YET })

export let onOpenUrl = (cb) => null

// ── Icons ───────────────────────────────────────────────────────────────────

// The shell wants backslashes; the file index keeps `/`-separated paths.
fn winPath(path) {
  return path.split('/').join('\\')
}

export fn fileIcon(path) {
  return windows.icons.file(winPath(path))
}

export fn symbolIcon(name) {
  return windows.icons.symbol(name)
}

export let imageFile = (path, template) => windows.icons.image(path)

export let onIconsLoaded = (cb) => windows.icons.onLoaded(cb)

// ── Apps and files ──────────────────────────────────────────────────────────

// Rescan the Start menu -> { count, ms }.
export fn reindex() {
  return reindexApps()
}

export fn search(text, limit) {
  return searchApps(text, limit).map((a) => ({ name: a.name, path: a.path, icon: windows.icons.file(a.path), kind: a.kind, score: a.score }))
}

// The file index's matches; the first `icons` rows get icons.
export fn findFiles(text, limit, icons) {
  let r = findIndexed(text, limit)
  if (r.ready) {
    for (let i = 0; i < r.results.length && i < icons; i = i + 1) {
      r.results[i].icon = fileIcon(r.results[i].path)
    }
  }
  return r
}

// Recently opened files from the file index, with icons.
export fn recentFiles(limit) {
  return recentIndexed(limit).map((f) => {
    f.icon = fileIcon(f.path)
    return f
  })
}

// `cb({ query, results, ms })` once, empty: no file search on Windows yet. Returns its generation.
let filesGeneration = 0
export let searchFiles = (query, limit, cb) => {
  filesGeneration = filesGeneration + 1
  let q = '' + query
  setTimeout(() => cb({ query: q, results: [], ms: 0 }), 0)
  return filesGeneration
}

export let searchContents = (text, limit, cb) => {
  let q = '' + text
  setTimeout(() => cb({ query: q, results: [] }), 0)
  return 0
}

export let queryFiles = (filter) => ({ results: [], total: 0, ms: 0 })

// The tray icon: a click shows the launcher, a right click opens Settings / Quit Moo.
export let statusItem = (hotkey, symbol, onMenu) => {
  let resources = bundleResources()
  return windows.statusItem({
    image: (resources ? resources : exeDir() + '/../../packaging') + '/AppIcon.ico',
    tooltip: hotkey === '' ? 'Moo' : 'Moo  (' + hotkey + ')',
    menu: [{ title: 'Moo ' + about().version, id: 'version', enabled: false }, { separator: true },
      { title: 'Settings…', id: 'settings' }, { separator: true }, { title: 'Quit Moo', id: 'quit' }],
    onClick: () => show(),
    onMenu: (picked) => {
      if (picked === 'quit') {
        quit()
      } else {
        onMenu(picked)
      }
    }
  })
}

// Start menu changes aren't watched yet: the index is rebuilt at startup and on demand.
export fn watchApps() {
  return false
}

// shortcuts.json's folder: created, but not watched yet (edits apply on the next start).
export let watchShortcuts = (dir, cb) => {
  if (dir === '') {
    return false
  }
  mkdir(dir, { recursive: true })
  return false
}

// ── Words and time ──────────────────────────────────────────────────────────

export let dictionaryEntries = (word) => []

export fn dictionaryWarm() {
  return null
}

// Only UTC until tish-windows has the time-zone database.
export let ZONES = {
  names: () => ['UTC'],
  local: () => 'UTC',
  lookup: (zoneId, when) => (zoneId === 'UTC' ? { offset: 0, abbreviation: 'UTC' } : null),
  byAbbreviation: (a) => (a === 'UTC' ? 'UTC' : null)
}

// ── System ──────────────────────────────────────────────────────────────────

export fn systemInfo() {
  return { os: 'Windows', model: '', chip: '', cores: 0, memoryBytes: 0, uptimeSecs: 0, diskTotal: 0, diskFree: 0, battery: null }
}

export fn volume() {
  return null
}

export fn darkMode() {
  return true
}

export fn bytesText(n) {
  let mb = n / 1048576
  return mb >= 1024 ? (mb / 1024).toFixed(1) + ' GB' : mb.toFixed(0) + ' MB'
}

export fn runningApps() {
  return []
}

export let appAction = (pid, action) => ({ ok: false, message: NOT_YET })

export let systemCommand = (id, rawArg, cb) => {
  let r = { ok: false, message: NOT_YET }
  if (typeof cb === 'function') {
    cb(r)
  }
  return r
}

export fn contactsAccess() {
  return 'denied'
}

export let contactsRequest = (cb) => {
  setTimeout(() => cb(false), 0)
  return null
}

export let searchContacts = (query, limit, cb) => {
  let q = '' + query
  setTimeout(() => cb({ query: q, results: [], error: NOT_YET }), 0)
  return 0
}

export let accessibilityTrusted = (prompt) => false

export fn selectedText() {
  return null
}

export let replaceTyped = (typed, text) => ({ ok: false, error: NOT_YET })

// Snippets need a system-wide keyboard hook; there's none yet, so expanding keywords is macOS-only.
export let watchSnippets = (keywords, cb) => (keywords.length === 0 ? { ok: true, error: '' } : { ok: false, error: 'expanding snippets in other apps is ' + NOT_YET })

export let arrangeWindow = (layout) => ({ ok: false, message: NOT_YET })
