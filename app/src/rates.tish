// Currency rates for the calculator: the European Central Bank's daily reference rates, cached in
// `~/Library/Caches/Moo/rates.txt` (`MOO_RATES`) and refetched in the background when over 12
// hours old. The file is `date\nfetched\nCODE rate\n…`.

import { macos } from "tish:macos"
import { fetch } from "tish:http"
import { readFile, writeFile, mkdir, rename, fileExists } from "tish:fs"
import { env } from "tish:process"
import { parseEcb, parseCache, formatCache } from "./calc.tish"

let URL = "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml"
let MAX_AGE = 12 * 3600

fn ratesPath() {
  if (env.MOO_RATES) {
    return env.MOO_RATES
  }
  return env.HOME ? env.HOME + "/Library/Caches/Moo/rates.txt" : ""
}

let cache = null
let loaded = false
let fetching = false

fn now() {
  return Date.now() / 1000
}

fn load() {
  if (loaded) {
    return
  }
  loaded = true
  let path = ratesPath()
  if (path !== "" && fileExists(path)) {
    let t = readFile(path)
    if (typeof t === "string") {
      cache = parseCache(t)
    }
  }
}

fn save(c) {
  let path = ratesPath()
  if (path === "") {
    return
  }
  mkdir(path.slice(0, path.lastIndexOf("/")), { recursive: true })
  if (writeFile(path + ".tmp", formatCache(c)) === null) {
    rename(path + ".tmp", path)
  }
}

fn refresh() {
  if (fetching) {
    return
  }
  fetching = true
  macos.whenSettled(fetch(URL, { timeout: 15000 }), (res, err) => {
    if (err !== null || !res.ok) {
      console.log("moo: currency rates: " + (err !== null ? err : (res.error ? res.error : "HTTP " + res.status)))
      fetching = false
      return
    }
    macos.whenSettled(res.text(), (xml, e2) => {
      fetching = false
      if (e2 !== null || typeof xml !== "string") {
        return
      }
      let p = parseEcb(xml)
      if (Object.keys(p.rates).length > 0) {
        cache = { rates: p.rates, date: p.date, fetched: now() }
        save(cache)
      }
    })
  })
}

// Rates per 1 EUR ({ USD: 1.08, … }), or null before any have loaded. Starts a background
// refresh when they're missing or old.
export fn currencyRates() {
  load()
  if (cache === null || now() - cache.fetched >= MAX_AGE) {
    refresh()
  }
  return cache === null ? null : cache.rates
}
