// Moo launcher shell: Lattish-style JSX on the platform's UI host (host.tish: tish-macos on macOS,
// tish-windows on Windows), launcher services from natives.tish (packages/moo-macos, `tish:moo`, plus
// natives.windows.tish on Windows), plugins loaded at runtime as native modules (`tish:ffi`).
// Follows macOS Spotlight: the hotkey opens a compact bar (search field plus up to 6 pinned bubbles,
// ⌘1–⌘6, by default Applications, Files, Actions and Clipboard; Applications is a grid of icons or a list, ⌘L);
// typing expands it into results grouped under a Top Hit;
// ↑ in the empty bar lists recent searches; "/" filters to a category; ⌘R shows in Finder; ⌫ in an
// empty field or esc leaves a category. tab (or "Ask AI") asks Apple's on-device model.

import { loadModule } from 'tish:ffi'
import { fileExists } from 'tish:fs'
import { macos, useState } from './host.tish'
import { setup, setPanelShape, setArrowKeys, setTheme, typeText, registerHotkey, quit, hide, appCount, fuzzy, pluginPaths, loadBytecodePlugin, bundleResources, exeDir, recordUse, frecency, aiAvailability, aiSession, aiEndSession, aiPrewarm, aiAsk, aiCancel, setPanelKeys, onPluginRefresh, fileIndexStart, quickLook, quickLookVisible, fileIndexStatus, show, toggle, unregisterHotkey, checkHotkey, hotkeyDisplay, recordHotkey, runShell, cliMain, cliServe, cliWrite, cliEnd, about , windowAction, isRightClick, DEFAULT_HOTKEYS, HAS_ON_DEVICE_AI } from './natives.tish'
import { env } from 'tish:process'
import { THEME } from './theme.tish'
import { greeting } from './greetings.tish'
import { answer as calcAnswer } from './calc.tish'
import { currencyRates } from './rates.tish'
import { siteIcon, imageIcon } from './siteicons.tish'
import { webSuggest } from './websuggest.tish'
import { aiProviders, aiModels, aiChat, aiChatCancel, aiSetKey, aiLogin, aiCancelLogin, aiLogout, aiAccount } from './ai.tish'
import { getPref, setPref, searchHistory, addSearchHistory, clearSearchHistory } from './stores.tish'
import { configDir, aiSetModel, aiSetClientId, aiSetOrganization, setAlias, checkAlias, setDisabled, setPanelKey, loadShortcuts, saveShortcut, checkKeyword, ensureShortcutsFile, removeShortcut, bindHotkey, unbindHotkey, setLauncherHotkey, expandTemplate, shellValues } from './shortcutsfile.tish'

import { timeAnswer } from './tz.tish'
import { reindex, search, findFiles, recentFiles, fileIcon, symbolIcon, imageFile, statusItem, onIconsLoaded, searchFiles, searchContents, queryFiles, arrangeWindow, selectedText, watchSnippets, replaceTyped, accessibilityTrusted, systemInfo, systemCommand, runningApps, appAction, contactsAccess, contactsRequest, searchContacts, launch, watchApps, copyText, watchClipboard, onOpenUrl, dictionaryEntries, dictionaryWarm, trashFile, appsFor, openWith, revealFile, watchShortcuts, ZONES } from './platform.tish'
import { define as defineFrom } from './dict.tish'
import { record as recordClip, clearClips, clipboardHistory as clipRows } from './clip.tish'

// Clipboard history rows: `[{ text, preview, app, icon, ago }]`, newest first.
fn clipboardHistory(query, limit) {
  return clipRows(query, limit, fuzzy, fileIcon)
}

fn clearClipboardHistory() {
  clearClips()
}

// `{ word, pronunciation, senses: [{ part, pronunciation, definition, example }], origin }` from
// the system dictionary, or null.
fn define(word) {
  return defineFrom(word, dictionaryEntries(word.trim()))
}

// Inline answers: arithmetic, units, currency and bases (calc.tish), else time zones (tz.tish).
fn calculate(text) {
  let a = calcAnswer(text, currencyRates())
  return a !== null ? a : timeAnswer(text, ZONES, Date.now() / 1000)
}

// `moo <command>` (or launching while Moo already runs) makes this process a client of the
// running app: it sends the arguments over the socket, prints the reply and exits here.
// `moo help`; printed by the client process too, so it needs no running app.
let CLI_USAGE = "usage: moo [command] [args]\n\n  (no command)                 show the launcher (starts Moo if needed)\n  toggle | show | hide | quit\n  search <text>                show the launcher with <text> typed\n  category <name> [text]       show Applications, Files, Actions, Clipboard or Recent searches\n  key <name>                   act as if a key was pressed in the open launcher (tab, shift+tab, enter, escape, …)\n  type <text>                  insert text into the focused field, one character every 120 ms\n  history [--clear]            recent searches, newest first\n  run <keyword|id> [text]      run a shortcut or command (ids: moo list commands)\n  open <path|url>              open with the default app\n  files <query> [-n N] [--contents]\n                               file paths, best match first; --contents searches inside files\n  trash <path>                 move to the Trash; prints where it went\n  open-with <path> [app]       list the apps that open it (* default), or open it in one\n  apps <query> [-n N]          matching applications\n  ask [--model M] <question>   ask Ask AI's model (or M); the answer streams, tools included\n  ai                           the model Ask AI uses and each provider's sign-in\n  ai models [text] [--json]    every model (* current): Apple's, Hypery's (Claude, Grok, Gemini,\n                               GPT, …), OpenAI's, local Ollama and LM Studio ones\n  ai use <model>               make Ask AI use it: apple, hypery:<id>, ollama:<id>, … or default\n  ai login | logout [provider] sign in to Hypery in the browser, or forget its key and sign-in\n  ai key [provider] <key>      keep an API key in the Keychain (Hypery when no provider)\n  ai usage [provider]          Hypery balance and this month's spending\n  ai team [name]               Hypery's teams (* current), or switch to one\n  ai client-id <id> [provider] the OAuth app id browser sign-in uses\n  calc <expression>            the plain answer: 2^10, 5 km in mi, 100 usd to eur, 255 in hex,\n                               time in tokyo, 3pm pst to cet (--json adds display and detail)\n  web <text>                   search suggestions from the default engine\n  web engine [name]            list engines (* default) or pick one: google, duckduckgo, bing,\n                               brave\n  define <word>                the word's senses, pronunciation and origin from the macOS\n                               dictionary, every homograph (--json for the parsed entry)\n  contacts [name]              contacts whose name matches (all when empty); needs access,\n                               which Search Contacts in Moo asks for\n  system [command] [arg]       list system commands, or run one: lock, sleep, sleep-displays,\n                               screen-saver, dark-mode, mute, volume, eject, hide-all, quit-all,\n                               empty-trash, restart, shut-down, log-out\n  window [layout]              list layouts, or arrange the frontmost window: left-half,\n                               right-third, maximize, center, next-display, restore, …\n  selection                    the selected text in the frontmost app\n  running [--json]             apps with a Dock icon, most memory first\n  running <action> <name|pid>  switch, hide, unhide, quit or force-quit one of them\n  volume [N|up|down]           print or set the output volume\n  mute [on|off]                toggle or set mute\n  dark-mode [on|off]           toggle or set dark mode\n  clipboard [-n N]             clipboard history, newest first\n  list [shortcuts|commands|hotkeys]\n  shortcut add <keyword> <kind> <target> [--name N] [--hotkey K] [--output show|copy|none] [--input T] [--expand]\n                               kinds: url, open, command, shell, text; --expand makes a text\n                               shortcut a snippet, replaced wherever its keyword is typed\n  shortcut rm <keyword>\n  hotkey add <keys> <keyword|id|app> [text]\n                               bind a shortcut, a command id or an app's path\n                               (/Applications/Safari.app)\n  hotkey rm <keys>\n  config                       print the path of shortcuts.json\n  status\n  --version                    this binary's version and path\n\n  --json                       machine-readable output (files, apps, list, clipboard, status)\n\nTemplates take {query}, {clipboard}, {date} and {time}.\n"

cliMain(CLI_USAGE)

const ROWS = 8
const FILE_MIN_CHARS = 2
const FILE_ROWS_WITH_APPS = 3
const FILE_LIST_MAX = 100
// Characters per answer row at 14 pt across the panel.
const AI_WRAP = 92
const AI_TITLE = 'Apple Intelligence'
let HOME = env.HOME ? env.HOME : ''
let AI_INSTRUCTIONS = 'You are the assistant inside Moo, a macOS launcher. Answer briefly and plainly in a few short sentences. Do not use Markdown. '
  + 'Most questions, such as how to do something, general facts, advice or writing, need no tool: answer them from what you know. '
  + 'Use a tool only when the question is about this Mac (its files, apps, clipboard history, settings or system facts) or is exactly what a tool does, call it once, then answer from its reply. Never say you searched without calling a tool. '
  + 'When a tool lists results, the user also sees them as rows they can open, so summarise instead of repeating every path. '
  + "For arithmetic on numbers, a unit or currency conversion, or the time in another place, call the calculate tool with just that expression; you do not know today's exchange rates or the current time. "
  + 'Only when the user asks what a particular word means or how it is said, call the define tool with that word and answer from its reply in a sentence or two. '
  + 'Only say a setting was changed when a tool reply says so, and pass on what the reply says. '
  + 'When the user asks to open an app, file, folder or website, call the open tool; when they ask to copy text, call the copyText tool. '
  + 'Never open anything, run a shortcut or change a setting unless the user asks for exactly that. '
  + "The user's home folder is " + HOME + '.'
let FILE_KINDS = ['any', 'image', 'video', 'audio', 'pdf', 'document', 'text', 'spreadsheet', 'presentation', 'archive', 'diskimage', 'folder']
// The AI's controlMac actions as systemCommand id and arg. Restart, shut down, log out, quit all
// and empty Trash are left out: those stay with the user.
let AI_SYSTEM = {
  darkModeOn: ['dark-mode', 'on'], darkModeOff: ['dark-mode', 'off'], mute: ['mute', 'on'], unmute: ['mute', 'off'],
  setVolume: ['volume', ''], volumeUp: ['volume', 'up'], volumeDown: ['volume', 'down'], lockScreen: ['lock', ''],
  sleepDisplays: ['sleep-displays', ''], startScreenSaver: ['screen-saver', ''], hideAllApps: ['hide-all', ''], ejectDisks: ['eject', '']
}
let AI_WINDOW_LAYOUTS = ['left-half', 'right-half', 'top-half', 'bottom-half', 'top-left', 'top-right', 'bottom-left', 'bottom-right', 'left-third', 'center-third', 'right-third', 'left-two-thirds', 'right-two-thirds', 'maximize', 'almost-maximize', 'maximize-height', 'center', 'reasonable-size', 'next-display', 'previous-display', 'restore']
// Offered so the model has a match for these requests; the tool refuses them and names the command.
let AI_SYSTEM_REFUSED = { restart: 'Restart', shutDown: 'Shut Down', sleep: 'Sleep', logOut: 'Log Out', quitAllApps: 'Quit All Apps', emptyTrash: 'Empty Trash' }
let AI_SYSTEM_ACTIONS = ['darkModeOn', 'darkModeOff', 'mute', 'unmute', 'setVolume', 'volumeUp', 'volumeDown', 'lockScreen', 'sleepDisplays', 'startScreenSaver', 'hideAllApps', 'ejectDisks', 'restart', 'shutDown', 'sleep', 'logOut', 'quitAllApps', 'emptyTrash']
let AI_LIST = 8
let AI_ANSWER_ROWS = 4

// Tools the on-device model may call while answering; handled by runAiTool. Built per session, since
// runShortcut lists the user's current shortcuts.
fn aiTools() {
  let opt = (name, description) => ({ name: name, description: description, optional: true })
  let tools = [
    { name: 'open', description: 'Open an application, file, folder or web address on this Mac.', params: [{ name: 'target', description: 'An app name such as Safari, a path such as ~/Documents, or a URL' }] },
    { name: 'copyText', description: 'Copy text to the clipboard.', params: [{ name: 'text', description: 'The text to copy' }] },
    { name: 'findFiles', description: 'Search files on this Mac with Spotlight by name, contents, kind, size, date and folder. Use for any question about finding, listing or sizing files, e.g. large files, recent downloads, screenshots from today, the document that mentions a project.', params: [
      opt('name', "Words in the file's own name, e.g. invoice; never a folder name"),
      opt('contains', "Words inside the file's text, e.g. a project name or invoice number the document mentions"),
      { name: 'kind', description: 'The kind of file', optional: true, choices: FILE_KINDS },
      opt('minSize', 'Smallest size to include, e.g. 100 MB or 1 GB'),
      opt('createdWithin', 'Only files created this recently, e.g. 2 days, 6 hours, 1 week'),
      opt('modifiedWithin', 'Only files changed this recently, e.g. 3 days'),
      opt('openedWithin', 'Only files opened this recently, e.g. 1 week'),
      opt('folder', 'Folder to search in when the user names one, e.g. ~/Downloads or ~/Desktop; the whole home folder when omitted'),
      { name: 'sortBy', description: 'Order of results: largest for big files, newest for recent ones', optional: true, choices: ['largest', 'newest', 'recentlyOpened', 'name'] }
    ] },
    { name: 'revealFile', description: 'Show a file or folder in Finder.', params: [{ name: 'path', description: 'The full path, e.g. ~/Downloads/report.pdf' }] },
    { name: 'findApps', description: 'Search the applications installed on this Mac by name.', params: [{ name: 'query', description: 'Part of the app name, e.g. photo' }] },
    { name: 'runningApps', description: 'List the applications that are open right now.', params: [] },
    { name: 'clipboardHistory', description: 'Get what the user copied recently (Moo keeps a clipboard history), newest first. Use whenever they ask what they copied or what is on the clipboard.', params: [opt('query', 'Words to look for; all recent entries when omitted')] },
    { name: 'systemInfo', description: 'Facts about this Mac: macOS version, model, chip, memory, disk space, battery and uptime.', params: [] },
    { name: 'controlMac', description: 'Change a setting on this Mac: dark mode, sound volume and mute, lock the screen, sleep the displays, start the screen saver, hide all apps, eject disks. Also call it for restart, shut down, sleep, log out, quit all apps and empty Trash, and repeat its reply.', params: [
      { name: 'action', description: 'What to do', choices: AI_SYSTEM_ACTIONS },
      { name: 'level', description: 'Volume percentage 0 to 100, only for setVolume', optional: true }
    ] },
    { name: 'arrangeWindow', description: 'Move or resize the window the user was working in: halves, quarters, thirds, maximize, center, another display, or restore it.', params: [
      { name: 'layout', description: 'Where the window goes', choices: AI_WINDOW_LAYOUTS }
    ] },
    { name: 'calculate', description: 'Work out arithmetic, percentages, unit and currency conversions, number bases and the time in other time zones exactly. Use it for any maths instead of calculating yourself.', params: [{ name: 'expression', description: 'e.g. 15% of 80, 5 km in mi, 100 usd to eur, 255 in hex, time in tokyo, 3pm pst to cet' }] },
    { name: 'define', description: 'Look up what a word means in the dictionary on this Mac: its senses, pronunciation and origin. Use it when asked what a word means or how it is said.', params: [{ name: 'word', description: 'One word or a short phrase, e.g. serendipity' }] }
  ]
  let list = config.shortcuts.slice(0, 30).map((s) => s.keyword + ' (' + s.name + ')')
  if (list.length > 0) {
    tools.push({ name: 'runShortcut', description: "Run one of the user's Moo shortcuts, only when the user asks to run or use it by name. Available: " + list.join(', ') + '.', params: [
      { name: 'keyword', description: "The shortcut's keyword" },
      opt('input', 'Text the shortcut needs, if any')
    ] })
  }
  return JSON.stringify(tools)
}

// Keys as printed on the keyboard; registerHotkey applies System Settings' modifier key mappings.
let HOTKEYS = DEFAULT_HOTKEYS
// shortcuts.json: user shortcuts, their hotkeys, other hotkey bindings and the launcher hotkey.
let config = loadShortcuts()
if (config.launcher !== '') {
  HOTKEYS = [config.launcher].concat(HOTKEYS)
}
if (env.MOO_HOTKEY) {
  HOTKEYS = [env.MOO_HOTKEY].concat(HOTKEYS)
}
let resources = bundleResources()
// A dev build runs from app/dist, so the repo root is two folders up.
let REPO_DIR = exeDir() + '/../..'
let PLUGIN_DIR = env.MOO_PLUGINS ? env.MOO_PLUGINS : (resources ? resources + '/plugins' : REPO_DIR + '/dist/plugins')
let ASSET_DIR = resources ? resources : REPO_DIR + '/packaging'
let appIcon = imageFile(ASSET_DIR + '/' + THEME.appIcon)
let statusIcon = imageFile(ASSET_DIR + '/' + THEME.statusIcon, true)
if (statusIcon === '') {
  statusIcon = THEME.statusSymbol
}
let fieldIcon = imageFile(ASSET_DIR + '/' + THEME.icon.searchImage, true)
let fieldIconSymbol = false
if (fieldIcon === '') {
  fieldIcon = THEME.icon.search
  fieldIconSymbol = true
}
let settingsIcon = symbolIcon(THEME.icon.settings)
let quitIcon = 'NSStopProgressTemplate'
if (appIcon !== '') {
  settingsIcon = appIcon
  quitIcon = appIcon
}

let index = reindex()
let watching = watchApps()
fileIndexStart()
dictionaryWarm()
let hotkey = ''
let hotkeyLabel = ''
let hotkeyId = 0
for (let i = 0; i < HOTKEYS.length && hotkey === ''; i = i + 1) {
  let r = registerHotkey(HOTKEYS[i])
  if (r.ok) {
    hotkey = HOTKEYS[i]
    hotkeyLabel = r.display
    hotkeyId = r.id
    console.log('moo: hotkey ' + r.display + ' (registered as ' + r.registered.join(', ') + ')')
  } else {
    console.log('moo: hotkey ' + r.error)
  }
}
statusItem(hotkeyLabel, statusIcon, (what) => onStatusMenu(what))
// Rows drawn before their icon loaded still show the placeholder until redrawn.
onIconsLoaded(() => refresh())
watchClipboard(recordClip)

// ── Plugins: every module in PLUGIN_DIR contributes its manifest's commands to root search ──

let aiIcon = symbolIcon(THEME.icon.ai)
let calcIcon = symbolIcon(THEME.icon.calculator)
let APPS = { name: 'Applications', path: 'moo:apps', icon: symbolIcon('square.grid.2x2'), kind: 'Command', mode: 'apps', pluginTitle: 'Moo' }
let FILES = { name: 'Search Files', path: 'moo:files', icon: symbolIcon('doc.text.magnifyingglass'), kind: 'Command', mode: 'files', pluginTitle: 'Moo' }
let ACTIONS = { name: 'Actions', path: 'moo:actions', icon: symbolIcon('square.2.layers.3d'), kind: 'Command', mode: 'actions', pluginTitle: 'Moo' }
let CLIPBOARD = { name: 'Clipboard History', path: 'moo:clipboard', icon: 'NSMultipleDocuments', kind: 'Command', mode: 'clipboard', pluginTitle: 'Moo' }
let HISTORY = { name: 'Recent Searches', path: 'moo:history', icon: symbolIcon('clock.arrow.circlepath'), kind: 'Command', mode: 'history', pluginTitle: 'Moo' }
let DICTIONARY = { name: 'Define Word', path: 'moo:dictionary', icon: symbolIcon(THEME.icon.dictionary), kind: 'Command', mode: 'dictionary', pluginTitle: 'Dictionary', entry: null }
let webIcon = symbolIcon(THEME.icon.web)
// suggestions: the last answer, for `suggested` (the text it was for); error: why there is none.
let WEB = { name: 'Search the Web', path: 'moo:web', icon: webIcon, kind: 'Command', mode: 'web', pluginTitle: 'Web', suggestions: [], suggested: '', error: '' }
let contactIcon = symbolIcon(THEME.icon.contact)
// results: the last answer, for `searched` (the text it was for; null before the first).
let CONTACTS = { name: 'Search Contacts', path: 'moo:contacts', icon: contactIcon, kind: 'Command', mode: 'contacts', pluginTitle: 'Contacts', results: [], searched: null, error: '' }
let SETTINGS = { name: 'Settings', path: 'moo:settings', icon: settingsIcon, kind: 'Command', mode: 'settings', pluginTitle: 'Moo' }
let AI_MODELS = { name: 'AI Models', path: 'moo:ai-models', icon: aiIcon, kind: 'Command', mode: 'ai-models', pluginTitle: 'AI' }
let HYPERY = { name: 'Hypery Account', path: 'moo:hypery', icon: symbolIcon(THEME.icon.account), kind: 'Command', mode: 'hypery', pluginTitle: 'Hypery' }
// The bar's pinned bubbles, in ⌘1–⌘6 order: up to PIN_MAX commands, shortcuts or apps, by the id
// runTarget takes, saved in the "pinned" pref. Moo's own categories show an SF Symbol (`symbol`);
// anything else shows its own icon. CATEGORIES is rebuilt from the pref on every refresh.
let PIN_MAX = 6
let DEFAULT_PINS = ['moo:apps', 'moo:files', 'moo:actions', 'moo:clipboard']
let PIN_LOOKS = [
  ['moo:apps', 'Applications', 'square.grid.2x2'],
  ['moo:files', 'Files', 'folder'],
  ['moo:actions', 'Actions', 'square.2.layers.3d'],
  ['moo:clipboard', 'Clipboard', 'doc.on.clipboard']
]
let CATEGORIES = []
// Moo's own keys in the open panel. `key` is the default and the name onKey handles it by;
// shortcuts.json "keys" moves an action to other keys, or to none.
let PANEL_ACTIONS = [
  { action: 'actions', name: 'Action Panel', key: 'cmd+k', symbol: 'command' },
  { action: 'settings', name: 'Open Settings', key: 'cmd+,', symbol: 'gearshape' },
  { action: 'category1', name: 'Open Pinned Item 1', key: 'cmd+1', symbol: '1.circle' },
  { action: 'category2', name: 'Open Pinned Item 2', key: 'cmd+2', symbol: '2.circle' },
  { action: 'category3', name: 'Open Pinned Item 3', key: 'cmd+3', symbol: '3.circle' },
  { action: 'category4', name: 'Open Pinned Item 4', key: 'cmd+4', symbol: '4.circle' },
  { action: 'category5', name: 'Open Pinned Item 5', key: 'cmd+5', symbol: '5.circle' },
  { action: 'category6', name: 'Open Pinned Item 6', key: 'cmd+6', symbol: '6.circle' },
  { action: 'appsview', name: 'Grid or List View', key: 'cmd+l', symbol: 'square.grid.3x2' },
  { action: 'quicklook', name: 'Quick Look', key: 'cmd+y', symbol: 'eye' },
  { action: 'reveal', name: 'Show in Finder', key: 'cmd+r', symbol: 'folder.badge.gearshape' },
  { action: 'openwith', name: 'Open With', key: 'cmd+o', symbol: 'square.on.square' },
  { action: 'hideapp', name: 'Hide App (Running Apps)', key: 'cmd+h', symbol: 'eye.slash' }
]
let PANEL_DEFAULTS = PANEL_ACTIONS.map((p) => hotkeyDisplay(p.key))

// A default panel key as printed in a hint ("⌘K") becomes the keys its action has now ("" for none).
fn currentKey(label) {
  let i = PANEL_DEFAULTS.indexOf(label)
  return i >= 0 ? panelLabel(PANEL_ACTIONS[i].action) : label
}

// Keys the search field and the list keep for themselves.
let FIELD_KEYS = ['⌘C', '⌘V', '⌘X', '⌘Z', '⇧⌘Z', '⌘A', '⌘↩', '⌥↩', '⌘⌫', '⌃N', '⌃P']

// The keys of panel action `p` now ("" for none).
fn panelKeys(p) {
  for (let i = 0; i < config.keys.length; i = i + 1) {
    if (config.keys[i].action === p.action) {
      return config.keys[i].keys === 'none' ? '' : config.keys[i].keys
    }
  }
  return p.key
}

fn panelAction(action) {
  for (let i = 0; i < PANEL_ACTIONS.length; i = i + 1) {
    if (PANEL_ACTIONS[i].action === action) {
      return PANEL_ACTIONS[i]
    }
  }
  return null
}

// How a panel action's keys are printed in hints ("" for none).
fn panelLabel(action) {
  let k = panelKeys(panelAction(action))
  return k !== '' ? hotkeyDisplay(k) : ''
}

// The name onKey knows the pressed panel key `spec` by, "" when no action has it.
fn panelKeyName(spec) {
  let d = hotkeyDisplay(spec)
  for (let i = 0; i < PANEL_ACTIONS.length; i = i + 1) {
    let k = panelKeys(PANEL_ACTIONS[i])
    if (k !== '' && hotkeyDisplay(k) === d) {
      return PANEL_ACTIONS[i].key
    }
  }
  return ''
}

fn syncPanelKeys() {
  setPanelKeys(PANEL_ACTIONS.map((p) => panelKeys(p)).filter((k) => k !== ''))
}

// Why `spec` cannot be panel action `p`'s keys, or "".
fn panelKeyConflict(spec, p) {
  let d = hotkeyDisplay(spec)
  if (FIELD_KEYS.indexOf(d) >= 0) {
    return d + ' belongs to the search field'
  }
  for (let i = 0; i < PANEL_ACTIONS.length; i = i + 1) {
    let q = PANEL_ACTIONS[i]
    if (q.action !== p.action && panelKeys(q) !== '' && hotkeyDisplay(panelKeys(q)) === d) {
      return d + ' is already “' + q.name + '”'
    }
  }
  return hotkeyConflict(spec, '')
}

// Aliases and disabled entries name a row by its path: a command id, "shortcut:<keyword>" or an
// app's path.
fn aliasOf(path) {
  for (let i = 0; i < config.aliases.length; i = i + 1) {
    if (config.aliases[i].run === path) {
      return config.aliases[i].alias
    }
  }
  return ''
}

fn isDisabled(path) {
  return config.disabled.indexOf(path) >= 0
}

let commands = [
  { name: 'Ask AI', path: 'moo:ai', icon: aiIcon, kind: AI_TITLE, mode: 'ai', pluginTitle: AI_TITLE, question: '' },
  APPS,
  FILES,
  ACTIONS,
  CLIPBOARD,
  DICTIONARY,
  WEB,
  CONTACTS,
  SETTINGS,
  AI_MODELS,
  HYPERY,
  { name: 'Clear Clipboard History', path: 'moo:clipboard-clear', icon: 'NSTrashEmpty', kind: 'Command', mode: 'builtin' },
  { name: 'Create Shortcut', path: 'moo:create-shortcut', icon: symbolIcon('plus.square'), kind: 'Command', mode: 'create', pluginTitle: 'Moo' },
  { name: 'Shortcuts', path: 'moo:shortcuts', icon: symbolIcon('command.square'), kind: 'Command', mode: 'shortcuts', pluginTitle: 'Moo' },
  { name: 'Hotkeys and Aliases', path: 'moo:hotkeys', icon: symbolIcon('keyboard'), kind: 'Command', mode: 'hotkeys', pluginTitle: 'Moo' },
  { name: 'Edit shortcuts.json', path: 'moo:edit-shortcuts', icon: 'NSActionTemplate', kind: 'Command', mode: 'builtin' },
  { name: 'Quit Moo', path: 'moo:quit', icon: quitIcon, kind: 'Command', mode: 'builtin' }
]
// System commands. `system` and `arg` go to systemCommand; `hides` closes the panel first so it
// does not cover the lock screen or screen saver; `confirm` asks for a second Return.
let SYSTEM_COMMANDS = [
  { name: 'Lock Screen', system: 'lock', symbol: 'lock.fill', hides: true },
  { name: 'Sleep', system: 'sleep', symbol: 'moon.zzz.fill', hides: true },
  { name: 'Sleep Displays', system: 'sleep-displays', symbol: 'display', hides: true },
  { name: 'Start Screen Saver', system: 'screen-saver', symbol: 'sparkles.tv', hides: true },
  { name: 'Toggle Dark Mode', system: 'dark-mode', symbol: 'circle.lefthalf.filled' },
  { name: 'Toggle Mute', system: 'mute', symbol: 'speaker.slash.fill' },
  { name: 'Volume Up', system: 'volume', arg: 'up', symbol: 'speaker.wave.3.fill' },
  { name: 'Volume Down', system: 'volume', arg: 'down', symbol: 'speaker.wave.1.fill' },
  { name: 'Eject All Disks', system: 'eject', symbol: 'eject.fill' },
  { name: 'Hide All Apps', system: 'hide-all', symbol: 'eye.slash', hides: true },
  { name: 'Quit All Apps', system: 'quit-all', symbol: 'xmark.app', hides: true, confirm: true },
  { name: 'Empty Trash', system: 'empty-trash', symbol: 'trash', confirm: true },
  { name: 'Restart', system: 'restart', symbol: 'restart', hides: true, confirm: true },
  { name: 'Shut Down', system: 'shut-down', symbol: 'power', hides: true, confirm: true },
  { name: 'Log Out', system: 'log-out', symbol: 'rectangle.portrait.and.arrow.right', hides: true, confirm: true }
]
// Window layouts for arrangeWindow: id and SF Symbol. They act on the window behind the panel.
let WINDOW_LAYOUTS = [
  { name: 'Left Half', layout: 'left-half', symbol: 'rectangle.lefthalf.filled' },
  { name: 'Right Half', layout: 'right-half', symbol: 'rectangle.righthalf.filled' },
  { name: 'Top Half', layout: 'top-half', symbol: 'rectangle.tophalf.filled' },
  { name: 'Bottom Half', layout: 'bottom-half', symbol: 'rectangle.bottomhalf.filled' },
  { name: 'Top Left Quarter', layout: 'top-left', symbol: 'rectangle.inset.topleft.filled' },
  { name: 'Top Right Quarter', layout: 'top-right', symbol: 'rectangle.inset.topright.filled' },
  { name: 'Bottom Left Quarter', layout: 'bottom-left', symbol: 'rectangle.inset.bottomleft.filled' },
  { name: 'Bottom Right Quarter', layout: 'bottom-right', symbol: 'rectangle.inset.bottomright.filled' },
  { name: 'First Third', layout: 'left-third', symbol: 'rectangle.leftthird.inset.filled' },
  { name: 'Center Third', layout: 'center-third', symbol: 'rectangle.center.inset.filled' },
  { name: 'Last Third', layout: 'right-third', symbol: 'rectangle.rightthird.inset.filled' },
  { name: 'First Two Thirds', layout: 'left-two-thirds', symbol: 'rectangle.lefthalf.inset.filled' },
  { name: 'Last Two Thirds', layout: 'right-two-thirds', symbol: 'rectangle.righthalf.inset.filled' },
  { name: 'Maximize Window', layout: 'maximize', symbol: 'macwindow' },
  { name: 'Almost Maximize', layout: 'almost-maximize', symbol: 'rectangle.inset.filled' },
  { name: 'Maximize Height', layout: 'maximize-height', symbol: 'arrow.up.and.down' },
  { name: 'Center Window', layout: 'center', symbol: 'rectangle.center.inset.filled' },
  { name: 'Reasonable Size', layout: 'reasonable-size', symbol: 'macwindow.on.rectangle' },
  { name: 'Next Display', layout: 'next-display', symbol: 'display.2' },
  { name: 'Previous Display', layout: 'previous-display', symbol: 'display.2' },
  { name: 'Restore Window', layout: 'restore', symbol: 'arrow.uturn.backward' }
]
for (let i = 0; i < WINDOW_LAYOUTS.length; i = i + 1) {
  let d = WINDOW_LAYOUTS[i]
  commands.push({ name: d.name, path: 'moo:window:' + d.layout, icon: symbolIcon(d.symbol), kind: 'Window', mode: 'window', layout: d.layout, pluginTitle: 'Window' })
}
commands.push({ name: 'Running Apps', path: 'moo:running', icon: symbolIcon('square.stack.3d.up'), kind: 'Command', mode: 'running', keyword: 'ps', pluginTitle: 'System' })
// App verbs: each is a subcommand over the running apps. "kill cursor", "focus slack", "max
// safari", "fs zed": the keyword, a space, and the app's name; Return does the verb to the picked
// app. `act` is an appAction (switch, hide, unhide, quit, force-quit), a windowAction (minimize,
// unminimize, fullscreen, close, raise), a window layout ("layout:left-half") or relaunch / reveal
// / copy-path. Every keyword works; the first is shown.
let APP_VERBS = [
  { name: 'Quit App', act: 'quit', keywords: ['kill', 'quit', 'q'], symbol: 'xmark.app', label: 'Quit' },
  { name: 'Force Quit App', act: 'force-quit', keywords: ['fkill', 'forcequit', 'kill9'], symbol: 'exclamationmark.octagon', label: 'Force Quit' },
  { name: 'Relaunch App', act: 'relaunch', keywords: ['relaunch', 'restart', 'reopen'], symbol: 'arrow.clockwise', label: 'Relaunch' },
  { name: 'Focus App', act: 'switch', keywords: ['focus', 'switch', 'go'], symbol: 'macwindow.on.rectangle', label: 'Focus' },
  { name: 'Hide App', act: 'hide', keywords: ['hide'], symbol: 'eye.slash', label: 'Hide' },
  { name: 'Show Hidden App', act: 'unhide', keywords: ['unhide', 'show'], symbol: 'eye', label: 'Show' },
  { name: 'Minimize Window', act: 'minimize', keywords: ['min', 'minimize', 'minimise'], symbol: 'minus.rectangle', label: 'Minimize' },
  { name: 'Restore Minimized Windows', act: 'unminimize', keywords: ['unmin', 'unminimize'], symbol: 'plus.rectangle', label: 'Restore' },
  { name: 'Toggle Full Screen', act: 'fullscreen', keywords: ['fs', 'fullscreen', 'full'], symbol: 'arrow.up.left.and.arrow.down.right', label: 'Full Screen' },
  { name: 'Close Window', act: 'close', keywords: ['close'], symbol: 'xmark.rectangle', label: 'Close Window' },
  { name: 'Maximize App', act: 'layout:maximize', keywords: ['max', 'maximize', 'maximise', 'zoom'], symbol: 'rectangle.inset.filled', label: 'Maximize' },
  { name: 'Almost Maximize App', act: 'layout:almost-maximize', keywords: ['almost'], symbol: 'rectangle.center.inset.filled', label: 'Almost Maximize' },
  { name: 'Center App', act: 'layout:center', keywords: ['center', 'centre'], symbol: 'rectangle.center.inset.filled', label: 'Center' },
  { name: 'App to Left Half', act: 'layout:left-half', keywords: ['left'], symbol: 'rectangle.lefthalf.filled', label: 'Left Half' },
  { name: 'App to Right Half', act: 'layout:right-half', keywords: ['right'], symbol: 'rectangle.righthalf.filled', label: 'Right Half' },
  { name: 'App to Top Half', act: 'layout:top-half', keywords: ['top'], symbol: 'rectangle.tophalf.filled', label: 'Top Half' },
  { name: 'App to Bottom Half', act: 'layout:bottom-half', keywords: ['bottom'], symbol: 'rectangle.bottomhalf.filled', label: 'Bottom Half' },
  { name: 'App to Next Display', act: 'layout:next-display', keywords: ['display', 'move', 'next'], symbol: 'rectangle.on.rectangle', label: 'Next Display' },
  { name: "Restore App's Window Size", act: 'layout:restore', keywords: ['restore', 'unmax'], symbol: 'arrow.uturn.backward', label: 'Restore Size' },
  { name: 'Reveal App in Finder', act: 'reveal', keywords: ['reveal', 'where'], symbol: 'folder', label: 'Show in Finder' },
  { name: 'Copy App Path', act: 'copy-path', keywords: ['path'], symbol: 'doc.on.clipboard', label: 'Copy Path' }
]
for (let i = 0; i < APP_VERBS.length; i = i + 1) {
  let v = APP_VERBS[i]
  commands.push({ name: v.name, path: 'moo:app:' + v.act, icon: symbolIcon(v.symbol), kind: v.keywords[0] + ' ‹app›', mode: 'running', keyword: v.keywords[0], keywords: v.keywords, appAct: v.act, verb: v.label, pluginTitle: 'Apps' })
}
// File verbs: "f report", "ql invoice", "trash old.zip". The files matching the text come first;
// Return does the verb (fileAction) to the picked one.
let FILE_VERBS = [
  { name: 'Open File', act: 'open', keywords: ['f', 'find', 'open'], symbol: 'doc', label: 'Open' },
  { name: 'Reveal File in Finder', act: 'reveal', keywords: ['finder', 'rev'], symbol: 'folder', label: 'Show in Finder' },
  { name: 'Quick Look File', act: 'look', keywords: ['ql', 'look', 'peek'], symbol: 'eye', label: 'Quick Look' },
  { name: 'Open File With…', act: 'openwith', keywords: ['with', 'openwith'], symbol: 'square.on.square', label: 'Open With' },
  { name: 'Copy File Path', act: 'copypath', keywords: ['cp', 'copypath'], symbol: 'doc.on.clipboard', label: 'Copy Path' },
  { name: 'Move File to Trash', act: 'trash', keywords: ['trash', 'rm', 'del'], symbol: 'trash', label: 'Move to Trash' }
]
for (let i = 0; i < FILE_VERBS.length; i = i + 1) {
  let v = FILE_VERBS[i]
  commands.push({ name: v.name, path: 'moo:file:' + v.act, icon: symbolIcon(v.symbol), kind: v.keywords[0] + ' ‹file›', mode: 'files', keyword: v.keywords[0], keywords: v.keywords, fileAct: v.act, verb: v.label, pluginTitle: 'Files' })
}
// "win left", "sys lock": the window layouts and system commands, filtered by the text.
commands.push({ name: 'Window Layouts', path: 'moo:windows', icon: symbolIcon('macwindow'), kind: 'win ‹layout›', mode: 'subs', keyword: 'win', keywords: ['win', 'window', 'layout'], subOf: 'window', pluginTitle: 'Window' })
commands.push({ name: 'System Commands', path: 'moo:system', icon: symbolIcon('gearshape.2'), kind: 'sys ‹command›', mode: 'subs', keyword: 'sys', keywords: ['sys', 'system', 'mac'], subOf: 'system', pluginTitle: 'System' })
// Keywords for Moo's own lists: "clip invoice", "define serendipity", "web rust traits", "contact
// ana", "apps xcode", "recent", "set engine".
let LIST_KEYWORDS = [
  [CLIPBOARD, ['clip', 'cb', 'paste']],
  [DICTIONARY, ['define', 'def', 'meaning']],
  [WEB, ['web', 'search']],
  [CONTACTS, ['contact', 'contacts', 'call', 'email']],
  [APPS, ['apps', 'app']],
  [HISTORY, ['recent', 'history']],
  [SETTINGS, ['set', 'settings', 'prefs']]
]
for (let i = 0; i < LIST_KEYWORDS.length; i = i + 1) {
  LIST_KEYWORDS[i][0].keyword = LIST_KEYWORDS[i][1][0]
  LIST_KEYWORDS[i][0].keywords = LIST_KEYWORDS[i][1]
}
for (let i = 0; i < SYSTEM_COMMANDS.length; i = i + 1) {
  let d = SYSTEM_COMMANDS[i]
  commands.push({ name: d.name, path: 'moo:system:' + d.system + (d.arg ? '-' + d.arg : ''), icon: symbolIcon(d.symbol), kind: 'System', mode: 'system', system: d.system, arg: d.arg ? d.arg : '', hides: d.hides === true, confirm: d.confirm === true, pluginTitle: 'System' })
}
let ASK_AI = commands[0]
let BUILTIN_COUNT = commands.length
let pluginCount = 0
let pluginFiles = pluginPaths(PLUGIN_DIR)
let pluginT0 = Date.now()

// Tier A (`.tishc`): bytecode in a capability-free VM. Tier B (`.lib`): native module via tish:ffi.
fn loadPlugin(path) {
  if (path.indexOf('.tishc') >= 0) {
    let r = loadBytecodePlugin(path)
    if (!r.ok) {
      console.log('moo: plugin ' + r.error)
      return null
    }
    console.log('moo: tier A ' + path + ' in ' + r.ms.toFixed(2) + ' ms')
    return r.plugin
  }
  let t0 = Date.now()
  let mod = loadModule(path)
  console.log('moo: tier B ' + path + ' in ' + (Date.now() - t0) + ' ms')
  return mod
}

fn addCommands(mod) {
  let m = mod.manifest()
  for (let j = 0; j < m.commands.length; j = j + 1) {
    let c = m.commands[j]
    let symbol = c.icon ? c.icon : (m.icon ? m.icon : '')
    commands.push({
      name: c.title,
      path: 'plugin:' + m.id + '/' + c.name,
      icon: symbol.indexOf('symbol:') === 0 ? symbolIcon(symbol.slice(7)) : (c.mode === 'list' || c.mode === 'view' ? 'NSListViewTemplate' : 'NSActionTemplate'),
      kind: m.title,
      mode: c.mode,
      plugin: mod,
      command: c.name,
      pluginTitle: m.title,
      arguments: c.arguments ? c.arguments : [],
      keyword: c.keyword ? c.keyword.toLowerCase() : '',
      args: {}
    })
  }
  pluginCount = pluginCount + 1
}

// No `continue` inside `try`: the native backend emits the try body as a closure.
for (let i = 0; i < pluginFiles.length; i = i + 1) {
  try {
    let mod = loadPlugin(pluginFiles[i])
    if (mod !== null) {
      addCommands(mod)
    }
  } catch (e) {
    console.log('moo: plugin ' + pluginFiles[i] + ' failed: ' + e.message)
  }
}
// What the root search matches a command by: its title, and a plugin command's keyword and plugin.
fn commandMatchText(c) {
  if (c.keywords) {
    return c.name + ' ' + c.keywords.join(' ')
  }
  return c.plugin ? [c.name, c.keyword, c.pluginTitle].filter((s) => s !== '').join(' ') : c.name
}

let commandTitles = commands.map(commandMatchText)

// A plugin's data arrived (moo.refresh()): search its list or suggestions again. With a message
// (moo.notify(text)): show it in the status line.
onPluginRefresh((message) => {
  if (message) {
    shell.hud = message
    refresh()
  } else if (shell.mode !== null && (shell.mode.mode === 'args' || shell.mode.plugin)) {
    relist()
  }
})
console.log('moo: indexed ' + index.count + ' apps in ' + index.ms.toFixed(1) + ' ms, watching ' + watching
  + ', ' + pluginCount + ' plugins / ' + (commands.length - BUILTIN_COUNT) + ' commands in ' + (Date.now() - pluginT0) + ' ms, hotkey ' + hotkeyLabel)

// ── Shell state ──
// Native key and show callbacks are registered once, so state lives outside the component.
// `apps` holds the synchronous rows (apps + commands, or a plugin's list); `files` arrives later
// from Spotlight for the same query. `mode` is the open plugin list command, or null at root.
// `offset` is the first visible result when they do not all fit; `groups[i]` is the section
// heading of `results[i]`; `view` is the open plugin view ({ id, tree, list }); `bubble` is the
// category button selected with tab in the idle bar (-1: the field).
let shell = { query: '', selected: 0, offset: 0, apps: [], files: [], contents: [], results: [], groups: [], mode: null, view: null, hud: '', fileMs: -1, bubble: -1, version: 0, rerender: null }

// Layout. The tree keeps the same shape in every state (header with 4 category buttons, SLOTS list
// rows, footer with HINT_SLOTS hints): a different shape rebuilds the views and the field loses
// focus. The idle bar is the same tree in a shorter panel cut into a field capsule and 4 circles.
const PANEL_W = 750
const HEADER_H = 52
const CAT_W = 52
const CAT_GAP = 8
const SECTION_H = 28
const ROW_H = 40
const LINE_H = 32
const LIST_PAD = 6
const FOOTER_H = 40
// Section headings and results share the list's height; filler rows take what is left.
const SLOTS = ROWS + 5
const LIST_H = ROWS * ROW_H + 4 * SECTION_H
// The Applications grid: GRID_ROWS rows of GRID_COLS icons under the heading, always in the tree
// (1 px tall unless the grid is showing).
const GRID_COLS = 7
const GRID_ROWS = 4
const PANEL_H = HEADER_H + 1 + LIST_PAD + LIST_H + SLOTS + GRID_ROWS + LIST_PAD + 1 + FOOTER_H
const HINT_SLOTS = 3
// Colours, type, radii and icon sizes come from theme.tish.
const C = THEME.colors
const T = THEME.type
const CLEAR = C.clear
const SELECTED = C.selection

// Applications shows a grid of icons (Spotlight's default) or the list; ⌘L switches, remembered.
let appsView = getPref('appsView') === 'list' ? 'list' : 'grid'

fn isGrid() {
  return appsView === 'grid' && modeIs('apps')
}

fn toggleAppsView() {
  appsView = appsView === 'grid' ? 'list' : 'grid'
  setPref('appsView', appsView)
  shell.offset = 0
  follow()
  refresh()
}

// Spotlight opens as a bare search bar; anything to show (results, a category, a message) expands it.
fn isCompact() {
  return shell.mode === null && shell.query === '' && shell.hud === ''
}

let shapeCompact = null

fn syncShape() {
  let c = isCompact()
  if (c === shapeCompact) {
    return
  }
  shapeCompact = c
  // One glass surface in both states: collapsed is the expanded panel cut to its header, so the
  // change is the same glass growing or shrinking, with the views fading in and out inside it.
  setPanelShape(c ? HEADER_H : PANEL_H, [])
}

fn refresh() {
  CATEGORIES = loadPins()
  syncShape()
  syncQuickLook()
  setArrowKeys(isGrid())
  shell.version = shell.version + 1
  if (shell.rerender !== null) {
    shell.rerender(shell.version)
  }
}

// ── Shortcuts: a keyword plus text runs a URL, path, command, shell command or text template ──

let KINDS = [
  { kind: 'url', title: 'Open a URL', hint: '{query} becomes the text you type after the keyword, URL-encoded', icon: symbolIcon('globe') },
  { kind: 'open', title: 'Open an app, file or folder', hint: 'Pick what to open', icon: 'NSFolder' },
  { kind: 'command', title: 'Run a Moo command', hint: 'Starts the command with the text you type', icon: 'NSActionTemplate' },
  { kind: 'shell', title: 'Run a shell command', hint: '{query} is inserted single-quoted; the output is shown', icon: symbolIcon('terminal') },
  { kind: 'text', title: 'Copy text', hint: '{query}, {clipboard}, {date} and {time} are filled in; \\n is a new line', icon: symbolIcon('text.quote') },
  { kind: 'snippet', title: 'Expand a snippet as you type', hint: 'Typing the keyword in any app replaces it; {clipboard}, {date} and {time} are filled in; \\n is a new line', icon: symbolIcon('text.insert') }
]

// The wizard's "snippet" is a text shortcut with expand on.
fn wizKindOf(s) {
  return s.expand ? 'snippet' : s.kind
}

fn kindInfo(kind) {
  for (let i = 0; i < KINDS.length; i = i + 1) {
    if (KINDS[i].kind === kind) {
      return KINDS[i]
    }
  }
  return KINDS[0]
}

fn shortcutIcon(s) {
  if (s.kind === 'open') {
    let icon = fileIcon(expandTemplate(s.target, '', 'open'))
    return icon !== '' ? icon : kindInfo(s.kind).icon
  }
  return kindInfo(wizKindOf(s)).icon
}

fn findShortcut(keyword) {
  let k = keyword.trim().toLowerCase()
  for (let i = 0; i < config.shortcuts.length; i = i + 1) {
    if (config.shortcuts[i].keyword.toLowerCase() === k) {
      return config.shortcuts[i]
    }
  }
  return null
}

fn findCommand(id) {
  let k = id.trim().toLowerCase()
  for (let i = 0; i < commands.length; i = i + 1) {
    let c = commands[i]
    if (c.mode !== 'shortcut' && (c.path.toLowerCase() === k || c.name.toLowerCase() === k)) {
      return c
    }
  }
  return null
}

fn shortcutKind(s) {
  let label = (s.expand ? 'Snippet · ' : 'Shortcut · ') + s.keyword
  return s.hotkey !== '' ? label + ' · ' + hotkeyDisplay(s.hotkey) : label
}

// Shortcuts take part in root search like commands (matched by name; the keyword is matched
// exactly by shortcutMatch).
fn syncShortcutCommands() {
  let kept = []
  for (let i = 0; i < commands.length; i = i + 1) {
    if (commands[i].mode !== 'shortcut') {
      kept.push(commands[i])
    }
  }
  for (let i = 0; i < config.shortcuts.length; i = i + 1) {
    let s = config.shortcuts[i]
    kept.push({ name: s.name, path: 'shortcut:' + s.keyword, icon: shortcutIcon(s), kind: shortcutKind(s), mode: 'shortcut', shortcut: s, query: '', pluginTitle: 'Shortcut' })
  }
  commands = kept
  commandTitles = commands.map(commandMatchText)
}

// "Google" for a shortcut keyword, "Clipboard History" for a command id, else the target itself.
fn targetLabel(run) {
  let s = findShortcut(run)
  if (s !== null) {
    return '“' + s.name + '”'
  }
  if (run === 'moo:toggle' || run === 'moo:show' || run === 'moo:hide') {
    return 'the Moo launcher'
  }
  let c = findCommand(run)
  if (c !== null) {
    return '“' + c.name + '”'
  }
  if (run.indexOf('/') === 0) {
    let name = run.split('/').pop()
    let bare = name.length > 4 && name.slice(name.length - 4) === '.app' ? name.slice(0, name.length - 4) : name
    return '“' + bare + '”'
  }
  return run
}

// Why `keys` cannot be given to something new, or "". Another entry of the config with the same
// combination (however it is spelled) is a conflict; `replacing` is the hotkeys[] spelling being
// rebound, which is not.
fn hotkeyConflict(keys, replacing) {
  let d = hotkeyDisplay(keys)
  if (d === hotkeyLabel) {
    return d + ' is the Moo launcher hotkey'
  }
  for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
    let h = hotkeyStatus[i]
    let same = !h.shortcut && h.keys.toLowerCase() === replacing.toLowerCase()
    if (!same && hotkeyDisplay(h.keys) === d) {
      return d + ' is already bound to ' + targetLabel(h.run)
    }
  }
  return ''
}

// Registered hotkeys besides the launcher: { keys, run, query, shortcut, display, id, error }. The
// action passed to registerHotkey is "hk:<index>" into this list.
let hotkeyStatus = []

fn bindHotkeys() {
  for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
    if (hotkeyStatus[i].id > 0) {
      unregisterHotkey(hotkeyStatus[i].id)
    }
  }
  let wanted = []
  for (let i = 0; i < config.shortcuts.length; i = i + 1) {
    let s = config.shortcuts[i]
    if (s.hotkey !== '' && !isDisabled('shortcut:' + s.keyword)) {
      wanted.push({ keys: s.hotkey, run: s.keyword, query: '', shortcut: true })
    }
  }
  for (let i = 0; i < config.hotkeys.length; i = i + 1) {
    let h = config.hotkeys[i]
    if (!isDisabled(h.run)) {
      wanted.push({ keys: h.keys, run: h.run, query: h.query, shortcut: false })
    }
  }
  hotkeyStatus = []
  for (let i = 0; i < wanted.length; i = i + 1) {
    let w = wanted[i]
    let r = registerHotkey(w.keys, 'hk:' + i, targetLabel(w.run))
    hotkeyStatus.push({ keys: w.keys, run: w.run, query: w.query, shortcut: w.shortcut, display: r.ok ? r.display : hotkeyDisplay(w.keys), id: r.ok ? r.id : 0, error: r.ok ? '' : r.error })
    if (!r.ok) {
      console.log('moo: hotkey ' + w.keys + ' → ' + w.run + ': ' + r.error)
    }
  }
}

fn reloadShortcuts() {
  config = loadShortcuts()
  if (!config.ok) {
    console.log('moo: shortcuts: ' + config.error)
  }
  for (let i = 0; i < config.warnings.length; i = i + 1) {
    console.log('moo: shortcuts: ' + config.warnings[i])
  }
  syncShortcutCommands()
  bindHotkeys()
  syncPanelKeys()
  syncSnippets()
  refreshProviders()
}

// Text shortcuts with "expand": true replace their keyword wherever it is typed.
fn syncSnippets() {
  let keywords = []
  for (let i = 0; i < config.shortcuts.length; i = i + 1) {
    if (config.shortcuts[i].expand) {
      keywords.push(config.shortcuts[i].keyword)
    }
  }
  let r = watchSnippets(keywords, onSnippetTyped)
  if (!r.ok) {
    console.log('moo: snippets: ' + r.error)
  }
}

fn snippetText(s) {
  return expandTemplate(s.target, '', 'text').split('\\n').join('\n')
}

fn onSnippetTyped(keyword) {
  let s = null
  for (let i = 0; i < config.shortcuts.length; i = i + 1) {
    if (config.shortcuts[i].expand && config.shortcuts[i].keyword === keyword) {
      s = config.shortcuts[i]
    }
  }
  if (s === null) {
    return
  }
  let r = replaceTyped(keyword, snippetText(s))
  if (r.ok) {
    recordUse('shortcut:' + s.keyword)
  } else {
    console.log('moo: snippet ' + keyword + ': ' + r.error)
  }
}

// A global hotkey: run its target; a shortcut that needs text opens the launcher to ask for it.
fn onHotkey(action) {
  let i = Number(action.slice(3))
  if (action.indexOf('hk:') !== 0 || i < 0 || i >= hotkeyStatus.length) {
    return
  }
  let h = hotkeyStatus[i]
  let r = runTarget(h.run, h.query, null)
  if (r !== 'done' && r !== 'pending') {
    shell.hud = r
    show()
    refresh()
  }
}

// Text typed after a keyword: "g rust traits" → Google with "rust traits".
fn shortcutMatch(text) {
  let t = text.trim()
  if (t === '') {
    return null
  }
  let space = t.indexOf(' ')
  let s = findShortcut(space > 0 ? t.slice(0, space) : t)
  if (s === null) {
    return null
  }
  return { shortcut: s, query: space > 0 ? t.slice(space + 1).trim() : '' }
}

// Text starting with an alias: "cb" puts Clipboard History first, "cb report" opens it searching
// "report". Apps take no text, so "safari x" is searched as usual.
fn aliasMatch(text) {
  let t = text.trim()
  if (t === '' || config.aliases.length === 0) {
    return null
  }
  let space = t.indexOf(' ')
  let word = (space > 0 ? t.slice(0, space) : t).toLowerCase()
  let query = space > 0 ? t.slice(space + 1).trim() : ''
  for (let i = 0; i < config.aliases.length; i = i + 1) {
    let a = config.aliases[i]
    if (a.alias.toLowerCase() === word && !isDisabled(a.run)) {
      let row = a.run.indexOf('/') === 0 ? appRow(a.run) : findCommand(a.run)
      if (row === null || (query !== '' && row.kind === 'Application')) {
        return null
      }
      if (query === '') {
        return { row: row }
      }
      return { row: { name: row.name + ': ' + query, path: row.path, icon: row.icon, kind: 'Alias · ' + a.alias, mode: 'alias', target: row, query: query, pluginTitle: row.pluginTitle } }
    }
  }
  return null
}

// A result row for the app at `path`, as search returns them.
fn appRow(path) {
  let file = path.split('/').pop()
  let name = file.length > 4 && file.slice(file.length - 4) === '.app' ? file.slice(0, file.length - 4) : file
  return { name: name, path: path, icon: fileIcon(path), kind: 'Application' }
}

fn shortcutRow(s, query) {
  let name = query !== '' ? s.name + ': ' + query : (s.needsQuery ? s.name + ' …' : s.name)
  return { name: name, path: 'shortcut:' + s.keyword, icon: shortcutIcon(s), kind: shortcutKind(s), mode: 'shortcut', shortcut: s, query: query, pluginTitle: 'Shortcut' }
}

fn leaveToRoot() {
  if (shell.mode !== null) {
    leaveList()
  }
}

// Open the launcher on a command with optional search text.
fn openCommand(c, query) {
  if (c.mode === 'system') {
    runSystem(c, query.trim() !== '' ? query.trim() : c.arg, false)
    return
  }
  if (c.mode === 'window') {
    runWindow(c)
    return
  }
  leaveToRoot()
  show()
  if (hasArgs(c)) {
    enterArgs(c, query.trim())
  } else if (c.mode === 'builtin') {
    runBuiltin(c)
  } else if (c.mode === 'ai') {
    enterAi(c, query)
  } else if (c.mode === 'view') {
    enterView(c)
    setQuery(query)
  } else if (c.mode === 'no-view') {
    runCommand(c)
  } else {
    enterList(c)
    setQuery(query)
  }
}

// Run a shortcut. `cli` is { token, cwd } for `moo run`, else null. Returns "done", "pending"
// (a shell command still running answers the CLI itself) or an error message.
fn runShortcut(s, query, cli) {
  recordUse('shortcut:' + s.keyword)
  if (s.kind === 'command') {
    let c = findCommand(s.target)
    if (c === null) {
      return 'Shortcut ' + s.keyword + ': no command ' + s.target
    }
    openCommand(c, expandTemplate(s.input, query, 'command'))
    return 'done'
  }
  if (s.needsQuery && query === '' && cli === null) {
    leaveToRoot()
    show()
    setQuery(s.keyword + ' ')
    return 'done'
  }
  let text = expandTemplate(s.target, query, s.kind)
  if (s.kind === 'url' || s.kind === 'open') {
    if (!launch(text)) {
      return 'Could not open ' + text
    }
    leaveToRoot()
    return 'done'
  }
  if (s.kind === 'text') {
    let body = text.split('\\n').join('\n')
    copyText(body)
    if (cli !== null) {
      cliWrite(cli.token, body.length > 0 && body[body.length - 1] === '\n' ? body : body + '\n', 'out')
    } else {
      hide()
      leaveToRoot()
    }
    return 'done'
  }
  runShell(text, cli !== null ? cli.cwd : HOME, (r) => onShellDone(s, r, cli), shellValues(s.target, query))
  if (cli === null && s.output === 'show') {
    showOutput(s, null)
  }
  return 'pending'
}

fn onShellDone(s, r, cli) {
  if (cli !== null) {
    if (r.stdout !== '') {
      cliWrite(cli.token, r.stdout, 'out')
    }
    if (r.stderr !== '') {
      cliWrite(cli.token, r.stderr, 'err')
    }
    cliEnd(cli.token, r.code)
    return
  }
  if (s.output === 'copy') {
    copyText(r.stdout.trim())
    shell.hud = r.code === 0 ? 'Copied the output of ' + s.name : s.name + ' failed (exit ' + r.code + ')'
    refresh()
  } else if (s.output === 'none') {
    shell.hud = s.name + (r.code === 0 ? ' finished' : ' failed (exit ' + r.code + ')')
    refresh()
  } else {
    showOutput(s, r)
  }
}

// Shell output as scrollable rows; enter copies a line, cmd+enter copies everything.
fn showOutput(s, r) {
  let lines = r === null ? [] : (r.stdout + r.stderr).split('\n')
  if (lines.length > 0 && lines[lines.length - 1] === '') {
    lines = lines.slice(0, lines.length - 1)
  }
  let c = { name: s.name, path: 'shortcut:' + s.keyword, icon: shortcutIcon(s), kind: 'Output', mode: 'output', pluginTitle: 'Shortcut', lines: lines, result: r, all: r === null ? '' : r.stdout }
  if (shell.mode === null || shell.mode.mode !== 'output' || shell.mode.path !== c.path) {
    leaveToRoot()
    show()
    shell.mode = c
    setQuery('')
  } else {
    shell.mode = c
    setQuery(shell.query)
  }
}

fn outputResults(text) {
  let m = shell.mode
  if (m.result === null) {
    return [{ name: 'Running…', kind: '', icon: '', action: null }]
  }
  let rows = []
  let needle = text.trim().toLowerCase()
  for (let i = 0; i < m.lines.length; i = i + 1) {
    if (needle === '' || m.lines[i].toLowerCase().indexOf(needle) >= 0) {
      rows.push({ name: m.lines[i], kind: '', icon: '', action: { copy: m.lines[i], hud: 'Copied line' } })
    }
  }
  if (rows.length === 0) {
    rows.push({ name: m.lines.length === 0 ? '(no output)' : 'No matching lines', kind: '', icon: '', action: null })
  }
  return rows
}

// ── Dictionary: Define Word lists a word's senses; "define <word>" or a one-word root search
// also gets a Definition row ──

let dictIcon = symbolIcon(THEME.icon.dictionary)
// One-word root searches at least this long are looked up too.
const DEFINE_MIN_CHARS = 4
// Where the Definition row goes among root results: after the best matches.
const DEFINE_ROW_AT = 3
const DEFINE_ROW_CHARS = 56
// Continuation lines of a sense line up under its text, past the "1. ". Row text is trimmed, so
// the indent starts with an invisible word joiner, which is not whitespace.
const DICT_INDENT = '\u2060\u00a0\u00a0\u00a0\u00a0\u00a0'

fn isWord(t) {
  if (t.length < DEFINE_MIN_CHARS) {
    return false
  }
  for (let i = 0; i < t.length; i = i + 1) {
    let c = t[i]
    if (c.toLowerCase() === c.toUpperCase() && c !== '-' && c !== "'") {
      return false
    }
  }
  return true
}

fn clip(s, n) {
  return s.length > n ? s.slice(0, n - 1).trim() + '…' : s
}

// "define serendipity" → "serendipity"; "" for any other search.
fn definePrefix(text) {
  let t = text.trim()
  return t.toLowerCase().indexOf('define ') === 0 ? t.slice(7).trim() : ''
}

// The root row for a word: its first sense, or (when `always`) a row that opens Define Word anyway.
fn definitionRow(word, always) {
  let e = define(word)
  if (e === null) {
    return always ? { name: 'Define “' + word + '”', path: DICTIONARY.path, icon: dictIcon, kind: 'Dictionary', mode: 'define', word: word, pluginTitle: 'Dictionary' } : null
  }
  let s = e.senses[0]
  return { name: clip(e.word + ' — ' + s.definition, DEFINE_ROW_CHARS), path: DICTIONARY.path, icon: dictIcon, kind: s.part, mode: 'define', word: word, pluginTitle: 'Dictionary' }
}

fn openDefinition(word) {
  leaveToRoot()
  enterList(DICTIONARY)
  setQuery(word)
}

fn partTitle(s) {
  let p = s.part === '' ? 'Definition' : s.part[0].toUpperCase() + s.part.slice(1)
  return s.pronunciation !== '' ? p + ' · ' + s.pronunciation : p
}

fn indented(lines, first) {
  let out = []
  for (let i = 0; i < lines.length; i = i + 1) {
    out.push((i === 0 ? first : DICT_INDENT) + lines[i])
  }
  return out
}

// Each sense as wrapped lines, numbered within its part of speech, its example in quotes under
// it; every line of a sense copies its definition. The origin comes last.
fn dictionaryResults(text) {
  let word = text.trim()
  shell.mode.entry = null
  if (word === '') {
    return [{ name: 'Type a word to look it up', kind: '', icon: '', action: null }]
  }
  let e = define(word)
  if (e === null) {
    return [{ name: 'No definition of “' + word + '” in the dictionary', kind: '', icon: '', action: null }]
  }
  shell.mode.entry = e
  let rows = []
  let n = 0
  let prev = ''
  for (let i = 0; i < e.senses.length; i = i + 1) {
    let s = e.senses[i]
    let group = partTitle(s)
    n = group === prev ? n + 1 : 1
    prev = group
    let action = { copy: s.definition, hud: 'Copied the definition' }
    let width = AI_WRAP - DICT_INDENT.length
    let lines = indented(wrapText(s.definition, width), n + '.\u00a0\u00a0')
    for (let k = 0; k < lines.length; k = k + 1) {
      rows.push({ name: lines[k], kind: '', icon: '', line: true, group: group, action: action })
    }
    if (s.example !== '') {
      let ex = indented(wrapText('“' + s.example + '”', width), DICT_INDENT)
      for (let k = 0; k < ex.length; k = k + 1) {
        rows.push({ name: ex[k], kind: '', icon: '', line: true, dim: true, group: group, action: action })
      }
    }
  }
  if (e.origin !== '') {
    let lines = wrapText(e.origin, AI_WRAP)
    for (let k = 0; k < lines.length; k = k + 1) {
      rows.push({ name: lines[k], kind: '', icon: '', line: true, group: 'Origin', action: { copy: e.origin, hud: 'Copied the origin' } })
    }
  }
  return rows
}

// ── Web search: Search the Web suggests as you type (requests go out only in that view); a root
// search ends with an offline "Search Google for …" row ──

// {query} is URL-encoded. Every `suggest` URL answers in the OpenSearch format.
let WEB_ENGINES = [
  { id: 'google', name: 'Google', search: 'https://www.google.com/search?q={query}', suggest: 'https://suggestqueries.google.com/complete/search?client=firefox&q={query}' },
  { id: 'duckduckgo', name: 'DuckDuckGo', search: 'https://duckduckgo.com/?q={query}', suggest: 'https://duckduckgo.com/ac/?q={query}&type=list' },
  { id: 'bing', name: 'Bing', search: 'https://www.bing.com/search?q={query}', suggest: 'https://api.bing.com/osjson.aspx?query={query}' },
  { id: 'brave', name: 'Brave Search', search: 'https://search.brave.com/search?q={query}', suggest: 'https://search.brave.com/api/suggest?q={query}' }
]
const WEB_QUERY_CHARS = 40

// By id or the start of its name: "ddg" is not one, "duck" is.
fn findEngine(name) {
  let n = name.trim().toLowerCase()
  for (let i = 0; i < WEB_ENGINES.length; i = i + 1) {
    let e = WEB_ENGINES[i]
    if (n !== '' && (e.id === n || e.name.toLowerCase().indexOf(n) === 0)) {
      return e
    }
  }
  return null
}

fn webEngine() {
  let e = findEngine(getPref('webEngine'))
  return e !== null ? e : WEB_ENGINES[0]
}

fn webSearchRow(text, group) {
  let e = webEngine()
  return { name: 'Search ' + e.name + ' for “' + clip(text.trim(), WEB_QUERY_CHARS) + '”', path: WEB.path, icon: webIcon, kind: e.name, mode: 'web-search', query: text.trim(), group: group, pluginTitle: 'Web' }
}

fn openWebSearch(text) {
  launch(expandTemplate(webEngine().search, text, 'url'))
  hide()
  if (shell.mode !== null) {
    leaveList()
  } else {
    setQuery('')
  }
}

// Empty: the engines, Return makes one the default. Text: searching it, then the engine's
// suggestions for it once they arrive (onWebSuggest).
fn webRows(text) {
  let t = text.trim()
  let e = webEngine()
  if (t === '') {
    return WEB_ENGINES.map((x) => ({ name: x.name, kind: x.id === e.id ? 'Default' : '', icon: webIcon, mode: 'web-engine', engine: x, group: 'Search Engine' }))
  }
  let rows = [webSearchRow(t, e.name)]
  if (shell.mode.suggested === t) {
    for (let i = 0; i < shell.mode.suggestions.length; i = i + 1) {
      let s = shell.mode.suggestions[i]
      rows.push({ name: s, kind: '', icon: webIcon, mode: 'web-search', query: s, group: 'Suggestions' })
    }
  }
  return rows
}

fn webResults(text) {
  let t = text.trim()
  if (t !== '' && shell.mode.suggested !== t) {
    pending.web = t
    webSuggest(expandTemplate(webEngine().suggest, t, 'url'), t, onWebSuggest)
  }
  return webRows(text)
}

fn onWebSuggest(r) {
  if (r.query === pending.web) {
    pending.web = ''
  }
  if (!modeIs('web') || r.query !== shell.query.trim()) {
    refresh()
    return
  }
  shell.mode.suggestions = r.results
  shell.mode.suggested = r.query
  shell.mode.error = r.error
  shell.apps = webRows(shell.query)
  compose()
  refresh()
}

fn cliWeb(token, w, rest) {
  if (w.length > 1 && w[1] === 'engine') {
    if (w.length > 2) {
      let e = findEngine(w.slice(2).join(' '))
      if (e === null) {
        cliFail(token, 'unknown search engine; one of: ' + WEB_ENGINES.map((x) => x.id).join(', '))
        return
      }
      setPref('webEngine', e.id)
      cliOut(token, 'default search engine: ' + e.name + '\n')
    } else {
      let cur = webEngine()
      cliOut(token, WEB_ENGINES.map((x) => (x.id === cur.id ? '* ' : '  ') + x.id + '  ' + x.name).join('\n') + '\n')
    }
    cliEnd(token, 0)
    return
  }
  let t = rest.trim()
  if (t === '') {
    cliFail(token, 'usage: moo web <text> | moo web engine [name]')
    return
  }
  let e = webEngine()
  webSuggest(expandTemplate(e.suggest, t, 'url'), t, (r) => {
    if (r.error !== '') {
      cliFail(token, e.name + ' suggestions failed: ' + r.error)
    } else {
      cliOut(token, r.results.join('\n') + (r.results.length > 0 ? '\n' : ''))
      cliEnd(token, 0)
    }
  })
}

// ── Contacts: Search Contacts lists the address book; Return shows a contact's emails and
// phone numbers. macOS asks for access only when the user picks "Allow Access to Contacts" ──

const CONTACTS_MAX = 200
const CONTACTS_PRIVACY = 'x-apple.systempreferences:com.apple.preference.security?Privacy_Contacts'

fn contactsAllowed() {
  let a = contactsAccess()
  return a === 'authorized' || a === 'limited'
}

fn contactDetail(c) {
  if (c.org !== '' && c.title !== '') {
    return c.title + ', ' + c.org
  }
  if (c.org !== '' || c.title !== '') {
    return c.org + c.title
  }
  if (c.emails.length > 0) {
    return c.emails[0].value
  }
  return c.phones.length > 0 ? c.phones[0].value : ''
}

fn contactRows() {
  return shell.mode.results.map((c) => ({ name: c.name, kind: contactDetail(c), icon: contactIcon, mode: 'contact', contact: c, group: 'Contacts' }))
}

fn contactsResults(text) {
  if (!contactsAllowed()) {
    let asked = contactsAccess() !== 'notDetermined'
    return [{ name: asked ? 'Open Privacy Settings for Contacts' : 'Allow Access to Contacts', kind: asked ? 'Access was turned off' : '', icon: symbolIcon('lock'), mode: 'contacts-allow', group: 'Contacts' }]
  }
  let t = text.trim()
  if (shell.mode.searched !== t) {
    searchContacts(t, CONTACTS_MAX, onContacts)
  }
  return contactRows()
}

fn onContacts(r) {
  if (!modeIs('contacts') || r.query !== shell.query.trim()) {
    return
  }
  shell.mode.results = r.results
  shell.mode.searched = r.query
  shell.mode.error = r.error
  shell.apps = contactRows()
  compose()
  refresh()
}

fn allowContacts() {
  if (contactsAccess() !== 'notDetermined') {
    launch(CONTACTS_PRIVACY)
    hide()
    return
  }
  contactsRequest((granted) => {
    if (modeIs('contacts') || modeIs('settings')) {
      shell.hud = granted ? '' : "Moo can't read contacts"
      shell.apps = listResults(shell.query)
      compose()
      refresh()
    }
  })
}

// ── Settings: the menu bar icon's right-click menu and the Settings command open it ──

fn onStatusMenu(what) {
  if (what === 'settings') {
    openCommand(SETTINGS, '')
  }
}

fn commandAt(path) {
  for (let i = 0; i < commands.length; i = i + 1) {
    if (commands[i].path === path) {
      return commands[i]
    }
  }
  return null
}

fn contactsAccessLabel() {
  let a = contactsAccess()
  if (a === 'authorized' || a === 'limited') {
    return 'Allowed'
  }
  return a === 'notDetermined' ? 'Not asked yet' : 'Off'
}

// "dev · /Users/me/moo/app/dist/moo": which Moo this is, for bug reports.
fn aboutLine() {
  let me = about()
  return me.version + ' · ' + (me.app !== null ? me.app : me.exe)
}

fn settingsResults(text) {
  let t = text.trim().toLowerCase()
  let rows = [
    { name: 'Launcher Hotkey', kind: hotkeyLabel !== '' ? hotkeyLabel : 'None', icon: symbolIcon('keyboard'), act: 'launcher', group: 'General' },
    { name: 'Hotkeys and Aliases', kind: 'Every command', icon: symbolIcon('command'), act: 'hotkeys', group: 'General' },
    { name: 'Shortcuts', kind: config.shortcuts.length + (config.shortcuts.length === 1 ? ' shortcut' : ' shortcuts'), icon: symbolIcon('command.square'), act: 'shortcuts', group: 'General' },
    { name: 'Edit shortcuts.json', kind: '', icon: 'NSActionTemplate', act: 'edit', group: 'General' },
    { name: 'Pinned in Bar', kind: CATEGORIES.length + ' of ' + PIN_MAX, icon: symbolIcon('pin'), act: 'pins', group: 'General' },
    { name: 'Search Engine', kind: webEngine().name, icon: webIcon, act: 'engine', group: 'Search' },
    { name: 'Applications View', kind: appsView === 'grid' ? 'Grid' : 'List', icon: symbolIcon('square.grid.2x2'), act: 'appsview', group: 'Search' },
    { name: 'AI Model', kind: modelName(currentModel()), icon: aiIcon, act: 'ai-models', group: 'AI' },
    { name: 'Hypery Account', kind: hyperyLabel(), icon: HYPERY.icon, act: 'hypery', group: 'AI' },
    { name: 'Contacts Access', kind: contactsAccessLabel(), icon: contactIcon, act: 'contacts', group: 'Privacy' },
    { name: 'About Moo', kind: aboutLine(), icon: appIcon !== '' ? appIcon : symbolIcon('info.circle'), act: 'about', group: 'Moo' },
    { name: 'Quit Moo', kind: '', icon: quitIcon, act: 'quit', group: 'Moo' }
  ]
  return rows.filter((r) => t === '' || r.name.toLowerCase().indexOf(t) >= 0).map((r) => ({ name: r.name, kind: r.kind, icon: r.icon, act: r.act, group: r.group, mode: 'setting' }))
}

fn openSetting(r) {
  if (r.act === 'launcher') {
    enterSub({ name: 'Launcher Hotkey', mode: 'assign-hotkey', pluginTitle: 'Moo', icon: symbolIcon('keyboard'), row: null, launcher: true, keys: '', check: null, current: hotkey })
    recordHotkey(true)
  } else if (r.act === 'hotkeys') {
    openCommand(commandAt('moo:hotkeys'), '')
  } else if (r.act === 'shortcuts') {
    openCommand(commandAt('moo:shortcuts'), '')
  } else if (r.act === 'edit') {
    runBuiltin(commandAt('moo:edit-shortcuts'))
  } else if (r.act === 'pins') {
    enterSub({ name: 'Pinned in Bar', mode: 'pins', pluginTitle: 'Moo', icon: symbolIcon('pin') })
  } else if (r.act === 'engine') {
    openCommand(WEB, '')
  } else if (r.act === 'appsview') {
    appsView = appsView === 'grid' ? 'list' : 'grid'
    setPref('appsView', appsView)
    shell.apps = settingsResults(shell.query)
    compose()
    refresh()
  } else if (r.act === 'contacts') {
    allowContacts()
  } else if (r.act === 'ai-models') {
    enterSub(modelPicker(false))
  } else if (r.act === 'hypery') {
    enterSub({ name: HYPERY.name, mode: 'hypery', pluginTitle: 'Hypery', icon: HYPERY.icon })
  } else if (r.act === 'about') {
    copyText('Moo ' + aboutLine())
    shell.hud = 'Copied the version and path'
    refresh()
  } else if (r.act === 'quit') {
    quit()
  }
}

// One contact: Return emails or calls, ⌥↵ copies; the last row opens the card in Contacts.
fn contactFieldResults(text) {
  let c = shell.mode.contact
  let t = text.trim().toLowerCase()
  let rows = []
  for (let i = 0; i < c.emails.length; i = i + 1) {
    let e = c.emails[i]
    rows.push({ name: e.value, kind: e.label, icon: symbolIcon(THEME.icon.email), mode: 'contact-field', act: 'mail', value: e.value, group: 'Email' })
  }
  for (let i = 0; i < c.phones.length; i = i + 1) {
    let p = c.phones[i]
    rows.push({ name: p.value, kind: p.label, icon: symbolIcon(THEME.icon.phone), mode: 'contact-field', act: 'call', value: p.value, group: 'Phone' })
  }
  rows.push({ name: 'Open in Contacts', kind: '', icon: contactIcon, mode: 'contact-field', act: 'open', value: c.id, group: 'Contact' })
  return rows.filter((r) => t === '' || r.name.toLowerCase().indexOf(t) >= 0 || r.kind.toLowerCase().indexOf(t) >= 0)
}

fn contactField(r) {
  if (r.act === 'open') {
    launch('addressbook://' + r.value)
  } else if (r.act === 'mail') {
    launch('mailto:' + r.value)
  } else {
    launch('tel:' + r.value.split(' ').join(''))
  }
  hide()
  leaveToRoot()
}

fn contactLine(c) {
  let parts = [c.name]
  if (c.org !== '') {
    parts.push(c.org)
  }
  if (c.emails.length > 0) {
    parts.push(c.emails[0].value)
  }
  if (c.phones.length > 0) {
    parts.push(c.phones[0].value)
  }
  return parts.join('  ·  ') + '\n'
}

fn cliContacts(token, rest) {
  if (!contactsAllowed()) {
    cliFail(token, 'no access to contacts (' + contactsAccess() + '); open Search Contacts in Moo to allow it')
    return
  }
  searchContacts(rest.trim(), CONTACTS_MAX, (r) => {
    if (r.error !== '') {
      cliFail(token, r.error)
      return
    }
    cliOut(token, r.results.map(contactLine).join(''))
    cliEnd(token, r.results.length > 0 ? 0 : 1)
  })
}

// Senses the AI's define tool returns; enough for a short answer.
const AI_SENSES = 4

// Plain text for the AI and `moo define`: the word, pronunciation, up to `limit` senses (0: all)
// with examples, and the origin.
fn definitionText(word, limit) {
  let e = define(word)
  if (e === null) {
    return 'The dictionary has no entry for “' + word + '”.'
  }
  let out = e.word + (e.pronunciation !== '' ? '  |' + e.pronunciation + '|' : '') + '\n'
  let prev = ''
  let n = 0
  let shown = limit > 0 ? Math.min(limit, e.senses.length) : e.senses.length
  for (let i = 0; i < shown; i = i + 1) {
    let s = e.senses[i]
    let group = partTitle(s)
    if (group !== prev) {
      out = out + group.toLowerCase() + '\n'
      n = 0
    }
    prev = group
    n = n + 1
    out = out + '  ' + n + '. ' + s.definition + (s.example !== '' ? ' (“' + s.example + '”)' : '') + '\n'
  }
  if (shown < e.senses.length) {
    out = out + '  … ' + (e.senses.length - shown) + ' more senses\n'
  }
  return out + (e.origin !== '' ? 'origin: ' + e.origin + '\n' : '')
}

// Dictionary.app on the word, for phrases, derivatives and usage notes.
fn openInDictionary() {
  let e = shell.mode.entry
  let word = e !== null ? e.word : shell.query.trim()
  if (word === '') {
    return
  }
  launch(expandTemplate('dict://{query}', word, 'url'))
  hide()
  leaveList()
}

// Anything runnable by name: a shortcut keyword, a command id or name ("moo:clipboard",
// "plugin:convert/units", "Clipboard History"), or moo:show / moo:hide / moo:toggle.
// Returns "done", "pending" or an error message.
fn runTarget(id, query, cli) {
  let k = id.trim()
  if (k === 'moo:show' || k === 'show') {
    show()
    return 'done'
  }
  if (k === 'moo:hide' || k === 'hide') {
    hide()
    return 'done'
  }
  if (k === 'moo:toggle' || k === 'toggle') {
    toggle()
    return 'done'
  }
  if (k.indexOf('shortcut:') === 0) {
    k = k.slice(9)
  }
  let s = findShortcut(k)
  if (s !== null) {
    return runShortcut(s, query, cli)
  }
  let c = findCommand(k)
  if (c !== null) {
    recordUse(c.path)
    openCommand(c, query)
    return 'done'
  }
  if (k.indexOf('/') === 0) {
    if (!launch(k)) {
      return 'Could not open ' + k
    }
    recordUse(k)
    return 'done'
  }
  return 'No shortcut or command called “' + id + '” (moo list)'
}

// Commands scored like apps: nucleo match plus frecency boost. An empty query keeps only
// commands that have been used, scored by boost alone.
fn commandHits(text) {
  let hits = []
  if (text.trim() === '') {
    for (let i = 0; i < commands.length; i = i + 1) {
      let b = frecency(commands[i].path)
      if (b > 0 && pluginVisible(commands[i]) && !isDisabled(commands[i].path)) {
        hits.push({ index: i, score: b })
      }
    }
  } else {
    let raw = fuzzy(text, commandTitles, commands.length)
    for (let i = 0; i < raw.length; i = i + 1) {
      if (pluginVisible(commands[raw[i].index]) && !isDisabled(commands[raw[i].index].path)) {
        hits.push({ index: raw[i].index, score: raw[i].score + frecency(commands[raw[i].index].path) })
      }
    }
  }
  hits.sort((a, b) => b.score - a.score)
  return hits
}

// Apps and commands share one scale (match + frecency), so merge them by score.
// A typed shortcut keyword comes first: "g rust" → "Google: rust".
fn rootResults(text) {
  if (text.trim() === '') {
    return []
  }
  if (text.indexOf('/') === 0) {
    return filterResults(text.slice(1))
  }
  let apps = search(text, ROWS).filter((a) => !isDisabled(a.path))
  let hits = commandHits(text)
  let out = []
  // An inline answer comes first, as in Spotlight: "2^10", "5 km in mi", "time in tokyo".
  let answer = calculate(text)
  if (answer !== null) {
    out.push({ name: answer.display, path: 'moo:calc', icon: calcIcon, kind: answer.detail, mode: 'calc', copy: answer.copy, pluginTitle: 'Calculator' })
  }
  let vol = volumeRow(text)
  if (vol !== null) {
    out.push(vol)
  }
  let sc = shortcutMatch(text)
  let skip = ''
  let sub = sc === null ? subcommandMatch(text) : null
  if (sub !== null) {
    out = out.concat(subcommandRows(sub.command, sub.query).slice(0, ROWS - 2))
    skip = sub.command.path
  }
  if (sc !== null) {
    out.push(shortcutRow(sc.shortcut, sc.query))
    skip = 'shortcut:' + sc.shortcut.keyword
    if (sc.query !== '') {
      return out
    }
  } else if (sub === null) {
    let al = aliasMatch(text)
    if (al !== null) {
      out.push(al.row)
      skip = al.row.path
      if (al.row.mode === 'alias') {
        return out
      }
    }
  }
  let i = 0
  let j = 0
  while (out.length < ROWS && (i < hits.length || j < apps.length)) {
    if (j >= apps.length || (i < hits.length && hits[i].score >= apps[j].score)) {
      if (commands[hits[i].index].path !== skip) {
        out.push(commands[hits[i].index])
      }
      i = i + 1
    } else {
      if (apps[j].path !== skip) {
        out.push(apps[j])
      }
      j = j + 1
    }
  }
  // "define <word>" puts the definition first; a plain word adds it after the best matches.
  let asked = definePrefix(text)
  let word = asked !== '' ? asked : (answer === null && isWord(text.trim()) ? text.trim() : '')
  let def = word !== '' ? definitionRow(word, asked !== '') : null
  if (def !== null) {
    let at = asked !== '' ? 0 : Math.min(out.length, DEFINE_ROW_AT)
    out = out.slice(0, at).concat([def]).concat(out.slice(at)).slice(0, ROWS)
  }
  // Fallback when there is room, as in Raycast; tab asks from anywhere.
  if (out.length < ROWS && text.trim() !== '') {
    out.push({ name: 'Ask AI “' + text.trim() + '”', path: ASK_AI.path, icon: ASK_AI.icon, kind: aiTitle(), mode: 'ai', pluginTitle: aiTitle(), question: text })
  }
  if (out.length < ROWS && text.trim() !== '') {
    out.push(webSearchRow(text, ''))
  }
  return out
}

// "/" lists the categories; "/files report" opens Files searching "report".
fn filterResults(text) {
  let space = text.indexOf(' ')
  let word = (space >= 0 ? text.slice(0, space) : text).toLowerCase()
  let rest = space >= 0 ? text.slice(space + 1).trim() : ''
  let out = []
  let cats = builtinCategories()
  for (let i = 0; i < cats.length; i = i + 1) {
    let c = cats[i]
    if (word === '' || c.title.toLowerCase().indexOf(word) === 0) {
      out.push({ name: rest !== '' ? c.title + ': ' + rest : c.title, path: c.command.path, icon: c.command.icon, kind: 'Category', mode: 'filter', category: c, query: rest })
    }
  }
  return out
}

fn categoryIndex() {
  if (shell.mode === null) {
    return -1
  }
  for (let i = 0; i < CATEGORIES.length; i = i + 1) {
    if (CATEGORIES[i].command !== null && CATEGORIES[i].command.path === shell.mode.path) {
      return i
    }
  }
  return -1
}

// Pressing the open category's button (or key) again goes back to the bar. A pinned app or
// shortcut just runs.
fn openCategory(c, query) {
  if (c.command === null) {
    let err = runTarget(c.id, query, null)
    if (err !== 'done' && err !== 'pending') {
      shell.hud = err
      refresh()
    }
    return
  }
  if (shell.mode !== null && shell.mode.path === c.command.path) {
    leaveList()
    return
  }
  leaveToRoot()
  openCommand(c.command, '')
  if (query !== '' && shell.mode !== null) {
    setQuery(query)
  }
}

fn pinIds() {
  let saved = getPref('pinned')
  if (saved === '') {
    return DEFAULT_PINS.slice(0)
  }
  if (saved === 'none') {
    return []
  }
  return saved.split('|').filter((id) => id !== '')
}

fn savePins(ids) {
  setPref('pinned', ids.length === 0 ? 'none' : ids.slice(0, PIN_MAX).join('|'))
  CATEGORIES = loadPins()
}

// A bubble for `id` (what hotkeyTarget gives: a command id, shortcut keyword or app path), or null
// when nothing by that id exists (an uninstalled plugin or deleted app).
fn pinOf(id) {
  let title = ''
  let icon = ''
  let command = null
  let s = findShortcut(id)
  if (s !== null) {
    title = s.name
    icon = shortcutIcon(s)
  } else if (id.indexOf('/') === 0) {
    if (!fileExists(id)) {
      return null
    }
    let r = appRow(id)
    title = r.name
    icon = r.icon
  } else {
    command = findCommand(id)
    if (command === null) {
      return null
    }
    title = command.name
    icon = command.icon
  }
  let symbol = ''
  for (let i = 0; i < PIN_LOOKS.length; i = i + 1) {
    if (PIN_LOOKS[i][0] === id) {
      title = PIN_LOOKS[i][1]
      symbol = PIN_LOOKS[i][2]
    }
  }
  return { id: id, title: title, command: command, symbol: symbol, icon: icon, key: '' }
}

fn loadPins() {
  let ids = pinIds()
  let out = []
  for (let i = 0; i < ids.length && out.length < PIN_MAX; i = i + 1) {
    let p = pinOf(ids[i])
    if (p !== null) {
      p.key = '' + (out.length + 1)
      out.push(p)
    }
  }
  return out
}

fn isPinned(id) {
  return id !== '' && pinIds().indexOf(id) >= 0
}

// Moo's own four categories, whatever is pinned: "/" and `moo category` reach them by name.
fn builtinCategories() {
  return DEFAULT_PINS.map((id) => pinOf(id))
}

// Every app A–Z, as Spotlight's Applications view; typing ranks matches.
fn appResults(text) {
  if (text.trim() !== '') {
    return search(text, FILE_LIST_MAX).filter((a) => !isDisabled(a.path))
  }
  let all = search('', appCount()).filter((a) => !isDisabled(a.path))
  all.sort((a, b) => a.name.toLowerCase() < b.name.toLowerCase() ? -1 : (a.name.toLowerCase() > b.name.toLowerCase() ? 1 : 0))
  return all
}

// Every command and shortcut; with no text the most used first. Shortcut keywords are the quick keys.
fn actionResults(text) {
  let hits = []
  if (text.trim() === '') {
    for (let i = 0; i < commands.length; i = i + 1) {
      if (!isDisabled(commands[i].path)) {
        hits.push({ index: i, score: frecency(commands[i].path) })
      }
    }
    hits.sort((a, b) => b.score - a.score)
  } else {
    hits = commandHits(text)
  }
  let out = []
  for (let i = 0; i < hits.length; i = i + 1) {
    let c = commands[hits[i].index]
    if (c.mode !== 'apps' && c.mode !== 'actions') {
      out.push(c)
    }
  }
  return groupInOrder(out, (r) => r.mode === 'shortcut' ? 'Quick Keys' : 'Actions', 0, ['Quick Keys', 'Actions'])
}

fn historyResults(text) {
  let t = text.trim().toLowerCase()
  let matches = searchHistory(20).filter((q) => t === '' || q.toLowerCase().indexOf(t) >= 0)
  return matches.map((q) => ({ name: q, kind: '', icon: HISTORY.icon, query: q, action: null }))
}

fn openHistory() {
  if (searchHistory(1).length > 0) {
    enterList(HISTORY)
  }
}

// Spotlight's groups for a root search; the first result is the Top Hit.
fn rootGroup(r) {
  if (r.sub) {
    return r.sub
  }
  if (r.mode === 'filter') {
    return 'Filter Search'
  }
  if (r.mode === 'calc') {
    return 'Calculator'
  }
  if (r.mode === 'define') {
    return 'Definition'
  }
  if (r.mode === 'web-search') {
    return 'Search the Web'
  }
  if (r.mode === 'ai' && r.question !== '') {
    return 'Ask AI'
  }
  if (isFile(r)) {
    return 'Files'
  }
  return r.kind === 'Application' ? 'Applications' : 'Actions'
}

let ROOT_GROUPS = ['Filter Search', 'Calculator', 'Applications', 'Definition', 'Files', 'Actions', 'Ask AI', 'Search the Web']

// Keeps list[0..from) in place and gathers the rest by group: groups named in `ranked` first, in
// that order, then any others in order of first appearance.
fn groupInOrder(list, groupOf, from, ranked) {
  let out = list.slice(0, from)
  let order = ranked.slice(0)
  for (let i = from; i < list.length; i = i + 1) {
    let g = groupOf(list[i])
    if (order.indexOf(g) < 0) {
      order.push(g)
    }
  }
  for (let k = 0; k < order.length; k = k + 1) {
    for (let i = from; i < list.length; i = i + 1) {
      if (groupOf(list[i]) === order[k]) {
        out.push(list[i])
      }
    }
  }
  return out
}

fn groupAt(r, i) {
  if (shell.mode === null) {
    return i === 0 && !r.sub && r.mode !== 'filter' && r.mode !== 'calc' && r.mode !== 'define' ? 'Top Hit' : rootGroup(r)
  }
  if (modeIs('actions')) {
    return r.mode === 'shortcut' ? 'Quick Keys' : 'Actions'
  }
  if (inAi() && r.item) {
    return ai.itemsTitle
  }
  if (r.group) {
    return r.group
  }
  return sectionTitle()
}

fn clipboardResults(text) {
  return clipboardHistory(text, ROWS).map((c) => ({
    name: c.preview,
    kind: (c.app !== '' ? c.app + ' · ' : '') + c.ago,
    icon: c.icon !== '' ? c.icon : 'NSMultipleDocuments',
    action: { copy: c.text, close: true }
  }))
}

// ── Plugin views: the plugin's VM renders with Lattish (@moo/ui); the shell shows the
// committed tree and sends events back through the plugin's `dispatch` ──

fn viewNodes(n, tag, out) {
  if (n.tag === tag) {
    out.push(n)
  }
  for (let i = 0; i < n.children.length; i = i + 1) {
    viewNodes(n.children[i], tag, out)
  }
  return out
}

fn setViewTree(tree) {
  let lists = viewNodes(tree, 'list', [])
  shell.view.tree = tree
  shell.view.list = lists.length > 0 ? lists[0] : null
}

fn hasEvent(node, name) {
  return node !== null && node.events.indexOf(name) >= 0
}

fn viewDispatch(node, event, arg) {
  try {
    let r = shell.mode.plugin.dispatch(shell.view.id, node.id, event, arg)
    setViewTree(r.tree)
    return r.result
  } catch (e) {
    shell.hud = 'Plugin error: ' + e.message
    return null
  }
}

fn propText(node, key) {
  let v = node.props[key]
  return v ? String(v) : ''
}

// All items (the shell scrolls them); without onSearchTextChange the shell filters by title.
fn viewResults(text) {
  let list = shell.view.list
  if (list === null) {
    return []
  }
  let nodes = viewNodes(list, 'listitem', [])
  if (!hasEvent(list, 'onSearchTextChange') && text.trim() !== '') {
    let hits = fuzzy(text, nodes.map((n) => propText(n, 'title')), nodes.length)
    nodes = hits.map((x) => nodes[x.index])
  }
  if (nodes.length === 0) {
    let empty = viewNodes(list, 'listemptyview', [])
    if (empty.length > 0) {
      return [{ name: propText(empty[0], 'title'), kind: propText(empty[0], 'description'), icon: shell.mode.icon, action: null, node: null }]
    }
  }
  return nodes.map((n) => ({
    name: propText(n, 'title'),
    kind: propText(n, 'accessory') !== '' ? propText(n, 'accessory') : propText(n, 'subtitle'),
    icon: propText(n, 'icon') !== '' ? propText(n, 'icon') : shell.mode.icon,
    action: n.props.action ? n.props.action : null,
    node: n
  }))
}

fn enterView(c) {
  let b = pluginBlocker(c)
  if (b !== null) {
    perform(pluginAction(c, b.action))
    return
  }
  try {
    let r = c.plugin.open(c.command, c.args ? c.args : {})
    shell.view = { id: r.view, tree: null, list: null }
    setViewTree(r.tree)
  } catch (e) {
    shell.view = null
    shell.hud = 'Plugin error: ' + e.message
    refresh()
    return
  }
  enterList(c)
}

fn closeView() {
  if (shell.view === null) {
    return
  }
  try {
    shell.mode.plugin.close(shell.view.id)
  } catch (e) {
    console.log('moo: closing view failed: ' + e.message)
  }
  shell.view = null
}

// Enter on a view row: the item's onAction runs in the plugin and may return an action;
// otherwise its static `action` applies.
fn openViewRow(target) {
  let result = null
  if (target.node !== null && hasEvent(target.node, 'onAction')) {
    result = viewDispatch(target.node, 'onAction', null)
    shell.apps = viewResults(shell.query)
    compose()
  }
  let action = result !== null ? result : target.action
  if (action === null) {
    refresh()
  } else {
    perform(action)
  }
}

// ── Create Shortcut: kind → target → keyword → name → hotkey, all in the search field ──

let wiz = { step: 'kind', kind: 'url', target: '', keyword: '', name: '', hotkey: '', check: null, editing: '', original: '' }
let WIZ_STEPS = ['kind', 'target', 'keyword', 'name', 'hotkey']

fn startWizard(edit) {
  leaveToRoot()
  show()
  wiz = { step: 'kind', kind: 'url', target: '', keyword: '', name: '', hotkey: '', check: null, editing: '', original: '' }
  shell.mode = findCommand('moo:create-shortcut')
  if (edit !== null) {
    wiz.kind = wizKindOf(edit)
    wiz.target = edit.target
    wiz.keyword = edit.keyword
    wiz.name = edit.name
    wiz.hotkey = edit.hotkey
    wiz.editing = edit.keyword
    wiz.original = edit.hotkey
    wiz.step = 'target'
    setQuery(edit.target)
    return
  }
  setQuery('')
}

fn wizStepNumber() {
  return WIZ_STEPS.indexOf(wiz.step) + 1
}

// Prefill each step from what is known so far.
fn wizGo(step) {
  wiz.step = step
  recordHotkey(step === 'hotkey')
  if (step === 'target') {
    setQuery(wiz.target)
  } else if (step === 'keyword') {
    setQuery(wiz.keyword !== '' ? wiz.keyword : suggestKeyword())
  } else if (step === 'name') {
    setQuery(wiz.name !== '' ? wiz.name : suggestName())
  } else {
    setQuery('')
  }
}

fn wizBack() {
  let i = WIZ_STEPS.indexOf(wiz.step)
  if (i <= 0 || (wiz.editing !== '' && wiz.step === 'target')) {
    recordHotkey(false)
    leaveList()
    return
  }
  wizGo(WIZ_STEPS[i - 1])
}

fn hostOf(url) {
  let s = url.indexOf('://')
  let rest = s >= 0 ? url.slice(s + 3) : url
  let end = rest.indexOf('/')
  let host = end >= 0 ? rest.slice(0, end) : rest
  return host.indexOf('www.') === 0 ? host.slice(4) : host
}

fn lastPart(path) {
  let parts = path.split('/').filter((p) => p !== '')
  let last = parts.length > 0 ? parts[parts.length - 1] : path
  return last.indexOf('.app') === last.length - 4 && last.length > 4 ? last.slice(0, last.length - 4) : last
}

fn defaultName(kind, target, keyword) {
  if (kind === 'url') {
    let host = hostOf(target)
    let dot = host.indexOf('.')
    let base = dot > 0 ? host.slice(0, dot) : host
    return base === '' ? keyword : base[0].toUpperCase() + base.slice(1)
  }
  if (kind === 'open') {
    let last = lastPart(target)
    return last === '' || last === '~' ? keyword : last
  }
  if (kind === 'command') {
    let c = findCommand(target)
    return c !== null ? c.name : target
  }
  return keyword
}

fn suggestName() {
  return defaultName(wiz.kind, wiz.target, wiz.keyword)
}

fn suggestKeyword() {
  let n = suggestName().toLowerCase()
  let out = ''
  for (let i = 0; i < n.length && out.length < 4; i = i + 1) {
    if (n[i] !== ' ') {
      out = out + n[i]
    }
  }
  return out
}

fn wizRow(name, kind, icon, pick) {
  return { name: name, kind: kind, icon: icon, action: null, pick: pick }
}

fn wizardResults(text) {
  let info = kindInfo(wiz.kind)
  if (wiz.step === 'kind') {
    return KINDS.map((k) => wizRow(k.title, k.kind, k.icon, k.kind))
  }
  if (wiz.step === 'target') {
    if (wiz.kind === 'open') {
      let rows = []
      let t = text.trim()
      if (t === '') {
        return [wizRow('Type to find an app, file or folder', '', info.icon, null)]
      }
      if (t[0] === '/' || t[0] === '~') {
        rows.push(wizRow(t, 'this path', info.icon, t))
      }
      let apps = search(t, 4)
      for (let i = 0; i < apps.length; i = i + 1) {
        rows.push(wizRow(apps[i].name, 'Application', apps[i].icon, apps[i].path))
      }
      let f = findFiles(t, ROWS - rows.length, ROWS)
      for (let i = 0; i < f.results.length && rows.length < ROWS; i = i + 1) {
        rows.push(wizRow(f.results[i].name, f.results[i].detail, f.results[i].icon, f.results[i].path))
      }
      return rows
    }
    if (wiz.kind === 'command') {
      let rows = []
      let hits = text.trim() === '' ? commands.map((c, i) => ({ index: i })) : fuzzy(text, commandTitles, commands.length)
      for (let i = 0; i < hits.length && rows.length < ROWS; i = i + 1) {
        let c = commands[hits[i].index]
        if (c.mode !== 'shortcut' && c.mode !== 'create' && c.mode !== 'shortcuts') {
          rows.push(wizRow(c.name, c.path, c.icon, c.path))
        }
      }
      return rows
    }
    let prompt = { url: 'Type a URL such as https://www.google.com/search?q={query}', shell: 'Type a shell command such as open -a Terminal {query}', text: 'Type the text to copy', snippet: 'Type the text the keyword becomes' }
    let t = text.trim()
    return [wizRow(t === '' ? prompt[wiz.kind] : t, info.hint, info.icon, null)]
  }
  if (wiz.step === 'keyword') {
    let k = text.trim()
    if (k === '') {
      return [wizRow('Type the keyword you will type to run it', '', info.icon, null)]
    }
    let r = checkKeyword(k, wiz.editing)
    return [wizRow(k, r.ok ? 'free · type ' + k + (wiz.kind === 'snippet' ? ' in any app' : ' then text') : r.error, info.icon, null)]
  }
  if (wiz.step === 'name') {
    return [wizRow(text.trim() === '' ? 'Name it' : text.trim(), 'shown in results', info.icon, null)]
  }
  let rows = []
  if (wiz.hotkey === '') {
    rows.push(wizRow('Press a key combination for a global hotkey (optional)', '', symbolIcon('keyboard'), null))
  } else {
    let ok = wiz.check === null || wiz.check.ok
    rows.push(wizRow(hotkeyDisplay(wiz.hotkey), ok ? 'free' : wiz.check.error, symbolIcon('keyboard'), null))
  }
  rows.push(wizRow('Save “' + wiz.name + '” · keyword ' + wiz.keyword, kindInfo(wiz.kind).title, info.icon, null))
  return rows
}

fn wizNext() {
  let text = shell.query.trim()
  let row = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (wiz.step === 'kind') {
    if (row !== null && row.pick) {
      if (wiz.kind !== row.pick) {
        wiz.target = ''
      }
      wiz.kind = row.pick
      wizGo('target')
    }
  } else if (wiz.step === 'target') {
    let target = row !== null && row.pick ? row.pick : text
    if (target === '') {
      shell.hud = 'Type a target first'
      refresh()
      return
    }
    if (wiz.kind === 'url' && target.indexOf('://') < 0) {
      target = 'https://' + target
    }
    wiz.target = target
    wizGo('keyword')
  } else if (wiz.step === 'keyword') {
    let r = checkKeyword(text, wiz.editing)
    if (!r.ok) {
      shell.hud = r.error
      refresh()
      return
    }
    wiz.keyword = text
    wizGo('name')
  } else if (wiz.step === 'name') {
    wiz.name = text !== '' ? text : wiz.keyword
    wizGo('hotkey')
  } else {
    wizSave()
  }
}

// Keys pressed on the hotkey step (the panel records instead of typing).
fn wizRecord(spec) {
  if (spec === 'escape') {
    wizBack()
    return
  }
  if (spec === 'return') {
    wizSave()
    return
  }
  if (spec === 'delete') {
    wiz.hotkey = ''
    wiz.check = null
  } else {
    wiz.hotkey = spec
    let conflict = spec === wiz.original ? '' : hotkeyConflict(spec, '')
    wiz.check = spec === wiz.original ? null : (conflict !== '' ? { ok: false, error: conflict } : checkHotkey(spec))
  }
  setQuery('')
}

fn wizSave() {
  if (wiz.hotkey !== '' && wiz.check !== null && !wiz.check.ok) {
    shell.hud = wiz.check.error
    refresh()
    return
  }
  let snippet = wiz.kind === 'snippet'
  let r = saveShortcut({ keyword: wiz.keyword, name: wiz.name, kind: snippet ? 'text' : wiz.kind, target: wiz.target, hotkey: wiz.hotkey, expand: snippet }, wiz.editing)
  if (!r.ok) {
    shell.hud = r.error
    refresh()
    return
  }
  recordHotkey(false)
  reloadShortcuts()
  let keyword = wiz.keyword
  let s = findShortcut(keyword)
  leaveList()
  shell.hud = 'Saved “' + wiz.name + '”: type ' + keyword + (snippet ? ' in any app' : (s !== null && s.needsQuery ? ' and some text' : ''))
  refresh()
}

// ── Shortcuts list: run, edit (⌘↵), delete (⌘⌫ twice), plus hotkey bindings ──

let pendingDelete = ''

fn shortcutsResults(text) {
  let rows = [{ name: 'Create Shortcut…', kind: '', icon: symbolIcon('plus.square'), action: null, create: true }]
  let needle = text.trim().toLowerCase()
  for (let i = 0; i < config.shortcuts.length; i = i + 1) {
    let s = config.shortcuts[i]
    if (needle === '' || s.name.toLowerCase().indexOf(needle) >= 0 || s.keyword.toLowerCase().indexOf(needle) >= 0) {
      rows.push({ name: s.name, kind: s.keyword + ' · ' + wizKindOf(s) + (s.hotkey !== '' ? ' · ' + hotkeyDisplay(s.hotkey) : ''), icon: shortcutIcon(s), action: null, shortcut: s })
    }
  }
  for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
    let h = hotkeyStatus[i]
    let isShortcutKey = findShortcut(h.run) !== null && findShortcut(h.run).hotkey === h.keys
    if (!isShortcutKey && (needle === '' || h.run.toLowerCase().indexOf(needle) >= 0)) {
      rows.push({ name: h.display + '  →  ' + h.run, kind: h.error !== '' ? h.error : 'hotkey', icon: symbolIcon('keyboard'), action: null, binding: h })
    } else if (isShortcutKey && h.error !== '') {
      rows.push({ name: h.display + '  →  ' + h.run, kind: h.error, icon: symbolIcon('exclamationmark.triangle'), action: null, binding: h })
    }
  }
  if (config.error !== '') {
    rows.push({ name: 'shortcuts.json has an error', kind: config.error, icon: symbolIcon('exclamationmark.triangle'), action: null })
  }
  for (let i = 0; i < config.warnings.length; i = i + 1) {
    rows.push({ name: 'Skipped an entry in shortcuts.json', kind: config.warnings[i], icon: symbolIcon('exclamationmark.triangle'), action: null })
  }
  return rows
}

fn openShortcutsRow(row, key) {
  if (row.create) {
    startWizard(null)
    return
  }
  if (row.shortcut) {
    if (key === 'cmd+enter') {
      startWizard(row.shortcut)
    } else if (key === 'alt+enter') {
      copyText('moo run ' + row.shortcut.keyword)
      shell.hud = 'Copied “moo run ' + row.shortcut.keyword + '”'
      refresh()
    } else if (key === 'cmd+delete') {
      if (pendingDelete !== row.shortcut.keyword) {
        pendingDelete = row.shortcut.keyword
        shell.hud = 'Press ⌘⌫ again to delete “' + row.shortcut.name + '”'
        refresh()
        return
      }
      let r = removeShortcut(row.shortcut.keyword)
      reloadShortcuts()
      shell.hud = r.ok ? 'Deleted “' + row.shortcut.name + '”' : r.error
      setQuery(shell.query)
    } else {
      let res = runShortcut(row.shortcut, '', null)
      if (res !== 'done' && res !== 'pending') {
        shell.hud = res
        refresh()
      }
    }
    pendingDelete = ''
    return
  }
  if (row.binding && key === 'cmd+delete') {
    let r = unbindHotkey(row.binding.keys)
    reloadShortcuts()
    shell.hud = r.ok ? 'Removed hotkey ' + row.binding.display : r.error
    setQuery(shell.query)
  } else if (row.binding) {
    let res = runTarget(row.binding.run, row.binding.query, null)
    if (res !== 'done' && res !== 'pending') {
      shell.hud = res
      refresh()
    }
  }
}

// ── Hotkeys and Aliases: every command and app with its alias and hotkey, as in Raycast's
// Extensions settings. Return records a hotkey; ⌘K sets an alias, disables, resets ──

// The hotkey shortcuts.json gives `item` (a command, shortcut or app row), registered or not.
fn configHotkey(item) {
  if (item.mode === 'shortcut') {
    return item.shortcut.hotkey
  }
  let target = hotkeyTarget(item).toLowerCase()
  if (target === '') {
    return ''
  }
  for (let i = 0; i < config.hotkeys.length; i = i + 1) {
    if (config.hotkeys[i].run.toLowerCase() === target) {
      return config.hotkeys[i].keys
    }
  }
  return ''
}

fn hkItem(item, group) {
  let off = isDisabled(item.path)
  let keys = configHotkey(item)
  let label = keys !== '' ? hotkeyDisplay(keys) : ''
  let alias = item.mode === 'shortcut' ? item.shortcut.keyword : aliasOf(item.path)
  return { name: item.name, alias: alias, kind: off ? (label !== '' ? label + ' · Off' : 'Off') : label, icon: item.icon, mode: 'hk-row', hk: 'item', item: item, dim: off, group: group }
}

fn hotkeysResults(text) {
  let t = text.trim().toLowerCase()
  let rows = [{ name: 'Open Moo', alias: '', kind: hotkeyLabel, icon: settingsIcon, mode: 'hk-row', hk: 'launcher', group: 'Moo' }]
  for (let i = 0; i < PANEL_ACTIONS.length; i = i + 1) {
    let p = PANEL_ACTIONS[i]
    let k = panelKeys(p)
    rows.push({ name: p.name, alias: '', kind: k !== '' ? hotkeyDisplay(k) : '', icon: symbolIcon(p.symbol), mode: 'hk-row', hk: 'panel', panel: p, group: 'Panel Keys' })
  }
  for (let i = 0; i < commands.length; i = i + 1) {
    let c = commands[i]
    rows.push(hkItem(c, c.mode === 'shortcut' ? 'Shortcuts' : (c.pluginTitle ? c.pluginTitle : 'Moo')))
  }
  let apps = search('', appCount())
  apps.sort((a, b) => a.name.toLowerCase() < b.name.toLowerCase() ? -1 : (a.name.toLowerCase() > b.name.toLowerCase() ? 1 : 0))
  for (let i = 0; i < apps.length; i = i + 1) {
    rows.push(hkItem(apps[i], 'Applications'))
  }
  let shown = rows.filter((r) => t === '' || r.name.toLowerCase().indexOf(t) >= 0 || r.alias.toLowerCase().indexOf(t) >= 0 || r.group.toLowerCase().indexOf(t) >= 0)
  return groupInOrder(shown, (r) => r.group, 0, ['Moo', 'Panel Keys'])
}

// Record a hotkey for a row of the hotkeys list.
fn recordFor(r) {
  if (r.hk === 'launcher') {
    enterSub({ name: 'Launcher Hotkey', mode: 'assign-hotkey', pluginTitle: 'Moo', icon: symbolIcon('keyboard'), row: null, launcher: true, keys: '', check: null, current: hotkey })
  } else if (r.hk === 'panel') {
    enterSub({ name: 'Panel Key', mode: 'assign-hotkey', pluginTitle: r.panel.name, icon: r.icon, row: null, panel: r.panel, keys: '', check: null, current: panelKeys(r.panel) })
  } else {
    enterSub({ name: 'Assign Hotkey', mode: 'assign-hotkey', pluginTitle: r.name, icon: r.icon, row: r.item, keys: '', check: null, current: configHotkey(r.item) })
  }
  recordHotkey(true)
}

fn hkActions(r) {
  let list = [act('hk-record', r.kind === '' || r.kind === 'Off' ? 'Record Hotkey…' : 'Change Hotkey…', '↵', 'keyboard')]
  if (r.hk === 'panel') {
    if (panelKeys(r.panel) !== '') {
      list.push(act('hk-unbind', 'Remove Key', '', 'keyboard.badge.ellipsis'))
    }
    if (panelKeys(r.panel) !== r.panel.key) {
      list.push(act('hk-reset', 'Reset to ' + hotkeyDisplay(r.panel.key), '', 'arrow.uturn.backward'))
    }
    return list
  }
  if (r.hk !== 'item') {
    return list
  }
  if (configHotkey(r.item) !== '') {
    list.push(act('hk-unbind', 'Remove Hotkey', '', 'keyboard.badge.ellipsis'))
  }
  list.push(act('hk-alias', r.alias === '' ? 'Set Alias…' : 'Change Alias (' + r.alias + ')…', '', 'character.cursor.ibeam'))
  if (r.alias !== '' && r.item.mode !== 'shortcut') {
    list.push(act('hk-unalias', 'Remove Alias', '', 'xmark.circle'))
  }
  list.push(isDisabled(r.item.path) ? act('hk-enable', 'Enable', '', 'checkmark.circle') : act('hk-disable', 'Disable', '', 'nosign'))
  return list
}

fn hkAction(id, r) {
  if (id === 'hk-record') {
    recordFor(r)
  } else if (id === 'hk-unbind') {
    let err = r.hk === 'panel' ? savePanelKey(r.panel, 'none') : saveRowHotkey(r.item, '', configHotkey(r.item))
    finishSub(err !== '' ? err : 'Removed the hotkey of “' + r.name + '”')
  } else if (id === 'hk-reset') {
    let err = savePanelKey(r.panel, '')
    finishSub(err !== '' ? err : '“' + r.name + '” is ' + hotkeyDisplay(r.panel.key) + ' again')
  } else if (id === 'hk-alias') {
    enterSub({ name: 'Set Alias', mode: 'set-alias', pluginTitle: r.name, icon: r.icon, item: r.item })
    setQuery(r.alias)
  } else if (id === 'hk-unalias') {
    let res = setAlias(r.item.path, '')
    reloadShortcuts()
    finishSub(res.ok ? 'Removed the alias of “' + r.name + '”' : res.error)
  } else if (id === 'hk-disable' || id === 'hk-enable') {
    let res = setDisabled(r.item.path, id === 'hk-disable')
    reloadShortcuts()
    finishSub(!res.ok ? res.error : '“' + r.name + '” is ' + (id === 'hk-disable' ? 'hidden from search' : 'back in search'))
  }
}

// Set Alias: the field holds the alias; a shortcut's alias is its keyword.
fn aliasResults(text) {
  let item = shell.mode.item
  let a = text.trim()
  if (a === '') {
    return [{ name: 'Type an alias for “' + item.name + '”', kind: 'then Return', icon: symbolIcon('character.cursor.ibeam'), mode: 'alias-prompt' }]
  }
  let check = item.mode === 'shortcut' ? checkKeyword(a, item.shortcut.keyword) : checkAlias(a, item.path)
  return [{ name: '“' + a + '” opens “' + item.name + '”', kind: check.ok ? 'Return saves' : check.error, icon: symbolIcon(check.ok ? 'character.cursor.ibeam' : 'exclamationmark.triangle'), mode: 'alias-save', alias: a, ok: check.ok }]
}

fn saveAlias(row) {
  if (!row.ok) {
    return
  }
  let item = shell.mode.item
  let res = null
  if (item.mode === 'shortcut') {
    let s = item.shortcut
    res = saveShortcut({ keyword: row.alias, name: s.name, kind: s.kind, target: s.target, input: s.input, output: s.output, hotkey: s.hotkey, expand: s.expand }, s.keyword)
  } else {
    res = setAlias(item.path, row.alias)
  }
  reloadShortcuts()
  finishSub(res.ok ? 'Type “' + row.alias + '” to open “' + item.name + '”' : res.error)
}

fn listResults(text) {
  let m = shell.mode
  if (m.mode === 'apps') {
    return appResults(text)
  }
  if (m.mode === 'actions') {
    return actionResults(text)
  }
  if (m.mode === 'history') {
    return historyResults(text)
  }
  if (m.mode === 'clipboard') {
    return clipboardResults(text)
  }
  if (m.mode === 'running') {
    return runningResults(text)
  }
  if (m.mode === 'dictionary') {
    return dictionaryResults(text)
  }
  if (m.mode === 'web') {
    return webResults(text)
  }
  if (m.mode === 'contacts') {
    return contactsResults(text)
  }
  if (m.mode === 'contact-card') {
    return contactFieldResults(text)
  }
  if (m.mode === 'settings') {
    return settingsResults(text)
  }
  if (m.mode === 'ai-models') {
    return aiModelResults(text)
  }
  if (m.mode === 'pins') {
    return pinResults(text)
  }
  if (m.mode === 'hypery') {
    return hyperyResults(text)
  }
  if (m.mode === 'hypery-orgs') {
    return orgResults(text)
  }
  if (m.mode === 'ai-key') {
    return keyResults(text)
  }
  if (m.mode === 'rowactions') {
    return rowActionResults(text)
  }
  if (m.mode === 'assign-hotkey') {
    return assignHotkeyResults(text)
  }
  if (m.mode === 'create') {
    return wizardResults(text)
  }
  if (m.mode === 'shortcuts') {
    return shortcutsResults(text)
  }
  if (m.mode === 'hotkeys') {
    return hotkeysResults(text)
  }
  if (m.mode === 'set-alias') {
    return aliasResults(text)
  }
  if (m.mode === 'output') {
    return outputResults(text)
  }
  if (m.mode === 'files') {
    if (text.trim().length >= CONTENT_MIN_CHARS) {
      pending.contents = text
      searchContents(text, CONTENT_MAX, onContents)
    }
    return fileResults(text, FILE_LIST_MAX, 0)
  }
  if (m.mode === 'fileactions') {
    return fileActionResults(text)
  }
  if (m.mode === 'openwith') {
    return openWithResults(text)
  }
  if (m.mode === 'view') {
    if (hasEvent(shell.view.list, 'onSearchTextChange')) {
      viewDispatch(shell.view.list, 'onSearchTextChange', text)
    }
    return viewResults(text)
  }
  if (m.mode === 'args') {
    return argResults(text)
  }
  let b = pluginBlocker(m)
  if (b !== null) {
    return [blockerRow(m, b)]
  }
  try {
    let items = m.plugin.list(m.command, text, m.args ? m.args : {})
    return items.slice(0, ROWS).map((it) => ({ name: it.title, kind: it.subtitle ? it.subtitle : '', icon: pluginIcon(it.icon, m.icon), action: pluginAction(m, it.action) }))
  } catch (e) {
    shell.hud = 'Plugin error: ' + e.message
    return []
  }
}

fn isFile(r) {
  return r !== null && (r.kind === 'File' || r.kind === 'Folder')
}

// ── File actions: ⌘K lists them; ⌘Y Quick Look, ⌘O Open With, ⌘⌫ twice Move to Trash ──

let FILE_ACTIONS = [
  { act: 'open', name: 'Open', key: '↵', symbol: 'arrow.up.forward.app' },
  { act: 'reveal', name: 'Show in Finder', key: '⌘R', symbol: 'folder' },
  { act: 'look', name: 'Quick Look', key: '⌘Y', symbol: 'eye' },
  { act: 'openwith', name: 'Open With…', key: '⌘O', symbol: 'square.on.square' },
  { act: 'copypath', name: 'Copy Path', key: '⌥↵', symbol: 'doc.on.clipboard' },
  { act: 'copyname', name: 'Copy Name', key: '', symbol: 'textformat' },
  { act: 'trash', name: 'Move to Trash', key: '⌘⌫', symbol: 'trash' }
]
let FILE_KEYS = { 'cmd+y': 'look', 'cmd+o': 'openwith', 'cmd+r': 'reveal', 'cmd+delete': 'trash' }

// A list opened from another one (a file's actions, Open With); Escape goes back to it with the
// same rows and selection (searching again could return them in a different order).
fn enterSub(c) {
  c.back = { mode: shell.mode, query: shell.query, selected: shell.selected, offset: shell.offset, apps: shell.apps, files: shell.files, contents: shell.contents }
  shell.mode = c
  setQuery('')
}

fn leaveSub() {
  let b = shell.mode.back
  shell.mode = b.mode
  shell.query = b.query
  shell.apps = b.apps
  shell.files = b.files
  shell.contents = b.contents
  shell.hud = ''
  compose()
  shell.selected = Math.min(b.selected, Math.max(0, shell.results.length - 1))
  shell.offset = b.offset
  follow()
  refresh()
}

// The file a key acts on: the selected file row, or the file whose actions are listed.
fn fileTarget(row) {
  if (modeIs('fileactions') || modeIs('openwith')) {
    return shell.mode.file
  }
  return isFile(row) ? row : null
}

fn fileActionResults(text) {
  let t = text.trim().toLowerCase()
  let rows = []
  for (let i = 0; i < FILE_ACTIONS.length; i = i + 1) {
    let a = FILE_ACTIONS[i]
    if (t === '' || a.name.toLowerCase().indexOf(t) >= 0) {
      rows.push({ name: a.name, kind: currentKey(a.key), icon: symbolIcon(a.symbol), act: a.act, mode: 'fileaction' })
    }
  }
  return rows
}

fn openWithResults(text) {
  let t = text.trim().toLowerCase()
  return shell.mode.apps.filter((a) => t === '' || a.name.toLowerCase().indexOf(t) >= 0).map((a) => ({ name: a.name, kind: a.isDefault ? 'Default' : '', icon: a.icon, app: a.path, mode: 'openwith-app' }))
}

fn openWithApp(f, app) {
  let r = openWith(f.path, app)
  if (!r.ok) {
    shell.hud = r.error
    refresh()
    return
  }
  recordUse(f.path)
  hide()
  leaveToRoot()
}

fn fileAction(f, act) {
  if (act === 'open') {
    recordUse(f.path)
    launch(f.path)
    leaveToRoot()
  } else if (act === 'reveal') {
    recordUse(f.path)
    revealFile(f.path)
    leaveToRoot()
  } else if (act === 'look') {
    toggleQuickLook(f)
  } else if (act === 'openwith') {
    if (!modeIs('openwith')) {
      enterSub({ name: 'Open With', mode: 'openwith', pluginTitle: f.name, icon: f.icon, file: f, apps: appsFor(f.path) })
    }
  } else if (act === 'copypath' || act === 'copyname') {
    let text = act === 'copypath' ? f.path : f.name
    copyText(text)
    shell.hud = 'Copied ' + text
    refresh()
  } else if (act === 'trash') {
    trashFileRow(f)
  }
}

let trashing = { path: '', name: '', at: 0 }

fn trashingFile() {
  return trashing.path !== '' && Date.now() - trashing.at <= CONFIRM_MS ? trashing : null
}

fn dropPath(p) {
  shell.apps = shell.apps.filter((r) => r.path !== p)
  shell.files = shell.files.filter((r) => r.path !== p)
  shell.contents = shell.contents.filter((r) => r.path !== p)
  compose()
}

// The first press asks; a second press of the same file within CONFIRM_MS moves it.
fn trashFileRow(f) {
  let pending = trashingFile()
  if (pending === null || pending.path !== f.path) {
    trashing = { path: f.path, name: f.name, at: Date.now() }
    refresh()
    return
  }
  trashing = { path: '', name: '', at: 0 }
  let r = trashFile(f.path)
  if (!r.ok) {
    shell.hud = r.error
    refresh()
    return
  }
  if (shell.mode !== null && shell.mode.back) {
    leaveSub()
  }
  let dry = r.message.indexOf('dry run') === 0
  if (!dry) {
    dropPath(f.path)
  }
  shell.hud = dry ? r.message : 'Moved “' + f.name + '” to the Trash'
  refresh()
}

// The file in Quick Look follows the selection while the preview is open.
let lookingAt = ''

fn toggleQuickLook(f) {
  if (lookingAt === f.path && quickLookVisible()) {
    quickLook('')
    lookingAt = ''
    return
  }
  lookingAt = quickLook(f.path) ? f.path : ''
}

fn syncQuickLook() {
  if (lookingAt === '') {
    return
  }
  if (!quickLookVisible()) {
    lookingAt = ''
    return
  }
  let r = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  let f = fileTarget(r)
  if (f === null) {
    quickLook('')
    lookingAt = ''
  } else if (f.path !== lookingAt) {
    lookingAt = f.path
    quickLook(f.path)
  }
}

// ── Running Apps: ↵ switch, ⌘H hide or show, ⌘⌫ quit, ⌥↵ twice force quit ──

let QUIT_HIDE_MS = 5000
// pid → when it was asked to quit; hidden from the list for QUIT_HIDE_MS while it closes.
let quitting = {}
let forcing = { pid: 0, at: 0 }

fn runningResults(text) {
  let apps = runningApps()
  let order = []
  if (text.trim() === '') {
    for (let i = 0; i < apps.length; i = i + 1) {
      order.push(i)
    }
  } else {
    let names = []
    for (let i = 0; i < apps.length; i = i + 1) {
      names.push(apps[i].name)
    }
    let hits = fuzzy(text, names, apps.length)
    for (let i = 0; i < hits.length; i = i + 1) {
      order.push(hits[i].index)
    }
  }
  let rows = []
  for (let k = 0; k < order.length; k = k + 1) {
    let a = apps[order[k]]
    let asked = quitting['' + a.pid]
    if (asked === null || Date.now() - asked > QUIT_HIDE_MS) {
      let state = a.active ? ' · frontmost' : (a.hidden ? ' · hidden' : '')
      rows.push({ name: a.name, kind: a.memoryText + state, icon: a.icon, path: a.path, pid: a.pid, hidden: a.hidden, mode: 'running-app' })
    }
  }
  return rows
}

// An app verb picked in the root search ("kill cursor" ↵): no list to refresh, so say what
// happened and search again (the app may be gone from the list now).
fn rootAppAction(row, verb) {
  let r = appAction(row.pid, verb)
  if (verb === 'switch' && r.ok) {
    hide()
    setQuery('')
    return
  }
  if (r.ok && (verb === 'quit' || verb === 'force-quit')) {
    quitting['' + row.pid] = Date.now()
  }
  shell.hud = r.message
  setQuery(shell.query)
}

// Window and other verbs on a running app: window states through Accessibility, layouts after
// bringing the app forward (they act on the frontmost window), relaunch, reveal, copy path.
fn appVerb(row, verb) {
  if (verb === 'reveal') {
    revealFile(row.path)
    hide()
    return
  }
  if (verb === 'copy-path') {
    copyText(row.path)
    shell.hud = 'Copied ' + row.path
    refresh()
    return
  }
  if (verb === 'relaunch') {
    let r = appAction(row.pid, 'quit')
    if (!r.ok) {
      shell.hud = r.message
      refresh()
      return
    }
    quitting['' + row.pid] = Date.now()
    shell.hud = 'Relaunching ' + row.name + '…'
    refresh()
    relaunchWhenGone(row, 0)
    return
  }
  if (verb.indexOf('layout:') === 0) {
    appAction(row.pid, 'switch')
    hide()
    setQuery('')
    let layout = verb.slice(7)
    // The app needs a moment to become frontmost before its window can be moved.
    setTimeout(() => {
      let r = arrangeWindow(layout)
      if (!r.ok) {
        console.log('moo: ' + layout + ' ' + row.name + ': ' + r.message)
      }
    }, 250)
    return
  }
  let r = windowAction(row.pid, row.name, verb)
  shell.hud = r.message
  if (r.ok && verb !== 'minimize' && verb !== 'close') {
    appAction(row.pid, 'switch')
    hide()
    setQuery('')
    return
  }
  setQuery(shell.query)
}

// Opens the app again once its process has gone (checking every 250 ms, for up to 10 s).
fn relaunchWhenGone(row, tries) {
  setTimeout(() => {
    let alive = runningApps().some((a) => a.pid === row.pid)
    if (alive && tries < 40) {
      relaunchWhenGone(row, tries + 1)
      return
    }
    if (alive) {
      shell.hud = row.name + ' did not quit'
      refresh()
      return
    }
    launch(row.path)
  }, 250)
}

// The selected row while it waits for its second ⌥↵.
fn forcingRow() {
  let r = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (r === null || r.mode !== 'running-app' || r.pid !== forcing.pid || Date.now() - forcing.at > CONFIRM_MS) {
    return null
  }
  return r
}

fn runningAction(row, action) {
  if (action === 'force-quit' && forcingRow() === null) {
    forcing = { pid: row.pid, at: Date.now() }
    refresh()
    return
  }
  forcing = { pid: 0, at: 0 }
  let r = appAction(row.pid, action)
  if (action === 'switch' && r.ok) {
    hide()
    leaveList()
    return
  }
  if (r.ok && (action === 'quit' || action === 'force-quit')) {
    quitting['' + row.pid] = Date.now()
  }
  let sel = shell.selected
  shell.apps = listResults(shell.query)
  compose()
  shell.selected = Math.min(sel, Math.max(0, shell.results.length - 1))
  shell.hud = r.ok && action === 'quit' ? r.message + ' · ⌥↵ twice to force quit' : r.message
  refresh()
}

// ── ⌘K on any other row: what can be done with it, including Assign Hotkey for apps, commands and
// shortcuts. Rows that are files have their own list (FILE_ACTIONS) ──

// What a hotkey runs for row `r`: an app's path, a command id or a shortcut keyword; "" when the
// row cannot have one.
fn hotkeyTarget(r) {
  if (r.kind === 'Application') {
    return r.path
  }
  if (r.mode === 'shortcut') {
    return r.shortcut.keyword
  }
  return r.path && findCommand(r.path) !== null ? r.path : ''
}

// The keys bound to row `r` now, or "".
fn rowHotkey(r) {
  if (r.mode === 'shortcut') {
    return r.shortcut.hotkey
  }
  let target = hotkeyTarget(r).toLowerCase()
  for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
    if (!hotkeyStatus[i].shortcut && hotkeyStatus[i].run.toLowerCase() === target) {
      return hotkeyStatus[i].keys
    }
  }
  return ''
}

fn runningPid(path) {
  let apps = runningApps()
  for (let i = 0; i < apps.length; i = i + 1) {
    if (apps[i].path === path) {
      return apps[i].pid
    }
  }
  return 0
}

fn act(id, name, key, symbol) {
  return { act: id, name: name, key: key, symbol: symbol }
}

fn rowActions(r) {
  if (r.mode === 'hk-row') {
    return hkActions(r)
  }
  if (r.mode === 'pin-row') {
    let list = [act('pin-unpin', 'Unpin from Bar', '', 'pin.slash')]
    if (r.pinIndex > 0) {
      list.push(act('pin-left', 'Move Left', '', 'arrow.left'))
    }
    if (r.pinIndex < CATEGORIES.length - 1) {
      list.push(act('pin-right', 'Move Right', '', 'arrow.right'))
    }
    return list
  }
  let list = [act('open', primaryAction(r), '↵', 'arrow.up.forward.app')]
  if (r.mode === 'running-app') {
    list = [act('switch', 'Switch To', '↵', 'arrow.up.forward.app'), act(r.hidden ? 'unhide' : 'hide', r.hidden ? 'Show' : 'Hide', '⌘H', 'eye.slash'), act('quit', 'Quit', '⌘⌫', 'xmark.app'), act('force-quit', 'Force Quit', '⌥↵', 'exclamationmark.octagon')]
    return list
  }
  if (r.kind === 'Application') {
    list.push(act('reveal', 'Show in Finder', '⌘R', 'folder'))
    list.push(act('copypath', 'Copy Path', '', 'doc.on.clipboard'))
    list.push(act('copyname', 'Copy Name', '', 'textformat'))
  }
  if (r.mode === 'shortcut') {
    list.push(act('edit', 'Edit Shortcut…', '', 'pencil'))
  }
  if (hotkeyTarget(r) !== '') {
    let keys = rowHotkey(r)
    list.push(act('hotkey', keys === '' ? 'Assign Hotkey…' : 'Change Hotkey (' + hotkeyDisplay(keys) + ')…', '', 'keyboard'))
    if (keys !== '') {
      list.push(act('unbind', 'Remove Hotkey', '', 'keyboard.badge.ellipsis'))
    }
    if (r.kind !== 'Application') {
      list.push(act('copycli', 'Copy CLI Command', '', 'terminal'))
    }
    if (isPinned(hotkeyTarget(r))) {
      list.push(act('unpin', 'Unpin from Bar', '', 'pin.slash'))
    } else if (CATEGORIES.length < PIN_MAX) {
      list.push(act('pin', 'Pin to Bar', '', 'pin'))
    }
  }
  if (r.kind === 'Application' && runningPid(r.path) > 0) {
    list.push(act('quit-app', 'Quit ' + r.name, '', 'xmark.app'))
  }
  if (r.mode === 'shortcut') {
    list.push(act('delete', 'Delete Shortcut', '', 'trash'))
  }
  if (r.mode === 'calc') {
    list.push(act('copyline', 'Copy Sum and Answer', '', 'doc.on.clipboard'))
  }
  if (r.mode === 'define') {
    list.push(act('dictionary', 'Open in Dictionary', '', THEME.icon.dictionary))
  }
  if (r.mode === 'web-search') {
    list.push(act('copyquery', 'Copy Text', '', 'doc.on.clipboard'))
  }
  if (r.mode === 'contact') {
    list.push(act('card', 'Open in Contacts', '', THEME.icon.contact))
    list.push(act('copyname', 'Copy Name', '', 'textformat'))
    if (r.contact.emails.length > 0) {
      list.push(act('copyemail', 'Copy ' + r.contact.emails[0].value, '', THEME.icon.email))
    }
  }
  return list
}

// Settings → Pinned in Bar: the pinned items in order; ⌘K or Return moves or unpins one.
fn pinResults(text) {
  let t = text.trim().toLowerCase()
  let rows = []
  for (let i = 0; i < CATEGORIES.length; i = i + 1) {
    let c = CATEGORIES[i]
    if (t === '' || c.title.toLowerCase().indexOf(t) >= 0) {
      rows.push({ name: c.title, kind: '⌘' + c.key, icon: c.symbol !== '' ? symbolIcon(c.symbol) : c.icon, mode: 'pin-row', path: c.id, pinIndex: i, group: 'Pinned' })
    }
  }
  if (t === '') {
    rows.push({ name: 'Pin anything with ⌘K → Pin to Bar', kind: CATEGORIES.length + ' of ' + PIN_MAX, icon: symbolIcon('info.circle'), mode: 'pin-help', group: 'More' })
    rows.push({ name: 'Reset to Defaults', kind: 'Applications, Files, Actions, Clipboard', icon: symbolIcon('arrow.uturn.backward'), mode: 'pin-reset', group: 'More' })
  }
  return rows
}

fn pinAction(id, r) {
  let ids = CATEGORIES.map((c) => c.id)
  let i = r.pinIndex
  if (id === 'pin-unpin') {
    ids.splice(i, 1)
    savePins(ids)
    finishSub('Unpinned “' + r.name + '”')
    return
  }
  let j = id === 'pin-left' ? i - 1 : i + 1
  let moved = ids[i]
  ids[i] = ids[j]
  ids[j] = moved
  savePins(ids)
  finishSub('Moved “' + r.name + '” ' + (id === 'pin-left' ? 'left' : 'right'))
}

fn rowActionResults(text) {
  let t = text.trim().toLowerCase()
  return shell.mode.actions.filter((a) => t === '' || a.name.toLowerCase().indexOf(t) >= 0).map((a) => ({ name: a.name, kind: currentKey(a.key), icon: symbolIcon(a.symbol), act: a.act, mode: 'rowaction' }))
}

fn openRowActions(row) {
  enterSub({ name: 'Actions', mode: 'rowactions', pluginTitle: row.name, icon: row.icon, row: row, actions: rowActions(row), query: shell.query, deleting: false })
}

// Leave the actions list and say what happened.
fn actionDone(message) {
  leaveSub()
  shell.hud = message
  refresh()
}

fn copied(text) {
  copyText(text)
  actionDone('Copied ' + text)
}

fn rowAction(id) {
  let m = shell.mode
  let r = m.row
  if (id.indexOf('hk-') === 0) {
    hkAction(id, r)
    return
  }
  if (id.indexOf('pin-') === 0) {
    pinAction(id, r)
    return
  }
  if (id === 'pin' || id === 'unpin') {
    let target = hotkeyTarget(r)
    let ids = pinIds().filter((x) => x !== target)
    if (id === 'pin') {
      ids.push(target)
    }
    savePins(ids)
    actionDone(id === 'pin' ? 'Pinned “' + r.name + '” to the bar' : 'Unpinned “' + r.name + '”')
    return
  }
  if (id === 'open') {
    leaveSub()
    open(shell.selected)
  } else if (id === 'switch' || id === 'hide' || id === 'unhide' || id === 'quit' || id === 'force-quit') {
    leaveSub()
    runningAction(r, id)
  } else if (id === 'reveal') {
    recordUse(r.path)
    revealFile(r.path)
    leaveToRoot()
  } else if (id === 'copypath') {
    copied(r.path)
  } else if (id === 'copyname') {
    copied(r.name)
  } else if (id === 'copyemail') {
    copied(r.contact.emails[0].value)
  } else if (id === 'copyquery') {
    copied(r.query)
  } else if (id === 'copyline') {
    copied(m.query.trim() + ' = ' + r.copy)
  } else if (id === 'copycli') {
    copied('moo run ' + hotkeyTarget(r))
  } else if (id === 'edit') {
    startWizard(r.shortcut)
  } else if (id === 'delete') {
    if (!m.deleting) {
      m.deleting = true
      shell.hud = 'Press Return again to delete “' + r.shortcut.name + '”'
      refresh()
      return
    }
    let res = removeShortcut(r.shortcut.keyword)
    reloadShortcuts()
    leaveSub()
    shell.hud = res.ok ? 'Deleted “' + r.shortcut.name + '”' : res.error
    setQuery(shell.query)
  } else if (id === 'hotkey') {
    enterSub({ name: 'Assign Hotkey', mode: 'assign-hotkey', pluginTitle: r.name, icon: r.icon, row: r, keys: '', check: null, current: rowHotkey(r) })
    recordHotkey(true)
  } else if (id === 'unbind') {
    let res = saveRowHotkey(r, '', rowHotkey(r))
    actionDone(res !== '' ? res : 'Removed the hotkey of “' + r.name + '”')
  } else if (id === 'quit-app') {
    let res = appAction(runningPid(r.path), 'quit')
    actionDone(res.message)
  } else if (id === 'dictionary') {
    launch(expandTemplate('dict://{query}', r.word, 'url'))
    hide()
    leaveToRoot()
  } else if (id === 'card') {
    launch('addressbook://' + r.contact.id)
    hide()
    leaveToRoot()
  }
}

// Bind `keys` to row `r` in place of `current` ("" removes it). Returns an error, or "".
fn saveRowHotkey(r, keys, current) {
  let res = null
  if (r.mode === 'shortcut') {
    let s = r.shortcut
    res = saveShortcut({ keyword: s.keyword, name: s.name, kind: s.kind, target: s.target, hotkey: keys, expand: s.expand }, s.keyword)
  } else {
    if (current !== '') {
      res = unbindHotkey(current)
    }
    if (keys !== '') {
      res = bindHotkey(keys, hotkeyTarget(r), '')
    }
  }
  reloadShortcuts()
  return res !== null && !res.ok ? res.error : ''
}

fn assignLabel(m) {
  if (m.launcher) {
    return 'the Moo launcher'
  }
  if (m.panel) {
    return '“' + m.panel.name + '”'
  }
  return targetLabel(hotkeyTarget(m.row))
}

// A system shortcut (Spotlight's ⌘Space, say) owns the keys: only System Settings can free them.
fn systemConflict(m) {
  return m.check !== null && !m.check.ok && m.check.error.indexOf('is macOS') >= 0
}

fn assignHotkeyResults(text) {
  let m = shell.mode
  let label = assignLabel(m)
  if (m.keys === '') {
    let now = m.current === '' ? '' : 'now ' + hotkeyDisplay(m.current) + (m.launcher ? '' : ' · ⌫ removes it')
    return [{ name: 'Press the keys for ' + label, kind: now, icon: symbolIcon('keyboard'), mode: 'hotkey-prompt' }]
  }
  let ok = m.check === null || m.check.ok
  let rows = [{ name: hotkeyDisplay(m.keys) + '  →  ' + label, kind: ok ? 'free · Return saves' : m.check.error, icon: symbolIcon(ok ? 'keyboard' : 'exclamationmark.triangle'), mode: 'hotkey-prompt' }]
  if (systemConflict(m)) {
    rows.push({ name: 'Turn it off in System Settings › Keyboard › Keyboard Shortcuts, then press the keys again', kind: 'Return opens it', icon: symbolIcon('gear'), mode: 'hk-open-keyboard' })
  }
  return rows
}

fn openKeyboardSettings() {
  launch('x-apple.systempreferences:com.apple.Keyboard-Settings.extension')
}

// Switch the launcher to `keys` now and save it as "launcher" in shortcuts.json. The old hotkey
// stays registered until the new one is. Returns an error, or "".
fn changeLauncherHotkey(keys) {
  let r = registerHotkey(keys)
  if (!r.ok) {
    return r.error
  }
  if (hotkeyId > 0) {
    unregisterHotkey(hotkeyId)
  }
  hotkey = keys
  hotkeyId = r.id
  hotkeyLabel = r.display
  statusItem(hotkeyLabel, statusIcon, (what) => onStatusMenu(what))
  let saved = setLauncherHotkey(keys)
  reloadShortcuts()
  return saved.ok ? '' : hotkeyLabel + ' works until Moo quits; saving it failed: ' + saved.error
}

// Keys pressed while Assign Hotkey records.
fn assignRecord(spec) {
  let m = shell.mode
  if (spec === 'escape') {
    recordHotkey(false)
    leaveSub()
    return
  }
  if (spec === 'delete') {
    if (m.keys === '' && m.current !== '' && !m.launcher) {
      recordHotkey(false)
      let err = m.panel ? savePanelKey(m.panel, 'none') : saveRowHotkey(m.row, '', m.current)
      finishSub(err !== '' ? err : 'Removed the ' + (m.panel ? 'key of “' + m.panel.name : 'hotkey of “' + m.row.name) + '”')
      return
    }
    m.keys = ''
    m.check = null
  } else if (spec === 'return') {
    if (systemConflict(m)) {
      openKeyboardSettings()
      return
    }
    if (m.keys === '' || (m.check !== null && !m.check.ok)) {
      return
    }
    recordHotkey(false)
    if (m.launcher) {
      let failed = changeLauncherHotkey(m.keys)
      finishSub(failed !== '' ? failed : hotkeyLabel + ' now opens Moo')
      return
    }
    if (m.panel) {
      let failedKey = savePanelKey(m.panel, m.keys)
      finishSub(failedKey !== '' ? failedKey : hotkeyDisplay(m.keys) + ' is now “' + m.panel.name + '”')
      return
    }
    let err = saveRowHotkey(m.row, m.keys, m.current)
    finishSub(err !== '' ? err : hotkeyDisplay(m.keys) + ' now opens ' + targetLabel(hotkeyTarget(m.row)))
    return
  } else {
    m.keys = spec
    if (m.current !== '' && hotkeyDisplay(spec) === hotkeyDisplay(m.current)) {
      m.check = null
    } else if (m.panel) {
      let taken = panelKeyConflict(spec, m.panel)
      m.check = taken !== '' ? { ok: false, error: taken } : null
    } else {
      let conflict = hotkeyConflict(spec, m.current)
      m.check = conflict !== '' ? { ok: false, error: conflict } : checkHotkey(spec)
    }
  }
  setQuery('')
}

// Save panel action `p`'s keys ("none" for none, "" for the default). Returns an error, or "".
fn savePanelKey(p, keys) {
  let r = setPanelKey(p.action, keys === p.key ? '' : keys)
  reloadShortcuts()
  return r.ok ? '' : r.error
}

// Back from a step opened over the hotkeys list or Settings (through Actions, maybe), with that
// list read again so it shows the change.
fn finishSub(msg) {
  leaveSub()
  if (modeIs('rowactions')) {
    leaveSub()
  }
  if (modeIs('hotkeys') || modeIs('settings') || modeIs('pins')) {
    shell.apps = listResults(shell.query)
    compose()
  }
  shell.hud = msg
  refresh()
}

// The text of each asynchronous search still out (files, contents, web), "" when none.
let pending = { files: '', contents: '', web: '' }
// The file verb typed at root ("trash old.zip" → { query: "old.zip", command }), or null.
let fileVerb = null

// Files found for a file verb, marked so they group under it and Return does the verb.
fn fileVerbRows(files) {
  return files.map((f) => {
    f.sub = fileVerb.command.name
    f.fileAct = fileVerb.command.fileAct
    return f
  })
}

// Something is on its way: the header shows a spinner in place of the search icon.
fn busy() {
  if ((inAi() && ai.request !== 0) || aiCatalog.loading || hyperyState.loading || hyperyState.signingIn) {
    return true
  }
  let q = shell.query
  return (pending.files !== '' && pending.files === q) || (pending.contents !== '' && pending.contents === q) || (modeIs('web') && pending.web !== '' && pending.web === q.trim())
}

// The file index answers synchronously; while it builds (or is busy applying changes), Spotlight
// answers asynchronously through onFiles. An empty query in Search Files lists recent files.
fn fileResults(text, limit, icons) {
  shell.fileMs = -1
  if (text.trim() === '') {
    return shell.mode !== null && shell.mode.mode === 'files' ? recentFiles(limit) : []
  }
  let f = findFiles(text, limit, icons)
  if (f.ready) {
    shell.fileMs = f.ms
    return f.results
  }
  pending.files = text
  searchFiles(text, limit, onFiles)
  return []
}

fn inFiles() {
  return shell.mode !== null && shell.mode.mode === 'files'
}

// Synchronous rows first; once files arrive they get at least FILE_ROWS_WITH_APPS rows. At root the
// best match stays first (Top Hit) and the rest are gathered by group.
fn compose() {
  if (shell.mode === null) {
    let keepApps = shell.files.length > 0 ? ROWS - Math.min(shell.files.length, FILE_ROWS_WITH_APPS) : ROWS
    let merged = shell.files.length > 0 && shell.files[0].sub ? shell.files.concat(shell.apps).slice(0, ROWS) : shell.apps.slice(0, keepApps).concat(shell.files).slice(0, ROWS)
    let lead = merged.length > 0 && merged[0].sub ? [merged[0].sub] : []
    shell.results = groupInOrder(merged, rootGroup, merged.length > 0 && merged[0].mode !== 'filter' && !merged[0].sub ? 1 : 0, lead.concat(ROOT_GROUPS))
  } else if (inFiles()) {
    let named = shell.apps.concat(shell.files)
    let seen = {}
    for (let i = 0; i < named.length; i = i + 1) {
      seen[named[i].path] = true
    }
    shell.results = named.concat(shell.contents.filter((r) => seen[r.path] !== true))
  } else {
    shell.results = shell.apps
  }
  let groups = []
  for (let i = 0; i < shell.results.length; i = i + 1) {
    groups.push(groupAt(shell.results[i], i))
  }
  shell.groups = groups
  if (shell.selected >= shell.results.length) {
    shell.selected = 0
  }
  follow()
}

fn wideRows() {
  return inAi() || modeIs('output') || modeIs('dictionary')
}

// The list from result `offset` on: a heading wherever the group changes (and above the first
// row), then rows, while they fit in LIST_H. Returns { slots: [{ kind, index, title, height }], used }.
fn layoutSlots(offset) {
  let wide = wideRows()
  let budget = LIST_H
  let slots = []
  let used = 0
  let prev = ''
  let full = false
  for (let i = offset; i < shell.results.length && !full; i = i + 1) {
    let g = i < shell.groups.length ? shell.groups[i] : ''
    let head = g !== '' && (i === offset || g !== prev)
    let rowH = wide && !shell.results[i].item ? LINE_H : ROW_H
    let need = rowH + (head ? SECTION_H : 0)
    if (used + need > budget) {
      full = true
    } else {
      if (head) {
        slots.push({ kind: 'header', index: -1, title: g, height: SECTION_H })
      }
      slots.push({ kind: 'row', index: i, title: '', height: rowH })
      used = used + need
      prev = g
    }
  }
  return { slots: slots, used: used }
}

fn lastVisible(offset) {
  let slots = layoutSlots(offset).slots
  return slots.length > 0 ? slots[slots.length - 1].index : offset - 1
}

// Keep the selected row inside the visible window. In the grid `offset` is the first icon of the
// top visible row.
fn follow() {
  if (isGrid()) {
    let row = Math.floor(shell.selected / GRID_COLS)
    let top = Math.floor(shell.offset / GRID_COLS)
    if (row < top) {
      top = row
    } else if (row >= top + GRID_ROWS) {
      top = row - GRID_ROWS + 1
    }
    shell.offset = top * GRID_COLS
    return
  }
  shell.offset = Math.max(0, Math.min(shell.offset, shell.results.length - 1))
  if (shell.selected < shell.offset) {
    shell.offset = shell.selected
  }
  while (shell.offset < shell.selected && lastVisible(shell.offset) < shell.selected) {
    shell.offset = shell.offset + 1
  }
}

fn clampTo(n, lo, hi) {
  return Math.max(lo, Math.min(n, hi))
}

// Where the view is, in rows: grid rows in the grid, answer lines (or tool results once the
// answer fits) in Ask AI, results elsewhere. { total, first, shown }; `lay` is the list's layout.
fn scrollState(lay) {
  if (isGrid()) {
    return { total: Math.ceil(shell.results.length / GRID_COLS), first: Math.floor(shell.offset / GRID_COLS), shown: GRID_ROWS }
  }
  if (inAi()) {
    let a = aiLayout()
    if (a.lines.length > a.shown) {
      return { total: a.lines.length, first: ai.scroll, shown: a.shown }
    }
    return { total: ai.items.length, first: ai.itemOff, shown: a.room }
  }
  let shown = 0
  for (let i = 0; i < lay.slots.length; i = i + 1) {
    if (lay.slots[i].kind === 'row') {
      shown = shown + 1
    }
  }
  return { total: shell.results.length, first: shell.offset, shown: shown }
}

// The first result that still fills the list to its last row.
fn lastOffset() {
  let end = shell.results.length - 1
  let o = Math.max(0, end)
  while (o > 0 && lastVisible(o - 1) === end) {
    o = o - 1
  }
  return o
}

// Trackpad, mouse wheel and scroll bar clicks: move the view `n` rows (negative: up). The
// selection stays on screen, moving with the edge it would leave by.
fn scrollBy(n) {
  if (isCompact() || n === 0) {
    return
  }
  if (inAi()) {
    let a = aiLayout()
    if (a.lines.length > a.shown) {
      ai.scroll = clampTo(ai.scroll + n, 0, a.lines.length - a.shown)
    } else if (ai.items.length > a.room) {
      ai.itemOff = clampTo(ai.itemOff + n, 0, ai.items.length - a.room)
      if (ai.pick >= 0) {
        ai.pick = clampTo(ai.pick, ai.itemOff, ai.itemOff + a.room - 1)
      }
    }
    showAi()
    return
  }
  if (isGrid()) {
    let rows = Math.ceil(shell.results.length / GRID_COLS)
    let top = clampTo(Math.floor(shell.offset / GRID_COLS) + n, 0, Math.max(0, rows - GRID_ROWS))
    shell.offset = top * GRID_COLS
    let col = shell.selected % GRID_COLS
    let row = clampTo(Math.floor(shell.selected / GRID_COLS), top, top + GRID_ROWS - 1)
    shell.selected = Math.min(row * GRID_COLS + col, shell.results.length - 1)
  } else {
    shell.offset = clampTo(shell.offset + n, 0, lastOffset())
    shell.selected = clampTo(shell.selected, shell.offset, lastVisible(shell.offset))
  }
  refresh()
}

// A thin bar at the right of the list: the thumb is the share of the rows on screen, placed where
// they are. Clicking above or below the thumb pages. Clear when everything fits.
fn ScrollBar(props) {
  let S = THEME.scrollbar
  let s = props.scroll
  let track = props.height - 2 * S.inset
  let on = s.shown > 0 && s.total > s.shown
  let thumb = on ? clampTo(Math.round(track * s.shown / s.total), S.minThumb, track) : 1
  let top = on ? Math.round((track - thumb) * Math.min(1, s.first / (s.total - s.shown))) : 0
  let page = Math.max(1, s.shown - 1)
  return (
    <div paddingLeft={S.gap}
      ><row height={S.inset + top} onClick={() => scrollBy(-page)} backgroundColor={CLEAR}
      /><row height={thumb} onClick={() => scrollBy(0)} borderRadius={S.width / 2} backgroundColor={on ? C.scrollThumb : CLEAR} hoverBackgroundColor={on ? C.scrollThumbHover : CLEAR}
      /><row height={Math.max(1, track - top - thumb) + S.inset} onClick={() => scrollBy(page)} backgroundColor={CLEAR} /></div>
  )
}

fn onFiles(r) {
  if (r.query === pending.files) {
    pending.files = ''
    refresh()
  }
  if (shell.mode === null && fileVerb !== null && r.query === fileVerb.query) {
    shell.files = fileVerbRows(r.results)
    compose()
    refresh()
    return
  }
  if ((shell.mode !== null && !inFiles()) || r.query !== shell.query) {
    return
  }
  shell.files = r.results
  compose()
  refresh()
}

// Files whose text matches, under the name matches in Search Files.
let CONTENT_MIN_CHARS = 3
let CONTENT_MAX = 8

fn onContents(r) {
  if (r.query === pending.contents) {
    pending.contents = ''
    refresh()
  }
  if (!inFiles() || r.query !== shell.query) {
    return
  }
  shell.contents = r.results.map((f) => {
    f.group = 'Contents'
    return f
  })
  compose()
  refresh()
}

// ── Ask AI: one session per visit, so follow-up questions keep context ──
// items: rows from the last tool call, shown under the answer; pick: the selected one (-1: none,
// arrows scroll the answer); itemOff: the first one showing.
// model: what this visit asks ("apple" or provider:model). With a remote model, messages is the
// conversation so far, turnStart where the current question's messages begin and turnId its turn.
fn freshAi() {
  return { session: 0, request: 0, question: '', answer: '', error: '', scroll: 0, t0: 0, ms: 0, stopped: false, items: [], itemsTitle: '', pick: -1, itemOff: 0, model: '', messages: [], turnStart: 0, turnId: 0, gate: null, activity: '', retried: false }
}

let ai = freshAi()

// ── AI models: Apple's on-device model, Hypery (one account for Claude, Grok, Gemini, GPT and
// hundreds more), OpenAI, and local Ollama and LM Studio servers. The choice is ai.model in
// shortcuts.json; without one, Hypery once it has a key or sign-in, else Apple's. ──

let APPLE_MODEL = 'apple'
let HYPERY_MODEL = 'hypery:~anthropic/claude-sonnet-latest'
let HYPERY_SITE = 'https://hypery.ai'

// hypery.ai's own logo (its favicon, cached on disk) on the Hypery rows; the account symbol until
// it has loaded.
let hyperyLogo = siteIcon(HYPERY_SITE, (name) => {
  hyperyLogo = name
  HYPERY.icon = name
  relist()
})
if (hyperyLogo !== '') {
  HYPERY.icon = hyperyLogo
}

fn hyperyIcon(symbol) {
  return hyperyLogo !== '' ? hyperyLogo : symbolIcon(symbol)
}
// Tool rounds a remote model may take before it has to answer.
let AI_ROUNDS = 6
let CATALOG_MS = 600000
let ACCOUNT_MS = 60000
let MODEL_ROWS = 120
let OWNERS = [['anthropic', 'Anthropic'], ['google', 'Google'], ['openai', 'OpenAI'], ['x-ai', 'xAI'], ['spacexai', 'xAI'], ['meta-llama', 'Meta'], ['meta', 'Meta'], ['mistralai', 'Mistral'], ['mistral', 'Mistral'], ['deepseek', 'DeepSeek'], ['deepseek-ai', 'DeepSeek'], ['qwen', 'Qwen'], ['moonshotai', 'Moonshot'], ['z-ai', 'Z.ai'], ['zai', 'Z.ai'], ['amazon', 'Amazon'], ['nvidia', 'NVIDIA'], ['minimax', 'MiniMax'], ['alibaba', 'Alibaba'], ['microsoft', 'Microsoft'], ['cohere', 'Cohere'], ['perplexity', 'Perplexity']]
// models: [{ model, name, owner, tier, context, provider, providerTitle }] from the last aiModels.
let aiCatalog = { models: [], errors: [], loading: false, at: 0 }
let hyperyState = { account: null, loading: false, again: false, at: 0, signingIn: false }
let aiProvs = aiProviders()
let turnCount = 0
let keyEntry = ''

fn refreshProviders() {
  aiProvs = aiProviders()
  ASK_AI.kind = aiTitle()
  ASK_AI.pluginTitle = ASK_AI.kind
}

fn providerInfo(id) {
  for (let i = 0; i < aiProvs.length; i = i + 1) {
    if (aiProvs[i].id === id) {
      return aiProvs[i]
    }
  }
  return null
}

fn hyperyCredential() {
  let p = providerInfo('hypery')
  return p !== null ? p.credential : ''
}

fn currentModel() {
  if (config.aiModel) {
    return config.aiModel
  }
  return hyperyCredential() !== '' || !HAS_ON_DEVICE_AI ? HYPERY_MODEL : APPLE_MODEL
}

fn isRemote(model) {
  return model !== APPLE_MODEL && model !== ''
}

fn modelProvider(model) {
  let i = model.indexOf(':')
  return i > 0 ? model.slice(0, i) : model
}

fn catalogEntry(model) {
  for (let i = 0; i < aiCatalog.models.length; i = i + 1) {
    if (aiCatalog.models[i].model === model) {
      return aiCatalog.models[i]
    }
  }
  return null
}

// "hypery:~anthropic/claude-sonnet-latest": "Claude Sonnet Latest" from the catalog, else the id's
// last part.
fn modelName(model) {
  if (!isRemote(model)) {
    return AI_TITLE
  }
  let e = catalogEntry(model)
  if (e !== null) {
    return e.name
  }
  let parts = model.slice(model.indexOf(':') + 1).split('/')
  let last = parts[parts.length - 1]
  return last.indexOf('~') === 0 ? last.slice(1) : last
}

fn providerTitle(id) {
  let p = providerInfo(id)
  return p !== null ? p.title : id
}

fn aiTitle() {
  return modelName(ai.model !== '' ? ai.model : currentModel())
}

fn aiWhere() {
  let m = ai.model !== '' ? ai.model : currentModel()
  return isRemote(m) ? 'via ' + providerTitle(modelProvider(m)) : 'on-device'
}

fn ownerLabel(owner) {
  let o = owner.toLowerCase()
  for (let i = 0; i < OWNERS.length; i = i + 1) {
    if (OWNERS[i][0] === o) {
      return OWNERS[i][1]
    }
  }
  return owner === '' ? '' : owner[0].toUpperCase() + owner.slice(1)
}

// Set this visit's model; Apple's needs a session (and can be unavailable).
fn beginAi() {
  ai.model = currentModel()
  if (isRemote(ai.model)) {
    loadCatalog(false)
    return true
  }
  let why = aiAvailability()
  if (why !== 'available') {
    ai.error = AI_TITLE + ' is unavailable: ' + why
    aiFix('Choose Another Model', 'Hypery and other providers work everywhere', aiIcon, 'models')
    return false
  }
  ai.session = aiSession(AI_INSTRUCTIONS, aiTools(), onAiTool)
  return true
}

// Lists the models of every provider, at most every CATALOG_MS unless forced.
fn loadCatalog(force) {
  if (aiCatalog.loading || (!force && aiCatalog.at > 0 && Date.now() - aiCatalog.at < CATALOG_MS)) {
    return
  }
  aiCatalog.loading = true
  aiModels((lists) => onCatalog(lists))
}

fn onCatalog(lists) {
  aiCatalog.models = catalogModels(lists)
  aiCatalog.errors = lists.filter((l) => l.error !== '' && l.error !== 'not running' && l.error !== 'no API key').map((l) => l.title + ': ' + l.error)
  aiCatalog.loading = false
  aiCatalog.at = Date.now()
  refreshProviders()
  if (modeIs('ai-models') || modeIs('settings') || modeIs('hypery')) {
    relist()
  } else if (inAi()) {
    showAi()
  }
}

fn catalogModels(lists) {
  let out = []
  for (let i = 0; i < lists.length; i = i + 1) {
    let l = lists[i]
    for (let j = 0; j < l.models.length; j = j + 1) {
      let m = l.models[j]
      out.push({ model: l.provider + ':' + m.id, name: m.name, owner: m.owner, tier: m.tier, context: m.context, provider: l.provider, providerTitle: l.title })
    }
  }
  return out
}

// Rebuild the open list in place, keeping the selection and any message.
fn relist() {
  let hud = shell.hud
  let sel = shell.selected
  shell.apps = listResults(shell.query)
  compose()
  shell.selected = Math.min(sel, Math.max(0, shell.results.length - 1))
  shell.hud = hud
  refresh()
}

// fromAi: opened with ⌘K from Ask AI, which it returns to.
fn modelPicker(fromAi) {
  return { name: AI_MODELS.name, mode: 'ai-models', pluginTitle: 'AI', icon: aiIcon, fromAi: fromAi }
}

fn modelRow(e, current, group) {
  let bits = [current === e.model ? 'Current' : '', e.provider === 'hypery' ? ownerLabel(e.owner) : e.providerTitle, e.tier, e.context > 0 ? shortCount(e.context) : '']
  return { name: e.name, kind: bits.filter((b) => b !== '').join(' · '), icon: e.provider === 'hypery' ? hyperyIcon(THEME.icon.ai) : aiIcon, mode: 'ai-model', model: e.model, group: group }
}

fn infoRow(name, group) {
  return { name: name, kind: '', icon: symbolIcon(THEME.icon.warning), mode: 'ai-info', group: group, dim: true }
}

// Hypery's "latest" aliases first (they follow each family's newest model), then Apple's and local
// models, then Hypery's catalog by popularity. Typing searches every model by name, id and maker.
fn aiModelResults(text) {
  loadCatalog(false)
  let current = currentModel()
  let t = text.trim().toLowerCase()
  let ms = aiCatalog.models
  let apple = { name: AI_TITLE, kind: (current === APPLE_MODEL ? 'Current · ' : '') + 'On-device · Free', icon: aiIcon, mode: 'ai-model', model: APPLE_MODEL, group: 'On This Mac' }
  if (t !== '') {
    let rows = HAS_ON_DEVICE_AI && (AI_TITLE + ' apple on-device').toLowerCase().indexOf(t) >= 0 ? [apple] : []
    let hits = fuzzy(t, ms.map((e) => e.name + ' ' + e.model + ' ' + ownerLabel(e.owner)), MODEL_ROWS)
    return rows.concat(hits.map((h) => modelRow(ms[h.index], current, 'Models')))
  }
  let hy = ms.filter((e) => e.provider === 'hypery')
  let latest = hy.filter((e) => e.model.indexOf('hypery:~') === 0).map((e) => modelRow(e, current, 'Hypery · Latest'))
  let local = ms.filter((e) => e.provider !== 'hypery').map((e) => modelRow(e, current, e.providerTitle))
  let rest = hy.filter((e) => e.model.indexOf('hypery:~') !== 0).slice(0, MODEL_ROWS).map((e) => modelRow(e, current, 'Hypery · Popular'))
  let rows = latest.concat(HAS_ON_DEVICE_AI ? [apple] : []).concat(local).concat(rest)
  if (aiCatalog.loading && ms.length === 0) {
    rows.push(infoRow('Loading models…', 'Hypery'))
  }
  return rows.concat(aiCatalog.errors.map((e) => infoRow(e, 'Unavailable')))
}

fn chooseModel(model) {
  let r = aiSetModel(model)
  if (!r.ok) {
    shell.hud = 'Could not save the model: ' + r.error
    refresh()
    return
  }
  config.aiModel = model
  refreshProviders()
  let msg = 'Ask AI uses ' + modelName(model)
  if (modelProvider(model) === 'hypery' && hyperyCredential() === '') {
    msg = msg + '; sign in to Hypery to use it'
  }
  if (shell.mode.fromAi) {
    let keep = isRemote(ai.model) && isRemote(model) && ai.request === 0
    let saved = { question: ai.question, answer: ai.answer, messages: ai.messages }
    leaveSub()
    resetAi()
    if (keep) {
      ai.question = saved.question
      ai.answer = saved.answer
      ai.messages = saved.messages
    }
    beginAi()
    shell.hud = msg
    showAi()
    return
  }
  shell.hud = msg
  relist()
}

// ── Remote models: a question is a turn that streams the reply and runs the tools the model calls,
// sending their results back, up to AI_ROUNDS times ──

// Ask AI's tools in the OpenAI function format.
fn openAiTools() {
  return JSON.stringify(JSON.parse(aiTools()).map((t) => ({ type: 'function', 'function': { name: t.name, description: t.description, parameters: toolParams(t.params) } })))
}

fn toolParams(params) {
  let props = {}
  let required = []
  for (let i = 0; i < params.length; i = i + 1) {
    let p = params[i]
    let schema = { type: 'string', description: p.description }
    if (p.choices) {
      schema['enum'] = p.choices
    }
    props[p.name] = schema
    if (!p.optional) {
      required.push(p.name)
    }
  }
  return { type: 'object', properties: props, required: required }
}

// t: { id, model, messages, tools, onTool(name, argsJson) -> text, onEvent(t, e), rounds, request }.
// onEvent gets aiChat's events, plus kind "tools" when tool results went back.
fn newTurn(model, messages, onTool, onEvent) {
  turnCount = turnCount + 1
  return { id: turnCount, model: model, messages: messages, tools: openAiTools(), onTool: onTool, onEvent: onEvent, rounds: 0, request: 0 }
}

fn turnSend(t) {
  t.request = aiChat(t.model, JSON.stringify(t.messages), t.tools, (e) => turnEvent(t, e))
  return t.request
}

fn turnEvent(t, e) {
  if (e.kind === 'done' && e.calls.length > 0 && t.rounds < AI_ROUNDS) {
    t.rounds = t.rounds + 1
    t.messages.push(callMessage(e))
    let results = toolResults(e.calls, t.onTool)
    for (let i = 0; i < results.length; i = i + 1) {
      t.messages.push(results[i])
    }
    t.onEvent(t, { request: e.request, kind: 'tools', text: e.text, calls: e.calls, finish: e.finish })
    turnSend(t)
    return
  }
  if (e.kind === 'done') {
    t.messages.push({ role: 'assistant', content: e.text })
  }
  t.onEvent(t, e)
}

fn callMessage(e) {
  return { role: 'assistant', content: e.text !== '' ? e.text : null, tool_calls: e.calls.map((c) => ({ id: c.id, type: 'function', 'function': { name: c.name, arguments: c.arguments !== '' ? c.arguments : '{}' } })) }
}

fn toolResults(calls, onTool) {
  return calls.map((c) => ({ role: 'tool', tool_call_id: c.id, content: callTool(onTool, c.name, c.arguments) }))
}

fn callTool(onTool, name, args) {
  try {
    return onTool(name, args !== '' ? args : '{}')
  } catch (err) {
    return 'The ' + name + ' tool failed: ' + err.message
  }
}

// What went wrong, in words; aiFix offers the way out as the selected row below it.
fn remoteErrorText(model, raw) {
  let p = modelProvider(model)
  let who = providerTitle(p)
  if (raw.indexOf('needs an API key') >= 0) {
    if (p === 'hypery') {
      aiFix('Sign In to Hypery', 'Or use an API key', hyperyIcon(THEME.icon.account), 'hypery-signin')
      return 'Hypery models need you to sign in'
    }
    aiFix('Add ' + who + ' API Key', 'Kept in the Keychain', symbolIcon(THEME.icon.apiKey), 'key:' + p)
    return who + ' needs an API key'
  }
  if (raw.indexOf('HTTP 402') >= 0 || raw.indexOf('INSUFFICIENT') >= 0) {
    let org = p === 'hypery' ? activeOrg() : null
    if (org !== null && hyperyState.account.orgs.length > 1) {
      aiFix('Switch Team', 'Or add credits to ' + orgTitle(org), orgIcon(org), 'hypery-orgs')
    } else {
      aiFix('Add Credits', 'Opens Hypery billing', hyperyIcon(THEME.icon.account), 'hypery-credits')
    }
    return who + (org !== null ? ' team ' + orgTitle(org) : '') + ' is out of credit'
  }
  if (raw.indexOf('HTTP 401') >= 0) {
    if (p === 'hypery') {
      aiFix('Sign In to Hypery Again', 'Or use an API key', hyperyIcon(THEME.icon.account), 'hypery-signin')
      return "Hypery didn't accept the sign-in"
    }
    aiFix('Replace ' + who + ' API Key', 'Kept in the Keychain', symbolIcon(THEME.icon.apiKey), 'key:' + p)
    return who + " didn't accept the API key"
  }
  return who + ': ' + (raw.length > 140 ? raw.slice(0, 140) + '…' : raw)
}

// The one result row under an AI error, selected, so Return does it.
fn aiFix(name, kind, icon, fix) {
  ai.items = [{ name: name, kind: kind, icon: icon, item: true, path: '', action: { fix: fix } }]
  ai.itemsTitle = 'Fix'
  ai.pick = 0
  ai.itemOff = 0
}

// The shell's own blockers: sign in, add credits, add a key, pick a working model. From Ask AI they
// open over it, and signing in or saving a key asks the question again.
fn runFix(fix) {
  if (fix === 'hypery-signin') {
    enterSub({ name: HYPERY.name, mode: 'hypery', pluginTitle: 'Hypery', icon: HYPERY.icon, path: HYPERY.path, resume: inAi() })
    signInHypery()
  } else if (fix === 'hypery-credits') {
    hyperyAct('billing')
  } else if (fix === 'hypery-orgs') {
    hyperyAct('orgs')
  } else if (fix === 'models') {
    enterSub(modelPicker(inAi()))
  } else if (fix.indexOf('key:') === 0) {
    keyEntry = ''
    enterSub(keyMode(fix.slice(4), inAi()))
  }
}

fn keyMode(provider, resume) {
  let who = providerTitle(provider)
  return { name: who + ' API Key', mode: 'ai-key', pluginTitle: who, icon: symbolIcon(THEME.icon.apiKey), provider: provider, resume: resume }
}

// Back to the question a fix interrupted, and ask it again.
fn resumeAsk() {
  leaveSub()
  while (!inAi() && shell.mode !== null && shell.mode.back) {
    leaveSub()
  }
  if (inAi() && ai.question !== '') {
    shell.query = ''
    askAi(ai.question)
  }
}

fn remoteAsk(question) {
  ai.question = question.trim()
  ai.answer = ''
  ai.items = []
  ai.itemsTitle = ''
  ai.pick = -1
  ai.itemOff = 0
  ai.error = ''
  ai.stopped = false
  ai.scroll = 0
  ai.gate = freshToolGate(ai.model, ai.question)
  ai.activity = ''
  ai.t0 = Date.now()
  if (ai.messages.length === 0) {
    ai.messages.push({ role: 'system', content: AI_INSTRUCTIONS })
  }
  ai.turnStart = ai.messages.length
  ai.messages.push({ role: 'user', content: ai.question })
  let t = newTurn(ai.model, ai.messages, onAiTool, onTurnEvent)
  ai.turnId = t.id
  ai.request = turnSend(t)
  shell.query = ''
  shell.hud = ''
  showAi()
}

fn onTurnEvent(t, e) {
  if (t.id !== ai.turnId) {
    return
  }
  ai.request = t.request
  if (e.kind === 'partial' || e.kind === 'tools') {
    if (e.text !== '') {
      ai.answer = e.text
    }
    showAi()
    return
  }
  if (e.kind === 'error') {
    ai.error = remoteErrorText(t.model, e.text)
    ai.messages = ai.messages.slice(0, ai.turnStart)
    // With a fix offered the field stays empty, so Return does the fix; the question comes back
    // after it.
    if (shell.query === '' && ai.itemsTitle !== 'Fix') {
      shell.query = ai.question
    }
  } else if (e.kind === 'cancelled') {
    ai.messages = ai.messages.slice(0, ai.turnStart)
    ai.stopped = true
  } else {
    ai.answer = e.text
  }
  ai.request = 0
  ai.ms = Date.now() - ai.t0
  showAi()
}

// ── Hypery Account: sign in (browser or API key), balance and this month's spending ──

// GitHub sign-ins without a public email get a placeholder address; the name reads better.
fn accountWho(a) {
  if (a.email !== '' && a.email.indexOf('@oauth.local') < 0) {
    return a.email
  }
  return a.name !== '' ? a.name : a.email
}

fn hyperyLabel() {
  let c = hyperyCredential()
  let a = hyperyState.account
  if (c === 'signed in') {
    return a !== null && accountWho(a) !== '' ? accountWho(a) : 'Signed in'
  }
  if (c === 'key') {
    return 'API key'
  }
  return c === 'environment' ? '$HYPERY_API_KEY' : 'Not signed in'
}

fn loadAccount() {
  if (hyperyState.loading || hyperyCredential() === '') {
    return
  }
  hyperyState.loading = true
  aiAccount('hypery', (a) => {
    hyperyState.loading = false
    if (hyperyState.again) {
      hyperyState.again = false
      loadAccount()
      return
    }
    hyperyState.account = a
    hyperyState.at = Date.now()
    if (modeIs('hypery') || modeIs('hypery-orgs') || modeIs('settings')) {
      relist()
    }
  })
}

fn money(n) {
  return '$' + n.toFixed(2)
}

fn hyperyRow(name, kind, symbol, act, group) {
  return { name: name, kind: kind, icon: symbolIcon(symbol), mode: 'hypery-act', act: act, group: group }
}

// A row that opens hypery.ai, with its logo.
fn hyperyLink(name, kind, symbol, act, group) {
  return { name: name, kind: kind, icon: hyperyIcon(symbol), mode: 'hypery-act', act: act, group: group }
}

// An image from the web (cached on disk), `fallback` until it has loaded. One fetch per URL per
// run, so a missing image is not asked for on every keystroke.
let remoteIcons = []

fn remoteIcon(url, fallback) {
  let known = remoteIcons.filter((e) => e.url === url)
  if (known.length > 0) {
    return known[0].name !== '' ? known[0].name : fallback
  }
  let entry = { url: url, name: '' }
  remoteIcons.push(entry)
  entry.name = imageIcon(url, (n) => {
    entry.name = n
    if (shell.mode !== null) {
      relist()
    }
  })
  return entry.name !== '' ? entry.name : fallback
}

// Each organization's own icon from hypery.ai, its symbol until that has loaded.
fn orgIcon(o) {
  let fallback = symbolIcon(o.personal ? THEME.icon.personalOrg : THEME.icon.organization)
  return o.image === '' ? fallback : remoteIcon(o.image, fallback)
}

fn orgTitle(o) {
  return o.name !== '' ? o.name : o.slug
}

fn activeOrg() {
  let a = hyperyState.account
  if (a === null) {
    return null
  }
  let m = a.orgs.filter((o) => o.id === a.organization)
  return m.length > 0 ? m[0] : null
}

fn orgResults(text) {
  let t = text.trim().toLowerCase()
  let a = hyperyState.account
  if (a === null || a.orgs.length === 0) {
    return [infoRow(hyperyState.loading ? 'Loading teams…' : 'No teams', 'Teams')]
  }
  return a.orgs
    .filter((o) => t === '' || orgTitle(o).toLowerCase().indexOf(t) >= 0 || o.slug.toLowerCase().indexOf(t) >= 0)
    .map((o) => {
      let role = o.role === '' ? '' : o.role[0].toUpperCase() + o.role.slice(1)
      let bits = [o.id === a.organization ? 'Current' : '', o.personal ? 'Personal' : '', role]
      return { name: orgTitle(o), kind: bits.filter((b) => b !== '').join(' · '), icon: orgIcon(o), mode: 'hypery-org', org: o, group: 'Teams' }
    })
}

// Chats, the balance and the billing links all follow the chosen organization.
fn chooseOrg(o) {
  let r = aiSetOrganization('hypery', o.personal ? '' : o.id)
  if (!r.ok) {
    shell.hud = 'Could not switch team: ' + r.error
    refresh()
    return
  }
  let a = hyperyState.account
  if (a !== null) {
    a.organization = o.id
    a.balance = -1
    a.error = ''
  }
  hyperyState.at = 0
  if (hyperyState.loading) {
    hyperyState.again = true
  }
  leaveSub()
  loadAccount()
  shell.hud = 'Using ' + orgTitle(o)
  relist()
}

fn hyperyResults(text) {
  let t = text.trim().toLowerCase()
  let c = hyperyCredential()
  let p = providerInfo('hypery')
  let a = hyperyState.account
  let I = THEME.icon
  if (c !== '' && (a === null || Date.now() - hyperyState.at > ACCOUNT_MS)) {
    loadAccount()
  }
  let rows = []
  if (hyperyState.signingIn) {
    rows.push(hyperyRow('Waiting for the browser…', 'esc cancels', I.waiting, 'cancel-signin', 'Account'))
  } else if (c === '') {
    if (p !== null && p.signIn) {
      rows.push(hyperyLink('Sign In with Hypery', 'Opens your browser', I.account, 'signin', 'Account'))
    }
    rows.push(hyperyRow('Use an API Key…', 'hypery.ai › Settings › API Keys', I.apiKey, 'key', 'Account'))
    rows.push(hyperyLink('Create a Hypery Account', 'hypery.ai', I.signUp, 'signup', 'Account'))
  } else {
    let me = hyperyRow(hyperyLabel(), c === 'signed in' ? 'Signed in' : (c === 'key' ? 'Saved in the Keychain' : 'From the environment'), I.signedIn, 'none', 'Account')
    // The account's own picture is its personal team's image.
    let personal = a !== null ? a.orgs.filter((o) => o.personal) : []
    if (personal.length > 0 && personal[0].image !== '') {
      me.icon = orgIcon(personal[0])
    }
    rows.push(me)
    // Always say which team the balance, chats and spending belong to, even before it has loaded.
    let org = activeOrg()
    if (org !== null) {
      rows.push({ name: 'Team: ' + orgTitle(org), kind: a.orgs.length > 1 ? '↵ Switch Team (' + a.orgs.length + ')' : 'Your only team', icon: orgIcon(org), mode: 'hypery-act', act: 'orgs', group: 'Account' })
    } else {
      rows.push(hyperyRow('Team: ' + (hyperyState.loading || a === null ? 'loading…' : 'unknown'), a !== null && a.error !== '' ? a.error : '', I.organization, 'orgs', 'Account'))
    }
    rows.push(hyperyLink('Manage Account', 'hypery.ai', I.account, 'manage', 'Account'))
    rows.push(hyperyLink('Manage API Keys', 'hypery.ai', I.apiKey, 'keys', 'Account'))
    if (c !== 'environment') {
      rows.push(hyperyRow(c === 'key' ? 'Remove API Key' : 'Sign Out', '', I.signOut, 'signout', 'Account'))
    }
    if (a !== null && a.error === '' && a.balance >= 0) {
      let month = a.monthSpent >= 0 ? 'This month ' + money(a.monthSpent) + (a.monthLimit > 0 ? ' of ' + money(a.monthLimit) : '') : ''
      rows.push(hyperyRow('Balance ' + money(a.balance), month, I.balance, 'billing', 'Usage'))
    } else if (a !== null && a.error !== '') {
      rows.push(hyperyRow('Usage unavailable', a.error, I.warning, 'account', 'Usage'))
    } else {
      rows.push(hyperyRow('Loading usage…', '', I.balance, 'none', 'Usage'))
    }
    rows.push(hyperyLink('Add Credits', 'Billing on hypery.ai', I.addCredits, 'billing', 'Usage'))
  }
  rows.push(hyperyRow('AI Model', modelName(currentModel()), THEME.icon.ai, 'models', 'Ask AI'))
  return rows.filter((r) => t === '' || r.name.toLowerCase().indexOf(t) >= 0)
}

fn hyperyPage(which) {
  let a = hyperyState.account
  if (a !== null && a.error === '' && which === 'keys') {
    return a.keys
  }
  if (a !== null && a.error === '' && which === 'billing') {
    return a.billing
  }
  if (a !== null && a.manage !== '' && which === 'manage') {
    return a.manage
  }
  return HYPERY_SITE + '/dashboard'
}

fn hyperyAct(act) {
  if (act === 'signin') {
    signInHypery()
  } else if (act === 'cancel-signin') {
    aiCancelLogin()
  } else if (act === 'key') {
    keyEntry = ''
    enterSub(keyMode('hypery', shell.mode !== null && shell.mode.resume === true))
  } else if (act === 'signup') {
    launch(HYPERY_SITE)
    hide()
  } else if (act === 'billing' || act === 'keys' || act === 'manage') {
    launch(hyperyPage(act))
    hide()
  } else if (act === 'keys-open') {
    launch(hyperyPage('keys'))
    shell.hud = 'Copy a key there, then paste it here'
    refresh()
  } else if (act === 'signout') {
    let wasKey = hyperyCredential() === 'key'
    aiLogout('hypery')
    hyperyState.account = null
    refreshProviders()
    shell.hud = wasKey ? 'Removed the Hypery API key' : 'Signed out of Hypery'
    relist()
  } else if (act === 'account') {
    hyperyState.at = 0
    loadAccount()
  } else if (act === 'orgs') {
    let org = activeOrg()
    enterSub({ name: 'Switch Team', mode: 'hypery-orgs', pluginTitle: 'Hypery', icon: org !== null ? orgIcon(org) : symbolIcon(THEME.icon.organization) })
  } else if (act === 'models') {
    enterSub(modelPicker(false))
  }
}

fn signInHypery() {
  let p = providerInfo('hypery')
  if (p === null || !p.signIn) {
    hyperyAct('key')
    shell.hud = "Browser sign-in isn't set up in this build: use a Hypery API key"
    refresh()
    return
  }
  hyperyState.signingIn = true
  relist()
  aiLogin('hypery', (r) => {
    hyperyState.signingIn = false
    refreshProviders()
    show()
    shell.hud = r.ok ? 'Signed in to Hypery' : 'Sign-in failed: ' + r.error
    if (r.ok) {
      hyperyState.at = 0
      loadAccount()
    }
    if (r.ok && modeIs('hypery') && shell.mode.resume) {
      resumeAsk()
    } else if (modeIs('hypery')) {
      relist()
    } else {
      refresh()
    }
  })
}

fn maskKey(k) {
  return k.length <= 10 ? '••••' : k.slice(0, 3) + '…' + k.slice(k.length - 4)
}

fn keyResults(text) {
  let k = keyEntry
  let p = shell.mode.provider
  let who = providerTitle(p)
  if (k === '') {
    if (p === 'hypery') {
      return [{ name: 'Get an API Key', kind: 'Opens hypery.ai › API Keys, then paste it here', icon: hyperyIcon(THEME.icon.apiKey), mode: 'hypery-act', act: 'keys-open', group: who }]
    }
    return [{ name: 'Paste your ' + who + ' API key', kind: 'From your ' + who + ' account', icon: symbolIcon(THEME.icon.apiKey), mode: 'ai-info', group: who }]
  }
  return [{ name: 'Save API Key ' + maskKey(k), kind: 'Kept in the Keychain', icon: symbolIcon(THEME.icon.apiKey), mode: 'ai-key-save', group: who }]
}

fn saveKey() {
  let k = keyEntry
  if (k === '') {
    return
  }
  keyEntry = ''
  let r = aiSetKey(shell.mode.provider, k)
  if (!r.ok) {
    shell.hud = 'Could not save the key: ' + r.error
    refresh()
    return
  }
  let p = shell.mode.provider
  let resume = shell.mode.resume === true
  refreshProviders()
  if (p === 'hypery') {
    hyperyState.account = null
    hyperyState.at = 0
  }
  if (resume) {
    resumeAsk()
    return
  }
  leaveSub()
  shell.hud = 'Saved the ' + providerTitle(p) + ' API key'
  relist()
}

fn wrapText(text, width) {
  let out = []
  let paras = text.split('\n')
  for (let p = 0; p < paras.length; p = p + 1) {
    let words = paras[p].split(' ')
    let line = ''
    for (let w = 0; w < words.length; w = w + 1) {
      let word = words[w]
      while (word.length > width) {
        if (line !== '') {
          out.push(line)
          line = ''
        }
        out.push(word.slice(0, width))
        word = word.slice(width)
      }
      if (line === '') {
        line = word
      } else if (line.length + 1 + word.length <= width) {
        line = line + ' ' + word
      } else {
        out.push(line)
        line = word
      }
    }
    out.push(line)
  }
  return out
}

// Shown in place of the answer until its first words arrive.
fn aiWaiting() {
  if (ai.activity !== '') {
    return ai.activity + '…'
  }
  return isRemote(ai.model) ? 'Asking ' + modelName(ai.model) + '…' : 'Thinking…'
}

fn aiLines() {
  return wrapText(ai.answer.split('**').join('').trim(), AI_WRAP)
}

// How the list splits between answer lines and tool results: { lines, shown (answer lines on
// screen), room (result rows on screen) }. With results the answer keeps at most AI_ANSWER_ROWS lines.
fn aiLayout() {
  let lines = ai.answer !== '' ? aiLines() : (ai.request !== 0 ? [aiWaiting()] : (ai.error !== '' ? wrapText(ai.error, AI_WRAP) : []))
  if (ai.items.length === 0) {
    return { lines: lines, shown: Math.min(lines.length, ROWS), room: 0 }
  }
  let shown = Math.min(lines.length, AI_ANSWER_ROWS)
  let heads = (shown > 0 ? SECTION_H : 0) + SECTION_H
  let room = Math.floor((LIST_H - heads - shown * LINE_H) / ROW_H)
  return { lines: lines, shown: shown, room: Math.min(room, ai.items.length) }
}

fn aiRows() {
  let lay = aiLayout()
  let action = { copy: ai.answer, hud: 'Copied answer' }
  let waiting = ai.answer === '' && ai.request !== 0
  let rows = lay.lines.slice(ai.scroll, ai.scroll + lay.shown).map((l) => ({ name: l, kind: '', icon: '', item: false, line: true, dim: waiting, action: action }))
  return rows.concat(ai.items.slice(ai.itemOff, ai.itemOff + lay.room))
}

fn aiPicked() {
  return ai.pick >= 0 && ai.pick < ai.items.length ? ai.items[ai.pick] : null
}

fn showAi() {
  shell.apps = aiRows()
  compose()
  shell.selected = aiSelected()
  refresh()
}

fn aiSelected() {
  return ai.pick >= 0 ? aiLayout().shown + ai.pick - ai.itemOff : 0
}

// ↑↓ scroll the answer, then walk the results below it.
fn moveInAi(down) {
  let lay = aiLayout()
  let maxScroll = Math.max(0, lay.lines.length - lay.shown)
  if (down) {
    if (ai.pick < 0 && ai.scroll < maxScroll) {
      ai.scroll = ai.scroll + 1
    } else if (ai.pick < ai.items.length - 1) {
      ai.pick = ai.pick + 1
    }
  } else if (ai.pick >= 0) {
    ai.pick = ai.pick - 1
  } else if (ai.scroll > 0) {
    ai.scroll = ai.scroll - 1
  }
  if (ai.pick >= 0 && ai.pick < ai.itemOff) {
    ai.itemOff = ai.pick
  } else if (ai.pick >= ai.itemOff + lay.room) {
    ai.itemOff = ai.pick - lay.room + 1
  }
  showAi()
}

fn aiErrorText(raw) {
  if (raw.indexOf('guardrailViolation') >= 0) {
    return "Apple's safety filter declined this request"
  }
  if (raw.indexOf('exceededContextWindowSize') >= 0) {
    return 'Conversation too long for the on-device model; press esc and start again'
  }
  return 'AI error: ' + (raw.length > 120 ? raw.slice(0, 120) + '…' : raw)
}

fn onAiEvent(e) {
  if (e.request !== ai.request) {
    return
  }
  // The on-device model's context is small; when a conversation fills it, ask again once in a
  // new one rather than give up.
  if (e.kind === 'error' && e.text.indexOf('exceededContextWindowSize') >= 0 && !ai.retried) {
    let q = ai.question
    aiEndSession(ai.session)
    ai.session = aiSession(AI_INSTRUCTIONS, aiTools(), onAiTool)
    ai.request = 0
    askAi(q)
    ai.retried = true
    shell.hud = "Started a new conversation: the on-device model's memory was full"
    refresh()
    return
  }
  if (e.kind === 'error') {
    ai.error = aiErrorText(e.text)
    // Put the question back so it can be rephrased.
    if (shell.query === '') {
      shell.query = ai.question
    }
  } else {
    ai.answer = e.text
  }
  if (e.kind !== 'partial') {
    ai.request = 0
    ai.ms = Date.now() - ai.t0
    ai.stopped = e.kind === 'cancelled'
  }
  showAi()
}

// open: a URL, a path (~ expanded; a missing path retries its last part under home, since the
// model guesses home folders), or an app name.
fn aiOpen(target) {
  let t = target.trim()
  if (t === '') {
    return 'Nothing to open.'
  }
  if (t.indexOf('://') > 0) {
    return launch(t) ? 'Opened ' + t : 'Could not open ' + t
  }
  if (t[0] === '~') {
    t = HOME + t.slice(1)
  }
  if (t[0] === '/') {
    if (launch(t)) {
      return 'Opened ' + t
    }
    let parts = t.split('/').filter((p) => p !== '')
    let underHome = parts.length > 0 ? HOME + '/' + parts[parts.length - 1] : ''
    if (underHome !== '' && launch(underHome)) {
      return 'Opened ' + underHome
    }
    return 'No such file or folder: ' + t
  }
  let folder = HOME + '/' + t[0].toUpperCase() + t.slice(1).toLowerCase()
  if (launch(folder)) {
    return 'Opened ' + folder
  }
  let apps = search(t, 1)
  if (apps.length > 0 && launch(apps[0].path)) {
    return 'Opened ' + apps[0].name
  }
  return 'Could not find an app, file or folder called ' + t
}

fn fmtBytes(n) {
  if (n >= 1000000000) {
    return (n / 1000000000).toFixed(1) + ' GB'
  }
  if (n >= 1000000) {
    return (n / 1000000).toFixed(1) + ' MB'
  }
  return n >= 1000 ? Math.round(n / 1000) + ' KB' : n + ' bytes'
}

// Unix ms -> "3 hours ago" etc.
fn fmtAgo(ms) {
  if (ms <= 0) {
    return 'never'
  }
  let s = (Date.now() - ms) / 1000
  let unit = (n, word) => n + ' ' + word + (n === 1 ? '' : 's') + ' ago'
  if (s < 60) {
    return 'just now'
  }
  if (s < 3600) {
    return unit(Math.floor(s / 60), 'minute')
  }
  if (s < 86400) {
    return unit(Math.floor(s / 3600), 'hour')
  }
  if (s < 2592000) {
    return unit(Math.floor(s / 86400), 'day')
  }
  if (s < 31536000) {
    return unit(Math.floor(s / 2592000), 'month')
  }
  return unit(Math.floor(s / 31536000), 'year')
}

// "2.5 days" -> [2.5, "days"]; a missing number counts as 1.
fn splitAmount(text) {
  let t = text.trim().toLowerCase()
  let i = 0
  while (i < t.length && ((t[i] >= '0' && t[i] <= '9') || t[i] === '.')) {
    i = i + 1
  }
  let n = i > 0 ? Number(t.slice(0, i)) : 1
  return [n, t.slice(i).trim()]
}

// "100 MB", "1.5gb", "500k" -> bytes; a bare number is megabytes. 0 when unreadable.
fn parseSize(text) {
  if (text.trim() === '') {
    return 0
  }
  let a = splitAmount(text)
  let u = a[1]
  let scale = 1000000
  if (u.indexOf('t') === 0) {
    scale = 1000000000000
  } else if (u.indexOf('g') === 0) {
    scale = 1000000000
  } else if (u.indexOf('k') === 0) {
    scale = 1000
  } else if (u.indexOf('b') === 0) {
    scale = 1
  } else if (u !== '' && u.indexOf('m') !== 0) {
    return 0
  }
  return a[0] > 0 ? Math.round(a[0] * scale) : 0
}

// "2 days", "48h", "1 week", "today", "yesterday" -> seconds; a bare number is days. 0 when unreadable.
fn parseAge(text) {
  if (text.trim() === '') {
    return 0
  }
  let a = splitAmount(text.split('last ').join('').split('past ').join(''))
  let u = a[1]
  let unit = 0
  if (u === 'today') {
    unit = 86400
  } else if (u === 'yesterday') {
    unit = 172800
  } else if (u.indexOf('mo') === 0) {
    unit = 2592000
  } else if (u.indexOf('mi') === 0 || u === 'm') {
    unit = 60
  } else if (u.indexOf('s') === 0) {
    unit = 1
  } else if (u.indexOf('h') === 0) {
    unit = 3600
  } else if (u.indexOf('w') === 0) {
    unit = 604800
  } else if (u.indexOf('y') === 0) {
    unit = 31536000
  } else if (u === '' || u.indexOf('d') === 0) {
    unit = 86400
  }
  return a[0] > 0 ? a[0] * unit : 0
}

// "~/Downloads", "Downloads", "/tmp" -> an absolute folder.
fn aiFolder(text) {
  let t = text.trim()
  if (t === '' || t === '~' || t === 'home') {
    return ''
  }
  if (t[0] === '~') {
    return HOME + t.slice(1)
  }
  return t[0] === '/' ? t : HOME + '/' + t[0].toUpperCase() + t.slice(1)
}

fn argText(ta, key) {
  let v = ta[key]
  return v === null ? '' : String(v).trim()
}

// A tool's reply: `text` goes back to the model; `items` (rows the user can open) and their section
// `title` show under the answer.
fn toolReply(text, title, items) {
  return { text: text, title: title, items: items }
}

let HOME_FOLDERS = ['downloads', 'desktop', 'documents', 'pictures', 'movies', 'music', 'projects']
let FILTER_WORDS = [['name', 'named'], ['kind', 'of kind'], ['minSize', 'of at least'], ['createdWithin', 'created within'], ['modifiedWithin', 'changed within'], ['openedWithin', 'opened within']]

fn aiFindFiles(ta) {
  let sortBy = argText(ta, 'sortBy')
  let kind = argText(ta, 'kind')
  let name = argText(ta, 'name')
  let folder = argText(ta, 'folder')
  // The model often puts "Downloads" in the name when the user said "in my Downloads".
  if (folder === '' && HOME_FOLDERS.indexOf(name.toLowerCase()) >= 0) {
    folder = name
    name = ''
  }
  // ...and the kind ("PDF", "videos") or just "files".
  let bare = name.toLowerCase().split('s').join('')
  if (bare === 'file' || bare === '' || (kind !== '' && bare === kind.split('s').join(''))) {
    name = ''
  }
  let filter = {
    name: name,
    contains: argText(ta, 'contains'),
    kind: kind === 'any' ? '' : kind,
    minBytes: parseSize(argText(ta, 'minSize')),
    createdSecs: parseAge(argText(ta, 'createdWithin')),
    modifiedSecs: parseAge(argText(ta, 'modifiedWithin')),
    openedSecs: parseAge(argText(ta, 'openedWithin')),
    folder: aiFolder(folder),
    sort: '',
    limit: AI_LIST
  }
  if (sortBy === 'largest' || (sortBy === '' && filter.minBytes > 0)) {
    filter.sort = 'size'
  } else if (sortBy === 'name') {
    filter.sort = 'name'
  } else if (sortBy === 'recentlyOpened' || (sortBy === '' && filter.openedSecs > 0)) {
    filter.sort = 'opened'
  } else {
    filter.sort = filter.createdSecs > 0 ? 'created' : 'modified'
  }
  let r = queryFiles(filter)
  let where = filter.folder !== '' ? filter.folder : 'the home folder'
  // The model picks the size floor; when nothing reaches it, the largest files that fit the other
  // filters still answer "what is big".
  let note = ''
  if (r.results.length === 0 && filter.minBytes > 0) {
    note = 'None are ' + fmtBytes(filter.minBytes) + ' or larger. '
    filter.minBytes = 0
    filter.sort = 'size'
    r = queryFiles(filter)
  }
  if (r.results.length === 0) {
    let what = []
    for (let k = 0; k < FILTER_WORDS.length; k = k + 1) {
      let w = FILTER_WORDS[k]
      let v = argText(ta, w[0])
      if (v !== '' && v !== 'any') {
        what.push(w[1] + ' ' + v)
      }
    }
    return toolReply('No files' + (what.length > 0 ? ' (' + what.join(', ') + ')' : '') + ' in ' + where + '.', '', [])
  }
  let lines = []
  let items = []
  // Show the date the user asked about.
  let dateOf = filter.createdSecs > 0 || filter.sort === 'created' ? 'created' : (filter.openedSecs > 0 || filter.sort === 'opened' ? 'opened' : 'modified')
  for (let i = 0; i < r.results.length; i = i + 1) {
    let f = r.results[i]
    let date = dateOf === 'created' ? 'created ' + fmtAgo(f.created) : (dateOf === 'opened' ? 'opened ' + fmtAgo(f.opened) : 'modified ' + fmtAgo(f.modified))
    let size = f.kind === 'Folder' ? 'folder' : fmtBytes(f.bytes)
    lines.push((i + 1) + '. ' + f.name + ', ' + size + ', ' + date + ', in ' + f.detail)
    items.push({ name: f.name, path: f.path, icon: f.icon, kind: f.kind, detail: size + ' · ' + date, item: true, line: false, action: { open: f.path } })
  }
  let order = { size: 'largest', created: 'newest', modified: 'most recently changed', opened: 'most recently opened', name: 'first by name' }
  let head = r.total > r.results.length ? r.total + ' files matched in ' + where + '; the ' + r.results.length + ' ' + order[filter.sort] + ':' : r.results.length + (r.results.length === 1 ? ' file' : ' files') + ' matched in ' + where + ':'
  return toolReply(note + head + '\n' + lines.join('\n'), 'Files', items)
}

fn aiFindApps(ta) {
  let apps = search(argText(ta, 'query'), AI_LIST)
  if (apps.length === 0) {
    return toolReply('No installed app matches ' + argText(ta, 'query') + '.', '', [])
  }
  let items = apps.map((a) => ({ name: a.name, path: a.path, icon: a.icon, kind: 'Application', item: true, line: false, action: { open: a.path } }))
  return toolReply('Installed apps: ' + apps.map((a) => a.name).join(', ') + '.', 'Applications', items)
}

fn aiRunningApps() {
  let apps = runningApps()
  let names = []
  let items = []
  for (let n = 0; n < apps.length; n = n + 1) {
    let a = apps[n]
    let state = a.active ? 'Frontmost' : (a.hidden ? 'Hidden' : 'Running')
    names.push(a.name + (state !== 'Running' ? ' (' + state.toLowerCase() + ')' : ''))
    items.push({ name: a.name, path: a.path, icon: a.icon, kind: state, item: true, line: false, action: { open: a.path } })
  }
  return toolReply(apps.length + ' apps are open: ' + names.join(', ') + '.', 'Open Apps', items)
}

fn aiClipboard(ta) {
  let rows = clipboardHistory(argText(ta, 'query'), AI_LIST)
  if (rows.length === 0) {
    return toolReply('Nothing in the clipboard history matches.', '', [])
  }
  let lines = []
  let items = []
  for (let n = 0; n < rows.length; n = n + 1) {
    let c = rows[n]
    lines.push((n + 1) + '. "' + c.preview + '" copied ' + c.ago + (c.app !== '' ? ' from ' + c.app : ''))
    items.push({ name: c.preview, path: '', icon: c.icon !== '' ? c.icon : 'NSMultipleDocuments', kind: (c.app !== '' ? c.app + ' · ' : '') + c.ago, item: true, line: false, action: { copy: c.text, close: true } })
  }
  return toolReply('Recent clipboard entries, newest first:\n' + lines.join('\n'), 'Clipboard', items)
}

fn aiControlMac(ta) {
  let action = argText(ta, 'action')
  let refused = AI_SYSTEM_REFUSED[action]
  if (refused !== null) {
    return toolReply('Nothing was done: only the user can do this. Tell them to type ' + refused + ' in Moo and press Return twice.', '', [])
  }
  let m = AI_SYSTEM[action]
  if (m === null) {
    return toolReply('Unknown action ' + action + '. Use one of: ' + AI_SYSTEM_ACTIONS.join(', '), '', [])
  }
  let arg = action === 'setVolume' ? argText(ta, 'level') : m[1]
  if (action === 'setVolume' && arg === '') {
    return toolReply('setVolume needs a level from 0 to 100.', '', [])
  }
  let r = systemCommand(m[0], arg)
  if (r.ok && (m[0] === 'lock' || m[0] === 'screen-saver' || m[0] === 'sleep-displays')) {
    hide()
  }
  return toolReply(r.ok ? (r.message !== '' ? r.message : 'Done.') : 'Failed: ' + r.message, '', [])
}

fn aiSystemInfo() {
  let s = systemInfo()
  if (s === null) {
    return toolReply('System information is not available.', '', [])
  }
  let hours = Math.floor(s.uptimeSecs / 3600)
  let facts = [
    s.os.split('Version ').join('macOS '),
    'model ' + s.model + (s.chip !== '' ? ', ' + s.chip : '') + ', ' + s.cores + ' cores',
    fmtBytes(s.memoryBytes) + ' of memory',
    'disk: ' + fmtBytes(s.diskFree) + ' available of ' + fmtBytes(s.diskTotal),
    'up for ' + (hours >= 24 ? Math.floor(hours / 24) + ' days ' + (hours % 24) + ' hours' : hours + ' hours ' + Math.floor((s.uptimeSecs % 3600) / 60) + ' minutes')
  ]
  let b = s.battery
  if (b !== null) {
    let left = b.charging && b.minutesToFull > 0 ? ', full in ' + b.minutesToFull + ' minutes' : (!b.onAC && b.minutesToEmpty > 0 ? ', about ' + Math.floor(b.minutesToEmpty / 60) + ' h ' + (b.minutesToEmpty % 60) + ' min left' : '')
    facts.push('battery ' + b.percent + '%' + (b.charging ? ', charging' : (b.onAC ? ', plugged in' : ', on battery')) + left)
  }
  return toolReply(facts.join('; ') + '.', '', [])
}

fn aiReveal(ta) {
  let p = aiFolder(argText(ta, 'path'))
  if (p === '') {
    p = HOME
  }
  return toolReply(revealFile(p) ? 'Shown in Finder: ' + p : 'No such file or folder: ' + p, '', [])
}

// Shortcuts that would take over the launcher (a command) are left to the user; shell output goes
// to the status line.
fn aiRunShortcut(ta) {
  let key = argText(ta, 'keyword').toLowerCase()
  let found = config.shortcuts.filter((s) => s.keyword.toLowerCase() === key || s.name.toLowerCase() === key)
  if (found.length === 0) {
    return toolReply('There is no shortcut called ' + key + '.', '', [])
  }
  let s = found[0]
  let input = argText(ta, 'input')
  if (s.needsQuery && input === '') {
    return toolReply('Shortcut ' + s.keyword + ' needs input; ask the user what to use.', '', [])
  }
  if (s.kind === 'command') {
    return toolReply('Shortcut ' + s.keyword + ' opens a Moo command; tell the user to type ' + s.keyword + ' to use it.', '', [])
  }
  recordUse('shortcut:' + s.keyword)
  let text = expandTemplate(s.target, input, s.kind)
  if (s.kind === 'url' || s.kind === 'open') {
    return toolReply(launch(text) ? 'Opened ' + text : 'Could not open ' + text, '', [])
  }
  if (s.kind === 'text') {
    copyText(text.split('\\n').join('\n'))
    return toolReply('Copied the text of ' + s.name + ' to the clipboard.', '', [])
  }
  runShell(text, HOME, (r) => {
    shell.hud = s.name + (r.code === 0 ? ' finished' : ' failed (exit ' + r.code + ')')
    refresh()
  }, shellValues(s.target, input))
  return toolReply('Started ' + s.name + '; it runs in the background.', '', [])
}

fn runAiTool(name, argsJson) {
  let args = JSON.parse(argsJson)
  if (name === 'open') {
    return toolReply(aiOpen(argText(args, 'target')), '', [])
  }
  if (name === 'copyText') {
    copyText(String(args.text))
    return toolReply('Copied to the clipboard.', '', [])
  }
  if (name === 'findFiles') {
    return aiFindFiles(args)
  }
  if (name === 'revealFile') {
    return aiReveal(args)
  }
  if (name === 'findApps') {
    return aiFindApps(args)
  }
  if (name === 'runningApps') {
    return aiRunningApps()
  }
  if (name === 'clipboardHistory') {
    return aiClipboard(args)
  }
  if (name === 'systemInfo') {
    return aiSystemInfo()
  }
  if (name === 'runShortcut') {
    return aiRunShortcut(args)
  }
  if (name === 'controlMac') {
    return aiControlMac(args)
  }
  if (name === 'arrangeWindow') {
    let r = arrangeWindow(argText(args, 'layout'))
    return toolReply(r.ok ? (r.message !== '' ? r.message : 'Done.') : 'Failed: ' + r.message, '', [])
  }
  if (name === 'calculate') {
    let a = calculate(argText(args, 'expression'))
    return toolReply(a === null ? 'Could not work that out; try a simpler expression such as 15% of 80 or 5 km in mi.' : a.display + ' (' + a.detail + ')', '', [])
  }
  if (name === 'define') {
    return toolReply(definitionText(argText(args, 'word'), AI_SENSES), '', [])
  }
  return toolReply('Unknown tool ' + name, '', [])
}

// Tool calls per question, and the longest reply the on-device model gets (its context holds about
// 4,000 tokens, instructions and tools included).
const AI_TOOL_CALLS = 3
const AI_TOOL_TEXT = 700
const REMOTE_TOOL_TEXT = 6000

// One question's tool calls: { calls, seen, cap }. The on-device model sometimes calls tools in a
// loop (define "tie", "knot", "loop", …) until its context is full; a repeat or a call past the
// limit gets told to answer instead.
fn freshToolGate(model, question) {
  return { calls: 0, seen: {}, cap: isRemote(model) ? REMOTE_TOOL_TEXT : AI_TOOL_TEXT, words: questionWords(question) }
}

// Tools that do something on this Mac run only when the question asks for that kind of thing: the
// on-device model otherwise reaches for them unasked (runShortcut "hypery" for "how to tie a tie").
const AI_ACTION_WORDS = {
  open: ['open', 'launch', 'start', 'show', 'visit', 'go', 'load', 'browse', 'bring'],
  copyText: ['copy', 'clipboard'],
  revealFile: ['reveal', 'show', 'finder', 'where'],
  controlMac: ['dark', 'light', 'volume', 'mute', 'unmute', 'louder', 'quieter', 'sound', 'lock', 'sleep', 'screen', 'screensaver', 'saver', 'hide', 'eject', 'restart', 'reboot', 'shut', 'shutdown', 'log', 'logout', 'quit', 'trash', 'turn', 'set'],
  arrangeWindow: ['window', 'move', 'resize', 'maximize', 'maximise', 'center', 'centre', 'snap', 'half', 'left', 'right', 'display', 'restore'],
  runShortcut: ['run', 'open', 'use', 'start', 'launch', 'search', 'go', 'do', 'trigger', 'look']
}

// The question's words, lower case, as a set.
fn questionWords(q) {
  let words = {}
  let w = ''
  let s = (q === null ? '' : String(q)).toLowerCase() + ' '
  for (let i = 0; i < s.length; i = i + 1) {
    let c = s[i]
    if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) {
      w = w + c
    } else {
      if (w !== '') {
        words[w] = true
      }
      w = ''
    }
  }
  return words
}

fn hasAnyWord(words, list) {
  for (let i = 0; i < list.length; i = i + 1) {
    if (words[list[i]] === true) {
      return true
    }
  }
  return false
}

// "" when the question asks for what this tool does, else why it may not run.
fn actionRefusal(gate, name, argsJson) {
  let verbs = AI_ACTION_WORDS[name]
  if (verbs === null) {
    return ''
  }
  let refuse = 'The user did not ask for that. Do not call ' + name + ' for this question; answer it in words.'
  if (!hasAnyWord(gate.words, verbs)) {
    return refuse
  }
  if (name === 'runShortcut') {
    let args = {}
    try {
      args = JSON.parse(argsJson)
    } catch (err) {
      args = {}
    }
    let keyword = argText(args, 'keyword').toLowerCase()
    let named = gate.words[keyword] === true
    for (let i = 0; i < config.shortcuts.length && !named; i = i + 1) {
      let s = config.shortcuts[i]
      if (s.keyword.toLowerCase() === keyword) {
        let parts = s.name.toLowerCase().split(' ')
        for (let j = 0; j < parts.length; j = j + 1) {
          if (parts[j].length >= 3 && verbs.indexOf(parts[j]) < 0 && gate.words[parts[j]] === true) {
            named = true
          }
        }
      }
    }
    if (!named) {
      return refuse
    }
  }
  return ''
}

fn gatedTool(gate, name, argsJson) {
  let key = name + ' ' + argsJson
  if (gate.seen[key] === true) {
    return toolReply('You already have this result. Answer the user now without calling more tools.', '', [])
  }
  let refusal = actionRefusal(gate, name, argsJson)
  if (refusal !== '') {
    gate.calls = gate.calls + 1
    gate.seen[key] = true
    return toolReply(refusal, '', [])
  }
  if (gate.calls >= AI_TOOL_CALLS) {
    return toolReply('No more tool calls for this question. Answer the user now from what you have.', '', [])
  }
  gate.calls = gate.calls + 1
  gate.seen[key] = true
  let r = runAiTool(name, argsJson)
  if (r.text.length > gate.cap) {
    r.text = r.text.slice(0, gate.cap) + '…'
  }
  return r
}

// What Ask AI shows while a tool runs.
fn toolActivity(name, argsJson) {
  let args = {}
  try {
    args = JSON.parse(argsJson)
  } catch (err) {
    args = {}
  }
  if (name === 'define') {
    return 'Looking up “' + argText(args, 'word') + '” in the dictionary'
  }
  if (name === 'calculate') {
    return 'Calculating ' + argText(args, 'expression')
  }
  if (name === 'findFiles') {
    return 'Searching files'
  }
  if (name === 'findApps') {
    return 'Searching apps'
  }
  if (name === 'runningApps') {
    return 'Checking open apps'
  }
  if (name === 'clipboardHistory') {
    return 'Reading clipboard history'
  }
  if (name === 'systemInfo') {
    return 'Checking this Mac'
  }
  if (name === 'open') {
    return 'Opening ' + argText(args, 'target')
  }
  return 'Working'
}

// The Ask AI view's tools: results become rows under the answer.
fn onAiTool(name, argsJson) {
  if (inAi()) {
    ai.activity = toolActivity(name, argsJson)
    showAi()
  }
  if (ai.gate === null) {
    ai.gate = freshToolGate(ai.model, ai.question)
  }
  let r = gatedTool(ai.gate, name, argsJson)
  if (r.items.length > 0 && inAi()) {
    ai.items = r.items
    ai.itemsTitle = r.title
    ai.pick = -1
    ai.itemOff = 0
    showAi()
  }
  return r.text
}

fn cliAiTool(gate) {
  return (name, argsJson) => gatedTool(gate, name, argsJson).text
}

fn askAi(question) {
  if (ai.request !== 0 || question.trim() === '') {
    return
  }
  if (ai.model === '' && !beginAi()) {
    showAi()
    return
  }
  if (isRemote(ai.model)) {
    remoteAsk(question)
    return
  }
  if (ai.session === 0 && !beginAi()) {
    showAi()
    return
  }
  ai.question = question.trim()
  ai.answer = ''
  ai.items = []
  ai.itemsTitle = ''
  ai.pick = -1
  ai.itemOff = 0
  ai.error = ''
  ai.stopped = false
  ai.scroll = 0
  ai.gate = freshToolGate(ai.model, ai.question)
  ai.activity = ''
  ai.retried = false
  ai.t0 = Date.now()
  ai.request = aiAsk(ai.session, ai.question, onAiEvent)
  if (ai.request === 0) {
    ai.error = 'AI error: the model is busy'
  }
  shell.query = ''
  shell.hud = ''
  showAi()
}

fn resetAi() {
  stopAi()
  if (ai.session !== 0) {
    aiEndSession(ai.session)
  }
  ai = freshAi()
}

fn stopAi() {
  if (ai.request === 0) {
    return
  }
  if (ai.turnId !== 0) {
    aiChatCancel(ai.request)
  } else {
    aiCancel(ai.request)
  }
}

fn inAi() {
  return shell.mode !== null && shell.mode.mode === 'ai'
}

// Setting the field's value (going back to a list, for one) reports it as typed; only real
// edits search again, so a message shown after going back stays.
fn onFieldChange(text) {
  if (text === shell.query) {
    return
  }
  if (modeIs('ai-key')) {
    keyEntry = text.trim()
  }
  if (modeIs('args')) {
    argEdit(text)
  }
  if (shell.mode === null && text.length > 1 && text.slice(text.length - 1) === ' ') {
    let c = keywordCommand(text)
    if (c !== null) {
      enterArgs(c, '')
      return
    }
  }
  setQuery(text)
}

fn setQuery(text) {
  if (text !== shell.query) {
    shell.bubble = -1
  }
  shell.query = text
  shell.selected = 0
  shell.offset = 0
  shell.hud = ''
  shell.files = []
  shell.contents = []
  if (inAi()) {
    shell.apps = aiRows()
  } else if (shell.mode !== null) {
    shell.apps = listResults(text)
  } else {
    shell.apps = rootResults(text)
    let sc = shortcutMatch(text)
    let sub = sc === null ? subcommandMatch(text) : null
    fileVerb = sub !== null && sub.command.fileAct ? { query: sub.query, command: sub.command } : null
    if (fileVerb !== null) {
      shell.files = fileVerb.query === '' ? [] : fileVerbRows(fileResults(fileVerb.query, ROWS, ROWS))
    } else if (text.trim().length >= FILE_MIN_CHARS && text.indexOf('/') !== 0 && (sc === null || sc.query === '')) {
      shell.files = fileResults(text, ROWS, ROWS)
    }
  }
  compose()
  if (inAi()) {
    shell.selected = aiSelected()
  }
  refresh()
}

fn enterList(c) {
  shell.mode = c
  setQuery('')
}

fn leaveList() {
  if (inAi()) {
    resetAi()
  }
  recordHotkey(false)
  closeView()
  shell.mode = null
  setQuery('')
}

// Ask AI with an optional first question (the root query when entered with tab).
fn enterAi(c, question) {
  shell.mode = c
  setQuery('')
  if (!beginAi()) {
    if (question.trim() !== '') {
      ai.question = question.trim()
    }
    showAi()
    return
  }
  if (question.trim() !== '') {
    askAi(question)
  } else if (ai.session !== 0) {
    aiPrewarm(ai.session)
  } else {
    refresh()
  }
}

// Actions: { copy } puts text on the clipboard, { open } opens a URL or path (and goes back to root
// unless { stay }), { hud } is a message, { close } hides Moo afterwards, { run } opens a command
// (a plugin's own by name), { fix } is the
// shell's way out of a blocker (sign in, add a key).
fn perform(action) {
  if (action === null) {
    return
  }
  if (action.fix) {
    runFix(action.fix)
    return
  }
  if (action.run) {
    let target = findCommand(action.run)
    if (target === null) {
      shell.hud = 'No command ' + action.run
      refresh()
      return
    }
    openCommand(target, '')
    if (action.hud) {
      shell.hud = action.hud
      hudSetAt = Date.now()
      refresh()
    }
    return
  }
  if (action.copy) {
    copyText(action.copy)
  }
  if (action.hud) {
    shell.hud = action.hud
  }
  if (action.open) {
    if (!launch(action.open)) {
      shell.hud = 'Could not open ' + action.open
      refresh()
      return
    }
    if (action.stay) {
      refresh()
    } else {
      leaveList()
    }
    return
  }
  if (action.close) {
    hide()
    leaveList()
    return
  }
  refresh()
}

fn runBuiltin(c) {
  if (c.path === 'moo:quit') {
    quit()
  } else if (c.path === 'moo:clipboard-clear') {
    clearClipboardHistory()
    shell.hud = 'Clipboard history cleared'
    refresh()
  } else if (c.path === 'moo:edit-shortcuts') {
    let path = ensureShortcutsFile()
    if (!launch(path)) {
      shell.hud = 'Could not open ' + path
      refresh()
    }
  }
}

let CONFIRM_MS = 4000
let confirming = { path: '', query: '', at: 0 }

// The selected row while it waits for its second Return: same row, same query, within CONFIRM_MS.
fn confirmingRow() {
  let r = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (r === null || r.mode !== 'system' || r.path !== confirming.path || shell.query !== confirming.query || Date.now() - confirming.at > CONFIRM_MS) {
    return null
  }
  return r
}

// `ask` is true when chosen in the panel: commands marked `confirm` then need a second Return.
// Hotkeys and shortcuts run at once.
fn runSystem(c, arg, ask) {
  if (ask && c.confirm && confirmingRow() === null) {
    confirming = { path: c.path, query: shell.query, at: Date.now() }
    refresh()
    return
  }
  confirming = { path: '', query: '', at: 0 }
  if (c.hides) {
    hide()
    setQuery('')
  } else if (c.system === 'empty-trash' || c.system === 'eject') {
    shell.hud = c.name + '…'
    refresh()
  }
  systemCommand(c.system, arg, (r) => {
    if (r.message !== '') {
      shell.hud = r.message
      refresh()
    }
  })
}

// Moves the window behind the panel and closes the panel; a failure (no permission, no window)
// shows in the panel, opening it if a hotkey ran the command.
fn runWindow(c) {
  let r = arrangeWindow(c.layout)
  if (r.ok) {
    hide()
    setQuery('')
    return
  }
  show()
  shell.hud = r.message
  refresh()
}

// "volume 30", "vol 30%" set the volume from the root search.
fn volumeRow(text) {
  let w = text.trim().toLowerCase().split(' ')
  if (w.length !== 2 || (w[0] !== 'volume' && w[0] !== 'vol')) {
    return null
  }
  let n = w[1].indexOf('%') === w[1].length - 1 ? w[1].slice(0, w[1].length - 1) : w[1]
  if (n === '' || n.length > 3) {
    return null
  }
  for (let i = 0; i < n.length; i = i + 1) {
    if ('0123456789'.indexOf(n[i]) < 0) {
      return null
    }
  }
  return { name: 'Set Volume to ' + n + '%', path: 'moo:system:volume', icon: symbolIcon('speaker.wave.2.fill'), kind: 'System', mode: 'system', system: 'volume', arg: n, hides: false, confirm: false, pluginTitle: 'System' }
}

fn runCommand(c) {
  let b = pluginBlocker(c)
  if (b !== null) {
    perform(pluginAction(c, b.action))
    return
  }
  try {
    perform(pluginAction(c, c.plugin.run(c.command, c.args ? c.args : {})))
  } catch (e) {
    shell.hud = 'Plugin error: ' + e.message
    refresh()
  }
}

// ── Blockers: what a plugin command needs first (signing in, say), offered as the thing to do ──
// `blocker(command)` returns null or { title, subtitle, icon, action }. Inside the command (its
// list or its arguments) the blocker is the one row, so Return does it; a no-view command does it
// straight away. `visible(command)` false leaves a command out of search (Sign Out when signed out).

fn pluginBlocker(c) {
  if (!c.plugin || !c.plugin.blocker) {
    return null
  }
  try {
    let b = c.plugin.blocker(c.command)
    return b ? b : null
  } catch (e) {
    return null
  }
}

fn blockerRow(c, b) {
  return { name: b.title, kind: b.subtitle ? b.subtitle : '', icon: pluginIcon(b.icon, c.icon), mode: 'blocker', action: pluginAction(c, b.action), group: 'First' }
}

fn pluginVisible(c) {
  if (!c.plugin || !c.plugin.visible) {
    return true
  }
  try {
    return c.plugin.visible(c.command) !== false
  } catch (e) {
    return true
  }
}

// A plugin's { run: "signin" } names one of its own commands.
fn pluginAction(c, action) {
  if (action && action.run && action.run.indexOf(':') < 0) {
    action.run = c.path.slice(0, c.path.length - c.command.length) + action.run
  }
  return action ? action : null
}

// ── Command arguments (Raycast's): a command's fields, filled in the search field ──
// Tab or Return on a command that takes arguments, or its keyword and a space, opens them. The
// field edits one argument at a time: Tab and ⇧Tab move between them, ⌫ in an empty field goes
// back, Return on a suggestion picks it and Return on the command runs it. A "dropdown" argument
// lists the plugin's suggestions, `suggest(command, argument, text, values)` -> [{ title, subtitle,
// value, icon }]; run, list and open get the values as their last parameter, `{ name: value }`.

fn hasArgs(c) {
  return c !== null && c.plugin && c.arguments && c.arguments.length > 0
}

// The plugin command whose keyword is `text` ("slack"), if it takes arguments.
fn keywordCommand(text) {
  let k = text.trim().toLowerCase()
  if (k === '' || findShortcut(k) !== null) {
    return null
  }
  for (let i = BUILTIN_COUNT; i < commands.length; i = i + 1) {
    if (commands[i].keyword === k && hasArgs(commands[i])) {
      return commands[i]
    }
  }
  return null
}

// Subcommands: a command's keyword (or alias), a space and text lists that command's own rows
// first in the root search, filtered by the text: "kill " lists running apps, "kill cursor" puts
// Cursor first; "npm react", "gh moo". Only commands that list something; shortcut keywords keep
// their own meaning ("g rust" → Google).
fn subcommandFor(word) {
  let k = word.trim().toLowerCase()
  if (k === '' || k.indexOf(' ') >= 0 || findShortcut(k) !== null) {
    return null
  }
  let found = null
  for (let i = 0; i < commands.length && found === null; i = i + 1) {
    if (commands[i].keyword === k || (commands[i].keywords && commands[i].keywords.indexOf(k) >= 0)) {
      found = commands[i]
    }
  }
  for (let i = 0; i < config.aliases.length && found === null; i = i + 1) {
    let a = config.aliases[i]
    if (a.alias.toLowerCase() === k && a.run.indexOf('/') !== 0) {
      found = findCommand(a.run)
    }
  }
  if (found === null || isDisabled(found.path) || hasArgs(found)) {
    return null
  }
  let m = found.mode
  if (m === 'system' || m === 'window' || m === 'builtin' || m === 'no-view' || m === 'shortcut' || m === 'view' || m === 'ai' || (m === 'files' && !found.fileAct)) {
    return null
  }
  return found
}

// "kill cursor" → { command: Quit App, query: "cursor" }; null unless the first word is a
// subcommand keyword followed by a space.
fn subcommandMatch(text) {
  let space = text.indexOf(' ')
  if (space <= 0) {
    return null
  }
  let c = subcommandFor(text.slice(0, space))
  return c === null ? null : { command: c, query: text.slice(space + 1).trim() }
}

// The command's own rows for `query`, as its list would show them, marked with the command so
// they are grouped under its name.
fn subcommandRows(c, query) {
  if (c.fileAct) {
    // Files arrive in setQuery (fileVerbFiles), possibly later; nothing synchronous here.
    return []
  }
  if (c.subOf) {
    let pool = commands.filter((x) => x.mode === c.subOf && !isDisabled(x.path))
    let hits = []
    if (query === '') {
      for (let k = 0; k < pool.length; k = k + 1) {
        hits.push({ index: k })
      }
    } else {
      hits = fuzzy(query, pool.map((x) => x.name), pool.length)
    }
    return hits.map((h) => {
      let x = pool[h.index]
      return { name: x.name, path: x.path, icon: x.icon, kind: x.kind, mode: x.mode, layout: x.layout, system: x.system, arg: x.arg, hides: x.hides, confirm: x.confirm, sub: c.name, subCommand: x }
    })
  }
  let saved = shell.mode
  shell.mode = c
  let rows = []
  try {
    rows = listResults(query)
  } catch (e) {
    rows = []
  }
  shell.mode = saved
  return rows.map((r) => {
    r.sub = c.name
    if (c.appAct) {
      r.appAct = c.appAct
      r.kind = c.verb + ' · ' + r.kind
    }
    return r
  })
}

fn enterArgs(c, first) {
  recordUse(c.path)
  let none = c.arguments.map(() => '')
  enterSub({ name: c.name, mode: 'args', pluginTitle: c.pluginTitle, icon: c.icon, cmd: c, values: none, picked: c.arguments.map(() => ''), index: 0 })
  if (first !== '') {
    argEdit(first)
    setQuery(first)
  }
}

fn argAt(i) {
  return shell.mode.cmd.arguments[i]
}

fn argTitle(a) {
  return a.placeholder ? a.placeholder : a.name
}

fn isDropdown(a) {
  return a.type === 'dropdown'
}

fn argEdit(text) {
  let m = shell.mode
  m.values[m.index] = text
  m.picked[m.index] = ''
}

fn argGo(i) {
  let m = shell.mode
  m.index = i
  setQuery(m.values[i])
}

// A picked suggestion's value, else the typed text.
fn argValues(m) {
  let out = {}
  for (let i = 0; i < m.cmd.arguments.length; i = i + 1) {
    out[m.cmd.arguments[i].name] = m.picked[i] !== '' ? m.picked[i] : m.values[i].trim()
  }
  return out
}

// The first required argument still empty (a required dropdown needs a pick), or -1.
fn argMissing(m) {
  for (let i = 0; i < m.cmd.arguments.length; i = i + 1) {
    let a = m.cmd.arguments[i]
    if (a.required === true && (isDropdown(a) ? m.picked[i] === '' : m.values[i].trim() === '')) {
      return i
    }
  }
  return -1
}

fn argSummary(m) {
  let miss = argMissing(m)
  if (miss >= 0) {
    return 'Fill in ' + argTitle(argAt(miss))
  }
  return m.values.map((v) => v.trim()).filter((v) => v !== '').join(' · ')
}

const ARG_CHIP_MAX = 300

// "Send Message › #general": the command and the values of the arguments not being edited.
fn argChip() {
  if (!modeIs('args')) {
    return ''
  }
  let m = shell.mode
  let parts = [m.cmd.name]
  for (let i = 0; i < m.values.length; i = i + 1) {
    let v = m.values[i].trim()
    if (i !== m.index && v !== '') {
      parts.push(v.length > 24 ? v.slice(0, 23) + '…' : v)
    }
  }
  return parts.join(' › ')
}

fn suggestionRow(m, a, s) {
  let row = { name: s.title, kind: s.subtitle ? s.subtitle : '', icon: pluginIcon(s.icon, m.icon), group: argTitle(a) }
  if (s.action) {
    row.mode = 'arg-action'
    row.action = pluginAction(m.cmd, s.action)
  } else {
    row.mode = 'arg-pick'
    row.label = s.title
    row.value = s.value ? String(s.value) : s.title
  }
  return row
}

// A dropdown lists its choices while nothing is picked; a text argument lists the plugin's help
// rows (an action each, "Create the app…") only while its field is empty, so Return on typed text
// still runs the command.
fn argResults(text) {
  let m = shell.mode
  let b = pluginBlocker(m.cmd)
  if (b !== null) {
    return [blockerRow(m.cmd, b)]
  }
  let a = argAt(m.index)
  let rows = []
  if (isDropdown(a) ? m.picked[m.index] === '' : text.trim() === '') {
    let found = []
    try {
      found = m.cmd.plugin.suggest ? m.cmd.plugin.suggest(m.cmd.command, a.name, text, argValues(m)) : []
    } catch (e) {
      shell.hud = 'Plugin error: ' + e.message
    }
    rows = found.slice(0, ROWS - 1).map((s) => suggestionRow(m, a, s))
  }
  // The command row only once it can run, or when nothing else is offered: a row that can only
  // say "fill this in" looks like the way to get it.
  if (argMissing(m) < 0 || rows.length === 0) {
    rows.push({ name: m.cmd.name, kind: argSummary(m), icon: m.icon, mode: 'arg-run', group: m.pluginTitle })
  }
  return rows
}

fn argPick(row) {
  let m = shell.mode
  m.picked[m.index] = row.value
  m.values[m.index] = row.label
}

// Leaving a dropdown with a suggestion selected picks it.
fn argCommit() {
  let m = shell.mode
  let row = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (row !== null && row.mode === 'arg-pick' && isDropdown(argAt(m.index)) && m.picked[m.index] === '') {
    argPick(row)
  }
}

fn argRun() {
  let m = shell.mode
  let b = pluginBlocker(m.cmd)
  if (b !== null) {
    perform(pluginAction(m.cmd, b.action))
    return
  }
  let miss = argMissing(m)
  if (miss >= 0) {
    if (miss !== m.index) {
      argGo(miss)
    }
    shell.hud = 'Fill in ' + argTitle(argAt(miss))
    refresh()
    return
  }
  let c = m.cmd
  c.args = argValues(m)
  leaveSub()
  if (shell.mode === null) {
    setQuery('')
  }
  if (c.mode === 'no-view') {
    runCommand(c)
  } else if (c.mode === 'view') {
    enterView(c)
  } else {
    enterList(c)
  }
}

// Keys while filling in arguments; false for the ones the list handles as usual (↑↓, esc).
fn argKey(name) {
  let m = shell.mode
  let row = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (name === 'tab') {
    argCommit()
    if (m.index < m.cmd.arguments.length - 1) {
      argGo(m.index + 1)
    } else {
      relist()
    }
    return true
  }
  if (name === 'shift+tab' || (name === 'delete-empty' && m.index > 0)) {
    if (m.index > 0) {
      argGo(m.index - 1)
    }
    return true
  }
  if (name === 'enter') {
    if (row !== null && (row.mode === 'blocker' || row.mode === 'arg-action')) {
      perform(row.action)
      return true
    }
    if (row !== null && row.mode === 'arg-pick') {
      argPick(row)
      let next = argMissing(m)
      if (next >= 0) {
        argGo(next)
        return true
      }
    }
    argRun()
    return true
  }
  return false
}

// A plugin row's icon: an https image (fetched and cached), "symbol:<SF Symbol>", an image name,
// else the command's.
fn pluginIcon(icon, fallback) {
  if (!icon) {
    return fallback
  }
  if (icon.indexOf('https://') === 0) {
    return remoteIcon(icon, fallback)
  }
  if (icon.indexOf('symbol:') === 0) {
    return symbolIcon(icon.slice(7))
  }
  return icon
}

fn open(i) {
  if (i < 0 || i >= shell.results.length) {
    return
  }
  let target = shell.results[i]
  if (modeIs('history')) {
    leaveList()
    setQuery(target.query)
    return
  }
  if (target.mode === 'filter') {
    openCategory(target.category, target.query)
    return
  }
  if (target.mode === 'calc') {
    addSearchHistory(shell.query)
    copyText(target.copy)
    hide()
    setQuery('')
    return
  }
  if (target.fileAct) {
    fileAction(target, target.fileAct)
    return
  }
  if (target.subCommand) {
    recordUse(target.subCommand.path)
    openCommand(target.subCommand, '')
    return
  }
  if (target.mode === 'running-app') {
    let verb = target.appAct ? target.appAct : (shell.mode !== null && shell.mode.appAct ? shell.mode.appAct : 'switch')
    if (verb === 'switch' || verb === 'hide' || verb === 'unhide' || verb === 'quit' || verb === 'force-quit') {
      if (shell.mode !== null) {
        runningAction(target, verb)
      } else {
        rootAppAction(target, verb)
      }
    } else {
      appVerb(target, verb)
    }
    return
  }
  if (target.mode === 'define') {
    addSearchHistory(shell.query)
    openDefinition(target.word)
    return
  }
  if (target.mode === 'web-search') {
    if (shell.mode === null) {
      addSearchHistory(shell.query)
    }
    openWebSearch(target.query)
    return
  }
  if (target.mode === 'web-engine') {
    setPref('webEngine', target.engine.id)
    setQuery('')
    shell.hud = target.engine.name + ' is the search engine'
    refresh()
    return
  }
  if (target.mode === 'contacts-allow') {
    allowContacts()
    return
  }
  if (target.mode === 'setting') {
    openSetting(target)
    return
  }
  if (target.mode === 'pin-row') {
    openRowActions(target)
    return
  }
  if (target.mode === 'pin-reset') {
    savePins(DEFAULT_PINS)
    shell.apps = listResults(shell.query)
    compose()
    shell.hud = 'The bar has its four categories again'
    refresh()
    return
  }
  if (target.mode === 'alias') {
    addSearchHistory(shell.query)
    recordUse(target.target.path)
    openCommand(target.target, target.query)
    return
  }
  if (target.mode === 'hk-row') {
    recordFor(target)
    return
  }
  if (target.mode === 'alias-save') {
    saveAlias(target)
    return
  }
  if (target.mode === 'alias-prompt') {
    return
  }
  if (target.mode === 'hk-open-keyboard') {
    openKeyboardSettings()
    return
  }
  if (target.mode === 'ai-model') {
    chooseModel(target.model)
    return
  }
  if (target.mode === 'ai-info') {
    return
  }
  if (target.mode === 'hypery-act') {
    hyperyAct(target.act)
    return
  }
  if (target.mode === 'hypery-org') {
    chooseOrg(target.org)
    return
  }
  if (target.mode === 'ai-key-save') {
    saveKey()
    return
  }
  if (target.mode === 'rowaction') {
    rowAction(target.act)
    return
  }
  if (target.mode === 'hotkey-prompt') {
    return
  }
  if (target.mode === 'contact') {
    enterSub({ name: target.contact.name, mode: 'contact-card', pluginTitle: 'Contacts', icon: contactIcon, contact: target.contact })
    return
  }
  if (target.mode === 'contact-field') {
    contactField(target)
    return
  }
  if (target.mode === 'fileaction') {
    fileAction(shell.mode.file, target.act)
    return
  }
  if (target.mode === 'openwith-app') {
    openWithApp(shell.mode.file, target.app)
    return
  }
  if (shell.query.trim() !== '' && (shell.mode === null || categoryIndex() >= 0)) {
    addSearchHistory(shell.query)
  }
  if (shell.mode !== null && shell.mode.mode === 'view') {
    shell.selected = i
    openViewRow(target)
    return
  }
  if (inFiles()) {
    recordUse(target.path)
    launch(target.path)
    leaveList()
    return
  }
  if (shell.mode !== null && shell.mode.mode === 'create') {
    shell.selected = i
    wizNext()
    return
  }
  if (shell.mode !== null && shell.mode.mode === 'shortcuts') {
    openShortcutsRow(target, 'enter')
    return
  }
  if (modeIs('args')) {
    shell.selected = i
    argKey('enter')
    return
  }
  if (shell.mode !== null && !modeIs('apps') && !modeIs('actions')) {
    perform(target.action)
    return
  }
  if (target.sub && target.action) {
    perform(target.action)
    return
  }
  if (target.mode === 'shortcut') {
    let r = runShortcut(target.shortcut, target.query, null)
    if (r !== 'done' && r !== 'pending') {
      shell.hud = r
      refresh()
    }
    return
  }
  recordUse(target.path)
  if (hasArgs(target)) {
    enterArgs(target, '')
  } else if (target.mode === 'builtin') {
    runBuiltin(target)
  } else if (target.mode === 'system') {
    runSystem(target, target.arg, true)
  } else if (target.mode === 'window') {
    runWindow(target)
  } else if (target.mode === 'ai') {
    enterAi(target, target.question)
  } else if (target.mode === 'create') {
    startWizard(null)
  } else if (target.mode === 'list' || target.mode === 'clipboard' || target.mode === 'files' || target.mode === 'shortcuts' || target.mode === 'hotkeys' || target.mode === 'running' || target.mode === 'dictionary' || target.mode === 'web' || target.mode === 'contacts' || target.mode === 'settings' || target.mode === 'ai-models' || target.mode === 'hypery') {
    enterList(target)
  } else if (target.mode === 'view') {
    enterView(target)
  } else if (target.mode === 'no-view') {
    runCommand(target)
  } else if (target.mode === 'apps' || target.mode === 'actions') {
    openCategory(pinOf(target.mode === 'apps' ? 'moo:apps' : 'moo:actions'), '')
  } else {
    launch(target.path)
    if (shell.mode !== null) {
      leaveList()
    } else {
      setQuery('')
    }
  }
}

fn onAiKey(name) {
  let picked = aiPicked()
  let path = picked !== null ? picked.path : ''
  if (name === 'down' || name === 'up') {
    moveInAi(name === 'down')
  } else if ((name === 'cmd+enter' || name === 'cmd+r') && path !== '') {
    recordUse(path)
    revealFile(path)
    leaveList()
  } else if (name === 'alt+enter' && path !== '') {
    copyText(path)
    shell.hud = 'Copied ' + path
    refresh()
  } else if (name === 'escape' && picked !== null && ai.request === 0) {
    ai.pick = -1
    showAi()
  } else if (name === 'enter' || name === 'cmd+enter' || name === 'alt+enter') {
    if (shell.query.trim() !== '') {
      askAi(shell.query)
    } else if (picked !== null) {
      if (path !== '') {
        recordUse(path)
      }
      perform(picked.action)
    } else if (ai.request === 0 && ai.answer !== '') {
      copyText(ai.answer)
      shell.hud = 'Copied answer'
      refresh()
    }
  } else if (name === 'escape') {
    if (ai.request !== 0) {
      stopAi()
    } else {
      leaveList()
    }
  } else if (name === 'cmd+k' && ai.request === 0) {
    enterSub(modelPicker(true))
  }
}

// ⌘↵ reveals a file in Finder, ⌥↵ copies its path; on other rows both act as ↵.
fn onFileKey(name) {
  let r = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (!isFile(r)) {
    open(shell.selected)
    return
  }
  recordUse(r.path)
  if (name === 'cmd+enter') {
    revealFile(r.path)
    leaveList()
  } else {
    copyText(r.path)
    shell.hud = 'Copied ' + r.path
    refresh()
  }
}

fn modeIs(m) {
  return shell.mode !== null && shell.mode.mode === m
}

// Panel keys arrive as "panel:<spec>" and are handled by the name of the action that has them.
fn onKey(raw) {
  if (raw.indexOf('panel:') === 0) {
    let name = panelKeyName(raw.slice(6))
    if (name !== '') {
      handleKey(name)
    }
    return
  }
  handleKey(raw)
}

fn handleKey(name) {
  // Not a key: app icons finished loading, so redraw any still showing a placeholder.
  if (name === 'icons') {
    refresh()
    return
  }
  if (name.indexOf('scroll:') === 0) {
    scrollBy(Number(name.slice(7)))
    return
  }
  if (name === 'cmd+,') {
    if (!modeIs('settings')) {
      openCommand(SETTINGS, '')
    }
    return
  }
  if (name.indexOf('record:') === 0) {
    if (modeIs('create')) {
      wizRecord(name.slice(7))
    } else if (modeIs('assign-hotkey')) {
      assignRecord(name.slice(7))
    } else {
      recordHotkey(false)
    }
    return
  }
  if (name === 'escape' && hyperyState.signingIn) {
    aiCancelLogin()
    return
  }
  if (name === 'escape' && lookingAt !== '' && quickLookVisible()) {
    quickLook('')
    lookingAt = ''
    return
  }
  if (modeIs('args') && argKey(name)) {
    return
  }
  if ((name === 'escape' || name === 'delete-empty') && shell.mode !== null && shell.mode.back) {
    leaveSub()
    return
  }
  if (name.indexOf('cmd+') === 0 && name.length === 5 && name[4] >= '1' && name[4] <= '6') {
    let n = Number(name[4]) - 1
    if (n < CATEGORIES.length) {
      openCategory(CATEGORIES[n], shell.mode === null ? shell.query : '')
    }
    return
  }
  if (name === 'delete-empty') {
    if (shell.mode !== null && !modeIs('create')) {
      leaveList()
    }
    return
  }
  if (name === 'cmd+l') {
    if (modeIs('apps')) {
      toggleAppsView()
    }
    return
  }
  if (isGrid() && moveInGrid(name)) {
    return
  }
  if (inAi()) {
    onAiKey(name)
    return
  }
  if (isCompact() && (name === 'tab' || name === 'shift+tab')) {
    moveBubble(name === 'tab' ? 1 : -1)
    return
  }
  if (isCompact() && shell.bubble >= 0 && (name === 'enter' || name === 'escape')) {
    if (name === 'enter') {
      openCategory(CATEGORIES[shell.bubble], '')
    } else {
      shell.bubble = -1
      refresh()
    }
    return
  }
  let row = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  let file = fileTarget(row)
  if (file !== null && (name === 'cmd+k' || name === 'cmd+y' || name === 'cmd+o' || name === 'cmd+r' || name === 'cmd+delete')) {
    if (name === 'cmd+k') {
      if (!modeIs('fileactions') && !modeIs('openwith')) {
        enterSub({ name: 'Actions', mode: 'fileactions', pluginTitle: file.name, icon: file.icon, file: file })
      }
    } else {
      fileAction(file, FILE_KEYS[name])
    }
    return
  }
  if (name === 'cmd+k') {
    if (modeIs('rowactions')) {
      leaveSub()
    } else if (row !== null && !modeIs('create') && !modeIs('view') && !modeIs('assign-hotkey') && !modeIs('args') && row.mode !== 'contacts-allow' && row.mode !== 'setting' && row.mode !== 'hotkey-prompt' && row.mode !== 'hk-open-keyboard' && !modeIs('set-alias') && row.mode !== 'ai-model' && row.mode !== 'ai-info' && row.mode !== 'hypery-act' && row.mode !== 'hypery-org' && row.mode !== 'ai-key-save') {
      openRowActions(row)
    }
    return
  }
  if (modeIs('shortcuts') && row !== null && (name === 'cmd+enter' || name === 'alt+enter' || name === 'cmd+delete')) {
    openShortcutsRow(row, name)
    return
  }
  if (modeIs('running') && row !== null && (name === 'cmd+h' || name === 'cmd+delete' || name === 'alt+enter')) {
    runningAction(row, name === 'cmd+h' ? (row.hidden ? 'unhide' : 'hide') : (name === 'cmd+delete' ? 'quit' : 'force-quit'))
    return
  }
  if (modeIs('output') && name === 'cmd+enter') {
    copyText(shell.mode.all)
    shell.hud = 'Copied all output'
    refresh()
    return
  }
  if (modeIs('dictionary') && name === 'cmd+enter') {
    openInDictionary()
    return
  }
  if (modeIs('contact-card') && row !== null && row.act !== 'open' && name === 'alt+enter') {
    copyText(row.value)
    shell.hud = 'Copied ' + row.value
    refresh()
    return
  }
  if (modeIs('create') && name === 'escape') {
    wizBack()
    return
  }
  if (name === 'cmd+delete') {
    return
  }
  if (name === 'cmd+enter' || name === 'alt+enter') {
    onFileKey(name)
    return
  }
  if (name === 'cmd+r') {
    if (row !== null && row.path && row.path[0] === '/') {
      recordUse(row.path)
      revealFile(row.path)
      leaveToRoot()
      setQuery('')
    }
    return
  }
  let n = shell.results.length
  if (name === 'tab') {
    if (shell.mode === null && hasArgs(row)) {
      enterArgs(row, '')
    } else if (shell.mode === null && shell.query.trim() !== '') {
      recordUse(ASK_AI.path)
      enterAi(ASK_AI, shell.query)
    }
  } else if (name === 'up' && n === 0 && isCompact()) {
    openHistory()
  } else if (name === 'down' && n > 0) {
    shell.selected = (shell.selected + 1) % n
    follow()
    refresh()
  } else if (name === 'up' && n > 0) {
    shell.selected = (shell.selected - 1 + n) % n
    follow()
    refresh()
  } else if (name === 'enter') {
    open(shell.selected)
  } else if (name === 'escape') {
    if (shell.mode !== null) {
      leaveList()
    } else if (shell.query !== '') {
      setQuery('')
    } else {
      hide()
    }
  }
}

// Arrows in the grid: ←→ by one icon, ↑↓ by a row (↓ from a row above a shorter last row lands on
// the last icon). They stop at the edges.
fn moveInGrid(name) {
  let n = shell.results.length
  let s = shell.selected
  if (name === 'left') {
    s = Math.max(0, s - 1)
  } else if (name === 'right') {
    s = Math.min(n - 1, s + 1)
  } else if (name === 'down') {
    if (s + GRID_COLS < n) {
      s = s + GRID_COLS
    } else if (Math.floor(s / GRID_COLS) < Math.floor((n - 1) / GRID_COLS)) {
      s = n - 1
    }
  } else if (name === 'up') {
    if (s >= GRID_COLS) {
      s = s - GRID_COLS
    }
  } else {
    return false
  }
  if (n > 0) {
    shell.selected = s
    follow()
    refresh()
  }
  return true
}

// Recompute on show: frecency and clipboard history may have changed while hidden. A message set as
// the panel opened (a command that redirected to its blocker, say) stays.
let hudSetAt = 0

fn onShow(_) {
  shell.bubble = -1
  fieldGreeting = freshGreeting()
  let keep = Date.now() - hudSetAt < 1000 ? shell.hud : ''
  setQuery(shell.query)
  if (keep !== '') {
    shell.hud = keep
    refresh()
  }
}

// ── View ──

fn kindLabel(r) {
  if (r === null) {
    return ''
  }
  return r.kind === 'File' || r.kind === 'Folder' ? r.detail : r.kind
}

// One list slot: a result row, a section heading or filler (1 px children, so `height` alone sizes it).
// Answer rows and headings use the full width; 0 would mean "flex", so unused columns get 1 px.
fn SlotRow(props) {
  let slot = props.slot
  let r = props.result
  let row = slot.kind === 'row'
  let header = slot.kind === 'header'
  let icons = row && !props.wide
  let textH = row || header ? 0 : 1
  let bg = props.selected ? SELECTED : CLEAR
  // The hotkeys list is a table: name, alias, hotkey; each heading names the columns.
  let table = modeIs('hotkeys') && (row || header)
  let widths = icons ? [38, 'flex', 1, 240] : [1, 'flex', 1, 1]
  if (table) {
    widths = icons ? [38, 'flex', THEME.hotkeys.alias, THEME.hotkeys.keys] : [1, 'flex', THEME.hotkeys.alias, THEME.hotkeys.keys]
  }
  let alias = table ? (header ? 'Alias' : (r !== null ? r.alias : '')) : ''
  let detail = table && header ? 'Hotkey' : kindLabel(r)
  return (
    <row
      onClick={() => clickRow(slot.index)}
      borderRadius={THEME.radius.row}
      backgroundColor={bg}
      hoverBackgroundColor={props.selected ? SELECTED : (row && r !== null && r.line !== true ? C.hover : bg)}
      columnWidths={widths}
      alignItems="center"
      height={slot.height}
      paddingLeft={icons ? 10 : 12}
      paddingRight={12}
    ><image src={r !== null ? r.icon : ''} height={row ? THEME.icon.row : 1} /><text
      fontSize={header ? T.section : T.row} fontWeight={header ? THEME.weight.section : THEME.weight.row} color={header || (r !== null && r.dim) ? C.secondaryText : C.text} paddingLeft={icons ? 4 : 0} height={textH} textAlign={props.center ? 'center' : 'left'}
    >{header ? slot.title : (r !== null ? r.name : '')}</text><text fontSize={header ? T.section : T.detail} fontWeight={header ? THEME.weight.section : THEME.weight.row} color={C.secondaryText} textAlign="left" height={table ? textH : 1}>{alias}</text><text fontSize={table && header ? T.section : T.detail} fontWeight={table && header ? THEME.weight.section : THEME.weight.row} color={C.secondaryText} textAlign="right" height={textH}>{detail}</text></row>
  )
}

// Names under grid icons are cut in the middle, as Finder and Spotlight do ("Epic Gam…Launcher").
fn shortName(name) {
  return name.length > 15 ? name.slice(0, 7) + '…' + name.slice(name.length - 7) : name
}

// One icon of the Applications grid: the app's icon over its name, a rounded highlight when
// selected. 1 px tall (no icon, no name) when the grid is not showing.
fn GridCell(props) {
  let r = props.result
  let big = props.height > 1
  return (
    <row onClick={() => clickRow(props.index)} backgroundColor={props.selected ? SELECTED : CLEAR} hoverBackgroundColor={props.selected ? SELECTED : (r !== null && big ? C.hover : CLEAR)} borderRadius={THEME.radius.gridCell} columnWidths={['flex']} alignItems="center" height={props.height} paddingLeft={4} paddingRight={4}
    ><div><image src={r !== null ? r.icon : ''} height={big ? THEME.icon.grid : 0} /><text
      fontSize={T.gridLabel} color={C.text} textAlign="center" paddingTop={big ? 6 : 0} height={big ? 0 : 1}
    >{r !== null ? shortName(r.name) : ''}</text></div></row>
  )
}

fn GridRow(props) {
  let cells = []
  let widths = []
  let cols = GRID_COLS
  for (let c = 0; c < cols; c = c + 1) {
    let i = props.first + c
    let r = props.height > 1 && i < shell.results.length ? shell.results[i] : null
    widths.push('flex')
    cells.push(<GridCell result={r} index={r !== null ? i : -1} height={props.height} selected={r !== null && i === shell.selected} />)
  }
  return <row columnWidths={widths}>{cells}</row>
}

// A pinned bubble of the idle bar, inside the bar's glass. The one selected with tab is filled
// with the system accent colour. 1 px once expanded, and for slots with nothing pinned.
fn CategoryButton(props) {
  let c = props.category
  let shown = props.compact && c !== null
  let on = shown && props.selected
  let src = !shown ? '' : (c.symbol !== '' ? c.symbol : c.icon)
  return (
    <row onClick={() => clickPin(c, props.index)} backgroundColor={on ? C.accent : CLEAR} hoverBackgroundColor={on ? C.accent : (shown ? C.hover : CLEAR)} borderRadius={CAT_W / 2} columnWidths={['flex']} alignItems="center" height={HEADER_H}
    ><image src={src} symbol={shown && c.symbol !== ''} symbolScale={THEME.icon.symbolScale} tint={on ? C.onAccent : C.secondaryText} height={THEME.icon.category} /></row>
  )
}

// tab / shift+tab in the idle bar: field → Applications → … → Clipboard → field.
fn moveBubble(step) {
  let last = CATEGORIES.length - 1
  let next = shell.bubble + step
  if (next > last) {
    next = -1
  } else if (next < -1) {
    next = last
  }
  shell.bubble = next
  refresh()
}

// A key cap ("↵", "⌘K") after its action name, right-aligned in the footer.
fn hintWidths(h) {
  if (h === null) {
    return [1, 1]
  }
  return [Math.ceil(h[0].length * 6.8) + 18, Math.max(22, h[1].length * 10 + 14)]
}

fn HintLabel(props) {
  return <text fontSize={T.hint} color={C.secondaryText} textAlign="right" paddingRight={7}>{props.hint !== null ? props.hint[0] : ''}</text>
}

// Footer key caps are buttons too: a click does what the key does.
let KEYCAP_KEYS = { '↵': 'enter', '⌘↵': 'cmd+enter', '⌥↵': 'alt+enter', 'esc': 'escape', '⌘R': 'cmd+r', '⌘L': 'cmd+l', '⇥': 'tab', '⌘⌫': 'cmd+delete', '⌘Y': 'cmd+y', '⌘K': 'cmd+k', '⌘O': 'cmd+o' }

// A click on a result row opens it; a right-click (or control-click) selects it and opens its
// actions, as ⌘K does.
fn clickRow(i) {
  if (!isRightClick()) {
    open(i)
    return
  }
  if (modeIs('rowactions') || modeIs('fileactions') || i >= shell.results.length) {
    return
  }
  shell.selected = i
  handleKey('cmd+k')
}

// A click on a pinned bubble opens it; a right-click lists Unpin, Move Left and Move Right.
fn clickPin(c, i) {
  if (c === null) {
    return
  }
  if (!isRightClick()) {
    openCategory(c, '')
    return
  }
  let row = { name: c.title, icon: c.symbol !== '' ? symbolIcon(c.symbol) : c.icon, mode: 'pin-row', path: c.id, pinIndex: i }
  leaveToRoot()
  openRowActions(row)
}

fn clickHint(h) {
  if (h === null) {
    return
  }
  let panel = panelKeyName(h[1])
  let key = panel !== '' ? panel : KEYCAP_KEYS[h[1]]
  if (key !== null) {
    handleKey(key)
  }
}

fn HintKey(props) {
  let h = props.hint
  return (
    <row onClick={() => clickHint(h)} backgroundColor={h !== null ? C.keycap : CLEAR} hoverBackgroundColor={h !== null ? C.keycapHover : CLEAR} borderRadius={THEME.radius.keycap} alignItems="center" height={20} paddingLeft={4} paddingRight={4}
    ><text fontSize={T.keycap} fontWeight={THEME.weight.keycap} color={C.secondaryText} textAlign="center">{h !== null ? h[1] : ''}</text></row>
  )
}

fn primaryAction(r) {
  if (r === null) {
    return 'Open'
  }
  if (r.kind === 'Application') {
    return 'Open Application'
  }
  if (r.kind === 'Command') {
    return 'Run Command'
  }
  if (r.mode === 'system') {
    return r.confirm ? (confirmingRow() !== null ? 'Confirm ' + r.name : r.name) : 'Run'
  }
  if (r.mode === 'window') {
    return 'Arrange Window'
  }
  if (r.mode === 'ai') {
    return 'Ask AI'
  }
  if (r.mode === 'calc') {
    return 'Copy Answer'
  }
  if (r.mode === 'define') {
    return 'Show Definition'
  }
  if (r.mode === 'web-search') {
    return 'Search the Web'
  }
  if (r.mode === 'shortcut' && r.shortcut.kind === 'text') {
    return 'Copy Text'
  }
  return 'Open'
}

// [[action, key], ...] for the footer, most important first, with panel keys as they are now.
fn footerHints() {
  return defaultHints().map((h) => [h[0], currentKey(h[1])]).filter((h) => h[1] !== '')
}

fn defaultHints() {
  let r = shell.selected < shell.results.length ? shell.results[shell.selected] : null
  if (modeIs('output')) {
    return [['Copy Line', '↵'], ['Copy All', '⌘↵'], ['Back', 'esc']]
  }
  if (modeIs('create')) {
    return wiz.step === 'hotkey' ? [['Save', '↵'], ['Clear', '⌫'], ['Back', 'esc']] : [['Next', '↵'], ['Back', 'esc']]
  }
  if (modeIs('shortcuts')) {
    return [['Run', '↵'], ['Edit', '⌘↵'], ['Delete', '⌘⌫']]
  }
  if (modeIs('hotkeys')) {
    return [[r !== null && r.kind !== '' && r.kind !== 'Off' ? 'Change Hotkey' : 'Record Hotkey', '↵'], ['Alias, Disable…', '⌘K'], ['Back', 'esc']]
  }
  if (modeIs('set-alias')) {
    return [['Save', '↵'], ['Back', 'esc']]
  }
  if (inAi()) {
    if (ai.request !== 0) {
      return [['Stop', 'esc']]
    }
    let picked = aiPicked()
    if (picked !== null && shell.query === '') {
      if (picked.action && picked.action.fix) {
        return [[picked.name.length <= 24 ? picked.name : 'Fix', '↵'], ['Back', 'esc']]
      }
      if (picked.path === '') {
        return [['Copy', '↵'], ['Deselect', 'esc']]
      }
      return [['Open', '↵'], ['Show in Finder', '⌘↵'], ['Copy Path', '⌥↵']]
    }
    if (ai.answer !== '' && shell.query === '') {
      return [['Copy Answer', '↵'], [ai.items.length > 0 ? 'Results' : 'Scroll', '↑↓'], ['Back', 'esc']]
    }
    return [['Ask', '↵'], ['Model', '⌘K'], ['Back', 'esc']]
  }
  if (modeIs('ai-models')) {
    return [['Use Model', '↵'], ['Back', 'esc']]
  }
  if (modeIs('hypery')) {
    return hyperyState.signingIn ? [['Cancel Sign-In', 'esc']] : [['Open', '↵'], ['Back', 'esc']]
  }
  if (modeIs('hypery-orgs')) {
    return [['Use Team', '↵'], ['Back', 'esc']]
  }
  if (modeIs('ai-key')) {
    return [['Save', '↵'], ['Back', 'esc']]
  }
  if (r !== null && r.mode === 'blocker' && !modeIs('args')) {
    return [[r.name.length <= 24 ? r.name : 'Open', '↵'], ['Back', 'esc']]
  }
  if (modeIs('args')) {
    let last = shell.mode.index === shell.mode.cmd.arguments.length - 1
    if (r !== null && (r.mode === 'blocker' || r.mode === 'arg-action')) {
      return [[r.name.length <= 24 ? r.name : 'Open', '↵'], ['Back', 'esc']]
    }
    return [[r !== null && r.mode === 'arg-pick' ? 'Choose' : 'Run', '↵'], [last ? 'Previous' : 'Next', last ? '⇧⇥' : '⇥'], ['Back', 'esc']]
  }
  if (modeIs('fileactions') || modeIs('rowactions')) {
    return [['Run', '↵'], ['Back', 'esc']]
  }
  if (modeIs('assign-hotkey') && systemConflict(shell.mode)) {
    return [['Open Keyboard Settings', '↵'], ['Clear', '⌫'], ['Back', 'esc']]
  }
  if (modeIs('assign-hotkey')) {
    return [['Save', '↵'], [shell.mode.current !== '' && shell.mode.keys === '' && !shell.mode.launcher ? 'Remove' : 'Clear', '⌫'], ['Back', 'esc']]
  }
  if (modeIs('openwith')) {
    return [['Open', '↵'], ['Back', 'esc']]
  }
  if (inFiles() || isFile(r)) {
    return [['Open', '↵'], ['Quick Look', '⌘Y'], ['Actions', '⌘K']]
  }
  if (modeIs('history')) {
    return [['Search', '↵'], ['Back', 'esc']]
  }
  if (modeIs('running')) {
    return [['Switch To', '↵'], [r !== null && r.hidden ? 'Show' : 'Hide', '⌘H'], ['Quit', '⌘⌫']]
  }
  if (modeIs('dictionary')) {
    return shell.mode.entry !== null ? [['Copy', '↵'], ['Open in Dictionary', '⌘↵'], ['Back', 'esc']] : [['Back', 'esc']]
  }
  if (modeIs('web')) {
    return [[r !== null && r.mode === 'web-engine' ? 'Make Default' : 'Search', '↵'], ['Back', 'esc']]
  }
  if (modeIs('settings')) {
    return [[r !== null && r.act === 'appsview' ? 'Switch' : 'Open', '↵'], ['Back', 'esc']]
  }
  if (modeIs('contacts')) {
    return [[r !== null && r.mode === 'contacts-allow' ? (contactsAccess() === 'notDetermined' ? 'Allow' : 'Open Settings') : 'Show Contact', '↵'], ['Back', 'esc']]
  }
  if (modeIs('contact-card')) {
    if (r === null || r.act === 'open') {
      return [['Open', '↵'], ['Back', 'esc']]
    }
    return [[r.act === 'mail' ? 'Email' : 'Call', '↵'], ['Copy', '⌥↵'], ['Back', 'esc']]
  }
  if (modeIs('apps')) {
    return [[primaryAction(r), '↵'], ['Actions', '⌘K'], [appsView === 'grid' ? 'List View' : 'Grid View', '⌘L']]
  }
  if (r !== null && r.kind === 'Application') {
    return [[primaryAction(r), '↵'], ['Actions', '⌘K'], shell.mode !== null ? ['Back', 'esc'] : ['Ask AI', '⇥']]
  }
  if (shell.mode !== null && !modeIs('actions')) {
    return [[shell.mode.mode === 'clipboard' ? 'Copy' : 'Run', '↵'], ['Back', 'esc']]
  }
  if (r !== null && r.mode === 'filter') {
    return [['Filter', '↵'], ['Clear', 'esc']]
  }
  if (shell.mode === null && hasArgs(r)) {
    return [[primaryAction(r), '↵'], ['Actions', '⌘K'], ['Fill In', '⇥']]
  }
  if (shell.mode === null && shell.query.trim() !== '') {
    return [[primaryAction(r), '↵'], ['Actions', '⌘K'], ['Ask AI', '⇥']]
  }
  return [[primaryAction(r), '↵'], ['Back', 'esc']]
}

fn sectionTitle() {
  if (inAi()) {
    return aiTitle()
  }
  if (inFiles()) {
    return shell.query.trim() === '' ? 'Recent Files' : 'Files'
  }
  if (modeIs('create')) {
    return wiz.editing !== '' ? 'Edit Shortcut' : 'Create Shortcut'
  }
  if (shell.mode !== null) {
    if (shell.view !== null && shell.view.list !== null && propText(shell.view.list, 'navigationTitle') !== '') {
      return propText(shell.view.list, 'navigationTitle')
    }
    return shell.mode.name
  }
  return shell.query.trim() === '' ? 'Suggestions' : 'Results'
}

// The root placeholder, a new cow pun each time the panel opens (greetings.tish).
fn freshGreeting() {
  let now = expandTemplate('{date} {time}', '', 'text').split(' ')
  return greeting(now[0], now.length > 1 ? now[1] : '', Math.random())
}
let fieldGreeting = freshGreeting()

fn placeholder() {
  if (inAi()) {
    return ai.answer !== '' ? 'Ask a follow-up…' : 'Ask anything…'
  }
  if (modeIs('hotkeys')) {
    return 'Search commands, apps and aliases…'
  }
  if (modeIs('set-alias')) {
    return 'Alias, like cb'
  }
  if (modeIs('args')) {
    let a = argAt(shell.mode.index)
    return argTitle(a) + (a.required === true ? '' : ' (optional)')
  }
  let cat = categoryIndex()
  if (cat >= 0) {
    return 'Search ' + CATEGORIES[cat].title
  }
  if (modeIs('history')) {
    return 'Search Recent Searches'
  }
  if (modeIs('web')) {
    return 'Search ' + webEngine().name + '…'
  }
  if (modeIs('dictionary')) {
    return 'Look up a word…'
  }
  if (modeIs('contacts')) {
    return 'Search Contacts…'
  }
  if (modeIs('assign-hotkey')) {
    return 'Press a key combination…'
  }
  if (modeIs('ai-models')) {
    return 'Search models: Claude, Grok, Gemini, GPT…'
  }
  if (modeIs('ai-key')) {
    return 'Paste your ' + providerTitle(shell.mode.provider) + ' API key…'
  }
  if (shell.view !== null && shell.view.list !== null && propText(shell.view.list, 'searchBarPlaceholder') !== '') {
    return propText(shell.view.list, 'searchBarPlaceholder')
  }
  if (shell.mode !== null) {
    return 'Search ' + shell.mode.name + '…'
  }
  return fieldGreeting
}

fn aiStatusText() {
  let q = ai.question.length > 32 ? ai.question.slice(0, 32) + '…' : ai.question
  if (ai.error !== '') {
    return q !== '' ? ai.error + ' · “' + q + '”' : ai.error
  }
  let lay = aiLayout()
  let lines = lay.lines.length
  let more = lines > lay.shown ? ' · lines ' + (ai.scroll + 1) + '–' + Math.min(lines, ai.scroll + lay.shown) + ' of ' + lines : ''
  if (ai.pick >= 0) {
    more = ' · ' + (ai.pick + 1) + ' of ' + ai.items.length + ' ' + ai.itemsTitle.toLowerCase()
  }
  if (ai.request !== 0) {
    return aiTitle() + ' · ' + (ai.answer === '' ? 'thinking' : 'answering') + more + ' · “' + q + '”'
  }
  if (ai.answer !== '') {
    let took = (ai.stopped ? 'stopped after ' : '') + (ai.ms / 1000).toFixed(1) + ' s'
    return aiTitle() + ' · ' + took + more + ' · “' + q + '”'
  }
  return aiTitle() + ' · ' + aiWhere() + ' · type a question'
}

fn shortCount(n) {
  if (n >= 1000000) {
    return (n / 1000000).toFixed(1) + 'M'
  }
  return n >= 1000 ? Math.round(n / 1000) + 'K' : '' + n
}

fn fileStatus() {
  let s = fileIndexStatus()
  if (s.state !== 'ready') {
    return 'indexing (Spotlight meanwhile)'
  }
  let n = shell.results.length
  if (shell.query.trim() === '') {
    return shortCount(s.entries) + ' items indexed · ' + (n === 0 ? 'no recent files' : 'recent')
  }
  let count = n === 0 ? 'No matches' : (n > ROWS ? (shell.selected + 1) + ' of ' + n : n + ' matches')
  return count + (shell.fileMs >= 0 ? ' · ' + shell.fileMs.toFixed(1) + ' ms' : '')
}

fn statusText() {
  let pending = confirmingRow()
  if (pending !== null) {
    return 'Press Return again to ' + pending.name
  }
  let forced = forcingRow()
  if (forced !== null) {
    return 'Press ⌥↵ again to force quit ' + forced.name + ' (unsaved changes are lost)'
  }
  let toTrash = trashingFile()
  if (toTrash !== null) {
    let short = toTrash.name.length > 28 ? toTrash.name.slice(0, 27) + '…' : toTrash.name
    return 'Press ' + (modeIs('fileactions') ? 'Return' : '⌘⌫') + ' again to trash “' + short + '”'
  }
  if (shell.hud !== '') {
    return shell.hud
  }
  if (inAi()) {
    return aiStatusText()
  }
  let where = shell.mode !== null ? shell.mode.pluginTitle + ' › ' + shell.mode.name : 'Moo'
  if (shell.view !== null && shell.view.list !== null && propText(shell.view.list, 'navigationTitle') !== '') {
    where = shell.mode.pluginTitle + ' › ' + propText(shell.view.list, 'navigationTitle')
  }
  if (inFiles()) {
    return where + ' · ' + fileStatus()
  }
  if (modeIs('create')) {
    let title = wiz.editing !== '' ? 'Edit Shortcut' : 'Create Shortcut'
    return title + ' · step ' + wizStepNumber() + ' of 5' + (wiz.step !== 'kind' ? ' · ' + kindInfo(wiz.kind).title : '')
  }
  if (modeIs('shortcuts')) {
    let broken = 0
    for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
      if (hotkeyStatus[i].error !== '') {
        broken = broken + 1
      }
    }
    return where + ' · ' + config.shortcuts.length + ' shortcuts · ' + (hotkeyStatus.length - broken) + ' hotkeys' + (broken > 0 ? ' · ' + broken + ' not active' : '')
  }
  if (modeIs('web') && shell.hud === '') {
    let t = shell.query.trim()
    let more = t === '' ? 'Return makes one the default' : (shell.mode.error !== '' && shell.mode.suggested === t ? 'no suggestions (offline?)' : (shell.mode.suggested === t ? shell.mode.suggestions.length + ' suggestions' : 'suggesting…'))
    return where + ' · ' + webEngine().name + ' · ' + more
  }
  if (modeIs('contacts')) {
    let m = shell.mode
    let more = !contactsAllowed() ? 'no access' : (m.error !== '' ? m.error : (m.searched !== shell.query.trim() ? 'searching…' : m.results.length + (m.results.length === 1 ? ' contact' : ' contacts')))
    return where + ' · ' + more
  }
  if (modeIs('contact-card')) {
    let d = contactDetail(shell.mode.contact)
    return where + (d !== '' ? ' · ' + d : '')
  }
  if (modeIs('dictionary') && shell.mode.entry !== null) {
    let e = shell.mode.entry
    let count = e.senses.length + (e.senses.length === 1 ? ' sense' : ' senses')
    return where + ' · ' + e.word + (e.pronunciation !== '' ? ' · ' + e.pronunciation : '') + ' · ' + count
  }
  if (modeIs('output')) {
    let r = shell.mode.result
    let state = r === null ? 'running' : (r.timedOut ? 'timed out' : 'exit ' + r.code) + ' · ' + Math.round(r.ms) + ' ms · ' + shell.mode.lines.length + ' lines'
    return where + ' · ' + state
  }
  if (shell.results.length === 0) {
    return where + ' · No matches'
  }
  if (shell.results.length > ROWS) {
    return where + ' · ' + (shell.selected + 1) + ' of ' + shell.results.length
  }
  if (shell.mode === null && shell.query === '') {
    return where + ' · ' + appCount() + ' apps · ' + commands.length + ' commands'
  }
  return where + ' · ' + shell.results.length + ' matches'
}

fn App() {
  let [version, setVersion] = useState(0)
  shell.rerender = setVersion

  let compact = isCompact()
  let wide = wideRows()
  let grid = isGrid()
  // In the grid the slots are just the heading; the grid rows below share what is left.
  let lay = grid ? { slots: [{ kind: 'header', index: -1, title: sectionTitle(), height: SECTION_H }], used: SECTION_H } : layoutSlots(shell.offset)
  let slots = lay.slots
  // Filler: the first takes the unused height, the rest 1 px each, so the list height is constant.
  let total = SLOTS
  let spare = grid ? 1 : LIST_H + total - lay.used - (total - slots.length - 1)
  let rows = []
  for (let i = 0; i < total; i = i + 1) {
    let slot = i < slots.length ? slots[i] : { kind: 'blank', index: -1, title: '', height: i === slots.length ? spare : 1 }
    let r = slot.kind === 'row' ? shell.results[slot.index] : null
    if (isFile(r) && r.icon === '') {
      r.icon = fileIcon(r.path)
    }
    let pickable = !inAi() || (r !== null && r.item && ai.pick >= 0)
    rows.push(<SlotRow slot={slot} result={r} selected={pickable && r !== null && slot.index === shell.selected} wide={wide && !(r !== null && r.item)} center={grid} />)
  }
  let gridSpace = LIST_H + total + GRID_ROWS - SECTION_H - (total - 1)
  let gridRows = GRID_ROWS
  let gridH = Math.floor(gridSpace / gridRows)
  for (let g = 0; g < gridRows; g = g + 1) {
    let h = !grid ? 1 : (g === gridRows - 1 ? gridSpace - gridH * (gridRows - 1) : gridH)
    rows.push(<GridRow first={shell.offset + g * GRID_COLS} height={h} />)
  }

  let hints = footerHints()
  let widths = ['flex']
  let cells = []
  let slots = HINT_SLOTS
  for (let i = 0; i < slots; i = i + 1) {
    let h = i < hints.length ? hints[i] : null
    let w = hintWidths(h)
    widths.push(w[0])
    widths.push(w[1])
    cells.push(<HintLabel hint={h} />)
    cells.push(<HintKey hint={h} />)
  }
  // Header: search icon (the category's symbol inside a category), field, 4 category buttons.
  let cat = categoryIndex()
  let inset = 14
  // Gaps are their own columns, so each button's row is exactly its circle. The spinner is always
  // there (changing the tree's shape would rebuild the field); while busy it takes the icon's width.
  let spin = busy()
  let iconW = spin ? 1 : 52
  let spinW = spin ? 52 : 1
  // The command whose arguments are being filled in, and the others' values, before the field.
  let chip = argChip()
  let chipW = chip === '' ? 1 : Math.min(ARG_CHIP_MAX, Math.round(chip.length * 7.5) + 18)
  // PIN_MAX gap + bubble column pairs, whatever is pinned (the tree keeps its shape); unused
  // slots are 1 px, and the field takes the rest.
  let pinCols = []
  let pinned = CATEGORIES.length
  // A local bound: tish lowers `i < GLOBAL` loops to a range over the global's bare name.
  let slots = PIN_MAX
  for (let i = 0; i < slots; i = i + 1) {
    if (!compact) {
      pinCols.push(i === 0 ? inset : 1)
      pinCols.push(1)
    } else if (i < pinned) {
      pinCols.push(i === 0 ? inset + CAT_GAP : CAT_GAP)
      pinCols.push(CAT_W)
    } else {
      pinCols.push(i === 0 && pinned === 0 ? inset : 1)
      pinCols.push(1)
    }
  }
  let rest = pinCols.reduce((a, b) => a + b, 0)
  let headerWidths = [iconW, spinW, chipW, compact ? PANEL_W - iconW - spinW - chipW - rest : 'flex'].concat(pinCols)
  let buttons = []
  for (let i = 0; i < slots; i = i + 1) {
    buttons.push(<space />)
    buttons.push(<CategoryButton category={i < pinned ? CATEGORIES[i] : null} index={i} compact={compact} selected={shell.bubble === i} />)
  }
  let header = (
    <row columnWidths={headerWidths} alignItems="center" height={HEADER_H} backgroundColor={CLEAR}
    ><image src={cat >= 0 ? (CATEGORIES[cat].symbol !== '' ? CATEGORIES[cat].symbol : CATEGORIES[cat].icon) : fieldIcon} symbol={cat >= 0 ? CATEGORIES[cat].symbol !== '' : fieldIconSymbol} symbolScale={THEME.icon.symbolScale} tint={cat >= 0 ? C.accent : C.secondaryText} height={spin ? 1 : THEME.icon.field} /><progress_bar indeterminate={true} /><text fontSize={T.row} fontWeight={THEME.weight.section} color={C.accent}>{chip}</text><textinput value={shell.query} onChange={onFieldChange} bezeled={false} fontSize={T.field} placeholder={placeholder()} />{buttons}</row>
  )
  let footer = (
    <row columnWidths={widths} alignItems="center" height={FOOTER_H} paddingLeft={18} paddingRight={12} backgroundColor={CLEAR}
    ><text fontSize={T.status} color={C.secondaryText}>{statusText()}</text>{cells}</row>
  )
  // The divider under the header is a plain 1 px row, clear while collapsed: the bar's shape ends
  // right below it, and a system separator (<rule>) draws its line whatever its height. It stays
  // in the tree either way (changing the tree's shape would rebuild the field).
  // The list's height: SLOTS slots and GRID_ROWS grid rows, with the 1 px ones, in either view.
  let listH = LIST_H + total + GRID_ROWS
  let bar = THEME.scrollbar
  return (
    <div>{header}<row columnWidths={['flex']} height={1} backgroundColor={compact ? CLEAR : C.divider}><space height={1} /></row><div paddingLeft={8} paddingRight={2} paddingTop={LIST_PAD} paddingBottom={LIST_PAD}
    ><row columnWidths={['flex', bar.gap + bar.width]} height={listH}><div>{rows}</div><ScrollBar scroll={scrollState(lay)} height={listH} /></row></div><rule />{footer}</div>
  )
}

// ── Command line: `moo <command>` from a terminal, script or hotkey daemon ──

fn cliOut(token, text) {
  cliWrite(token, text, 'out')
}

fn cliFail(token, message) {
  cliWrite(token, 'moo: ' + message + '\n', 'err')
  cliEnd(token, 1)
}

// Words plus flags: --json, --expand, --contents, -n N, --name N, --hotkey K, --output O, --input T.
fn cliParse(argv) {
  let words = []
  let flags = { json: false, expand: false, contents: false, n: 0, name: '', hotkey: '', output: '', input: '', model: '' }
  for (let i = 0; i < argv.length; i = i + 1) {
    let a = argv[i]
    if (a === '--json') {
      flags.json = true
    } else if (a === '--expand') {
      flags.expand = true
    } else if (a === '--contents') {
      flags.contents = true
    } else if ((a === '-n' || a === '--limit') && i + 1 < argv.length) {
      flags.n = Number(argv[i + 1])
      i = i + 1
    } else if ((a === '--name' || a === '--hotkey' || a === '--output' || a === '--input' || a === '--model') && i + 1 < argv.length) {
      flags[a.slice(2)] = argv[i + 1]
      i = i + 1
    } else {
      words.push(a)
    }
  }
  return { words: words, flags: flags }
}

fn cliLimit(flags, fallback) {
  return flags.n > 0 ? flags.n : fallback
}

// Relative paths are resolved against the caller's working directory.
fn cliPath(target, cwd) {
  if (target.indexOf('://') > 0 || target[0] === '/') {
    return target
  }
  if (target === '~' || target.indexOf('~/') === 0) {
    return HOME + target.slice(1)
  }
  let parts = []
  let segs = (cwd + '/' + target).split('/')
  for (let i = 0; i < segs.length; i = i + 1) {
    if (segs[i] === '..') {
      parts.pop()
    } else if (segs[i] !== '' && segs[i] !== '.') {
      parts.push(segs[i])
    }
  }
  return '/' + parts.join('/')
}

fn printFiles(token, results, json) {
  if (json) {
    cliOut(token, JSON.stringify(results.map((r) => ({ name: r.name, path: r.path, kind: r.kind, score: r.score }))) + '\n')
  } else {
    for (let i = 0; i < results.length; i = i + 1) {
      cliOut(token, results[i].path + '\n')
    }
  }
  cliEnd(token, results.length > 0 ? 0 : 1)
}

fn cliFiles(token, query, flags) {
  if (query.trim() === '') {
    cliFail(token, 'usage: moo files <query>')
    return
  }
  let limit = cliLimit(flags, 20)
  if (flags.contents) {
    searchContents(query, limit, (r) => printFiles(token, r.results, flags.json))
    return
  }
  let f = findFiles(query, limit, 0)
  if (f.ready) {
    printFiles(token, f.results, flags.json)
    return
  }
  searchFiles(query, limit, (r) => printFiles(token, r.results, flags.json))
}

fn cliTrash(token, target, cwd) {
  if (target === '') {
    cliFail(token, 'usage: moo trash <path>')
    return
  }
  let r = trashFile(cliPath(target, cwd))
  if (!r.ok) {
    cliFail(token, r.error)
    return
  }
  cliOut(token, r.message + '\n')
  cliEnd(token, 0)
}

// `moo open-with <path>` lists the apps that open it (the default marked *); with an app name
// or path it opens the file in that app.
fn cliOpenWith(token, w, cwd) {
  if (w.length < 2) {
    cliFail(token, 'usage: moo open-with <path> [app]')
    return
  }
  let path = cliPath(w[1], cwd)
  let apps = appsFor(path)
  if (w.length === 2) {
    cliOut(token, apps.map((a) => (a.isDefault ? '* ' : '  ') + a.name + '\t' + a.path).join('\n') + (apps.length > 0 ? '\n' : ''))
    cliEnd(token, apps.length > 0 ? 0 : 1)
    return
  }
  let want = w.slice(2).join(' ')
  let app = want.indexOf('/') >= 0 ? cliPath(want, cwd) : ''
  for (let i = 0; i < apps.length && app === ''; i = i + 1) {
    if (apps[i].name.toLowerCase() === want.toLowerCase()) {
      app = apps[i].path
    }
  }
  if (app === '') {
    cliFail(token, 'no app called “' + want + '” opens ' + path + ' (moo open-with ' + w[1] + ')')
    return
  }
  let r = openWith(path, app)
  if (!r.ok) {
    cliFail(token, r.error)
    return
  }
  cliEnd(token, 0)
}

fn cliAsk(token, question, model) {
  if (question.trim() === '') {
    cliFail(token, 'usage: moo ask [--model provider:model] <question>')
    return
  }
  let m = model !== '' ? model : currentModel()
  if (isRemote(m)) {
    let t = newTurn(m, [{ role: 'system', content: AI_INSTRUCTIONS }, { role: 'user', content: question.trim() }], cliAiTool(freshToolGate(m, question)), onCliTurn)
    t.token = token
    t.printed = 0
    turnSend(t)
    return
  }
  let why = aiAvailability()
  if (why !== 'available') {
    cliFail(token, AI_TITLE + ' is unavailable: ' + why)
    return
  }
  let session = aiSession(AI_INSTRUCTIONS, aiTools(), cliAiTool(freshToolGate(APPLE_MODEL, question)))
  let printed = { n: 0 }
  let request = aiAsk(session, question, (e) => {
    if (e.kind === 'error') {
      aiEndSession(session)
      cliFail(token, aiErrorText(e.text))
      return
    }
    if (e.text.length > printed.n) {
      cliOut(token, e.text.slice(printed.n))
      printed.n = e.text.length
    }
    if (e.kind !== 'partial') {
      cliOut(token, '\n')
      aiEndSession(session)
      cliEnd(token, 0)
    }
  })
  if (request === 0) {
    aiEndSession(session)
    cliFail(token, 'the model is busy')
  }
}

// Prints the reply as it streams; text from before a tool round stays on its own line.
fn onCliTurn(t, e) {
  if (e.kind === 'error') {
    cliFail(t.token, remoteErrorText(t.model, e.text))
    return
  }
  if (e.text.length > t.printed) {
    cliOut(t.token, e.text.slice(t.printed))
    t.printed = e.text.length
  }
  if (e.kind === 'partial') {
    return
  }
  if (e.kind === 'tools') {
    if (t.printed > 0) {
      cliOut(t.token, '\n')
    }
    t.printed = 0
    return
  }
  cliOut(t.token, t.printed > 0 ? '\n' : '')
  cliEnd(t.token, e.kind === 'done' ? 0 : 1)
}

fn credentialLabel(p) {
  if (p.id === APPLE_MODEL) {
    let why = aiAvailability()
    return why === 'available' ? 'available' : 'unavailable: ' + why
  }
  if (p.credential === 'signed in') {
    return 'signed in'
  }
  if (p.credential === 'key') {
    return 'API key in the Keychain'
  }
  if (p.credential === 'environment') {
    return 'API key from the environment'
  }
  return p.local ? 'local' : 'not signed in'
}

// `moo ai`: the model Ask AI uses and each provider's state.
fn cliAiStatus(token) {
  let m = currentModel()
  let lines = ['model\t' + m + (config.aiModel ? '' : ' (default)')]
  for (let i = 0; i < aiProvs.length; i = i + 1) {
    let p = aiProvs[i]
    lines.push(p.id + '\t' + p.title + '\t' + credentialLabel(p))
  }
  cliOut(token, lines.join('\n') + '\n')
  cliEnd(token, 0)
}

fn cliAiModels(token, query, flags) {
  aiModels((lists) => {
    onCatalog(lists)
    let q = query.toLowerCase()
    let current = currentModel()
    let all = (HAS_ON_DEVICE_AI ? [{ model: APPLE_MODEL, name: AI_TITLE, owner: 'apple', tier: 'Free', context: 0 }] : []).concat(aiCatalog.models)
    let hits = all.filter((e) => q === '' || (e.model + ' ' + e.name + ' ' + ownerLabel(e.owner)).toLowerCase().indexOf(q) >= 0)
    let shown = flags.n > 0 ? hits.slice(0, flags.n) : hits
    if (flags.json) {
      cliOut(token, JSON.stringify(shown.map((e) => ({ model: e.model, name: e.name, owner: e.owner, tier: e.tier, context: e.context, current: e.model === current }))) + '\n')
    } else {
      cliOut(token, shown.map((e) => (e.model === current ? '* ' : '  ') + e.model + '\t' + e.name + '\t' + ownerLabel(e.owner) + (e.tier !== '' ? '\t' + e.tier : '')).join('\n') + (shown.length > 0 ? '\n' : ''))
      if (aiCatalog.errors.length > 0) {
        cliOut(token, '# ' + aiCatalog.errors.join('\n# ') + '\n')
      }
    }
    cliEnd(token, shown.length > 0 ? 0 : 1)
  })
}

fn cliAiUsage(token, provider) {
  aiAccount(provider, (a) => {
    let team = a.orgs.filter((o) => o.id === a.organization)
    if (a.error !== '') {
      cliFail(token, providerTitle(provider) + (team.length > 0 ? ' team ' + orgTitle(team[0]) : '') + ': ' + a.error)
      return
    }
    let who = accountWho(a) !== '' ? 'signed in as ' + accountWho(a) : (a.credential === 'key' ? 'API key' : (a.credential === 'environment' ? 'API key from the environment' : a.credential))
    let lines = [providerTitle(provider) + ': ' + who]
    if (team.length > 0) {
      lines.push('team\t' + orgTitle(team[0]) + (a.orgs.length > 1 ? '  (moo ai team to switch)' : ''))
    }
    lines.push('balance\t' + money(a.balance))
    if (a.monthSpent >= 0) {
      lines.push('this month\t' + money(a.monthSpent) + (a.monthLimit > 0 ? ' of ' + money(a.monthLimit) : ''))
    }
    lines.push('billing\t' + a.billing)
    cliOut(token, lines.join('\n') + '\n')
    cliEnd(token, 0)
  })
}

// `moo ai team`: Hypery's teams (* current); `moo ai team <name|slug>` switches to one.
fn cliAiTeam(token, want) {
  aiAccount('hypery', (a) => {
    if (a.orgs.length === 0) {
      cliFail(token, 'Hypery: ' + (a.error !== '' ? a.error : 'no teams'))
      return
    }
    if (want === '') {
      cliOut(token, a.orgs.map((o) => (o.id === a.organization ? '* ' : '  ') + orgTitle(o) + '\t' + o.slug + (o.personal ? '\tpersonal' : '')).join('\n') + '\n')
      cliEnd(token, 0)
      return
    }
    let w = want.toLowerCase()
    let m = a.orgs.filter((o) => o.slug.toLowerCase() === w || orgTitle(o).toLowerCase() === w || o.id === want)
    if (m.length === 0) {
      cliFail(token, 'no team called “' + want + '” (moo ai team)')
      return
    }
    let r = aiSetOrganization('hypery', m[0].personal ? '' : m[0].id)
    if (!r.ok) {
      cliFail(token, 'Could not switch team: ' + r.error)
      return
    }
    hyperyState.account = null
    cliOut(token, 'Hypery uses team ' + orgTitle(m[0]) + '\n')
    cliEnd(token, 0)
  })
}

fn cliAi(token, w, flags) {
  let sub = w.length > 1 ? w[1] : 'status'
  let args = w.slice(2)
  if (sub === 'status') {
    cliAiStatus(token)
  } else if (sub === 'models') {
    cliAiModels(token, args.join(' '), flags)
  } else if (sub === 'use') {
    let m = args.join(' ').trim()
    if (m === '' || (m !== APPLE_MODEL && m !== 'default' && m.indexOf(':') <= 0)) {
      cliFail(token, 'usage: moo ai use apple|default|<provider:model> (moo ai models)')
      return
    }
    let r = aiSetModel(m === 'default' ? '' : m)
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    config.aiModel = m === 'default' ? '' : m
    refreshProviders()
    cliOut(token, 'Ask AI uses ' + currentModel() + '\n')
    cliEnd(token, 0)
  } else if (sub === 'key') {
    let provider = args.length > 1 ? args[0] : 'hypery'
    let key = args.length > 1 ? args[1] : (args.length > 0 ? args[0] : '')
    if (key === '') {
      cliFail(token, 'usage: moo ai key [provider] <key>  (hypery by default; moo ai logout removes it)')
      return
    }
    let r = aiSetKey(provider, key)
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    refreshProviders()
    cliOut(token, 'Saved the ' + providerTitle(provider) + ' API key in the Keychain\n')
    cliEnd(token, 0)
  } else if (sub === 'login') {
    let provider = args.length > 0 ? args[0] : 'hypery'
    aiLogin(provider, (r) => {
      refreshProviders()
      if (r.ok) {
        cliOut(token, 'Signed in to ' + providerTitle(provider) + '\n')
        cliEnd(token, 0)
      } else {
        cliFail(token, r.error)
      }
    })
  } else if (sub === 'logout') {
    let provider = args.length > 0 ? args[0] : 'hypery'
    aiLogout(provider)
    hyperyState.account = null
    refreshProviders()
    cliOut(token, 'Signed out of ' + providerTitle(provider) + '\n')
    cliEnd(token, 0)
  } else if (sub === 'team' || sub === 'teams') {
    cliAiTeam(token, args.join(' ').trim())
  } else if (sub === 'usage' || sub === 'account') {
    cliAiUsage(token, args.length > 0 ? args[0] : 'hypery')
  } else if (sub === 'client-id') {
    if (args.length === 0) {
      cliFail(token, 'usage: moo ai client-id <id> [provider]')
      return
    }
    let r = aiSetClientId(args.length > 1 ? args[1] : 'hypery', args[0])
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    refreshProviders()
    cliEnd(token, 0)
  } else {
    cliFail(token, 'usage: moo ai [status|models [text]|use <model>|key [provider] <key>|login|logout|usage|team [name]|client-id <id>]')
  }
}

fn cliList(token, what, json) {
  let out = []
  if (what === '' || what === 'shortcuts') {
    for (let i = 0; i < config.shortcuts.length; i = i + 1) {
      let s = config.shortcuts[i]
      out.push(json ? { type: 'shortcut', keyword: s.keyword, name: s.name, kind: s.kind, target: s.target, hotkey: s.hotkey } : s.keyword + '\t' + s.name + '\t' + s.kind + '\t' + s.target + (s.hotkey !== '' ? '\t' + s.hotkey : ''))
    }
  }
  if (what === '' || what === 'commands') {
    for (let i = 0; i < commands.length; i = i + 1) {
      let c = commands[i]
      if (c.mode !== 'shortcut') {
        out.push(json ? { type: 'command', id: c.path, name: c.name } : c.path + '\t' + c.name)
      }
    }
  }
  if (what === '' || what === 'hotkeys') {
    out.push(json ? { type: 'hotkey', keys: hotkey, run: 'moo:toggle', display: hotkeyLabel, error: '' } : hotkey + '\tmoo:toggle\t' + hotkeyLabel)
    for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
      let h = hotkeyStatus[i]
      out.push(json ? { type: 'hotkey', keys: h.keys, run: h.run, display: h.display, error: h.error } : h.keys + '\t' + h.run + '\t' + (h.error !== '' ? 'not active: ' + h.error : h.display))
    }
  }
  if (what !== '' && what !== 'shortcuts' && what !== 'commands' && what !== 'hotkeys') {
    cliFail(token, 'list shortcuts, commands or hotkeys')
    return
  }
  cliOut(token, json ? JSON.stringify(out) + '\n' : (out.length > 0 ? out.join('\n') + '\n' : ''))
  cliEnd(token, 0)
}

fn cliShortcut(token, words, flags, cwd) {
  let sub = words.length > 1 ? words[1] : ''
  if (sub === 'add' && words.length >= 5) {
    let s = { keyword: words[2], kind: words[3], target: words.slice(4).join(' '), name: flags.name, hotkey: flags.hotkey, output: flags.output, input: flags.input, expand: flags.expand }
    if (s.expand && s.kind !== 'text') {
      cliFail(token, '--expand is for text shortcuts')
      return
    }
    if (s.kind === 'open' && (s.target === '.' || s.target === '..' || s.target.indexOf('./') === 0 || s.target.indexOf('../') === 0)) {
      s.target = cliPath(s.target, cwd)
    }
    if (s.name === '') {
      s.name = defaultName(s.kind, s.target, s.keyword)
    }
    if (s.hotkey !== '') {
      let conflict = hotkeyConflict(s.hotkey, '')
      if (conflict !== '') {
        cliFail(token, conflict)
        return
      }
    }
    let r = saveShortcut(s, '')
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    reloadShortcuts()
    let saved = findShortcut(s.keyword)
    let hk = null
    for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
      if (hotkeyStatus[i].run === s.keyword && hotkeyStatus[i].keys === s.hotkey) {
        hk = hotkeyStatus[i]
      }
    }
    cliOut(token, 'Added “' + saved.name + '”: type ' + saved.keyword + (saved.expand ? ' in any app to expand it' : (saved.needsQuery ? ' and some text' : '')) + '\n')
    if (hk !== null && hk.error !== '') {
      cliWrite(token, 'moo: hotkey not active: ' + hk.error + '\n', 'err')
    }
    cliEnd(token, 0)
  } else if (sub === 'rm' && words.length === 3) {
    let r = removeShortcut(words[2])
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    reloadShortcuts()
    cliEnd(token, 0)
  } else {
    cliFail(token, 'usage: moo shortcut add <keyword> <kind> <target> [--name N] [--hotkey K] [--expand] | shortcut rm <keyword>')
  }
}

fn cliHotkey(token, words) {
  let sub = words.length > 1 ? words[1] : ''
  if (sub === 'add' && words.length >= 4) {
    let target = words[3]
    let t = target.indexOf('shortcut:') === 0 ? target.slice(9) : target
    let builtin = ['show', 'hide', 'toggle', 'moo:show', 'moo:hide', 'moo:toggle'].indexOf(t) >= 0
    if (!builtin && t.indexOf('/') !== 0 && findShortcut(t) === null && findCommand(t) === null) {
      cliFail(token, 'No shortcut or command called “' + target + '” (moo list)')
      return
    }
    let conflict = hotkeyConflict(words[2], words[2])
    if (conflict !== '') {
      cliFail(token, conflict)
      return
    }
    let r = bindHotkey(words[2], target, words.slice(4).join(' '))
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    reloadShortcuts()
    for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
      let h = hotkeyStatus[i]
      if (h.keys === words[2] && h.error !== '') {
        cliFail(token, 'saved, but not active: ' + h.error)
        return
      }
    }
    cliEnd(token, 0)
  } else if (sub === 'rm' && words.length === 3) {
    let r = unbindHotkey(words[2])
    if (!r.ok) {
      cliFail(token, r.error)
      return
    }
    reloadShortcuts()
    cliEnd(token, 0)
  } else {
    cliFail(token, 'usage: moo hotkey add <keys> <keyword|id> [text] | hotkey rm <keys>')
  }
}

fn cliStatus(token, json) {
  let s = fileIndexStatus()
  let active = 0
  for (let i = 0; i < hotkeyStatus.length; i = i + 1) {
    if (hotkeyStatus[i].error === '') {
      active = active + 1
    }
  }
  let me = about()
  let st = { version: me.version, path: me.app !== null ? me.app : me.exe, launcher: hotkeyLabel, apps: appCount(), commands: commands.length - config.shortcuts.length, shortcuts: config.shortcuts.length, hotkeys: active, hotkeysNotActive: hotkeyStatus.length - active, files: s.entries, fileIndex: s.state, config: config.path }
  if (json) {
    cliOut(token, JSON.stringify(st) + '\n')
  } else {
    cliOut(token, 'version    ' + st.version + '\npath       ' + st.path + '\nplugins    ' + PLUGIN_DIR + '\nlauncher   ' + st.launcher + '\napps       ' + st.apps + '\ncommands   ' + st.commands + '\nshortcuts  ' + st.shortcuts + '\nhotkeys    ' + st.hotkeys + (st.hotkeysNotActive > 0 ? ' (' + st.hotkeysNotActive + ' not active)' : '') + '\nfiles      ' + st.files + ' (' + st.fileIndex + ')\nconfig     ' + st.config + '\n')
  }
  cliEnd(token, 0)
}

// `moo window` lists the layouts; `moo window <layout>` arranges the frontmost window.
fn cliWindow(token, layout) {
  if (layout === '') {
    let lines = []
    for (let i = 0; i < WINDOW_LAYOUTS.length; i = i + 1) {
      lines.push(WINDOW_LAYOUTS[i].layout + '\t' + WINDOW_LAYOUTS[i].name)
    }
    cliOut(token, lines.join('\n') + '\n')
    cliEnd(token, 0)
    return
  }
  let r = arrangeWindow(layout)
  if (!r.ok) {
    cliFail(token, r.message)
    return
  }
  if (r.message !== '') {
    cliOut(token, r.message + '\n')
  }
  cliEnd(token, 0)
}

let APP_ACTIONS = ['switch', 'hide', 'unhide', 'quit', 'force-quit']

// `moo running` lists apps; `moo running <action> <name|pid>` acts on one. A name must
// match one app exactly (case aside) or be the start of only one app's name.
fn cliRunning(token, w, json) {
  let apps = runningApps()
  if (w.length < 2) {
    if (json) {
      cliOut(token, JSON.stringify(apps.map((a) => ({ name: a.name, pid: a.pid, memory: a.memory, active: a.active, hidden: a.hidden, path: a.path }))) + '\n')
    } else {
      let lines = []
      for (let i = 0; i < apps.length; i = i + 1) {
        let a = apps[i]
        lines.push(a.name + '\t' + a.memoryText + '\t' + a.pid + (a.active ? '\tfrontmost' : (a.hidden ? '\thidden' : '')))
      }
      cliOut(token, lines.join('\n') + (lines.length > 0 ? '\n' : ''))
    }
    cliEnd(token, 0)
    return
  }
  let action = w[1]
  if (APP_ACTIONS.indexOf(action) < 0 || w.length < 3) {
    cliFail(token, 'usage: moo running [' + APP_ACTIONS.join('|') + ' <name|pid>]')
    return
  }
  let want = w.slice(2).join(' ').toLowerCase()
  let exact = []
  let prefix = []
  for (let i = 0; i < apps.length; i = i + 1) {
    let n = apps[i].name.toLowerCase()
    if (n === want || ('' + apps[i].pid) === want) {
      exact.push(apps[i])
    } else if (n.indexOf(want) === 0) {
      prefix.push(apps[i])
    }
  }
  let found = exact.length === 1 ? exact : (exact.length === 0 ? prefix : exact)
  if (found.length !== 1) {
    cliFail(token, found.length === 0 ? 'no running app called ' + want : want + ' matches ' + found.map((a) => a.name).join(', '))
    return
  }
  let r = appAction(found[0].pid, action)
  if (!r.ok) {
    cliFail(token, r.message)
    return
  }
  cliOut(token, (r.message !== '' ? r.message : 'Switched to ' + found[0].name) + '\n')
  cliEnd(token, 0)
}

// `moo system` lists the commands; `moo system <id> [arg]` runs one without asking.
fn cliSystem(token, id, arg) {
  if (id === '') {
    let lines = []
    for (let i = 0; i < SYSTEM_COMMANDS.length; i = i + 1) {
      let d = SYSTEM_COMMANDS[i]
      lines.push(d.system + (d.arg ? ' ' + d.arg : '') + '\t' + d.name)
    }
    cliOut(token, lines.join('\n') + '\n')
    cliEnd(token, 0)
    return
  }
  systemCommand(id, arg, (r) => {
    if (!r.ok) {
      cliFail(token, r.message)
      return
    }
    if (r.message !== '') {
      cliOut(token, r.message + '\n')
    }
    cliEnd(token, 0)
  })
}

fn handleCli(argv, cwd, token) {
  let p = cliParse(argv)
  let w = p.words
  let cmd = w.length > 0 ? w[0] : 'show'
  let rest = w.slice(1).join(' ')
  if (cmd === 'show') {
    show()
    cliEnd(token, 0)
  } else if (cmd === 'toggle') {
    toggle()
    cliEnd(token, 0)
  } else if (cmd === 'hide') {
    hide()
    cliEnd(token, 0)
  } else if (cmd === 'quit') {
    cliEnd(token, 0)
    quit()
  } else if (cmd === 'search') {
    leaveToRoot()
    show()
    setQuery(rest)
    cliEnd(token, 0)
  } else if (cmd === 'category') {
    let name = w.length > 1 ? w[1].toLowerCase() : ''
    let text = w.slice(2).join(' ')
    let found = null
    let cats = builtinCategories()
    for (let i = 0; i < cats.length; i = i + 1) {
      if (name !== '' && cats[i].title.toLowerCase().indexOf(name) === 0) {
        found = cats[i]
      }
    }
    if (found === null && name !== 'recent') {
      cliFail(token, 'usage: moo category applications|files|actions|clipboard|recent [text]')
      return
    }
    leaveToRoot()
    show()
    if (found !== null) {
      openCategory(found, text)
    } else {
      enterList(HISTORY)
      setQuery(text)
    }
    cliEnd(token, 0)
  } else if (cmd === 'key') {
    if (w.length < 2) {
      cliFail(token, 'usage: moo key <tab|shift+tab|enter|escape|down|up|…>')
      return
    }
    onKey(w[1])
    cliEnd(token, 0)
  } else if (cmd === 'type') {
    typeText(w.slice(1).join(' '))
    cliEnd(token, 0)
  } else if (cmd === 'history') {
    if (argv.indexOf('--clear') >= 0) {
      clearSearchHistory()
    } else {
      let items = searchHistory(cliLimit(p.flags, 20))
      cliOut(token, items.length > 0 ? items.join('\n') + '\n' : '')
    }
    cliEnd(token, 0)
  } else if (cmd === 'run') {
    if (w.length < 2) {
      cliFail(token, 'usage: moo run <keyword|id> [text]')
      return
    }
    let r = runTarget(w[1], w.slice(2).join(' '), { token: token, cwd: cwd })
    if (r === 'done') {
      cliEnd(token, 0)
    } else if (r !== 'pending') {
      cliFail(token, r)
    }
  } else if (cmd === 'open') {
    let target = cliPath(rest, cwd)
    if (rest === '' || !launch(target)) {
      cliFail(token, rest === '' ? 'usage: moo open <path|url>' : 'cannot open ' + target)
      return
    }
    cliEnd(token, 0)
  } else if (cmd === 'files') {
    cliFiles(token, rest, p.flags)
  } else if (cmd === 'apps') {
    let apps = search(rest, cliLimit(p.flags, 20))
    cliOut(token, p.flags.json ? JSON.stringify(apps.map((a) => ({ name: a.name, path: a.path, score: a.score }))) + '\n' : apps.map((a) => a.name + '\t' + a.path).join('\n') + (apps.length > 0 ? '\n' : ''))
    cliEnd(token, apps.length > 0 ? 0 : 1)
  } else if (cmd === 'ask') {
    cliAsk(token, rest, p.flags.model)
  } else if (cmd === 'ai') {
    cliAi(token, w, p.flags)
  } else if (cmd === 'trash') {
    cliTrash(token, rest, cwd)
  } else if (cmd === 'open-with') {
    cliOpenWith(token, w, cwd)
  } else if (cmd === 'window') {
    cliWindow(token, w.length > 1 ? w[1] : '')
  } else if (cmd === 'selection') {
    let t = selectedText()
    if (t === null) {
      cliFail(token, accessibilityTrusted(false) ? 'no selected text in the focused app' : 'Moo needs Accessibility: System Settings › Privacy & Security › Accessibility')
    } else {
      cliOut(token, t + '\n')
      cliEnd(token, 0)
    }
  } else if (cmd === 'running') {
    cliRunning(token, w, p.flags.json)
  } else if (cmd === 'system') {
    cliSystem(token, w.length > 1 ? w[1] : '', w.slice(2).join(' '))
  } else if (cmd === 'volume' || cmd === 'dark-mode' || cmd === 'mute') {
    cliSystem(token, cmd, rest)
  } else if (cmd === 'calc') {
    let a = calculate(rest)
    if (a === null) {
      cliFail(token, 'not a calculation, conversion or time: ' + rest)
    } else {
      cliOut(token, (p.flags.json ? JSON.stringify(a) : a.copy) + '\n')
      cliEnd(token, 0)
    }
  } else if (cmd === 'web') {
    cliWeb(token, w, rest)
  } else if (cmd === 'contacts') {
    cliContacts(token, rest)
  } else if (cmd === 'define') {
    let e = rest.trim() !== '' ? define(rest) : null
    if (e === null) {
      cliFail(token, rest.trim() === '' ? 'usage: moo define <word>' : 'no dictionary entry for ' + rest.trim())
    } else {
      cliOut(token, p.flags.json ? JSON.stringify(e) + '\n' : definitionText(rest, 0))
      cliEnd(token, 0)
    }
  } else if (cmd === 'clipboard') {
    let items = clipboardHistory('', cliLimit(p.flags, 10))
    cliOut(token, p.flags.json ? JSON.stringify(items.map((c) => ({ text: c.text, app: c.app, ago: c.ago }))) + '\n' : items.map((c) => c.text).join('\n') + (items.length > 0 ? '\n' : ''))
    cliEnd(token, 0)
  } else if (cmd === 'list') {
    cliList(token, rest, p.flags.json)
  } else if (cmd === 'shortcut') {
    cliShortcut(token, w, p.flags, cwd)
  } else if (cmd === 'hotkey') {
    cliHotkey(token, w)
  } else if (cmd === 'config') {
    cliOut(token, config.path + '\n')
    cliEnd(token, 0)
  } else if (cmd === 'status') {
    cliStatus(token, p.flags.json)
  } else if (cmd === 'help') {
    cliOut(token, CLI_USAGE)
    cliEnd(token, 0)
  } else {
    cliFail(token, 'unknown command “' + cmd + '” (moo help)')
  }
}

fn onCli(argv, cwd, token) {
  try {
    handleCli(argv, cwd, token)
  } catch (e) {
    cliFail(token, e.message)
  }
}

// The message of the change that wrote the file ("Saved …") outlives the refreshed rows.
fn onShortcutsChanged() {
  reloadShortcuts()
  if (shell.mode === null || modeIs('shortcuts')) {
    let hud = shell.hud
    setQuery(shell.query)
    if (hud !== '') {
      shell.hud = hud
      refresh()
    }
  }
}

syncShortcutCommands()
bindHotkeys()
syncPanelKeys()
for (let i = 0; i < config.warnings.length; i = i + 1) {
  console.log('moo: shortcuts: ' + config.warnings[i])
}
watchShortcuts(configDir(), onShortcutsChanged)
// moo:// URLs, from the marketplace on moo.moi. moo://plugins/<id> shows the launcher with that
// plugin's commands; plugins can't be installed from the web yet, so an unknown id says so.
fn onUrl(url) {
  let rest = url.indexOf('://') >= 0 ? url.slice(url.indexOf('://') + 3) : url
  let parts = rest.split('?')[0].split('/').filter((p) => p !== '')
  leaveToRoot()
  show()
  if (parts.length >= 2 && (parts[0] === 'plugins' || parts[0] === 'plugin')) {
    let id = parts[1]
    let found = commands.filter((c) => c.plugin && c.path.indexOf('plugin:' + id + '/') === 0)
    if (found.length > 0) {
      setQuery(found[0].pluginTitle)
      return
    }
    setQuery('')
    shell.hud = 'The “' + id + "” plugin isn't installed"
    refresh()
    return
  }
  setQuery('')
}
onOpenUrl(onUrl)

let served = cliServe(onCli)
console.log('moo: ' + config.shortcuts.length + ' shortcuts, ' + hotkeyStatus.length + ' hotkeys; cli ' + (served.ok ? served.path : served.error))

refreshProviders()
shell.apps = rootResults('')
compose()
syncShape()
setTheme(THEME)
setup({ width: PANEL_W, height: PANEL_H, onKey: onKey, onShow: onShow, onHotkey: onHotkey, hidden: env.MOO_START_HIDDEN === '1' })
syncSnippets()
// The host window is never shown: setup moves its content into the launcher panel, and Moo is
// a menu bar app (no Dock icon), so the window and the Regular activation policy would only flash.
macos.run(App, { autoShow: false, skipActivationPolicy: true })
