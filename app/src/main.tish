// Nimble launcher shell: Lattish-style JSX on tish-macos (`tish:macos`), launcher services from
// packages/nimble-macos (`tish:nimble`), plugins loaded at runtime as native modules (`tish:ffi`).
// Hotkey toggles the panel; type to search apps, plugin commands and files; up/down select;
// enter (or click) opens; esc leaves a plugin list, otherwise hides. tab (or "Ask AI") asks Apple's
// on-device model; the answer streams into the rows.

import { loadModule } from "tish:ffi"
import { macos, useState } from "tish:macos"
import { reindex, search, launch, setup, registerHotkey, quit, hide, appCount, searchFiles, watchApps, fuzzy, pluginPaths, copyText, loadBytecodePlugin, bundleResources, recordUse, frecency, statusItem, watchClipboard, clipboardHistory, clearClipboardHistory, aiAvailability, aiSession, aiEndSession, aiPrewarm, aiAsk, aiCancel, symbolIcon } from "tish:nimble"
import { env } from "tish:process"

const ROWS = 8
const FILE_MIN_CHARS = 2
const FILE_ROWS_WITH_APPS = 3
// Characters per answer row at 14 pt across the panel.
const AI_WRAP = 92
const AI_INSTRUCTIONS = "You are the assistant inside Nimble, a macOS launcher. Answer briefly and plainly in a few short sentences. Do not use Markdown."
const AI_TITLE = "Apple Intelligence"

let HOTKEYS = ["cmd+space", "alt+space", "ctrl+alt+space", "cmd+shift+space"]
if (env.NIMBLE_HOTKEY) {
  HOTKEYS = [env.NIMBLE_HOTKEY].concat(HOTKEYS)
}
let resources = bundleResources()
let PLUGIN_DIR = env.NIMBLE_PLUGINS ? env.NIMBLE_PLUGINS : (resources ? resources + "/plugins" : "../plugins/dist")

let index = reindex()
let watching = watchApps()
let hotkey = ""
for (let i = 0; i < HOTKEYS.length && hotkey === ""; i = i + 1) {
  let r = registerHotkey(HOTKEYS[i])
  if (r.ok) {
    hotkey = HOTKEYS[i]
  } else {
    console.log("nimble: hotkey " + r.error)
  }
}
statusItem(hotkey)
watchClipboard()

// ── Plugins: every module in PLUGIN_DIR contributes its manifest's commands to root search ──

let aiIcon = symbolIcon("sparkles")
let commands = [
  { name: "Ask AI", path: "nimble:ai", icon: aiIcon, kind: AI_TITLE, mode: "ai", pluginTitle: AI_TITLE, question: "" },
  { name: "Clipboard History", path: "nimble:clipboard", icon: "NSMultipleDocuments", kind: "Command", mode: "clipboard", pluginTitle: "Nimble" },
  { name: "Clear Clipboard History", path: "nimble:clipboard-clear", icon: "NSTrashEmpty", kind: "Command", mode: "builtin" },
  { name: "Quit Nimble", path: "nimble:quit", icon: "NSStopProgressTemplate", kind: "Command", mode: "builtin" }
]
let ASK_AI = commands[0]
let BUILTIN_COUNT = commands.length
let pluginCount = 0
let pluginFiles = pluginPaths(PLUGIN_DIR)
let pluginT0 = Date.now()

// Tier A (`.tishc`): bytecode in a capability-free VM. Tier B (`.lib`): native module via tish:ffi.
fn loadPlugin(path) {
  if (path.indexOf(".tishc") >= 0) {
    let r = loadBytecodePlugin(path)
    if (!r.ok) {
      console.log("nimble: plugin " + r.error)
      return null
    }
    console.log("nimble: tier A " + path + " in " + r.ms.toFixed(2) + " ms")
    return r.plugin
  }
  let t0 = Date.now()
  let mod = loadModule(path)
  console.log("nimble: tier B " + path + " in " + (Date.now() - t0) + " ms")
  return mod
}

fn addCommands(mod) {
  let m = mod.manifest()
  for (let j = 0; j < m.commands.length; j = j + 1) {
    let c = m.commands[j]
    commands.push({
      name: c.title,
      path: "plugin:" + m.id + "/" + c.name,
      icon: c.mode === "list" ? "NSListViewTemplate" : "NSActionTemplate",
      kind: m.title,
      mode: c.mode,
      plugin: mod,
      command: c.name,
      pluginTitle: m.title
    })
  }
  pluginCount = pluginCount + 1
}

// No `continue` inside `try`: the native backend emits the try body as a closure.
for (let i = 0; i < pluginFiles.length; i = i + 1) {
  try {
    let mod = loadPlugin(pluginFiles[i])
    if (mod !== null) {
      addCommands(mod)
    }
  } catch (e) {
    console.log("nimble: plugin " + pluginFiles[i] + " failed: " + e.message)
  }
}
let commandTitles = commands.map((c) => c.name)
console.log("nimble: indexed " + index.count + " apps in " + index.ms.toFixed(1) + " ms, watching " + watching
  + ", " + pluginCount + " plugins / " + (commands.length - BUILTIN_COUNT) + " commands in " + (Date.now() - pluginT0) + " ms, hotkey " + hotkey)

// ── Shell state ──
// Native key and show callbacks are registered once, so state lives outside the component.
// `apps` holds the synchronous rows (apps + commands, or a plugin's list); `files` arrives later
// from Spotlight for the same query. `mode` is the open plugin list command, or null at root.
let shell = { query: "", selected: 0, apps: [], files: [], results: [], rowCount: ROWS, mode: null, hud: "", version: 0, rerender: null }

fn refresh() {
  shell.version = shell.version + 1
  if (shell.rerender !== null) {
    shell.rerender(shell.version)
  }
}

// Commands scored like apps: nucleo match plus frecency boost. An empty query keeps only
// commands that have been used, scored by boost alone.
fn commandHits(text) {
  let hits = []
  if (text.trim() === "") {
    for (let i = 0; i < commands.length; i = i + 1) {
      let b = frecency(commands[i].path)
      if (b > 0) {
        hits.push({ index: i, score: b })
      }
    }
  } else {
    let raw = fuzzy(text, commandTitles, commands.length)
    for (let i = 0; i < raw.length; i = i + 1) {
      hits.push({ index: raw[i].index, score: raw[i].score + frecency(commands[raw[i].index].path) })
    }
  }
  hits.sort((a, b) => b.score - a.score)
  return hits
}

// Apps and commands share one scale (match + frecency), so merge them by score.
fn rootResults(text) {
  let apps = search(text, ROWS)
  let hits = commandHits(text)
  let out = []
  let i = 0
  let j = 0
  while (out.length < ROWS && (i < hits.length || j < apps.length)) {
    if (j >= apps.length || (i < hits.length && hits[i].score >= apps[j].score)) {
      out.push(commands[hits[i].index])
      i = i + 1
    } else {
      out.push(apps[j])
      j = j + 1
    }
  }
  // Fallback when there is room, as in Raycast; tab asks from anywhere.
  if (out.length < ROWS && text.trim() !== "") {
    out.push({ name: "Ask AI “" + text.trim() + "”", path: ASK_AI.path, icon: ASK_AI.icon, kind: AI_TITLE, mode: "ai", pluginTitle: AI_TITLE, question: text })
  }
  return out
}

fn clipboardResults(text) {
  return clipboardHistory(text, ROWS).map((c) => ({
    name: c.preview,
    kind: (c.app !== "" ? c.app + " · " : "") + c.ago,
    icon: c.icon !== "" ? c.icon : "NSMultipleDocuments",
    action: { copy: c.text, close: true }
  }))
}

fn listResults(text) {
  let m = shell.mode
  if (m.mode === "clipboard") {
    return clipboardResults(text)
  }
  try {
    let items = m.plugin.list(m.command, text)
    return items.slice(0, ROWS).map((it) => ({ name: it.title, kind: it.subtitle, icon: m.icon, action: it.action }))
  } catch (e) {
    shell.hud = "Plugin error: " + e.message
    return []
  }
}

// Synchronous rows first; once files arrive they get at least FILE_ROWS_WITH_APPS rows.
fn compose() {
  let keepApps = shell.files.length > 0 ? ROWS - Math.min(shell.files.length, FILE_ROWS_WITH_APPS) : ROWS
  shell.results = shell.apps.slice(0, keepApps).concat(shell.files).slice(0, ROWS)
  if (shell.selected >= shell.results.length) {
    shell.selected = 0
  }
}

fn onFiles(r) {
  if (shell.mode !== null || r.query !== shell.query) {
    return
  }
  shell.files = r.results
  compose()
  refresh()
}

// ── Ask AI: one session per visit, so follow-up questions keep context ──
let ai = { session: 0, request: 0, question: "", answer: "", error: "", scroll: 0, t0: 0, ms: 0, stopped: false }

fn wrapText(text, width) {
  let out = []
  let paras = text.split("\n")
  for (let p = 0; p < paras.length; p = p + 1) {
    let words = paras[p].split(" ")
    let line = ""
    for (let w = 0; w < words.length; w = w + 1) {
      let word = words[w]
      while (word.length > width) {
        if (line !== "") {
          out.push(line)
          line = ""
        }
        out.push(word.slice(0, width))
        word = word.slice(width)
      }
      if (line === "") {
        line = word
      } else if (line.length + 1 + word.length <= width) {
        line = line + " " + word
      } else {
        out.push(line)
        line = word
      }
    }
    out.push(line)
  }
  return out
}

fn aiLines() {
  return wrapText(ai.answer.split("**").join("").trim(), AI_WRAP)
}

fn aiRows() {
  if (ai.answer === "") {
    return []
  }
  let action = { copy: ai.answer, hud: "Copied answer" }
  return aiLines().slice(ai.scroll, ai.scroll + ROWS).map((l) => ({ name: l, kind: "", icon: "", action: action }))
}

fn showAi() {
  shell.apps = aiRows()
  compose()
  refresh()
}

fn aiErrorText(raw) {
  if (raw.indexOf("guardrailViolation") >= 0) {
    return "Apple's safety filter declined this request"
  }
  if (raw.indexOf("exceededContextWindowSize") >= 0) {
    return "Conversation too long for the on-device model; press esc and start again"
  }
  return "AI error: " + (raw.length > 120 ? raw.slice(0, 120) + "…" : raw)
}

fn onAiEvent(e) {
  if (e.request !== ai.request) {
    return
  }
  if (e.kind === "error") {
    ai.error = aiErrorText(e.text)
  } else {
    ai.answer = e.text
  }
  if (e.kind !== "partial") {
    ai.request = 0
    ai.ms = Date.now() - ai.t0
    ai.stopped = e.kind === "cancelled"
  }
  showAi()
}

fn askAi(question) {
  if (ai.request !== 0 || question.trim() === "") {
    return
  }
  if (ai.session === 0) {
    let why = aiAvailability()
    if (why !== "available") {
      ai.error = AI_TITLE + " is unavailable: " + why
      showAi()
      return
    }
    ai.session = aiSession(AI_INSTRUCTIONS)
  }
  ai.question = question.trim()
  ai.answer = ""
  ai.error = ""
  ai.stopped = false
  ai.scroll = 0
  ai.t0 = Date.now()
  ai.request = aiAsk(ai.session, ai.question, onAiEvent)
  if (ai.request === 0) {
    ai.error = "AI error: the model is busy"
  }
  shell.query = ""
  shell.hud = ""
  showAi()
}

fn resetAi() {
  if (ai.request !== 0) {
    aiCancel(ai.request)
  }
  if (ai.session !== 0) {
    aiEndSession(ai.session)
  }
  ai = { session: 0, request: 0, question: "", answer: "", error: "", scroll: 0, t0: 0, ms: 0, stopped: false }
}

fn inAi() {
  return shell.mode !== null && shell.mode.mode === "ai"
}

fn setQuery(text) {
  shell.query = text
  shell.selected = 0
  shell.hud = ""
  shell.files = []
  if (inAi()) {
    shell.apps = aiRows()
  } else if (shell.mode !== null) {
    shell.apps = listResults(text)
  } else {
    shell.apps = rootResults(text)
    if (text.trim().length >= FILE_MIN_CHARS) {
      searchFiles(text, ROWS, onFiles)
    }
  }
  compose()
  refresh()
}

fn enterList(c) {
  shell.mode = c
  setQuery("")
}

fn leaveList() {
  if (inAi()) {
    resetAi()
  }
  shell.mode = null
  setQuery("")
}

// Ask AI with an optional first question (the root query when entered with tab).
fn enterAi(c, question) {
  shell.mode = c
  setQuery("")
  let why = aiAvailability()
  if (why !== "available") {
    ai.error = AI_TITLE + " is unavailable: " + why
    refresh()
    return
  }
  ai.session = aiSession(AI_INSTRUCTIONS)
  if (question.trim() !== "") {
    askAi(question)
  } else {
    aiPrewarm(ai.session)
  }
}

// Actions: { copy } puts text on the clipboard, { open } opens a URL or path, { hud } is a message,
// { close } hides Nimble afterwards.
fn perform(action) {
  if (action === null) {
    return
  }
  if (action.copy) {
    copyText(action.copy)
  }
  if (action.hud) {
    shell.hud = action.hud
  }
  if (action.open) {
    launch(action.open)
    leaveList()
    return
  }
  if (action.close) {
    hide()
    leaveList()
    return
  }
  refresh()
}

fn runBuiltin(c) {
  if (c.path === "nimble:quit") {
    quit()
  } else if (c.path === "nimble:clipboard-clear") {
    clearClipboardHistory()
    shell.hud = "Clipboard history cleared"
    refresh()
  }
}

fn runCommand(c) {
  try {
    perform(c.plugin.run(c.command))
  } catch (e) {
    shell.hud = "Plugin error: " + e.message
    refresh()
  }
}

fn open(i) {
  if (i >= shell.results.length) {
    return
  }
  let target = shell.results[i]
  if (shell.mode !== null) {
    perform(target.action)
    return
  }
  if (target.kind !== "File" && target.kind !== "Folder") {
    recordUse(target.path)
  }
  if (target.mode === "builtin") {
    runBuiltin(target)
  } else if (target.mode === "ai") {
    enterAi(target, target.question)
  } else if (target.mode === "list" || target.mode === "clipboard") {
    enterList(target)
  } else if (target.mode === "no-view") {
    runCommand(target)
  } else {
    launch(target.path)
    setQuery("")
  }
}

fn onAiKey(name) {
  let maxScroll = Math.max(0, aiLines().length - ROWS)
  if (name === "down" && ai.scroll < maxScroll) {
    ai.scroll = ai.scroll + 1
    showAi()
  } else if (name === "up" && ai.scroll > 0) {
    ai.scroll = ai.scroll - 1
    showAi()
  } else if (name === "enter") {
    if (shell.query.trim() !== "") {
      askAi(shell.query)
    } else if (ai.request === 0 && ai.answer !== "") {
      copyText(ai.answer)
      shell.hud = "Copied answer"
      refresh()
    }
  } else if (name === "escape") {
    if (ai.request !== 0) {
      aiCancel(ai.request)
    } else {
      leaveList()
    }
  }
}

fn onKey(name) {
  if (inAi()) {
    onAiKey(name)
    return
  }
  let n = shell.results.length
  if (name === "tab") {
    if (shell.mode === null && shell.query.trim() !== "") {
      recordUse(ASK_AI.path)
      enterAi(ASK_AI, shell.query)
    }
  } else if (name === "down" && n > 0) {
    shell.selected = (shell.selected + 1) % n
    refresh()
  } else if (name === "up" && n > 0) {
    shell.selected = (shell.selected - 1 + n) % n
    refresh()
  } else if (name === "enter") {
    open(shell.selected)
  } else if (name === "escape") {
    if (shell.mode !== null) {
      leaveList()
    } else {
      hide()
      setQuery("")
    }
  }
}

// Recompute on show: frecency and clipboard history may have changed while hidden.
fn onShow(_) {
  setQuery(shell.query)
}

// ── View ──

fn kindLabel(r) {
  if (r === null) {
    return ""
  }
  return r.kind === "File" || r.kind === "Folder" ? r.detail : r.kind
}

fn ResultRow(props) {
  let r = props.result
  let selected = props.selected
  // Answer rows use the full width; 0 would mean "flex", so the unused columns get 1 px.
  let wide = props.wide
  return (
    <row
      onClick={() => open(props.index)}
      borderRadius={8}
      backgroundColor={selected ? "#0A84FF40" : "#00000000"}
      columnWidths={wide ? [1, "flex", 1] : [40, "flex", 250]}
      paddingTop={5}
      paddingBottom={5}
      paddingLeft={8}
      paddingRight={10}
    ><image src={r !== null ? r.icon : ""} height={26} /><text fontSize={wide ? 14 : 15}>{r !== null ? r.name : ""}</text><text fontSize={12} color="secondaryLabel" textAlign="right">{kindLabel(r)}</text></row>
  )
}

fn aiStatusText() {
  if (ai.error !== "") {
    return ai.error
  }
  let q = ai.question.length > 32 ? ai.question.slice(0, 32) + "…" : ai.question
  let lines = aiLines().length
  let more = lines > ROWS ? " · lines " + (ai.scroll + 1) + "–" + Math.min(lines, ai.scroll + ROWS) + " of " + lines : ""
  if (ai.request !== 0) {
    return AI_TITLE + " · " + (ai.answer === "" ? "thinking" : "answering") + more + " · “" + q + "”"
  }
  if (ai.answer !== "") {
    let took = (ai.stopped ? "stopped after " : "") + (ai.ms / 1000).toFixed(1) + " s"
    return AI_TITLE + " · " + took + more + " · “" + q + "”"
  }
  return AI_TITLE + " · on-device · type a question"
}

fn statusText() {
  if (shell.hud !== "") {
    return shell.hud
  }
  if (inAi()) {
    return aiStatusText()
  }
  let where = shell.mode !== null ? shell.mode.pluginTitle + " › " + shell.mode.name : "Nimble"
  if (shell.results.length === 0) {
    return where + " · No matches"
  }
  if (shell.mode === null && shell.query === "") {
    return where + " · " + appCount() + " apps · " + commands.length + " commands"
  }
  return where + " · " + shell.results.length + " matches"
}

fn App() {
  let [version, setVersion] = useState(0)
  shell.rerender = setVersion

  let rows = []
  let wide = inAi()
  let rowCount = shell.rowCount
  for (let i = 0; i < rowCount; i = i + 1) {
    let r = i < shell.results.length ? shell.results[i] : null
    rows.push(<ResultRow index={i} result={r} selected={!wide && r !== null && i === shell.selected} wide={wide} />)
  }
  let hints = "↑↓ select   ↵ open   ⇥ ask AI   esc hide"
  if (wide) {
    if (ai.request !== 0) {
      hints = "esc stop"
    } else if (ai.answer !== "" && shell.query === "") {
      hints = "↵ copy   ↑↓ scroll   esc back"
    } else {
      hints = "↵ ask   esc back"
    }
  } else if (shell.mode !== null) {
    hints = shell.mode.mode === "clipboard" ? "↑↓ select   ↵ copy   esc back" : "↑↓ select   ↵ run   esc back"
  }
  let footer = <row columnWidths={["flex", 280]} paddingTop={6}><text fontSize={11} color="secondaryLabel">{statusText()}</text><text fontSize={11} color="secondaryLabel" textAlign="right">{hints}</text></row>
  return (
    <div paddingTop={18} paddingLeft={16} paddingRight={16} paddingBottom={10}><textinput value={shell.query} onChange={setQuery} /><space height={10} />{rows}<space height={6} /><rule />{footer}</div>
  )
}

shell.apps = rootResults("")
compose()
setup({ width: 680, height: 372, onKey: onKey, onShow: onShow })
macos.run(App)
