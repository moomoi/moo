<?xml version="1.0" encoding="utf-8"?>
<!-- Moo's MSIX package, for the Microsoft Store (the Store signs it). scripts/package-msix.ps1 fills
     in $VERSION$ (x.y.z.0) and, from Partner Center's Product identity page, $NAME$, $PUBLISHER$ and
     $PUBLISHER_NAME$. Package identity is what Windows' Contacts API needs; the package also
     registers moo:// and the `moo` command (an execution alias). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="$NAME$" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Moo</DisplayName>
    <PublisherDisplayName>$PUBLISHER_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Moo" Executable="moo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Moo" Description="A fast launcher for apps, files, commands and AI"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="moo">
            <uap:DisplayName>Moo</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="moo.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MooAtLogin" Enabled="false" DisplayName="Moo" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- The `moo` command: a console copy of the binary, on PATH through an execution alias. -->
    <Application Id="MooCli" Executable="moo-cli.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Moo command" Description="The moo command line" AppListEntry="none"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="moo-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="moo.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap:Capability Name="contacts" />
  </Capabilities>
</Package>
