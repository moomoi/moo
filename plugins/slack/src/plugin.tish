// Slack: send messages, search them and open conversations from Moo. A Tier A plugin: all of it
// runs in the plugin VM and reaches Slack only through the host's `moo` object (fetch, Keychain,
// browser sign-in), which allows slack.com because the manifest asks for it.
//
//   "slack" then Space (or Tab on Send Slack Message): To (a channel or person), then Message.
//
// Sign-in is Slack's user OAuth with PKCE through a Slack app you register (slack-app.json, see
// docs/plugin-api.md); "Set Slack Client ID" stores that app's client ID. No client secret is
// needed, and the user token stays in the Keychain.

const API = "https://slack.com/api/"
const AUTHORIZE = "https://slack.com/oauth/v2_user/authorize"
const SCOPES = "chat:write,channels:read,groups:read,im:read,im:write,mpim:read,users:read,search:read"
const CACHE_MS = 10 * 60 * 1000
// Pages small enough that each one's callback stays well inside the plugin's call budget.
const PAGE = 200
const PAGES = 50
const SUGGESTIONS = 8
// api.slack.com's "create an app" page with slack-app.json filled in.
const CREATE_APP = "https://api.slack.com/apps?new_app=1&manifest_json=%7B%22display_information%22%3A%7B%22name%22%3A%22Moo%22%2C%22description%22%3A%22Send%20Slack%20messages%2C%20search%20them%20and%20open%20channels%20from%20the%20Moo%20launcher.%22%2C%22background_color%22%3A%22%231d1d1f%22%7D%2C%22oauth_config%22%3A%7B%22redirect_urls%22%3A%5B%22https%3A%2F%2Fmoo.moi%2Fcallback%22%5D%2C%22scopes%22%3A%7B%22user%22%3A%5B%22chat%3Awrite%22%2C%22channels%3Aread%22%2C%22groups%3Aread%22%2C%22im%3Aread%22%2C%22im%3Awrite%22%2C%22mpim%3Aread%22%2C%22users%3Aread%22%2C%22search%3Aread%22%5D%7D%7D%2C%22settings%22%3A%7B%22org_deploy_enabled%22%3Afalse%2C%22socket_mode_enabled%22%3Afalse%2C%22token_rotation_enabled%22%3Afalse%7D%7D"
const APPS = "https://api.slack.com/apps"
const NEEDED = { send: "Needed to send messages", search: "Needed to search messages", channels: "Needed to list your channels" }

fn parse(text, fallback) {
  if (!text) {
    return fallback
  }
  try {
    return JSON.parse(text)
  } catch (e) {
    return fallback
  }
}

fn noTeam() {
  return { id: "", name: "", url: "", user: "" }
}

fn noDirectory() {
  return { at: 0, channels: [], users: [] }
}

// null until read from the Keychain, "" when signed out.
let token = null
let team = parse(moo.store.get("team"), noTeam())
let directory = parse(moo.store.get("directory"), noDirectory())
let loading = false
// Why the last sign-in failed, shown on the Sign In row until one works.
let signInError = ""
// Message searches by query: { done, rows, error }.
let searches = {}

fn userToken() {
  if (token === null) {
    token = moo.secret.get("token")
  }
  return token
}

fn signedIn() {
  return userToken() !== ""
}

fn forget() {
  moo.secret.remove("token")
  moo.store.remove("team")
  moo.store.remove("directory")
  token = ""
  team = noTeam()
  directory = noDirectory()
  searches = {}
}

fn describe(error) {
  if (error === "not_in_channel") {
    return "you're not in that channel"
  }
  if (error === "channel_not_found") {
    return "no such channel"
  }
  if (error === "missing_scope") {
    return "the Slack app is missing a scope (see slack-app.json)"
  }
  if (error === "ratelimited") {
    return "Slack asked to slow down; try again in a minute"
  }
  return error
}

// One Web API call, a form POST with the user token; cb gets Slack's answer, `ok` false with an
// `error` when it failed (or the request never got there).
fn api(method, form, cb) {
  moo.fetch({ method: "POST", url: API + method, headers: { Authorization: "Bearer " + userToken() }, form: form }, (r) => {
    if (r.error !== "") {
      cb({ ok: false, error: r.error })
      return
    }
    let body = parse(r.body, null)
    if (body === null) {
      cb({ ok: false, error: "Slack answered " + r.status })
      return
    }
    if (!body.ok && (body.error === "invalid_auth" || body.error === "token_revoked" || body.error === "account_inactive")) {
      forget()
      moo.notify("Slack signed you out (" + body.error + ")")
      moo.refresh()
    }
    cb(body)
  })
}

// Every page of a cursor-paged method (up to PAGES), each item of `key` to `each`.
fn pageThrough(method, form, key, each, done, fail) {
  fn page(n) {
    api(method, form, (r) => {
      if (!r.ok) {
        fail(r.error)
        return
      }
      let items = r[key] ? r[key] : []
      for (let i = 0; i < items.length; i = i + 1) {
        each(items[i])
      }
      let next = r.response_metadata && r.response_metadata.next_cursor ? r.response_metadata.next_cursor : ""
      if (next !== "" && n + 1 < PAGES) {
        form.cursor = next
        page(n + 1)
      } else {
        done()
      }
    })
  }
  page(0)
}

fn groupName(name) {
  let n = name.indexOf("mpdm-") === 0 ? name.slice(5) : name
  if (n.length > 2 && n.slice(n.length - 2, n.length - 1) === "-") {
    n = n.slice(0, n.length - 2)
  }
  return n.split("--").join(", ")
}

fn channelEntry(c) {
  if (c.is_im) {
    return { id: c.id, kind: "im", name: "", user: c.user, member: true }
  }
  if (c.is_mpim) {
    return { id: c.id, kind: "group", name: groupName(c.name), user: "", member: true }
  }
  return { id: c.id, kind: c.is_private ? "private" : "channel", name: c.name, user: "", member: c.is_member === true }
}

fn userEntry(u) {
  let p = u.profile ? u.profile : {}
  let shown = p.display_name ? p.display_name : (p.real_name ? p.real_name : u.name)
  return { id: u.id, handle: u.name, name: shown, real: p.real_name ? p.real_name : "", avatar: p.image_48 ? p.image_48 : "" }
}

// Channels and people, cached for CACHE_MS (and on disk, so the first keystroke has them).
fn loadDirectory(force) {
  if (loading || !signedIn()) {
    return
  }
  if (!force && directory.at > 0 && Date.now() - directory.at < CACHE_MS) {
    return
  }
  loading = true
  let next = noDirectory()
  let fail = (error) => {
    loading = false
    moo.notify("Slack: " + describe(error))
  }
  let people = () => {
    pageThrough("users.list", { limit: PAGE }, "members", (u) => {
      if (!u.deleted && !u.is_bot && u.id !== "USLACKBOT") {
        next.users.push(userEntry(u))
      }
    }, () => {
      next.at = Date.now()
      directory = next
      moo.store.set("directory", JSON.stringify(directory))
      loading = false
      moo.refresh()
    }, fail)
  }
  pageThrough("conversations.list", { types: "public_channel,private_channel,mpim,im", exclude_archived: "true", limit: PAGE }, "channels", (c) => next.channels.push(channelEntry(c)), people, fail)
}

fn person(id) {
  let found = directory.users.filter((u) => u.id === id)
  return found.length > 0 ? found[0] : null
}

fn conversation(id) {
  let found = directory.channels.filter((c) => c.id === id)
  return found.length > 0 ? found[0] : null
}

// "#general", "Jane Doe", "alice, bob": how a channel or person id reads.
fn label(id) {
  let u = person(id)
  if (u !== null) {
    return u.name
  }
  let c = conversation(id)
  if (c === null) {
    return id
  }
  if (c.kind === "im") {
    let other = person(c.user)
    return other !== null ? other.name : c.user
  }
  return c.kind === "group" ? c.name : "#" + c.name
}

// 2 when a word of `text` starts with `q`, 1 when it contains it, else 0.
fn score(text, q) {
  let t = text.toLowerCase()
  if (q === "" || t.indexOf(q) === 0 || t.indexOf(" " + q) >= 0 || t.indexOf("-" + q) >= 0 || t.indexOf("_" + q) >= 0) {
    return 2
  }
  return t.indexOf(q) >= 0 ? 1 : 0
}

fn best(rows) {
  let top = rows.filter((r) => r.score === 2)
  return top.concat(rows.filter((r) => r.score === 1))
}

fn channelRow(c, q) {
  if (c.kind === "group") {
    return { score: score(c.name, q), title: c.name, subtitle: "Group message", value: c.id, icon: "symbol:person.2" }
  }
  return { score: score(c.name, q), title: "#" + c.name, subtitle: c.kind === "private" ? "Private channel" : "Channel", value: c.id, icon: c.kind === "private" ? "symbol:lock" : "symbol:number" }
}

fn personRow(u, q) {
  let s = Math.max(score(u.name, q), Math.max(score(u.handle, q), score(u.real, q)))
  let sub = "@" + u.handle + (u.real !== "" && u.real !== u.name ? " · " + u.real : "")
  return { score: s, title: u.name, subtitle: sub, value: u.id, icon: u.avatar !== "" ? u.avatar : "symbol:person.crop.circle" }
}

// Where a message can go: channels you're in, people and group messages that match `text`.
fn targets(text) {
  let q = text.trim().toLowerCase()
  if (q.indexOf("#") === 0 || q.indexOf("@") === 0) {
    q = q.slice(1)
  }
  let rows = directory.channels.filter((c) => c.kind !== "im" && c.member).map((c) => channelRow(c, q))
  rows = rows.concat(directory.users.map((u) => personRow(u, q)))
  return best(rows).slice(0, SUGGESTIONS)
}

// The Client ID field's way to get one: create the app with everything filled in, or find it.
fn clientHelp() {
  let hud = "Create the app, turn on PKCE under OAuth & Permissions, then paste its Client ID here"
  return [
    { title: "Create Moo's Slack App", subtitle: "Opens Slack with it filled in", icon: "symbol:plus.app", action: { open: CREATE_APP, stay: true, hud: hud } },
    { title: "I Already Made It", subtitle: "Opens your Slack apps", icon: "symbol:square.grid.2x2", action: { open: APPS, stay: true, hud: "Open Moo's app, copy the Client ID from Basic Information, then paste it here" } }
  ]
}

fn suggest(command, argument, text, values) {
  if (command === "client") {
    return clientHelp()
  }
  if (command !== "send" || argument !== "to") {
    return []
  }
  loadDirectory(false)
  return targets(text)
}

// What a command needs first. The shell shows it as the one row inside the command.
fn blocker(command) {
  if (command === "signin" || command === "client" || signedIn()) {
    return null
  }
  if (signInError.indexOf("client_id") >= 0) {
    return { title: "Fix the Slack Client ID", subtitle: "Slack didn't recognize it", icon: "symbol:key", action: { run: "client" } }
  }
  let why = NEEDED[command] ? NEEDED[command] : "Needed first"
  return { title: "Sign In to Slack", subtitle: signInError !== "" ? "Last try: " + signInError : why, icon: "symbol:person.badge.key", action: { run: "signin" } }
}

fn visible(command) {
  if (command === "signin" || command === "client") {
    return !signedIn()
  }
  if (command === "signout" || command === "refresh") {
    return signedIn()
  }
  return true
}

// Slack's markup to plain text: <@U1> -> @name, <#C1|general> -> #general, <url|label> -> label.
fn plain(text) {
  let out = ""
  let rest = text
  let open = rest.indexOf("<")
  while (open >= 0) {
    let close = rest.indexOf(">", open)
    if (close < 0) {
      break
    }
    out = out + rest.slice(0, open)
    let inner = rest.slice(open + 1, close)
    let bar = inner.indexOf("|")
    if (bar >= 0) {
      out = out + (inner.indexOf("#") === 0 ? "#" : "") + inner.slice(bar + 1)
    } else if (inner.indexOf("@") === 0) {
      out = out + "@" + label(inner.slice(1))
    } else if (inner.indexOf("#") === 0) {
      out = out + label(inner.slice(1))
    } else {
      out = out + inner
    }
    rest = rest.slice(close + 1)
    open = rest.indexOf("<")
  }
  out = out + rest
  return out.split("\n").join(" ").split("&amp;").join("&").split("&lt;").join("<").split("&gt;").join(">")
}

fn searchRows(query) {
  let known = searches[query]
  if (known) {
    return known
  }
  let entry = { done: false, rows: [], error: "", scope: false }
  searches[query] = entry
  api("search.messages", { query: query, count: 40, sort: "timestamp" }, (r) => {
    entry.done = true
    if (!r.ok) {
      entry.error = describe(r.error)
      entry.scope = r.error === "missing_scope"
    } else {
      let matches = r.messages && r.messages.matches ? r.messages.matches : []
      entry.rows = matches.map((m) => {
        let where = m.channel && m.channel.name ? (m.channel.is_im ? "Direct message" : "#" + m.channel.name) : ""
        let who = m.username ? m.username : (m.user ? label(m.user) : "")
        let text = plain(m.text ? m.text : "")
        return { title: text.length > 140 ? text.slice(0, 139) + "…" : text, subtitle: [where, who].filter((s) => s !== "").join(" · "), icon: "symbol:text.bubble", action: { open: m.permalink } }
      })
    }
    moo.refresh()
  })
  return entry
}

fn notice(title, subtitle) {
  return [{ title: title, subtitle: subtitle, icon: "symbol:info.circle", action: { hud: title } }]
}

fn appUrl(path) {
  return "slack://" + path + "?team=" + team.id + "&id="
}

fn conversationRow(c, q) {
  if (c.kind === "im") {
    let u = person(c.user)
    if (u === null) {
      return { score: 0 }
    }
    let row = personRow(u, q)
    row.action = { open: appUrl("user") + u.id }
    return row
  }
  let row = channelRow(c, q)
  row.action = { open: appUrl("channel") + c.id }
  return row
}

fn list(command, text, args) {
  let q = text.trim().toLowerCase()
  if (command === "channels") {
    loadDirectory(false)
    if (directory.at === 0) {
      return notice("Loading your Slack channels…", team.name)
    }
    return best(directory.channels.filter((c) => c.member).map((c) => conversationRow(c, q))).slice(0, 50)
  }
  if (command === "search") {
    let query = args.query ? args.query : ""
    if (query === "") {
      return notice("Type what to search for", "Search Slack Messages takes a query")
    }
    let found = searchRows(query)
    if (!found.done) {
      return notice("Searching Slack for “" + query + "”…", team.name)
    }
    if (found.error !== "" && found.scope) {
      return [{ title: "Sign In to Slack Again", subtitle: "Searching needs access Moo doesn't have yet", icon: "symbol:person.badge.key", action: { run: "signin" } }]
    }
    if (found.error !== "") {
      return notice("Slack: " + found.error, "")
    }
    let rows = found.rows.filter((r) => q === "" || r.title.toLowerCase().indexOf(q) >= 0 || r.subtitle.toLowerCase().indexOf(q) >= 0)
    return rows.length > 0 ? rows : notice("No messages match “" + query + "”", team.name)
  }
  return []
}

// Post `text` to a channel id, or to the direct message with a person (opening it if need be).
fn send(to, text) {
  if (!signedIn()) {
    return { run: "signin" }
  }
  let where = label(to)
  let post = (channel) => {
    api("chat.postMessage", { channel: channel, text: text }, (r) => moo.notify(r.ok ? "Sent to " + where : "Slack: " + describe(r.error)))
  }
  if (person(to) !== null) {
    let im = directory.channels.filter((c) => c.kind === "im" && c.user === to)
    if (im.length > 0) {
      post(im[0].id)
    } else {
      api("conversations.open", { users: to }, (r) => {
        if (r.ok) {
          post(r.channel.id)
        } else {
          moo.notify("Slack: " + describe(r.error))
        }
      })
    }
  } else {
    post(to)
  }
  return { hud: "Sending to " + where + "…" }
}

fn signIn() {
  let clientId = moo.store.get("clientId")
  if (clientId === "") {
    return { run: "client", hud: "Slack sign-in needs Moo's Slack app: create it, then paste its Client ID" }
  }
  signInError = ""
  moo.signIn({ authorize: AUTHORIZE, token: API + "oauth.v2.user.access", clientId: clientId, scope: SCOPES }, (r) => {
    if (!r.ok) {
      signInError = r.error
      let pkce = r.error.indexOf("secret") >= 0 || r.error.indexOf("verifier") >= 0 || r.error.indexOf("pkce") >= 0
      moo.notify("Slack sign-in failed: " + r.error + (pkce ? " · turn on PKCE under OAuth & Permissions in your Slack app" : ""))
      moo.refresh()
      return
    }
    token = r.accessToken
    searches = {}
    moo.secret.set("token", token)
    api("auth.test", {}, (a) => {
      if (!a.ok) {
        moo.notify("Slack: " + describe(a.error))
        return
      }
      team = { id: a.team_id, name: a.team, url: a.url, user: a.user }
      moo.store.set("team", JSON.stringify(team))
      moo.notify("Signed in to " + a.team + " as " + a.user)
      moo.refresh()
      loadDirectory(true)
    })
  })
  return { hud: "Finish signing in to Slack in your browser…" }
}

fn signOut() {
  if (!signedIn()) {
    return { hud: "Not signed in to Slack" }
  }
  let name = team.name
  api("auth.revoke", {}, (r) => {})
  forget()
  return { hud: "Signed out of " + (name !== "" ? name : "Slack") }
}

fn run(command, args) {
  if (command === "send") {
    return send(args.to, args.message)
  }
  if (command === "signin") {
    return signIn()
  }
  if (command === "signout") {
    return signOut()
  }
  if (command === "refresh") {
    loadDirectory(true)
    return { hud: "Refreshing Slack channels and people…" }
  }
  if (command === "client") {
    moo.store.set("clientId", args.id.trim())
    return signIn()
  }
  return { hud: "Unknown Slack command " + command }
}

register({
  manifest: () => ({
    id: "slack",
    title: "Slack",
    icon: "symbol:number.square",
    permissions: { network: ["slack.com"] },
    commands: [
      {
        name: "send",
        title: "Send Slack Message",
        mode: "no-view",
        keyword: "slack",
        icon: "symbol:paperplane",
        arguments: [
          { name: "to", placeholder: "To", type: "dropdown", required: true },
          { name: "message", placeholder: "Message", type: "text", required: true }
        ]
      },
      {
        name: "search",
        title: "Search Slack Messages",
        mode: "list",
        icon: "symbol:text.magnifyingglass",
        arguments: [{ name: "query", placeholder: "Search for", type: "text", required: true }]
      },
      { name: "channels", title: "Open Slack Channel", mode: "list", icon: "symbol:number" },
      { name: "refresh", title: "Refresh Slack Channels", mode: "no-view", icon: "symbol:arrow.clockwise" },
      { name: "signin", title: "Sign In to Slack", mode: "no-view", icon: "symbol:person.badge.key" },
      { name: "signout", title: "Sign Out of Slack", mode: "no-view", icon: "symbol:rectangle.portrait.and.arrow.right" },
      {
        name: "client",
        title: "Set Slack Client ID",
        mode: "no-view",
        icon: "symbol:key",
        arguments: [{ name: "id", placeholder: "Slack Client ID", type: "text", required: true }]
      }
    ]
  }),
  run: run,
  list: list,
  suggest: suggest,
  blocker: blocker,
  visible: visible
})
