// Smoke-test each built plugin's contract: tish run plugins/check.tish dist/utils.lib
import { loadModule } from "tish:ffi"
import { argv } from "tish:process"

let p = loadModule(argv[argv.length - 1])
let m = p.manifest()
console.log("manifest", m.id, m.commands.length, "commands")
for (let i = 0; i < m.commands.length; i = i + 1) {
  let c = m.commands[i]
  if (c.mode === "no-view") {
    console.log("run", c.name, JSON.stringify(p.run(c.name)))
  } else {
    let items = p.list(c.name, "")
    console.log("list", c.name, items.length, "items; first", JSON.stringify(items[0]))
  }
}
console.log("list emoji 'ro'", JSON.stringify(p.list("emoji", "ro").map((x) => x.title)))
