// Unit Converter: a Tier A plugin. It compiles to bytecode and runs in its own VM with no
// capabilities (no fs, process, network or timers); it can only compute and return data.
// The host injects `register`; the plugin hands over the same contract native plugins export.

let runs = 0

const UNITS = [
  ["km", "length", 1000], ["m", "length", 1], ["cm", "length", 0.01], ["mm", "length", 0.001],
  ["mi", "length", 1609.344], ["yd", "length", 0.9144], ["ft", "length", 0.3048], ["in", "length", 0.0254],
  ["kg", "mass", 1], ["g", "mass", 0.001], ["lb", "mass", 0.45359237], ["oz", "mass", 0.028349523125],
  ["l", "volume", 1], ["ml", "volume", 0.001], ["gal", "volume", 3.785411784], ["cup", "volume", 0.2365882365],
  ["kb", "data", 1000], ["mb", "data", 1000000], ["gb", "data", 1000000000], ["kib", "data", 1024],
  ["mib", "data", 1048576], ["gib", "data", 1073741824]
]

fn findUnit(name) {
  let n = name.toLowerCase()
  for (let i = 0; i < UNITS.length; i = i + 1) {
    if (UNITS[i][0] === n) {
      return UNITS[i]
    }
  }
  return null
}

fn fmt(x) {
  if (x !== 0 && (Math.abs(x) >= 1000000000000 || Math.abs(x) < 0.0001)) {
    return x.toExponential(4)
  }
  return String(Math.round(x * 10000) / 10000)
}

fn temperature(value, unit) {
  let u = unit.toLowerCase()
  if (u === "c") {
    return [[fmt(value * 9 / 5 + 32), "°F"], [fmt(value + 273.15), "K"]]
  }
  if (u === "f") {
    return [[fmt((value - 32) * 5 / 9), "°C"], [fmt((value - 32) * 5 / 9 + 273.15), "K"]]
  }
  return []
}

// "10 km", "10km", "72 f": a number then a unit.
fn parse(query) {
  let q = query.trim()
  let i = 0
  while (i < q.length && "0123456789.-".indexOf(q[i]) >= 0) {
    i = i + 1
  }
  if (i === 0) {
    return null
  }
  let value = Number(q.slice(0, i))
  let unit = q.slice(i).trim()
  if (isNaN(value) || unit === "") {
    return null
  }
  return { value: value, unit: unit }
}

fn convertList(query) {
  let p = parse(query)
  if (p === null) {
    return [{ title: "Type a value and unit", subtitle: "e.g. 10 km, 72 f, 3 lb, 512 mib", action: { hud: "Try: 10 km" } }]
  }
  let out = []
  let temps = temperature(p.value, p.unit)
  for (let i = 0; i < temps.length; i = i + 1) {
    let text = temps[i][0] + " " + temps[i][1]
    out.push({ title: text, subtitle: p.value + " °" + p.unit.toUpperCase(), action: { copy: temps[i][0], hud: "Copied " + text } })
  }
  let from = findUnit(p.unit)
  if (from !== null) {
    for (let i = 0; i < UNITS.length; i = i + 1) {
      let to = UNITS[i]
      if (to[1] === from[1] && to[0] !== from[0]) {
        let text = fmt(p.value * from[2] / to[2]) + " " + to[0]
        out.push({ title: text, subtitle: p.value + " " + from[0] + " · " + from[1], action: { copy: fmt(p.value * from[2] / to[2]), hud: "Copied " + text } })
      }
    }
  }
  if (out.length === 0) {
    out.push({ title: "Unknown unit \"" + p.unit + "\"", subtitle: "length, mass, volume, data, or c / f", action: null })
  }
  return out
}

fn password() {
  let chars = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789-_!@#%"
  let s = ""
  for (let i = 0; i < 20; i = i + 1) {
    s = s + chars[Math.floor(Math.random() * chars.length)]
  }
  return s
}

register({
  manifest: () => ({
    id: "convert",
    title: "Unit Converter",
    commands: [
      { name: "convert", title: "Convert Units", subtitle: "10 km, 72 f, 3 lb, 512 mib", mode: "list" },
      { name: "password", title: "Generate Password", subtitle: "Copy a random 20-character password", mode: "no-view" },
      { name: "runs", title: "Converter Stats", subtitle: "Calls served by this VM", mode: "no-view" }
    ]
  }),
  run: (command) => {
    runs = runs + 1
    if (command === "password") {
      return { copy: password(), hud: "Copied a new password" }
    }
    return { hud: "Unit Converter VM has served " + runs + " calls" }
  },
  list: (command, query) => {
    runs = runs + 1
    return convertList(query)
  }
})
